[Unit]
Description=domum-media: daily restic backup (NAS + cloud)
Documentation=file:///opt/domum-core-media/docs/SETUP-RESTIC.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/usr/local/bin/domum-media-backup
# This unit reads or writes the protected storage, so it must not run with
# either root unmounted: it would classify a phantom tree, or create the
# snapshot root on the OS disk. RequiresMountsFor= adds Requires= and After=.
RequiresMountsFor=/srv/data /srv/snapshots

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CacheDirectory=domum-media-restic
CacheDirectoryMode=0700
Environment=XDG_CACHE_HOME=/var/cache/domum-media-restic
ExecStart=/usr/local/bin/domum-media-backup
TimeoutStartSec=18h
