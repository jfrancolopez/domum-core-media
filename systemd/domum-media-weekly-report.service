[Unit]
Description=domum-media: write weekly operational report
Documentation=file:///opt/domum-core-media/docs/WEEKLY-REPORT.md
ConditionPathExists=/usr/local/bin/domum-media
# This unit reads or writes the protected storage, so it must not run with
# either root unmounted: it would classify a phantom tree, or create the
# snapshot root on the OS disk. RequiresMountsFor= adds Requires= and After=.
RequiresMountsFor=/srv/data /srv/snapshots

[Service]
Type=oneshot
# The `-` prefixes are the opposite way round from the obvious reading, and
# getting them wrong is worse than having no notification at all.
#
# For Type=oneshot systemd runs each ExecStart in order, and a non-zero one
# WITHOUT a `-` fails the unit and the REMAINING lines are never executed. So:
#
#   report --write   takes `-`, because a failed report must NOT suppress the
#                    alert. A broken report is exactly when being told matters.
#   health-notify    takes NO prefix, because an alert that could not be
#                    DELIVERED must fail the unit -- that is what puts it in
#                    `systemctl --failed`, where checkup_systemd_health finds
#                    it. With `-` an undeliverable alert left the unit green and
#                    nothing surfaced it: silence would have meant "healthy"
#                    when it actually meant "could not tell you".
ExecStart=-/usr/local/bin/domum-media report --write
ExecStart=/usr/local/bin/domum-media health-notify
TimeoutStartSec=10m
