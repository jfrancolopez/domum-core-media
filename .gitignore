# Local environment files (real values live outside the repo)
*.env
.env
.env.*
!.env.example
!config/ci.env

# The REAL production config. It lives at
# /opt/domum-core-media/config/domum-media.conf, is mode 0600 root-only, and
# holds the production topology -- domains, backup endpoints, SFTP hosts -- plus
# the paths of every secret file. `git add -A` in the production checkout would
# have staged it, and it showed as permanently untracked there, which trains the
# operator to ignore git status in production. Secret VALUES live in
# /etc/domum-core-media/secrets and are referenced by *_FILE, so this is not a
# secret store; it is still production configuration that must never be
# committed. The .example stays tracked -- the installer copies it.
config/domum-media.conf

# Anything containing real secrets
secrets/
*.key
*.pem
*.crt
acme.json

# Live data (lives under /srv/data on the host)
data/
/srv/

# Logs
*.log
logs/

# macOS / editor noise
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Local-only Nimbalyst session state
nimbalyst-local/

# Rendered Traefik dynamic config (sources live as *.tmpl)
compose/proxy/traefik/dynamic/dashboard.yml
