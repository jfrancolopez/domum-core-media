# Copy to /srv/data/experiments/aurral/aurral.env (0600, root) and fill in.
# Untracked on purpose: the repository carries no infrastructure address, and
# tests/identifier-audit.py rejects one in a tracked file.
#
# Every value below is required. compose refuses to start with one missing,
# and firewall.sh refuses to apply a policy with an empty block list -- an
# empty list would open the LAN while reporting success.

# This host's LAN address and its Tailscale address. The Aurral UI is
# published on these two ONLY -- never 0.0.0.0, never IPv6.
AURRAL_LAN_IP=<this host's LAN IPv4>
AURRAL_TAILSCALE_IP=<this host's Tailscale IPv4>

# A private /24 used by nothing else (check `docker network inspect` and the
# LAN), and two addresses inside it.
AURRAL_SUBNET=<unused private /24>
AURRAL_PROXY_IP=<.10 in that subnet>
AURRAL_APP_IP=<.20 in that subnet>

# A PUBLIC DNS resolver, e.g. Quad9 or Cloudflare. It must be public, and that
# is a correctness requirement rather than a preference: this host's own
# resolver is Tailscale MagicDNS, which the experiment must not reach, and a
# resolver on the host would be blocked by the host-isolation rule. A public
# one is reached over the egress path that is open anyway.
# These two are the approved resolvers and are also compose's defaults, so
# they are stated here as values rather than placeholders. A public resolver
# is not infrastructure information, so unlike every other address in this
# file it can be named in the repository.
AURRAL_DNS=1.1.1.1
AURRAL_DNS_FALLBACK=1.0.0.1

# The ranges Aurral may not open a connection to, space separated. List, at
# minimum, the three RFC1918 ranges and the Tailscale CGNAT range:
#
#     10/8   172.16/12   192.168/16   100.64/10
#
# written out as full CIDRs. Loopback, link-local (including the cloud
# metadata address), multicast and the reserved ranges are always blocked and
# do not need listing. Add any further range your LAN uses.
#
# THE QUOTES ARE REQUIRED. This file is sourced, so an unquoted value stops
# at the first space and bash runs the rest as a command. firewall.sh refuses
# rather than applying a short list, and it names this as the likely cause.
#
# firewall.sh also proves the list COVERS each required range, so a list of
# four unrelated entries is refused even though it has four of them.
AURRAL_BLOCK_CIDRS="<range> <range> <range> <range>"

# Used only by validate.sh, to prove the LAN router is unreachable.
AURRAL_LAN_ROUTER_IP=<the LAN default gateway>

# Optional, and worth setting: validate.sh will prove a REAL device on each
# network is unreachable from Aurral, rather than only the router and this
# host. Left unset, those two checks report that they were skipped.
#AURRAL_LAN_PEER_IP=<another device on the LAN>
#AURRAL_TAILSCALE_PEER_IP=<another device on the tailnet>
