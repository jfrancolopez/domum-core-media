#!/usr/bin/env bash
set -euo pipefail

# domum-media-backup — restic wrapper invoked by systemd timers and the CLI.
#
# Backups are now driven by BACKUP_TARGET_* entries in config/domum-media.conf.
# Each enabled target can be a plain restic repository string, an NFS-mounted
# repo, or an FTP target reached via restic's rclone backend.

DOMUM_DIR="${DOMUM_DIR:-/opt/domum-core-media}"
CFG_FILE="${CFG_FILE:-$DOMUM_DIR/config/domum-media.conf}"
SECRETS_DIR="${SECRETS_DIR:-/etc/domum-core-media/secrets}"
REPO_META_DIR="${REPO_META_DIR:-/var/lib/domum-media/backups}"

die() { echo "ERROR: $*" >&2; exit 1; }
# Non-fatal problems. This script had only `die` and `log`, so five `warn`
# calls in the exclusion gate -- the lines that explain WHY an exclusion was
# withheld -- printed "warn: command not found" and the operator was told
# nothing. The gate itself was correct; only its explanation was missing, which
# is the worse half to lose: a refusal nobody can read trains people to ignore
# refusals. `log` is not a substitute, because it writes to LOG_FILE, which an
# unprivileged or read-only caller may not have.
warn() { echo "WARNING: $*" >&2; }
log() { echo "[$(date -Iseconds)] $*" | tee -a "$LOG_FILE" >&2; }

need_root() { [[ "${EUID}" -eq 0 ]] || die "Run as root (use sudo)."; }
cmd_exists() { command -v "$1" >/dev/null 2>&1; }

uppercase_token() {
  printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_' | tr -c 'A-Z0-9_' '_'
}

load_cfg() {
  [[ -f "$CFG_FILE" ]] || die "Missing config: $CFG_FILE"
  # shellcheck disable=SC1090
  source "$CFG_FILE"
  DOMUM_DATA_ROOT="${DOMUM_DATA_ROOT:-/srv/data}"
  DOMUM_MEDIA_ROOT="${DOMUM_MEDIA_ROOT:-/srv/media}"
  DOMUM_SNAPSHOT_ROOT="${DOMUM_SNAPSHOT_ROOT:-/srv/snapshots}"
  DOMUM_LOG_DIR="${DOMUM_LOG_DIR:-/var/log/domum-media}"
  RESTIC_KEEP_DAILY="${RESTIC_KEEP_DAILY:-7}"
  RESTIC_KEEP_WEEKLY="${RESTIC_KEEP_WEEKLY:-5}"
  RESTIC_KEEP_MONTHLY="${RESTIC_KEEP_MONTHLY:-12}"
  RESTIC_KEEP_YEARLY="${RESTIC_KEEP_YEARLY:-3}"
  BACKUP_DEEP_CHECK_PERCENT="${BACKUP_DEEP_CHECK_PERCENT:-10%}"
  # Global fallback for targets without an explicit *_INCLUDE_PATHS. Durable
  # state only — never the disposable /srv/media media disk by default.
  BACKUP_INCLUDE_PATHS="${BACKUP_INCLUDE_PATHS:-/srv/data}"
}

# Immich-only profile: photos + database dump + recovery pack. This is the
# default for the cloud target so large media libraries are never uploaded.
immich_only_include_paths() {
  printf '%s/immich/library %s/immich/backup-staging /var/lib/domum-media/recovery-pack' \
    "$DOMUM_DATA_ROOT" "$DOMUM_DATA_ROOT"
}

export_compose_env() {
  export DOMUM_DOMAIN="${DOMUM_DOMAIN:-ladomum.com}"
  export DOMUM_DATA_ROOT
  export IMMICH_DB_USERNAME="${IMMICH_DB_USERNAME:-postgres}"
  export IMMICH_DB_DATABASE_NAME="${IMMICH_DB_DATABASE_NAME:-immich}"

  if [[ -f "$SECRETS_DIR/immich_db_password" ]]; then
    IMMICH_DB_PASSWORD="$(cat "$SECRETS_DIR/immich_db_password")"
    export IMMICH_DB_PASSWORD
  fi
  if [[ -f "$SECRETS_DIR/immich_jwt_secret" ]]; then
    IMMICH_JWT_SECRET="$(cat "$SECRETS_DIR/immich_jwt_secret")"
    export IMMICH_JWT_SECRET
  fi
}

ensure_dirs() {
  mkdir -p "$DOMUM_LOG_DIR"
  LOG_FILE="$DOMUM_LOG_DIR/backup.log"
  HEARTBEAT_FILE="$DOMUM_LOG_DIR/last-success"
  # Create the log restrictively if it does not exist yet. restic prints paths
  # from the photo library on error, so it must not be world-readable; `tee -a`
  # would otherwise create it with the ambient umask.
  #
  # An EXISTING file is deliberately never touched: doing so bumped backup.log's
  # mtime on every read-only invocation -- including the latest-snapshot query
  # that `domum-media report` makes -- which made a read-only report look like
  # backup activity.
  [[ -e "$LOG_FILE" ]] || install -m 0640 /dev/null "$LOG_FILE" 2>/dev/null || true
}

require_files() {
  local missing=()
  for f in "$@"; do
    [[ -f "$f" ]] || missing+=("$f")
  done
  if (( ${#missing[@]} > 0 )); then
    die "Missing required files: ${missing[*]}"
  fi
}

backup_target_names() {
  local names="${BACKUP_TARGETS:-nas cloud}"
  for name in $names; do
    [[ -n "$name" ]] && echo "$name"
  done
}

backup_target_default_enabled() {
  case "$1" in
    nas|cloud) echo "1" ;;
    *)         echo "0" ;;
  esac
}

backup_target_value() {
  local target="$1"
  local field="$2"
  local fallback="${3:-}"
  local key
  key="BACKUP_TARGET_$(uppercase_token "$target")_${field}"
  if [[ -n "${!key:-}" ]]; then
    printf '%s' "${!key}"
  else
    printf '%s' "$fallback"
  fi
}

backup_target_enabled() {
  [[ "$(backup_target_value "$1" ENABLED "$(backup_target_default_enabled "$1")")" == "1" ]]
}

backup_target_password_file() {
  backup_target_value "$1" PASSWORD_FILE "$SECRETS_DIR/restic_password_$1"
}

shell_join_quoted() {
  local joined=""
  printf -v joined '%q ' "$@"
  printf '%s' "${joined% }"
}

sftp_repo_user_host() {
  local repo="$1"
  local path
  [[ "$repo" =~ ^sftp:([A-Za-z0-9._-]+)@([A-Za-z0-9.-]+):(/.*)$ ]] || return 1
  path="${BASH_REMATCH[3]}"
  [[ "$path" != "/" && "$path" != *:* && "$path" != *[[:space:]]* ]] || return 1
  [[ "$path" != "/./"* && "$path" != *"/./"* && "$path" != *"/../"* ]] || return 1
  [[ "$path" != */. && "$path" != */.. ]] || return 1
  printf '%s\n%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
}

sftp_port_is_valid() {
  local port="$1"
  [[ "$port" =~ ^[0-9]+$ ]] || return 1
  (( 10#$port >= 1 && 10#$port <= 65535 ))
}

sftp_command_option_for_target() {
  local target="$1"
  local sftp_key sftp_known_hosts sftp_port repo
  local -a ssh_cmd=()
  local -a sftp_parts=()
  sftp_key="$(backup_target_value "$target" SFTP_KEY_FILE)"
  sftp_known_hosts="$(backup_target_value "$target" SFTP_KNOWN_HOSTS_FILE)"
  sftp_port="$(backup_target_value "$target" SFTP_PORT)"
  [[ -n "$sftp_key" ]] || die "SFTP target '$target' is missing BACKUP_TARGET_$(uppercase_token "$target")_SFTP_KEY_FILE."
  require_files "$sftp_key"
  repo="$(backup_target_value "$target" REPOSITORY)"
  mapfile -t sftp_parts < <(sftp_repo_user_host "$repo") \
    || die "SFTP target '$target' must use sftp:user@host:/absolute/path; configure the port separately."
  [[ -n "${sftp_parts[0]:-}" && -n "${sftp_parts[1]:-}" ]] \
    || die "SFTP target '$target' has an invalid repository."
  ssh_cmd=(ssh -F /dev/null -i "$sftp_key")
  ssh_cmd+=(-o IdentitiesOnly=yes)
  ssh_cmd+=(-o PreferredAuthentications=publickey)
  ssh_cmd+=(-o PasswordAuthentication=no)
  ssh_cmd+=(-o StrictHostKeyChecking=yes)
  if [[ -n "$sftp_known_hosts" ]]; then
    require_files "$sftp_known_hosts"
    ssh_cmd+=(-o UserKnownHostsFile="$sftp_known_hosts")
  fi
  if [[ -n "$sftp_port" ]]; then
    sftp_port_is_valid "$sftp_port" \
      || die "SFTP target '$target' has an invalid port; expected 1-65535."
    ssh_cmd+=(-p "$sftp_port")
  fi
  ssh_cmd+=("${sftp_parts[0]}@${sftp_parts[1]}" -s sftp)
  printf 'sftp.command=%s' "$(shell_join_quoted "${ssh_cmd[@]}")"
}

backup_env_line_is_valid() {
  local line="$1"
  [[ "$line" =~ ^[[:space:]]*$ ]] && return 0
  [[ "$line" =~ ^[[:space:]]*# ]] && return 0
  [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*= ]] && return 0
  return 1
}

validate_backup_env_file() {
  local path="$1"
  local line
  bash -n "$path" >/dev/null 2>&1 || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    backup_env_line_is_valid "$line" || return 1
  done < "$path"
}

source_backup_env_file() {
  local path="$1"
  validate_backup_env_file "$path" \
    || die "Invalid backup env file: $path. It must contain valid shell export/key=value lines."
  set +u
  # shellcheck disable=SC1090
  source "$path" \
    || die "Invalid backup env file: $path. It must contain valid shell export/key=value lines."
  set -u
}

backup_target_retention() {
  case "$1" in
    nas)   backup_target_value "$1" RETENTION "daily" ;;
    cloud) backup_target_value "$1" RETENTION "weekly" ;;
    *)     backup_target_value "$1" RETENTION "none" ;;
  esac
}

backup_target_include_paths() {
  local target="$1"
  local paths target_default
  paths="$(backup_target_value "$target" INCLUDE_PATHS)"
  # The cloud target defaults to immich-only so /srv/media is never swept off-site.
  case "$target" in
    cloud) target_default="$(immich_only_include_paths)" ;;
    *)     target_default="${BACKUP_INCLUDE_PATHS:-/srv/data}" ;;
  esac
  printf '%s' "${paths:-$target_default}"
}

repo_meta_file() {
  printf '%s' "$REPO_META_DIR/$1-repo.env"
}

get_repo_id() {
  local target="$1"
  restic_for_target "$target" cat config 2>/dev/null \
    | grep -oE '"id"[[:space:]]*:[[:space:]]*"[0-9a-f]+"' \
    | grep -oE '[0-9a-f]{8,}' | head -1
}

check_repo_identity() {
  local target="$1"
  local meta_file
  meta_file="$(repo_meta_file "$target")"
  [[ -f "$meta_file" ]] || return 0
  local saved_id current_id
  unset REPOSITORY_ID
  # shellcheck disable=SC1090
  source "$meta_file"
  saved_id="${REPOSITORY_ID:-}"
  [[ -n "$saved_id" ]] || return 0
  current_id="$(get_repo_id "$target")"
  [[ -n "$current_id" ]] || return 0
  if [[ "$current_id" != "$saved_id"* && "$saved_id" != "$current_id"* ]]; then
    die "ERROR: $target restic repository ID mismatch.
  Expected: $saved_id
  Current:  $current_id
  This usually means BACKUP_TARGET_$(uppercase_token "$target")_REPOSITORY or port changed.
  Run: sudo domum-media backup adopt-repo $target"
  fi
}

backup_target_legacy_env_file() {
  printf '%s/restic_%s_env' "$SECRETS_DIR" "$1"
}

backup_target_exists() {
  local target="$1"
  while IFS= read -r name; do
    [[ "$name" == "$target" ]] && return 0
  done < <(backup_target_names)
  return 1
}

default_restore_target() {
  if backup_target_exists nas && backup_target_enabled nas; then
    echo "nas"
    return 0
  fi
  while IFS= read -r name; do
    backup_target_enabled "$name" || continue
    echo "$name"
    return 0
  done < <(backup_target_names)
  die "No enabled backup targets found."
}

default_full_check_target() {
  if backup_target_exists cloud && backup_target_enabled cloud; then
    echo "cloud"
    return 0
  fi
  default_restore_target
}

# Quiesce Immich Postgres: take a btrfs snapshot of the postgres data dir,
# then run pg_dump from inside the postgres container into the staging
# location alongside the photo library.
quiesce_immich_postgres() {
  local pg_subvol="$DOMUM_DATA_ROOT/immich/postgres"
  local stage_dir="$DOMUM_DATA_ROOT/immich/backup-staging"
  mkdir -p "$stage_dir"

  if [[ ! -d "$pg_subvol" ]]; then
    log "Skipping Immich quiesce: $pg_subvol absent."
    return 0
  fi

  if command -v btrfs >/dev/null 2>&1 && btrfs subvolume show "$pg_subvol" >/dev/null 2>&1; then
    local snap
    snap="$DOMUM_SNAPSHOT_ROOT/immich-postgres-prebackup-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$DOMUM_SNAPSHOT_ROOT"
    log "btrfs snapshot: $pg_subvol -> $snap"
    btrfs subvolume snapshot -r "$pg_subvol" "$snap" >/dev/null
  fi

  local dump_file="$stage_dir/immich-postgres.dump.sql.gz"
  local dump_tmp
  local pg_user="${IMMICH_DB_USERNAME:-postgres}"
  local pg_db="${IMMICH_DB_DATABASE_NAME:-immich}"
  local pg_cid
  pg_cid="$(docker ps --filter "name=immich_postgres" --filter "status=running" -q 2>/dev/null | head -1)"
  if [[ -n "$pg_cid" ]]; then
    log "pg_dump immich -> $dump_file"
    dump_tmp="$(mktemp "$stage_dir/.immich-postgres.dump.sql.gz.XXXXXX.tmp")"
    if ! (
      local -a pipeline_status
      trap 'rm -f -- "$dump_tmp"' EXIT HUP INT TERM

      set +e
      docker exec -i "$pg_cid" pg_dump -U "$pg_user" -d "$pg_db" | gzip -9 > "$dump_tmp"
      pipeline_status=("${PIPESTATUS[@]}")
      set -e
      (( pipeline_status[0] == 0 && pipeline_status[1] == 0 )) || exit 1

      gzip -t "$dump_tmp" || exit 1
      (( $(stat -c %s "$dump_tmp") >= 1024 )) || exit 1
      gzip -cd "$dump_tmp" \
        | tail -n 20 \
        | grep -Fqx -- '-- PostgreSQL database dump complete' \
        || exit 1

      sync -f "$dump_tmp" || exit 1
      mv -fT "$dump_tmp" "$dump_file" || exit 1
      sync -f "$dump_file" || exit 1
    ); then
      log "ERROR: pg_dump validation failed; preserving the previous dump."
      return 1
    fi
    log "pg_dump complete"
  else
    log "Immich postgres container not running — skipping pg_dump."
    return 1
  fi
}

restic_with_env() {
  local pw_file="$1"
  local repository="$2"
  local env_file="${3:-}"
  local rclone_config="${4:-}"
  local restic_option="${5:-}"
  shift 5
  require_files "$pw_file"

  (
    if [[ -n "$env_file" && -f "$env_file" ]]; then
      source_backup_env_file "$env_file"
    fi
    export RESTIC_PASSWORD_FILE="$pw_file"
    export RESTIC_REPOSITORY="$repository"
    if [[ -n "$rclone_config" ]]; then
      export RCLONE_CONFIG="$rclone_config"
    fi
    local -a restic_cmd=(restic)
    if [[ -n "$restic_option" ]]; then
      restic_cmd+=(-o "$restic_option")
    fi
    restic_cmd+=("$@")
    "${restic_cmd[@]}"
  )
}

restic_for_target() {
  local target="$1"
  shift

  local target_type pw_file
  target_type="$(backup_target_value "$target" TYPE repository)"
  pw_file="$(backup_target_password_file "$target")"

  case "$target_type" in
    repository)
      local repository env_file extra_env_file sftp_command_opt
      repository="$(backup_target_value "$target" REPOSITORY)"
      env_file="$(backup_target_legacy_env_file "$target")"
      extra_env_file="$(backup_target_value "$target" ENV_FILE)"
      if [[ -n "$repository" ]]; then
        if [[ "$repository" == sftp:* ]]; then
          sftp_command_opt="$(sftp_command_option_for_target "$target")"
        fi
        local rc=0
        restic_with_env "$pw_file" "$repository" "$extra_env_file" "" "$sftp_command_opt" "$@" || rc=$?
        return "$rc"
      fi
      require_files "$env_file" "$pw_file"
      (
        source_backup_env_file "$env_file"
        export RESTIC_PASSWORD_FILE="$pw_file"
        local -a restic_cmd=(restic)
        if [[ "${RESTIC_REPOSITORY:-}" == sftp:* ]]; then
          sftp_command_opt="$(sftp_command_option_for_target "$target")"
          restic_cmd+=(-o "$sftp_command_opt")
        fi
        restic_cmd+=("$@")
        "${restic_cmd[@]}"
      )
      ;;
    nfs)
      local remote mount_point repository mounted_here=0 rc
      remote="$(backup_target_value "$target" NFS_REMOTE)"
      mount_point="$(backup_target_value "$target" NFS_MOUNT_POINT)"
      repository="$(backup_target_value "$target" REPOSITORY)"
      [[ -n "$remote" && -n "$mount_point" && -n "$repository" ]] || die "Incomplete NFS config for target '$target'"
      mkdir -p "$mount_point"
      if ! mountpoint -q "$mount_point"; then
        mount -t nfs "$remote" "$mount_point"
        mounted_here=1
      fi
      set +e
      restic_with_env "$pw_file" "$repository" "" "" "" "$@"
      rc=$?
      set -e
      if (( mounted_here )); then
        umount "$mount_point"
      fi
      return "$rc"
      ;;
    ftp)
      local host port remote_name path user_file pass_file tmp_cfg obscured_pass rc
      host="$(backup_target_value "$target" FTP_HOST)"
      port="$(backup_target_value "$target" FTP_PORT 21)"
      remote_name="$(backup_target_value "$target" FTP_REMOTE_NAME "$target")"
      path="$(backup_target_value "$target" FTP_PATH "/domum-media")"
      user_file="$(backup_target_value "$target" FTP_USERNAME_FILE "$SECRETS_DIR/${target}_ftp_username")"
      pass_file="$(backup_target_value "$target" FTP_PASSWORD_FILE "$SECRETS_DIR/${target}_ftp_password")"
      [[ -n "$host" ]] || die "Missing FTP host for target '$target'"
      require_files "$pw_file" "$user_file" "$pass_file"
      cmd_exists rclone || die "rclone is required for FTP backup targets."
      obscured_pass="$(rclone obscure "$(cat "$pass_file")")"
      tmp_cfg="$(mktemp)"
      cat > "$tmp_cfg" <<EOF
[${remote_name}]
type = ftp
host = ${host}
port = ${port}
user = $(cat "$user_file")
pass = ${obscured_pass}
EOF
      set +e
      restic_with_env "$pw_file" "rclone:${remote_name}:${path}" "" "$tmp_cfg" "" "$@"
      rc=$?
      set -e
      rm -f "$tmp_cfg"
      return "$rc"
      ;;
    *)
      die "Unknown backup target type '$target_type' for '$target'"
      ;;
  esac
}

enabled_backup_targets() {
  while IFS= read -r target; do
    backup_target_enabled "$target" || continue
    echo "$target"
  done < <(backup_target_names)
}

retention_targets() {
  local cadence="$1"
  while IFS= read -r target; do
    [[ "$(backup_target_retention "$target")" == "$cadence" ]] || continue
    echo "$target"
  done < <(enabled_backup_targets)
}

restic_backup_to() {
  local target="$1"
  local paths=() missing=()
  local path
  for path in $(backup_target_include_paths "$target"); do
    if [[ -e "$path" ]]; then
      paths+=("$path")
    else
      # A configured path that does not exist is skipped. Record it: a success
      # record that does not say what was actually backed up can overstate the
      # protection it claims.
      missing+=("$path")
      log "WARNING: configured include path does not exist, skipping: $path"
    fi
  done
  BACKUP_LAST_PATHS="${paths[*]}"
  BACKUP_LAST_PATHS_MISSING="${missing[*]}"
  if (( ${#paths[@]} == 0 )); then
    log "ERROR: no configured include path exists for target $target"
    return 1
  fi
  log "restic backup -> $target"
  # Stream output to the log as it happens -- a long backup must stay observable
  # in the journal while it runs -- while also capturing it to a private file so
  # the snapshot id can be recorded as evidence. `set -o pipefail` is in force,
  # but read PIPESTATUS explicitly so restic's status is used, not tee's.
  local runlog rc=0
  BACKUP_LAST_SNAPSHOT_ID=""
  runlog="$(mktemp)" || die "Cannot create a temporary file for the backup run"
  # A scheduled backup can be killed (systemd TimeoutStartSec is 18h). Clean the
  # capture file on the way out so a killed run leaves nothing in /tmp. No outer
  # trap is active here: the pg_dump trap lives inside its own subshell.
  # The signal traps must also terminate: a trap that only cleans up would let
  # the shell carry on running after the signal.
  # shellcheck disable=SC2064
  trap "rm -f -- '$runlog'" EXIT
  # shellcheck disable=SC2064
  trap "rm -f -- '$runlog'; exit 143" HUP INT TERM
  # Read from backup_exclude_patterns so the audit and the backup cannot
  # disagree about what is excluded.
  local -a excl=() ; local pat
  while IFS= read -r pat; do
    [[ -n "$pat" ]] && excl+=(--exclude "$pat")
  done < <(backup_exclude_patterns)
  restic_for_target "$target" backup \
    --tag "$(date +%Y-%m-%d)" \
    "${excl[@]}" \
    "${paths[@]}" 2>&1 | tee -a "$LOG_FILE" "$runlog" >&2
  rc="${PIPESTATUS[0]}"
  BACKUP_LAST_SNAPSHOT_ID="$(sed -n 's/.*snapshot \([0-9a-f]\{6,\}\) saved.*/\1/p' "$runlog" | tail -1)"
  rm -f -- "$runlog"
  trap - EXIT HUP INT TERM
  return "$rc"
}

# Durable per-target run evidence.
#
# The aggregate heartbeat says only that every enabled target succeeded; it
# cannot attribute a result to one target, and a new target would silently
# inherit its credibility. This records, per target, what actually happened.
# Written atomically so a crashed run cannot leave a half-written record.
record_backup_target_run() {
  local target="$1" result="$2" started="$3" snapshot_id="${4:-}"
  # Named distinctly from the `paths` array in restic_backup_to: reusing that
  # name here makes the two look like the same variable.
  local run_paths="${BACKUP_LAST_PATHS:-}" run_paths_missing="${BACKUP_LAST_PATHS_MISSING:-}"
  local dir meta file tmp repo_id=""
  dir="$REPO_META_DIR"
  mkdir -p "$dir"
  meta="$(repo_meta_file "$target")"
  if [[ -f "$meta" ]]; then
    # Read the already-pinned identity; never re-query the repository for it.
    repo_id="$(
      unset REPOSITORY_ID
      # shellcheck disable=SC1090
      . "$meta" >/dev/null 2>&1 || true
      printf '%s' "${REPOSITORY_ID:-}"
    )"
  fi
  file="$dir/${target}-run.env"
  tmp="$(mktemp "$dir/.${target}-run.env.XXXXXX")" || return 1
  {
    printf 'SCHEMA_VERSION=1\n'
    printf 'TARGET=%s\n' "$target"
    printf 'RESULT=%s\n' "$result"
    printf 'STARTED_TS=%s\n' "$started"
    printf 'FINISHED_TS=%s\n' "$(date -Iseconds)"
    printf 'SNAPSHOT_ID=%s\n' "$snapshot_id"
    printf 'REPOSITORY_ID=%s\n' "$repo_id"
    printf 'PATHS=%q\n' "$run_paths"
    printf 'PATHS_MISSING=%q\n' "$run_paths_missing"
  } > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 0600 "$tmp"
  mv -f "$tmp" "$file"
}

restic_forget_for() {
  local target="$1"
  log "restic forget --prune on $target"
  restic_for_target "$target" forget --prune \
    --keep-daily   "$RESTIC_KEEP_DAILY" \
    --keep-weekly  "$RESTIC_KEEP_WEEKLY" \
    --keep-monthly "$RESTIC_KEEP_MONTHLY" \
    --keep-yearly  "$RESTIC_KEEP_YEARLY"
}

restic_check_for() {
  local target="$1"
  shift
  log "restic check on $target $*"
  restic_for_target "$target" check "$@"
}

list_latest_snapshots() {
  local any=0
  while IFS= read -r target; do
    any=1
    echo "-- $target --"
    local out rc=0
    out="$(restic_for_target "$target" snapshots --latest 1 2>&1)" || rc=$?
    if (( rc == 0 )); then
      printf '%s\n' "$out"
    elif printf '%s' "$out" | grep -qiE 'repository does not exist|unable to open config|config file does not exist'; then
      echo "($target: repository not initialized — run: sudo domum-media backup init $target)"
    else
      echo "(failed to query snapshots for $target)"
      printf '%s\n' "$out"
    fi
  done < <(enabled_backup_targets)
  (( any == 1 )) || echo "(no enabled backup targets)"
}

latest_snapshot_json() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: domum-media-backup --latest-snapshot-json <target>"
  backup_target_enabled "$target" || die "Backup target is not enabled: $target"
  restic_for_target "$target" snapshots --latest 1 --json \
    | jq -c 'if length == 0 then {id:null,time:null,hostname:null,tags:[]} else .[-1] | {id:(.short_id // (.id[0:8])),time,hostname,tags:(.tags // [])} end'
}

heartbeat() {
  date -Iseconds > "$HEARTBEAT_FILE"
  if [[ -n "${BACKUP_HEARTBEAT_URL:-}" ]]; then
    curl -fsS --max-time 10 -o /dev/null "$BACKUP_HEARTBEAT_URL" || true
  fi
}

do_daily_backup() {
  local ran_any=0
  # Unlike the interactive operations, the backup WAITS. It is unattended and
  # will not be retried by anyone: giving up because a migration was running
  # would silently skip a night's backup, which is the outcome the lock exists
  # to prevent. Thirty minutes is longer than any migration should take and far
  # shorter than the gap to the next scheduled run.
  if ! domum_acquire_lock "daily backup" "${BACKUP_LOCK_WAIT_SECONDS:-1800}"; then
    die "Timed out waiting for another domum-media operation to finish: $(domum_lock_holder)
No backup was taken. The last-success marker has deliberately NOT been refreshed."
  fi
  log "=== daily backup start ==="
  local pg_dump_ok=1
  quiesce_immich_postgres || pg_dump_ok=0
  if (( pg_dump_ok == 0 )) && [[ "${ENABLE_IMMICH:-0}" == "1" ]]; then
    case "${BACKUP_POLICY:-BALANCED}" in
      STRICT)   die "Immich is enabled but pg_dump failed/skipped. Aborting in STRICT mode." ;;
      BALANCED) log "WARNING: Immich pg_dump failed/skipped. Continuing in BALANCED mode." ;;
      LENIENT)  log "INFO: Immich pg_dump failed/skipped. Continuing in LENIENT mode." ;;
    esac
  fi

  local target_started
  while IFS= read -r target; do
    ran_any=1
    target_started="$(date -Iseconds)"
    BACKUP_LAST_PATHS=""
    BACKUP_LAST_PATHS_MISSING=""
    BACKUP_LAST_SNAPSHOT_ID=""
    # Mark the attempt before anything can abort. check_repo_identity calls die
    # on a mismatch, and a killed run exits from a trap, so without this the
    # previous run's RESULT=success would linger and the report would show a
    # stale "ok" for a target whose backup never actually completed.
    record_backup_target_run "$target" running "$target_started" "" \
      || log "WARNING: could not record run evidence for $target"
    if check_repo_identity "$target" && restic_backup_to "$target"; then
      record_backup_target_run "$target" success "$target_started" "${BACKUP_LAST_SNAPSHOT_ID:-}" \
        || log "WARNING: could not record run evidence for $target"
    else
      record_backup_target_run "$target" failure "$target_started" "" \
        || log "WARNING: could not record run evidence for $target"
      die "Backup failed for target: $target"
    fi
  done < <(enabled_backup_targets)

  while IFS= read -r target; do
    restic_forget_for "$target"
  done < <(retention_targets daily)

  (( ran_any == 1 )) || die "No enabled backup targets configured."

  heartbeat
  if [[ "${RECOVERY_PACK_ENABLED:-1}" == "1" ]] && command -v /usr/local/bin/domum-media >/dev/null 2>&1; then
    log "refresh recovery-pack"
    /usr/local/bin/domum-media recovery-pack create --no-email || log "recovery-pack refresh failed"
  fi
  log "=== daily backup ok ==="
}

do_weekly_retention() {
  local ran_any=0
  while IFS= read -r target; do
    ran_any=1
    restic_forget_for "$target"
  done < <(retention_targets weekly)
  (( ran_any == 1 )) || log "No weekly-retention targets configured."
}

do_check() {
  while IFS= read -r target; do
    check_repo_identity "$target"
    restic_check_for "$target"
  done < <(enabled_backup_targets)
}

do_check_deep() {
  local target="${1:-$(default_restore_target)}"
  check_repo_identity "$target"
  restic_check_for "$target" --read-data-subset="$BACKUP_DEEP_CHECK_PERCENT"
}

do_check_full() {
  local target="${1:-$(default_full_check_target)}"
  check_repo_identity "$target"
  restic_check_for "$target" --read-data
}

do_restore() {
  local snap="${1:-}"
  local target_dir="${2:-}"
  local repo
  repo="$(default_restore_target)"
  shift 2 || true
  while (( $# )); do
    case "$1" in
      --repo)
        repo="$2"
        shift 2
        ;;
      *)
        die "Unknown restore arg: $1"
        ;;
    esac
  done
  [[ -n "$snap" && -n "$target_dir" ]] || die "Usage: --restore <snapshot> <target> [--repo target-name]"
  log "restic restore $snap -> $target_dir (from $repo)"
  mkdir -p "$target_dir"
  restic_for_target "$repo" restore "$snap" --target "$target_dir"
}

# ---- restore verification --------------------------------------------------
#
# A successful backup is NOT a successful restore, and a repository check is NOT
# a restore either. This restores the validated Immich dump from a target into
# an ISOLATED scratch directory, revalidates the restored bytes with the same
# three checks the dump itself had to pass when it was written, records the
# outcome, and removes the scratch.
#
# It never restores into a live path, and never writes to the repository.

# ---- operation locking ------------------------------------------------------
# BEGIN SHARED LOCK HELPER
# Kept byte-identical between bin/domum-media and bin/domum-media-backup, and
# tests/operation-lock-smoke.sh fails if they drift. Duplicated rather than
# sourced from a new file on purpose: a shared library is one more artefact a
# partial deployment can leave missing, and the failure mode there is a CLI that
# will not start at all. Two scripts that already exist, pinned by a test, is
# the smaller risk.
#
# Why this exists: the nightly backup fires at 02:30 (+15m jitter) and reads all
# of /srv/data with no exclude for .new / .premigration / .rollback-*. A
# migration overlapping it has restic walking a tree that is being renamed
# underneath it -- it captures a half-copied .new, hits vanished paths, exits
# non-zero, and the last-success marker is not refreshed. Fail-safe, but the
# operator is left with a failed backup and no obvious cause.
#
# The lock lives in an open file descriptor, so the kernel releases it when the
# process exits for ANY reason, SIGKILL included. There is no stale lock file to
# detect or clean up, which is the usual way lock schemes become the outage.
domum_lock_file() {
  printf '%s/operation.lock' "${DOMUM_STATE_ROOT:-/var/lib/domum-media}"
}

# $1 = label recorded for diagnostics, $2 = seconds to wait (0 = fail at once)
domum_acquire_lock() {
  local label="$1" wait_seconds="${2:-0}" lock_file
  [[ -n "${DOMUM_LOCK_FD:-}" ]] && return 0
  lock_file="$(domum_lock_file)"
  mkdir -p "$(dirname "$lock_file")" || return 1
  exec {DOMUM_LOCK_FD}>>"$lock_file" || return 1
  if (( wait_seconds > 0 )); then
    flock -w "$wait_seconds" "$DOMUM_LOCK_FD" || return 1
  else
    flock -n "$DOMUM_LOCK_FD" || return 1
  fi
  # Diagnostic only -- never consulted to decide whether the lock is held. That
  # decision belongs to flock alone; a file that says who owns it is for the
  # operator reading a refusal, and may be stale or absent without consequence.
  printf '%s %s %s\n' "$$" "$(date -Iseconds)" "$label" > "${lock_file}.holder" 2>/dev/null || true
  return 0
}

domum_lock_holder() {
  local h
  h="$(cat "$(domum_lock_file).holder" 2>/dev/null || true)"
  printf '%s' "${h:-unknown}"
}
# END SHARED LOCK HELPER

restore_verification_dir() {
  printf '%s' "${DOMUM_STATE_ROOT:-/var/lib/domum-media}/restore-verification"
}

record_restore_verification() {
  local target="$1" result="$2" snapshot_id="$3" artifact="$4" bytes="$5" checks="$6" reason="${7:-}"
  local dir file tmp now
  dir="$(restore_verification_dir)"
  mkdir -p "$dir"
  file="$dir/${target}.env"
  now="$(date -Iseconds)"

  # A failed or interrupted verification must never erase the record of when
  # verification last genuinely passed. Carry that forward.
  local prev_ok_ts="" prev_ok_snap=""
  if [[ -f "$file" ]]; then
    eval "$(
      unset RESULT VERIFIED_TS SNAPSHOT_ID LAST_SUCCESS_TS LAST_SUCCESS_SNAPSHOT_ID
      # shellcheck disable=SC1090
      . "$file" >/dev/null 2>&1 || true
      if [[ "${RESULT:-}" == "success" ]]; then
        printf 'prev_ok_ts=%q\nprev_ok_snap=%q\n' "${VERIFIED_TS:-}" "${SNAPSHOT_ID:-}"
      else
        printf 'prev_ok_ts=%q\nprev_ok_snap=%q\n' "${LAST_SUCCESS_TS:-}" "${LAST_SUCCESS_SNAPSHOT_ID:-}"
      fi
    )"
  fi
  local last_ok_ts last_ok_snap
  if [[ "$result" == "success" ]]; then
    last_ok_ts="$now"; last_ok_snap="$snapshot_id"
  else
    last_ok_ts="$prev_ok_ts"; last_ok_snap="$prev_ok_snap"
  fi

  tmp="$(mktemp "$dir/.${target}.env.XXXXXX")" || return 1
  {
    printf 'SCHEMA_VERSION=2\n'
    printf 'TARGET=%s\n' "$target"
    printf 'RESULT=%s\n' "$result"
    printf 'VERIFIED_TS=%s\n' "$now"
    printf 'LAST_SUCCESS_TS=%s\n' "$last_ok_ts"
    printf 'LAST_SUCCESS_SNAPSHOT_ID=%s\n' "$last_ok_snap"
    printf 'SNAPSHOT_ID=%s\n' "$snapshot_id"
    printf 'ARTIFACT=%s\n' "$artifact"
    printf 'BYTES=%s\n' "$bytes"
    printf 'CHECKS=%s\n' "$checks"
    printf 'REASON=%s\n' "$reason"
  } > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 0600 "$tmp"
  mv -f "$tmp" "$file"
}

do_verify_restore() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: domum-media-backup verify-restore <target>"
  backup_target_enabled "$target" || die "Backup target is not enabled: $target"
  cmd_exists gzip || die "gzip is required for restore verification"

  local vdir scratch artifact bytes=0 snapshot_id="" checks="" reason=""
  vdir="$(restore_verification_dir)"
  mkdir -p "$vdir"

  # The scratch directory must be nowhere near live data.
  case "$vdir" in
    "${DOMUM_DATA_ROOT%/}"/*|"${DOMUM_MEDIA_ROOT%/}"/*|"${DOMUM_DATA_ROOT%/}"|"${DOMUM_MEDIA_ROOT%/}")
      die "Refusing to verify: the scratch location $vdir is inside a live data root." ;;
  esac
  scratch="$(mktemp -d "$vdir/scratch.XXXXXX")" || die "Cannot create a scratch directory"
  # Always clean up, including on interruption. The signal traps must also
  # TERMINATE: a cleanup-only trap deletes the scratch and then lets execution
  # continue into validation, which would find the artefact missing and record a
  # genuine-looking failure for a run that was merely interrupted.
  # shellcheck disable=SC2064
  trap "rm -rf -- '$scratch'" EXIT
  # shellcheck disable=SC2064
  trap "rm -rf -- '$scratch'; exit 143" HUP INT TERM

  local rel="$DOMUM_DATA_ROOT/immich/backup-staging/immich-postgres.dump.sql.gz"
  log "restore verification: $target -> $scratch (isolated; no live path is touched)"

  snapshot_id="$(restic_for_target "$target" snapshots --latest 1 --json 2>/dev/null \
    | jq -r 'if length == 0 then "" else (.[-1].short_id // .[-1].id[0:8]) end' 2>/dev/null || true)"

  if ! restic_for_target "$target" restore latest --target "$scratch" --include "$rel" >/dev/null 2>&1; then
    reason="restic restore of $rel failed"
    record_restore_verification "$target" failure "$snapshot_id" "$rel" 0 "" "$reason" || true
    die "Restore verification FAILED for $target: $reason"
  fi

  artifact="$scratch$rel"
  if [[ ! -f "$artifact" ]]; then
    reason="the snapshot did not contain $rel"
    record_restore_verification "$target" failure "$snapshot_id" "$rel" 0 "" "$reason" || true
    die "Restore verification FAILED for $target: $reason"
  fi

  # The same three checks the dump had to pass when it was written.
  if ! gzip -t "$artifact" 2>/dev/null; then
    reason="restored artifact failed gzip integrity"
    record_restore_verification "$target" failure "$snapshot_id" "$rel" 0 "gzip" "$reason" || true
    die "Restore verification FAILED for $target: $reason"
  fi
  checks="gzip"

  bytes="$(stat -c %s "$artifact" 2>/dev/null || echo 0)"
  if (( bytes < 1024 )); then
    reason="restored artifact is implausibly small (${bytes} bytes)"
    record_restore_verification "$target" failure "$snapshot_id" "$rel" "$bytes" "$checks" "$reason" || true
    die "Restore verification FAILED for $target: $reason"
  fi
  checks="$checks,size"

  if ! gzip -dc "$artifact" 2>/dev/null | tail -5 \
       | grep -Fqx -- '-- PostgreSQL database dump complete'; then
    reason="restored dump is missing the PostgreSQL completion footer"
    record_restore_verification "$target" failure "$snapshot_id" "$rel" "$bytes" "$checks" "$reason" || true
    die "Restore verification FAILED for $target: $reason"
  fi
  checks="$checks,footer"

  record_restore_verification "$target" success "$snapshot_id" "$rel" "$bytes" "$checks" "" \
    || log "WARNING: verification passed but the result could not be recorded"
  log "restore verification OK for $target (snapshot ${snapshot_id:-unknown}, ${bytes} bytes, checks: $checks)"
  echo "[domum-media-backup] Restore verification PASSED for $target."
  echo "  snapshot: ${snapshot_id:-unknown}"
  echo "  artifact: $rel (${bytes} bytes)"
  echo "  checks:   $checks"
  echo "  scratch removed; no live path was touched."
}

# ---- representative asset restore verification ------------------------------
#
# The dump verification proves the Immich DATABASE restores. It says nothing
# about the 213GB of photos and videos. Restoring all of them to find out is
# wasteful, so this restores a deterministic, deliberately DIVERSE sample and
# compares it byte-for-byte against the live originals.
#
# What it proves: the repository is readable, the snapshot indexes those paths,
# and the stored data decrypts and decompresses to bytes identical to source.
# What it does NOT prove: that every file is intact -- sampling cannot -- nor
# that the library restores at full scale, nor that a rebuilt Immich can serve
# the result. Those need a full restore and an import.
#
# Recorded separately from the dump verification: they are different claims and
# must never be conflated.

# ---------------------------------------------------------------------------
# The ORIGINAL inventory: the asset table, not a filesystem walk
# ---------------------------------------------------------------------------

# Every Immich original, as "<size>\t<host path>", written to $1.
#
# A filesystem walk of upload/ was the wrong source and got BOTH ends of the
# coverage fraction wrong at once. Measured on this host:
#
#   asset table                         : 23,033 originals
#   files under upload/                 : 22,976  (22,975 originals + 1 marker)
#   originals under encoded-video/      :     58  (motion-photo parts)
#
# So the walk counted a 13-byte `.immich` marker as an original and MISSED 58
# real ones -- and because selection picked the median-sized file of each
# extension, the marker became the representative of extension "immich" and was
# reported as a restored original: `match immich 13 .immich`.
#
# Prints "<originals> <missing_on_disk>" on stdout; returns non-zero when the
# database cannot be read, so the caller says UNKNOWN rather than falling back
# to a walk that is known to be wrong.
immich_original_inventory() {  # $1 = output file
  local out="${1:?immich_original_inventory: no output file}"
  local paths want got
  paths="$(immich_db_original_paths)" || return 1
  [[ -n "$paths" ]] || return 1
  want="$(printf '%s\n' "$paths" | grep -c . || true)"
  # NUL-delimited: a path may legitimately contain spaces, and this is the
  # inventory everything else is derived from.
  printf '%s\n' "$paths" | sed '/^$/d' | tr '\n' '\0' \
    | xargs -0 -r stat -c '%s	%n' 2>/dev/null > "$out" || true
  got="$(grep -c . < "$out" || true)"
  printf '%s %s\n' "$want" "$(( want - got ))"
}

# Is this a usable inventory file?
#
# An EMPTY argument is the dangerous case. `awk 'prog' ""` does not fail -- it
# reads STDIN. Measured: with stdin a pipe that never closes, awk waits
# forever, so a caller that lost its filename turned a measurement into a hang
# that appears only when stdin happens to stay open. The whole test suite hung
# for 900 s on exactly that, while standalone with `< /dev/null` it passed in
# two seconds -- the worst possible failure signature.
#
# Every inventory reader goes through this first, so a lost filename fails
# immediately and visibly instead of blocking.
inventory_usable() {  # $1 = path
  [[ -n "${1:-}" ]] || { warn "inventory: no file given"; return 1; }
  [[ -f "$1" ]] || { warn "inventory: not a file: $1"; return 1; }
  return 0
}

# An inventory built by WALKING a directory.
#
# This is not the production source of truth and must not become one: walking
# upload/ is precisely what counted a marker as an original and missed the 58
# under encoded-video/. It exists so the selection algorithm can be tested as a
# pure function of an inventory, without a database.
inventory_from_dir() {  # $1 = directory, $2 = output file
  find "$1" -type f -printf '%s\t%p\n' 2>/dev/null | sort -t"$(printf '\t')" -k2,2 > "$2"
}

# The originals an exclusion of glob metacharacters would make unsamplable.
# restic --include takes a PATTERN, so such a name would select the wrong
# objects or none, and "none" would then be reported as a mismatch against a
# file that is perfectly fine.
inventory_unsamplable() {  # $1 = inventory file
  inventory_usable "${1:-}" || { printf '0\n'; return 1; }
  grep -cE '/[^/]*(\*|\?|\[|\]|\\)[^/]*$' "$1" 2>/dev/null || true
}

# Where the originals actually live, so the report can state it rather than
# implying every original sits under upload/.
# Prints "<count> <subtree>" lines, most populous first.
inventory_by_location() {  # $1 = inventory file, $2 = library root
  inventory_usable "${1:-}" || return 1
  awk -F'\t' -v lib="$2" '
      {
        p = $2
        sub("^" lib "/", "", p)
        sub("/.*", "", p)
        if (p == "") p = "(library root)"
        c[p]++
      }
      END { for (k in c) printf "%d %s\n", c[k], k }' "$1" | sort -rn
}

SAMPLE_MAX_FILE_BYTES="${SAMPLE_MAX_FILE_BYTES:-268435456}"   # 256 MiB
SAMPLE_MAX_TOTAL_BYTES="${SAMPLE_MAX_TOTAL_BYTES:-1073741824}" # 1 GiB
SAMPLE_DEFAULT_COUNT="${SAMPLE_DEFAULT_COUNT:-12}"

sample_coverage_file() {
  printf '%s/%s-coverage.json' "$(restore_verification_dir)" "$1"
}

sample_manifest_file() {
  printf '%s/%s-sample.jsonl' "$(restore_verification_dir)" "$1"
}

# restic's --include takes a GLOB PATTERN, not a literal path, so a filename
# containing * ? [ ] or a backslash would silently select the wrong objects --
# or none, which would then be reported as a mismatch against a file that is
# actually fine. Such paths are excluded from sampling and counted, so the
# blind spot is visible rather than silent.
# What the sample CANNOT cover, in numbers.
#
# sample_unsamplable_count below counts only names containing glob
# metacharacters. The per-file cap excludes files too, and nothing said so:
# measured on this host, SAMPLE_MAX_FILE_BYTES=256 MiB leaves 17 of 22,976
# originals outside the sample -- 7.9 GiB, and they are the largest videos,
# precisely the files a sample of small photos is least representative of.
#
# "12 sampled, 12 matched" with no statement of the population is a coverage
# claim that cannot be falsified. One `find` pass, so it stays cheap over
# 23k files.
#
# Prints: <total_files> <total_bytes> <oversize_files> <oversize_bytes>
sample_coverage_stats() {  # $1 = inventory file
  inventory_usable "${1:-}" || { printf '0 0 0 0\n'; return 1; }
  awk -F'\t' -v cap="$SAMPLE_MAX_FILE_BYTES" '
      { n++; b += $1; if ($1 > cap) { on++; ob += $1 } }
      END { printf "%d %d %d %d\n", n+0, b+0, on+0, ob+0 }' "$1"
}

# Human bytes, for the coverage lines only. Nothing parses these.
sample_human_bytes() {  # $1 = bytes
  awk -v b="${1:-0}" 'BEGIN{
    split("B KiB MiB GiB TiB", u, " "); i=1
    while (b >= 1024 && i < 5) { b /= 1024; i++ }
    printf (i == 1 ? "%d %s" : "%.1f %s"), b, u[i]
  }'
}

# One place that renders the coverage block, so the plan and the verification
# cannot describe the population differently.
sample_report_coverage() {  # $1 = inventory file, $2 = library root, $3 = missing-on-disk
  local inv="$1" lib="$2" absent="${3:-0}"
  local stats tf tb of ob glob
  if ! inventory_usable "$inv"; then
    echo "  originals    : UNKNOWN -- the inventory could not be read, so no"
    echo "                 population can be stated for this proof"
    return 1
  fi
  stats="$(sample_coverage_stats "$inv")"
  read -r tf tb of ob <<< "$stats"
  echo "  originals    : ${tf} asset(s), $(sample_human_bytes "$tb") -- from the Immich asset table"
  while read -r cnt sub; do
    [[ -n "$cnt" ]] || continue
    printf '                 %6d under %s/\n' "$cnt" "$sub"
  done < <(inventory_by_location "$inv" "$lib")
  if [[ "$absent" =~ ^[0-9]+$ ]] && (( absent > 0 )); then
    echo "  MISSING      : ${absent} original(s) the asset table names are NOT on disk"
    echo "                 These cannot be sampled and are not backed up either."
  fi
  if [[ "$of" =~ ^[0-9]+$ ]] && (( of > 0 )); then
    echo "  NEVER sampled: ${of} file(s), $(sample_human_bytes "$ob") exceed the per-file"
    echo "                 cap of $(sample_human_bytes "$SAMPLE_MAX_FILE_BYTES"). These are the"
    echo "                 largest originals -- see verify-large for a progressive proof."
  else
    echo "  NEVER sampled: none by size -- every original is within the per-file cap"
  fi
  glob="$(inventory_unsamplable "$inv")"
  if [[ "$glob" =~ ^[0-9]+$ ]] && (( glob > 0 )); then
    echo "  also excluded: ${glob} file(s) whose names contain glob metacharacters"
    echo "                 (restic --include is a pattern, so these cannot be sampled safely)"
  fi
}

sample_unsamplable_count() {
  find "$1" -type f \( -name '*[*?]*' -o -name '*[][]*' -o -name '*\\*' \) \
    -printf '.\n' 2>/dev/null | wc -l
}

# Paths already proven by an ordinary sample run, one per line.
#
# Selection is deterministic by design -- the same library always yields the
# same picks, which is what makes a run reproducible. Measured consequence:
# the 2026-10-09 and 2026-10-11 production runs sampled the SAME 12 files, so
# coverage of the main library was permanently capped at 12 of 23,033 however
# often the command ran. verify-large already solved this for the over-cap
# files; ordinary originals get the same treatment.
sample_verified_paths() {  # $1 = target
  local f; f="$(sample_history_file "$1")"
  [[ -f "$f" ]] || return 0
  jq -r 'select(.result == "match") | .path' "$f" 2>/dev/null | sort -u || true
}

sample_history_file() {
  printf '%s/%s-sample-verified.jsonl' "$(restore_verification_dir)" "$1"
}

sample_verified_count() {  # $1 = target
  local n
  n="$(sample_verified_paths "$1" 2>/dev/null | grep -c . || true)"
  printf '%s' "${n:-0}"
}

# Deterministic and diverse: the median-sized file of each distinct extension,
# then the smallest and largest that fit under the per-file cap, then every
# k-th path to fill the quota. Sorted throughout so repeated runs agree.
sample_select_paths() {  # $1 = inventory file, $2 = how many, [$3 = proven list]
  local inv="$1" want="$2" done_file="${3:-/dev/null}"
  inventory_usable "$inv" || return 1
  grep -vE '/[^/]*(\*|\?|\[|\]|\\)[^/]*$' "$inv" \
    | awk -F'\t' -v dfile="$done_file" '
        BEGIN { while ((getline line < dfile) > 0) proven[line]=1 }
        !($2 in proven)' \
    | awk -F'\t' -v cap="$SAMPLE_MAX_FILE_BYTES" '$1 > 0 && $1 <= cap' \
    | sort -t"$(printf '\t')" -k2,2 \
    | awk -F'\t' -v want="$want" '
        {
          size[NR]=$1; path[NR]=$2
          base=$2; sub(/.*\//, "", base)
          if (base ~ /\./) { ext=tolower(base); sub(/.*\./, "", ext) } else { ext="none" }
          n[ext]++; byext[ext, n[ext]]=NR
        }
        END {
          picked=0
          # one representative per extension: the median-sized entry, stable
          m=0
          for (e in n) { exts[++m]=e }
          for (i=1; i<=m; i++)
            for (j=i+1; j<=m; j++)
              if (exts[j] < exts[i]) { t=exts[i]; exts[i]=exts[j]; exts[j]=t }
          for (i=1; i<=m && picked<want; i++) {
            e=exts[i]; idx=byext[e, int((n[e]+1)/2)]
            if (!(idx in chosen)) { chosen[idx]=1; picked++ }
          }
          # smallest and largest under the cap
          smin=0; smax=0
          for (r=1; r<=NR; r++) {
            if (smin==0 || size[r] < size[smin]) smin=r
            if (smax==0 || size[r] > size[smax]) smax=r
          }
          if (smin && !(smin in chosen) && picked<want) { chosen[smin]=1; picked++ }
          if (smax && !(smax in chosen) && picked<want) { chosen[smax]=1; picked++ }
          # fill the rest by even stride so the sample spreads across the tree,
          # then sweep sequentially so a strided pass that lands only on
          # already-chosen rows can never return short of the quota.
          if (picked < want) {
            step = int(NR / (want - picked)); if (step < 1) step = 1
            for (r=1; r<=NR && picked<want; r+=step)
              if (!(r in chosen)) { chosen[r]=1; picked++ }
            for (r=1; r<=NR && picked<want; r++)
              if (!(r in chosen)) { chosen[r]=1; picked++ }
          }
          for (r=1; r<=NR; r++) if (r in chosen) printf "%s\t%s\n", size[r], path[r]
        }'
}

# What WOULD be sampled, without restoring anything.
#
# `verify-sample` needs root and a live repository, so until it runs there is no
# way to see what it would pick. This shows exactly that -- read-only, against
# the real library -- so the selection can be inspected, its determinism checked,
# and its cost known before anyone spends a restore on it.
#
# It deliberately does NOT contact the repository or record anything: a plan is
# not evidence, and must never be mistaken for a verification.
do_sample_plan() {
  local want="${1:-$SAMPLE_DEFAULT_COUNT}"
  [[ "$want" =~ ^[0-9]+$ ]] && (( want > 0 )) || die "Sample count must be a positive integer"
  # The plan must reflect what would ACTUALLY be picked, which depends on what
  # a target has already proven. Without a target named it uses the first
  # enabled one; with none enabled it plans against an empty history and says
  # so, rather than silently showing a selection no run would make.
  local target_for_plan="${2:-}" t
  if [[ -z "$target_for_plan" ]]; then
    while read -r t; do
      backup_target_enabled "$t" 2>/dev/null && { target_for_plan="$t"; break; }
    done < <(backup_target_names)
  fi

  local lib inv counts n_orig n_missing
  lib="${IMMICH_LIBRARY_DIR:-$DOMUM_DATA_ROOT/immich/library}"
  [[ -d "$lib" ]] || die "Immich library not found at $lib"
  inv="$(mktemp)" || die "Cannot stage the originals inventory"
  # shellcheck disable=SC2064
  trap "rm -f -- '$inv'" EXIT
  # shellcheck disable=SC2064
  trap "rm -f -- '$inv'; exit 143" HUP INT TERM
  counts="$(immich_original_inventory "$inv")" \
    || die "Refusing: the Immich asset table could not be read, and it is the only
authority for which files are originals. Walking upload/ instead counted a
13-byte .immich marker as an original and missed the 58 originals that live
under encoded-video/, so the fallback is not safe to use."
  read -r n_orig n_missing <<< "$counts"

  local plan_done
  plan_done="$(mktemp)" || die "Cannot stage the sample history"
  # shellcheck disable=SC2064
  trap "rm -f -- '$inv' '$plan_done'" EXIT
  # shellcheck disable=SC2064
  trap "rm -f -- '$inv' '$plan_done'; exit 143" HUP INT TERM
  if [[ -n "$target_for_plan" ]]; then
    sample_verified_paths "$target_for_plan" > "$plan_done" 2>/dev/null || : > "$plan_done"
  else
    : > "$plan_done"
  fi

  local total=0 n=0 size path ext
  echo "[domum-media-backup] Sample plan over $n_orig original(s) in $lib"
  if [[ -n "$target_for_plan" ]]; then
    echo "  already proven: $(grep -c . < "$plan_done" || true) for target $target_for_plan"
  else
    echo "  already proven: UNKNOWN -- no enabled target, so no history was read"
  fi
  echo
  printf '  %-10s %14s  %s\n' "TYPE" "BYTES" "PATH"
  while IFS=$'\t' read -r size path; do
    [[ -n "$path" ]] || continue
    (( total + size > SAMPLE_MAX_TOTAL_BYTES )) && continue
    ext="${path##*/}"
    if [[ "$ext" == *.* ]]; then ext="${ext##*.}"; ext="${ext,,}"; else ext="none"; fi
    printf '  %-10s %14s  %s\n' "$ext" "$size" "${path#"$lib"/}"
    total=$(( total + size )); n=$(( n + 1 ))
  done < <(sample_select_paths "$inv" "$want" "$plan_done")

  if (( n == 0 )); then
    echo "  nothing left to sample: every original within the size caps has been"
    echo "  proven. Use --revalidate on verify-sample to prove them again."
    return 0
  fi

  echo
  echo "  files        : $n"
  echo "  total bytes  : $total"
  echo "  per-file cap : $SAMPLE_MAX_FILE_BYTES"
  echo "  total cap    : $SAMPLE_MAX_TOTAL_BYTES"
  sample_report_coverage "$inv" "$lib" "$n_missing"
  echo
  echo "  This is a PLAN. Nothing was restored, nothing was contacted, and no"
  echo "  evidence was recorded. Run verify-sample <target> to actually verify."
}

do_verify_sample() {
  local target="${1:-}" want="" reval=0 a
  shift || true
  for a in "$@"; do
    case "$a" in
      --revalidate) reval=1 ;;
      ''|*[!0-9]*)  [[ -n "$a" ]] && die "Unknown argument: $a" ;;
      *)            want="$a" ;;
    esac
  done
  want="${want:-$SAMPLE_DEFAULT_COUNT}"
  [[ -n "$target" ]] || die "Usage: domum-media-backup verify-sample <target> [count] [--revalidate]"
  backup_target_enabled "$target" || die "Backup target is not enabled: $target"
  [[ "$want" =~ ^[0-9]+$ ]] && (( want > 0 )) || die "Sample count must be a positive integer"

  local lib
  lib="${IMMICH_LIBRARY_DIR:-$DOMUM_DATA_ROOT/immich/library}"
  [[ -d "$lib" ]] || die "Immich library not found at $lib"

  local vdir scratch manifest snapshot_id total=0
  local inv counts n_orig n_missing
  vdir="$(restore_verification_dir)"
  mkdir -p "$vdir"
  case "$vdir" in
    "${DOMUM_DATA_ROOT%/}"/*|"${DOMUM_MEDIA_ROOT%/}"/*|"${DOMUM_DATA_ROOT%/}"|"${DOMUM_MEDIA_ROOT%/}")
      die "Refusing: the scratch location $vdir is inside a live data root." ;;
  esac
  scratch="$(mktemp -d "$vdir/sample.XXXXXX")" || die "Cannot create a scratch directory"
  # The inventory must live OUTSIDE $scratch: $scratch is the restore TARGET,
  # so anything written there becomes indistinguishable from restored content.
  # It was briefly inside, and the corruption test caught it -- the stub that
  # damages "the first restored file" damaged the inventory instead.
  inv="$(mktemp "$vdir/.originals.XXXXXX")" || die "Cannot stage the originals inventory"
  # shellcheck disable=SC2064
  trap "rm -rf -- '$scratch'; rm -f -- '$inv'" EXIT
  # shellcheck disable=SC2064
  trap "rm -rf -- '$scratch'; rm -f -- '$inv'; exit 143" HUP INT TERM

  snapshot_id="$(restic_for_target "$target" snapshots --latest 1 --json 2>/dev/null \
    | jq -r 'if length == 0 then "" else (.[-1].short_id // .[-1].id[0:8]) end' 2>/dev/null || true)"
  [[ -n "$snapshot_id" ]] || die "Could not determine the latest snapshot for $target"

  counts="$(immich_original_inventory "$inv")" \
    || die "Refusing: the Immich asset table could not be read, and it is the only
authority for which files are originals. A filesystem walk is not an acceptable
substitute -- it counted a 13-byte .immich marker as a restored original and
missed the 58 originals under encoded-video/."
  read -r n_orig n_missing <<< "$counts"

  # Already-proven originals are skipped so repeated runs BROADEN coverage
  # rather than re-proving the same deterministic twelve. --revalidate is the
  # only way to prove them again.
  local done_file already
  done_file="$(mktemp "$vdir/.sample-done.XXXXXX")" || die "Cannot stage the sample history"
  # shellcheck disable=SC2064
  trap "rm -rf -- '$scratch'; rm -f -- '$inv' '$done_file'" EXIT
  # shellcheck disable=SC2064
  trap "rm -rf -- '$scratch'; rm -f -- '$inv' '$done_file'; exit 143" HUP INT TERM
  if (( reval == 1 )); then : > "$done_file"; else sample_verified_paths "$target" > "$done_file"; fi
  already="$(grep -c . < "$done_file" || true)"

  local -a sample_paths=() sample_sizes=()
  local size path
  while IFS=$'\t' read -r size path; do
    [[ -n "$path" ]] || continue
    (( total + size > SAMPLE_MAX_TOTAL_BYTES )) && continue
    sample_paths+=("$path"); sample_sizes+=("$size"); total=$(( total + size ))
  done < <(sample_select_paths "$inv" "$want" "$done_file")

  if (( ${#sample_paths[@]} == 0 )); then
    echo "[domum-media-backup] Sample verification for $target"
    echo "  originals    : $n_orig (asset table)"
    echo "  already proven: ${already:-0}"
    echo "  nothing left to sample within the size caps. Every original that the"
    echo "  caps can reach has been proven; use --revalidate to prove them again,"
    echo "  or verify-large for the files above the per-file cap."
    return 0
  fi
  log "sample verification: $target snapshot $snapshot_id, ${#sample_paths[@]} file(s), $total bytes"

  local -a include_args=()
  for path in "${sample_paths[@]}"; do include_args+=(--include "$path"); done
  if ! restic_for_target "$target" restore latest --target "$scratch" "${include_args[@]}" >/dev/null 2>&1; then
    die "Sample restore failed for $target"
  fi

  manifest="$(sample_manifest_file "$target")"
  local tmp; tmp="$(mktemp "${manifest}.XXXXXX")" || die "Cannot stage the manifest"
  local ok=0 bad=0 i ext src_hash dst_hash verdict
  for i in "${!sample_paths[@]}"; do
    path="${sample_paths[$i]}"; size="${sample_sizes[$i]}"
    ext="${path##*/}"
    if [[ "$ext" == *.* ]]; then ext="${ext##*.}"; ext="${ext,,}"; else ext="none"; fi
    src_hash="$(sha256sum "$path" 2>/dev/null | cut -d" " -f1)"
    dst_hash="$(sha256sum "$scratch$path" 2>/dev/null | cut -d" " -f1)"
    if [[ -n "$src_hash" && "$src_hash" == "$dst_hash" ]]; then
      verdict=match; ok=$(( ok + 1 ))
    else
      verdict=MISMATCH; bad=$(( bad + 1 ))
    fi
    jq -cn --arg t "$target" --arg s "$snapshot_id" --arg p "$path" --arg e "$ext" \
      --argjson b "$size" --arg sh "${src_hash:-}" --arg dh "${dst_hash:-}" \
      --arg v "$verdict" --arg ts "$(date -Iseconds)" \
      '{target:$t,snapshot_id:$s,path:$p,media_type:$e,size_bytes:$b,
        source_sha256:($sh|select(length>0)),restored_sha256:($dh|select(length>0)),
        result:$v,verified_at:$ts}' >> "$tmp"
    printf '  %-9s %-6s %12s  %s\n' "$verdict" "$ext" "$size" "${path#"$lib"/}"
  done
  chmod 0600 "$tmp"; mv -f "$tmp" "$manifest"

  # The manifest is this RUN; the history is every run. Coverage accumulates in
  # the history, which is what selection consults next time.
  local hist htmp
  hist="$(sample_history_file "$target")"
  htmp="$(mktemp "${hist}.XXXXXX")" || die "Cannot stage the sample history"
  [[ -f "$hist" ]] && cat "$hist" >> "$htmp"
  cat "$manifest" >> "$htmp"
  chmod 0600 "$htmp"; mv -f "$htmp" "$hist"

  echo
  echo "[domum-media-backup] Sample verification for $target"
  echo "  snapshot : $snapshot_id"
  echo "  sampled  : ${#sample_paths[@]} file(s), $total bytes, $ok matched, $bad mismatched"
  echo "  sampled  : from $lib (asset table)"
  echo "  cumulative: $(sample_verified_count "$target") of $n_orig original(s) proven across all runs"
  echo "  manifest : $manifest"
  echo "  history  : $(sample_history_file "$target")"
  sample_report_coverage "$inv" "$lib" "$n_missing"
  # Recorded beside the manifest, so the report can state the population rather
  # than only what was sampled. A separate file, not a record in the JSONL: the
  # report aggregates that with `jq -s` over per-file records, and a
  # differently-shaped row there would skew the match counts.
  local cov_file cov_stats c_tf c_tb c_of c_ob
  cov_file="$(sample_coverage_file "$target")"
  cov_stats="$(sample_coverage_stats "$inv")"
  read -r c_tf c_tb c_of c_ob <<< "$cov_stats"
  # `source` is recorded so a reader can tell WHICH population a stored proof
  # was measured against. A denominator with no stated provenance is how the
  # filesystem-walk figure passed for an original count for as long as it did.
  local cov_loc
  cov_loc="$(inventory_by_location "$inv" "$lib" \
    | jq -Rn '[inputs | split(" ") | {(.[1]): (.[0]|tonumber)}] | add // {}' 2>/dev/null || echo '{}')"
  if jq -cn --arg t "$target" --arg o "$lib" --arg ts "$(date -Iseconds)" \
       --arg src "immich-asset-table" \
       --argjson tf "${c_tf:-0}" --argjson tb "${c_tb:-0}" \
       --argjson of "${c_of:-0}" --argjson ob "${c_ob:-0}" \
       --argjson miss "${n_missing:-0}" \
       --argjson byloc "${cov_loc:-\{\}}" \
       --argjson cap "$SAMPLE_MAX_FILE_BYTES" --argjson tcap "$SAMPLE_MAX_TOTAL_BYTES" \
       --argjson sampled "${#sample_paths[@]}" \
       '{target:$t,originals:$o,source:$src,recorded_at:$ts,population_files:$tf,
         population_bytes:$tb,oversize_files:$of,oversize_bytes:$ob,
         missing_on_disk:$miss,by_location:$byloc,
         per_file_cap_bytes:$cap,total_cap_bytes:$tcap,sampled_files:$sampled}' \
       > "$cov_file.tmp" 2>/dev/null; then
    chmod 0600 "$cov_file.tmp"; mv -f "$cov_file.tmp" "$cov_file"
    echo "  coverage : $cov_file"
  else
    rm -f -- "$cov_file.tmp"
    echo "  coverage : NOT RECORDED -- could not write $cov_file"
  fi
  echo "  NOTE: this proves the SAMPLED objects only. It does not prove the whole"
  echo "        library, nor that a rebuilt Immich can serve it."
  (( bad == 0 )) || die "Sample verification FAILED for $target: $bad mismatch(es)"
}

do_init_repo() {
  local target="${1:-}"
  local adopt=0
  [[ -n "$target" ]] || die "Usage: backup init <target> [--adopt-existing]"
  shift || true
  while (( $# )); do
    case "$1" in
      --adopt-existing) adopt=1 ;;
      *) die "Usage: backup init <target> [--adopt-existing]" ;;
    esac
    shift
  done

  load_cfg
  export_compose_env

  local repository
  repository="$(backup_target_value "$target" REPOSITORY)"
  [[ -n "$repository" ]] || die "No BACKUP_TARGET_$(uppercase_token "$target")_REPOSITORY configured."

  mkdir -p "$REPO_META_DIR"
  local meta_file
  meta_file="$(repo_meta_file "$target")"
  if [[ -f "$meta_file" ]] && (( adopt == 0 )); then
    die "Repository metadata already exists at $meta_file. Use --adopt-existing to overwrite."
  fi

  log "Initializing $target repository"
  if restic_for_target "$target" snapshots >/dev/null 2>&1; then
    if (( adopt == 0 )); then
      log "Repository already initialized. Using existing repo."
    else
      log "Repository exists. Adopting."
    fi
  else
    log "Repository not found. Running restic init..."
    restic_for_target "$target" init || die "Failed to init repository."
  fi

  local repo_id
  repo_id="$(get_repo_id "$target")"
  [[ -n "$repo_id" ]] || die "Failed to get repository ID. Check connectivity and password."

  log "Repository ID: $repo_id"
  mkdir -p "$REPO_META_DIR"
  cat > "$meta_file" <<EOF
TARGET="$target"
REPOSITORY_ID="$repo_id"
INIT_TS="$(date -Iseconds)"
EOF
  log "Saved metadata to $meta_file"

  log "Verifying connectivity..."
  restic_for_target "$target" snapshots --latest 1 || die "Failed to read snapshots after init."
  log "Repository initialized and ready."
}

do_plan_target() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: backup plan <target>"

  load_cfg
  local repository target_type
  repository="$(backup_target_value "$target" REPOSITORY)"
  target_type="$(backup_target_value "$target" TYPE repository)"
  [[ -n "$repository" ]] || die "No BACKUP_TARGET_$(uppercase_token "$target")_REPOSITORY configured."

  local meta_file repo_id
  meta_file="$(repo_meta_file "$target")"
  if [[ -f "$meta_file" ]]; then
    unset REPOSITORY_ID
    # shellcheck disable=SC1090
    source "$meta_file"
    repo_id="${REPOSITORY_ID:0:16}"
  else
    repo_id="(run: sudo domum-media backup init $target)"
  fi

  echo "Backup plan for target: $target"
  if [[ "$repository" == sftp:* ]]; then
    echo "  Repository: configured (sftp)"
  else
    echo "  Repository: configured ($target_type)"
  fi
  echo "  Repo ID: $repo_id"
  echo "  Encryption: restic client-side encryption — data encrypted locally before upload"
  echo
  echo "Include paths:"
  local path
  for path in $(backup_target_include_paths "$target"); do
    if [[ -e "$path" ]]; then
      echo "  ✓ $path"
    else
      echo "  ⚠ $path (missing on disk)"
    fi
  done
  echo
  echo "Excluded paths (by design):"
  echo "  /srv/media/movies (media: not included)"
  echo "  /srv/media/tv (media: not included)"
  echo "  /srv/media/music (media: not included)"
  echo "  /srv/media/books (media: not included)"
  echo "  /srv/data/jellyfin (media app: not included)"
  echo "  /srv/data/plex (media app: not included)"
  echo "  /srv/data/navidrome (music app: not included)"
  echo "  /srv/data/calibre-web (ebook app: not included)"
  echo "  /srv/data/kavita (comics app: not included)"
}

do_verify_target() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: backup verify <target>"

  load_cfg
  export_compose_env

  log "Verifying repository: $target"
  log "--- snapshots (latest 1) ---"
  restic_for_target "$target" snapshots --latest 1

  log "--- metadata check ---"
  restic_for_target "$target" check

  log "--- storage stats (best-effort) ---"
  restic_for_target "$target" stats --mode restore-size || true

  log "Verification complete."
}

do_adopt_repo() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: backup adopt-repo <target>"

  load_cfg
  export_compose_env

  local repository
  repository="$(backup_target_value "$target" REPOSITORY)"
  [[ -n "$repository" ]] || die "No BACKUP_TARGET_$(uppercase_token "$target")_REPOSITORY configured."

  log "Adopting current repository for $target"
  local repo_id
  repo_id="$(get_repo_id "$target")" || die "Failed to connect to repository. Check configuration."

  log "Current repository ID: $repo_id"

  mkdir -p "$REPO_META_DIR"
  local meta_file
  meta_file="$(repo_meta_file "$target")"
  cat > "$meta_file" <<EOF
TARGET="$target"
REPOSITORY_ID="$repo_id"
INIT_TS="$(date -Iseconds)"
ADOPTED=1
EOF
  log "Repository adopted. Metadata saved to $meta_file"
}

# ---------------------------------------------------------------------------
# Backup exclusion patterns, and whether they can be trusted
# ---------------------------------------------------------------------------

# The exclusion patterns actually handed to restic.
#
# They used to be written inline in the restic invocation, where nothing could
# read them: a proposal to stop backing up regenerable data had no way to be
# checked against what is really in effect, and "the backup excludes X" was a
# claim about source code rather than about behaviour. One source, read by both
# the backup and the audit, so the two cannot disagree.
backup_exclude_patterns() {
  printf '%s\n' "$DOMUM_DATA_ROOT/immich/backup-staging/*.tmp"
  printf '%s\n' "${DOMUM_MEDIA_ROOT}/.cache/*"
  # The Immich derivative exclusion is OFF by default and, even when switched
  # on, is applied only if it can be PROVEN against the live asset table that
  # no original matches. See exclusion_safe_to_apply.
  if [[ "${BACKUP_EXCLUDE_IMMICH_DERIVATIVES:-0}" == "1" ]]; then
    local -a proposed=()
    local pat
    while IFS= read -r pat; do [[ -n "$pat" ]] && proposed+=("$pat"); done \
      < <(backup_proposed_exclude_patterns)
    if (( ${#proposed[@]} > 0 )) && exclusion_safe_to_apply "${proposed[@]}"; then
      printf '%s\n' "${proposed[@]}"
    fi
  fi
}

# Patterns that are NOT in effect: a reviewable proposal, kept beside the
# active set so the audit can evaluate it against live data before anyone
# edits the backup. Nothing in the backup path reads this function.
#
# Immich's library holds 130.2 GiB of originals and 82.4 GiB of regenerable
# derivatives, so excluding the derivatives is worth doing -- but only once it
# is proven the patterns cannot reach an original. See
# docs/BACKUP-EXCLUSION-PROPOSAL.md.
backup_proposed_exclude_patterns() {
  local lib="${IMMICH_LIBRARY_DIR:-$DOMUM_DATA_ROOT/immich/library}"
  printf '%s\n' "$lib/thumbs/**"
  printf '%s\n' "$lib/encoded-video/**/*[0-9a-f].mp4"
}

# Does one path match one restic exclude pattern?
#
# Conservative by construction. Restic's "**" matches zero or more path
# components, while bash's "*" inside [[ ]] crosses "/" but a literal "**/"
# still demands one separator -- so the zero-component case is tested as a
# separate collapsed variant. A pattern may therefore match here that restic
# would not: this check can over-report, never miss. That is the only safe
# direction for a check whose job is to find an original that would silently
# stop being backed up.
path_matches_exclude() {  # $1 = path, $2 = pattern
  local path="$1" pat="$2" collapsed
  # shellcheck disable=SC2053
  [[ "$path" == $pat ]] && return 0
  collapsed="${pat//\*\*\//}"
  if [[ "$collapsed" != "$pat" ]]; then
    # shellcheck disable=SC2053
    [[ "$path" == $collapsed ]] && return 0
  fi
  return 1
}

# Where the container sees the Immich library, so database paths can be
# translated to host paths. Read from the running container rather than
# assumed: the destination is Immich's to choose, and a wrong prefix would
# make every original look unmatched, i.e. would make the audit pass
# vacuously.
immich_container_library_prefix() {
  local lib dest
  lib="${IMMICH_LIBRARY_DIR:-$DOMUM_DATA_ROOT/immich/library}"
  dest="$(docker inspect immich_server \
    --format "{{range .Mounts}}{{if eq .Source \"$lib\"}}{{.Destination}}{{end}}{{end}}" \
    2>/dev/null || true)"
  printf '%s' "${dest:-/usr/src/app/upload}"
}

# Every path Immich considers an ORIGINAL, as host paths.
#
# The database is the only authority for this. A filesystem walk of upload/
# cannot answer it: measured on this host, 58 assets keep their original under
# encoded-video/ (motion-photo parts, named "<uuid>-MP.mp4"), so a proposal
# reasoned from directory names alone would have dropped 58 irreplaceable
# files and reported success. Returns non-zero when the database cannot be
# read, so the caller can say UNKNOWN instead of guessing.
immich_db_original_paths() {
  local pg_cid pg_user pg_db prefix lib rows tbl
  lib="${IMMICH_LIBRARY_DIR:-$DOMUM_DATA_ROOT/immich/library}"
  pg_user="${IMMICH_DB_USERNAME:-postgres}"
  pg_db="${IMMICH_DB_DATABASE_NAME:-immich}"
  pg_cid="$(docker ps --filter "name=immich_postgres" --filter "status=running" -q 2>/dev/null | head -1 || true)"
  [[ -n "$pg_cid" ]] || return 1
  prefix="$(immich_container_library_prefix)"
  # The table was renamed between Immich versions; try both rather than pin one.
  for tbl in asset assets; do
    rows="$(docker exec -i "$pg_cid" psql -U "$pg_user" -d "$pg_db" -At \
              -c "select \"originalPath\" from $tbl where \"originalPath\" is not null" \
              2>/dev/null || true)"
    if [[ -n "$rows" ]]; then
      printf '%s\n' "$rows" | sed "s|^${prefix}|${lib}|"
      return 0
    fi
  done
  return 1
}

# Which originals would these patterns exclude?
#
# The one implementation of the question. The human audit and the runtime gate
# both call it, so a report that says "safe" and a backup that excludes an
# original cannot coexist.
#
# Prints one "<pattern>\t<original path>" line per offence. Returns 0 when
# nothing matched, 1 when something did, and 2 when the question could not be
# answered -- which callers must treat as "not safe", never as "safe".
originals_matched_by_patterns() {  # $@ = patterns
  local rc=0 path pat lib n_under paths
  lib="${IMMICH_LIBRARY_DIR:-$DOMUM_DATA_ROOT/immich/library}"
  # Matched on the PATHS the asset table names, deliberately NOT on a stat of
  # them. Whether a file is currently on disk is a different question: a path
  # the table names is an original, and an exclusion that matches it is wrong
  # even while the file is missing. Requiring existence here made the audit
  # report "clean" for a library whose files had not been created yet.
  paths="$(immich_db_original_paths)" || return 2
  [[ -n "$paths" ]] || return 2
  # Untranslated paths match no host pattern, so "nothing matched" would be
  # meaningless rather than reassuring.
  n_under="$(grep -c "^${lib}/" <<< "$paths" || true)"
  [[ "${n_under:-0}" -gt 0 ]] || return 2
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    for pat in "$@"; do
      [[ -n "$pat" ]] || continue
      if path_matches_exclude "$path" "$pat"; then
        printf '%s\t%s\n' "$pat" "$path"
        rc=1
      fi
    done
  done <<< "$paths"
  return "$rc"
}

# The permanent invariant: NO Immich original may be excluded from the off-site
# backup.
#
# This is why the derivative exclusion is gated at RUN TIME rather than trusted
# because an audit passed once. The patterns key off a naming convention --
# a transcode is <uuid>.mp4, a motion-photo original is <uuid>-MP.mp4 -- and a
# future Immich version is free to name a new kind of original anything it
# likes, including something ending in a hex digit. The convention is evidence,
# not a guarantee; the asset table is the guarantee.
#
# Failing toward MORE backup is safe: excluding less costs money, never data.
# So when the invariant cannot be established the patterns are DROPPED and the
# run says so, rather than the backup being refused. A refused backup would
# turn a cost optimisation into an outage.
exclusion_safe_to_apply() {  # $@ = patterns -> 0 safe, 1 unsafe/unknown
  local offences rc
  offences="$(originals_matched_by_patterns "$@")"; rc=$?
  case "$rc" in
    0) return 0 ;;
    1) warn "Exclusion REFUSED: these patterns would stop an Immich ORIGINAL being backed up."
       printf '%s\n' "$offences" | head -10 | sed 's/^/  /' >&2
       warn "The backup will proceed WITHOUT them. Nothing irreplaceable is dropped."
       return 1 ;;
    *) warn "Exclusion REFUSED: could not read the Immich asset table, so it cannot be"
       warn "proven that no original would be excluded. Proceeding WITHOUT the"
       warn "derivative exclusions -- backing up more is the safe direction."
       return 1 ;;
  esac
}

# Would any exclusion pattern stop an Immich original from being backed up?
#
# Read-only: it contacts no repository, writes nothing, and changes no
# exclusion. It exists because the obvious version of the derivative-exclusion
# proposal was wrong in the dangerous direction, and the only thing that
# revealed it was comparing the patterns against the live asset table.
#
# Exit 0 clean, 1 an original is matched, 2 the question could not be answered.
do_exclusion_audit() {
  local mode="${1:-}" pat path
  local -a patterns=() labels=()
  local lib="${IMMICH_LIBRARY_DIR:-$DOMUM_DATA_ROOT/immich/library}"

  case "$mode" in
    ""|--active)   : ;;
    --proposed)    : ;;
    *) die "Usage: domum-media-backup exclusion-audit [--proposed]" ;;
  esac

  echo "BACKUP EXCLUSION AUDIT"
  echo
  echo "active exclusions (in effect for every backup):"
  while IFS= read -r pat; do
    [[ -n "$pat" ]] || continue
    patterns+=("$pat"); labels+=("active")
    echo "  $pat"
  done < <(backup_exclude_patterns)

  if [[ "$mode" == "--proposed" ]]; then
    echo
    if [[ "${BACKUP_EXCLUDE_IMMICH_DERIVATIVES:-0}" == "1" ]]; then
      echo "proposed exclusions (SWITCHED ON; applied only while this audit passes):"
    else
      echo "proposed exclusions (NOT in effect; BACKUP_EXCLUDE_IMMICH_DERIVATIVES=0):"
    fi
    while IFS= read -r pat; do
      [[ -n "$pat" ]] || continue
      patterns+=("$pat"); labels+=("proposed")
      echo "  $pat"
    done < <(backup_proposed_exclude_patterns)
  fi

  echo
  local originals rc=0 total=0 hits=0 i
  if ! originals="$(immich_db_original_paths)"; then
    echo "originals          : UNKNOWN -- the Immich database could not be read"
    echo
    echo "VERDICT: UNKNOWN. The audit cannot tell whether these patterns match an"
    echo "         original, because the asset table is the only authority for"
    echo "         which files are originals. Do not treat this as a pass."
    return 2
  fi

  local n_orig n_under
  n_orig="$(printf '%s\n' "$originals" | grep -c . || true)"
  n_under="$(printf '%s\n' "$originals" | grep -c "^${lib}/" || true)"
  echo "originals          : $n_orig (from the Immich asset table)"
  echo "library root       : $lib"
  echo "under library root : $n_under"
  echo

  # A failed container-to-host translation would leave every path shaped like
  # the container's view, matching no host pattern, and the audit would report
  # a clean pass having compared nothing. Refuse to answer instead: the one
  # thing this check must never do is pass vacuously.
  if (( n_under == 0 )); then
    echo "VERDICT: UNKNOWN -- not one original resolved under the library root, so"
    echo "         the database paths were not translated to host paths and no"
    echo "         pattern could have matched. Do not treat this as a pass."
    return 2
  fi

  # One implementation of the question, shared with the runtime gate, so this
  # report and the backup's behaviour cannot disagree.
  local -a offenders=()
  local off_lines opat opath
  total="$n_orig"
  off_lines="$(originals_matched_by_patterns "${patterns[@]}")" || true
  while IFS=$'\t' read -r opat opath; do
    [[ -n "$opath" ]] || continue
    hits=$((hits + 1))
    offenders+=("$opat  ->  $opath")
  done <<< "$off_lines"

  if (( hits > 0 )); then
    echo "MATCHED ORIGINALS  : $hits of $total"
    echo
    echo "These files are originals and an exclusion pattern matches them. Backing"
    echo "them up would stop, and nothing else holds them:"
    printf '  %s\n' "${offenders[@]:0:20}"
    (( hits > 20 )) && echo "  ... and $((hits - 20)) more"
    echo
    echo "VERDICT: FAIL -- an exclusion pattern reaches irreplaceable data."
    rc=1
  else
    echo "MATCHED ORIGINALS  : 0 of $total"
    echo
    echo "VERDICT: no Immich original is matched by any audited pattern."
    [[ "$mode" == "--proposed" ]] && echo "         The proposal is safe against the library as it is right now."
    rc=0
  fi
  return "$rc"
}

# ---------------------------------------------------------------------------
# Disaster-recovery status: what is actually proven, per tier
# ---------------------------------------------------------------------------

# The five levels the operator asked for, in increasing strength.
#
# They are deliberately not collapsible into a boolean. "A backup exists" and
# "recovery works" are different claims, and the distance between them is where
# this project's real risk lives: every historical defect here was a report
# that answered the weaker question in the stronger question's words.
#
#   UNKNOWN                 no evidence either way -- never treat as a pass
#   CONFIGURED              the path is in the backup set and not excluded
#   BACKED UP               a successful run recorded a snapshot covering it
#   RESTORE TESTED          some of it was restored and compared, with a
#                           stated denominator
#   FULL RECOVERY VERIFIED  all of it was restored and the application that
#                           owns it confirmed the result
#
# Nothing on this host is FULL RECOVERY VERIFIED yet, and the report must keep
# saying so until something earns it.
dr_level_rank() {  # $1 = level -> 0..4, or empty
  case "$1" in
    UNKNOWN)                  printf '0' ;;
    CONFIGURED)               printf '1' ;;
    "BACKED UP")              printf '2' ;;
    "RESTORE TESTED")         printf '3' ;;
    "FULL RECOVERY VERIFIED") printf '4' ;;
    *)                        printf '' ;;
  esac
}

# Is this path inside the configured backup set, and not excluded?
# 0 = in the backup set, 1 = NOT in it, 2 = cannot tell.
#
# The third case matters: with no include paths known, "not in the backup set"
# would be a claim about configuration that was never read, which is the exact
# conflation this report exists to avoid.
dr_path_configured() {  # $1 = path
  local path="$1" root pat
  local ok=1
  [[ -n "${BACKUP_INCLUDE_PATHS:-}" ]] || return 2
  for root in ${BACKUP_INCLUDE_PATHS:-}; do
    case "$path" in
      "$root"|"$root"/*) ok=0 ;;
    esac
  done
  (( ok == 0 )) || return 1
  while IFS= read -r pat; do
    [[ -n "$pat" ]] || continue
    path_matches_exclude "$path" "$pat" && return 1
  done < <(backup_exclude_patterns)
  return 0
}

# The most recent successful run record for a target, if any.
dr_last_success_run() {  # $1 = target -> "ts snapshot_id" or empty
  local target="$1" file
  file="${REPO_META_DIR:-}/${target}-run.env"
  [[ -n "${REPO_META_DIR:-}" && -f "$file" ]] || return 1
  (
    unset RESULT FINISHED_TS SNAPSHOT_ID
    # shellcheck disable=SC1090
    . "$file" >/dev/null 2>&1 || exit 1
    [[ "${RESULT:-}" == "success" ]] || exit 1
    printf '%s %s' "${FINISHED_TS:-unknown}" "${SNAPSHOT_ID:-unknown}"
  )
}

# The recorded dump-restore verification for a target, if it passed.
dr_last_restore_verification() {  # $1 = target -> "ts snapshot_id" or empty
  local target="$1" file
  file="$(restore_verification_dir)/${target}.env"
  [[ -f "$file" ]] || return 1
  (
    unset LAST_SUCCESS_TS LAST_SUCCESS_SNAPSHOT_ID
    # shellcheck disable=SC1090
    . "$file" >/dev/null 2>&1 || exit 1
    [[ -n "${LAST_SUCCESS_TS:-}" ]] || exit 1
    printf '%s %s' "$LAST_SUCCESS_TS" "${LAST_SUCCESS_SNAPSHOT_ID:-unknown}"
  )
}

# The database IMPORT proof for a target, if it passed.
#
# Separate from dr_last_restore_verification on purpose. That one records the
# ARCHIVE checks -- gzip, size, footer -- which say nothing about whether
# PostgreSQL can read the file. Treating the two as one claim is how
# "RESTORE TESTED" got attached to a proof that had never run an import.
dr_last_dbimport() {  # $1 = target -> "ts snapshot assets" or empty
  local target="$1" file
  file="$(dbimport_evidence_file "$target")"
  [[ -f "$file" ]] || return 1
  (
    unset LAST_SUCCESS_TS LAST_SUCCESS_SNAPSHOT_ID ASSETS_IMPORTED
    # shellcheck disable=SC1090
    . "$file" >/dev/null 2>&1 || exit 1
    [[ -n "${LAST_SUCCESS_TS:-}" ]] || exit 1
    printf '%s %s %s' "$LAST_SUCCESS_TS" "${LAST_SUCCESS_SNAPSHOT_ID:-unknown}" "${ASSETS_IMPORTED:-0}"
  )
}

# The recorded snapshot-coverage proof: how many originals were OBSERVED in a
# real snapshot, and which snapshot that was.
#
# Separate from the configuration question. "The library is under the backup
# root and no exclusion matches it" is an argument; "this path is in snapshot
# 05a6adb0" is an observation. The report must not present the first as the
# second.
dr_snapshot_coverage() {  # $1 = target -> "present originals missing snapshot" or empty
  local f; f="$(snapshot_coverage_file "$1")"
  [[ -f "$f" ]] || return 1
  local present orig miss snap
  present="$(jq -r '.in_snapshot // empty' "$f" 2>/dev/null || true)"
  orig="$(jq -r '.originals // empty' "$f" 2>/dev/null || true)"
  miss="$(jq -r '.missing_from_snapshot // empty' "$f" 2>/dev/null || true)"
  snap="$(jq -r '.snapshot_id // empty' "$f" 2>/dev/null || true)"
  [[ -n "$present" && -n "$orig" ]] || return 1
  printf '%s %s %s %s' "$present" "$orig" "${miss:-0}" "${snap:-unknown}"
}

# The Phase A rehearsal result, if it passed.
#
# A distinct claim from everything else: the application opened the recovered
# database. It is NOT claim 4 -- nothing was served -- so it must never promote
# a tier to FULL RECOVERY VERIFIED.
dr_last_phase_a() {  # $1 = target -> "ts snapshot assets" or empty
  local f; f="$(phasea_evidence_file "$1")"
  [[ -f "$f" ]] || return 1
  (
    unset LAST_SUCCESS_TS LAST_SUCCESS_SNAPSHOT_ID ASSETS
    # shellcheck disable=SC1090
    . "$f" >/dev/null 2>&1 || exit 1
    [[ -n "${LAST_SUCCESS_TS:-}" ]] || exit 1
    printf '%s %s %s' "$LAST_SUCCESS_TS" "${LAST_SUCCESS_SNAPSHOT_ID:-unknown}" "${ASSETS:-0}"
  )
}

# The sample-restore proof for a target, WITH its denominator.
#
# A sample proof without a population is not reportable as RESTORE TESTED: that
# is the defect the coverage artefact was added to fix, and reading the manifest
# alone would reintroduce it.
dr_sample_proof() {  # $1 = target -> "sampled population unsampled" or empty
  local target="$1" man cov sampled pop uns large
  man="$(sample_manifest_file "$target" 2>/dev/null)" || return 1
  cov="$(sample_coverage_file "$target" 2>/dev/null)" || return 1
  [[ -f "$man" && -f "$cov" ]] || return 1
  # The coverage artefact records the LAST RUN's sample count; the history
  # records every run. Now that selection skips what is already proven, the
  # cumulative figure is the honest numerator -- reporting the per-run one
  # would hold coverage at 12 forever however many times the command ran.
  pop="$(jq -r '.population_files // empty' "$cov" 2>/dev/null || true)"
  sampled="$(sample_verified_count "$target")"
  if [[ "${sampled:-0}" -eq 0 ]]; then
    sampled="$(jq -r '.sampled_files // empty' "$cov" 2>/dev/null || true)"
  fi
  [[ -n "$sampled" && -n "$pop" ]] || return 1
  # The large-file history counts too. It did not, and the report contradicted
  # itself in production: the tier row said "23021 never restore-tested" while
  # the summary four lines below said 23019, because only the summary knew
  # about the two large originals verify-large had just proved. Two numbers in
  # one report that must agree are one number, computed once.
  large="$(dr_large_proven_count "$target")"
  uns=$(( pop - sampled - large ))
  (( uns < 0 )) && uns=0
  printf '%s %s %s %s' "$sampled" "$pop" "$uns" "$large"
}

# How many large originals have been proven for this target.
#
# Separate from dr_sample_proof so the summary and the tier row read the same
# figure; both call it rather than counting for themselves.
dr_large_proven_count() {  # $1 = target
  local n
  n="$(large_verified_paths "$1" 2>/dev/null | grep -c . || true)"
  printf '%s' "${n:-0}"
}

# One row of the report.
dr_row() {  # $1 = tier, $2 = level, $3 = evidence
  printf '  %-26s %-24s %s\n' "$1" "$2" "$3"
}

# What the operator actually asks: how many originals, how many proven, what is
# still unproven, and what it would cost to change that.
#
# Every number here is either read from recorded evidence or measured locally.
# Where a figure cannot be obtained it says UNKNOWN rather than being omitted,
# because a missing line reads as "nothing to report".
dr_immich_summary() {  # $1 = target, $2 = library root
  local target="$1" lib="$2"
  local cov inv counts n_orig n_missing
  cov="$(sample_coverage_file "$target")"

  echo "  IMMICH ORIGINALS"
  inv="$(mktemp)" || return 0
  if counts="$(immich_original_inventory "$inv")"; then
    read -r n_orig n_missing <<< "$counts"
    local stats tf tb of ob
    stats="$(sample_coverage_stats "$inv")"
    read -r tf tb of ob <<< "$stats"
    printf '    %-34s %s\n' "originals (asset table)" \
      "$n_orig, $(sample_human_bytes "$tb")"
    while read -r cnt sub; do
      [[ -n "$cnt" ]] || continue
      printf '    %-34s %s\n' "  under $sub/" "$cnt"
    done < <(inventory_by_location "$inv" "$lib")
    printf '    %-34s %s\n' "present on disk" "$(( n_orig - n_missing )) of $n_orig"
    (( n_missing > 0 )) && printf '    %-34s %s\n' "MISSING from disk" "$n_missing"
    local brc=0
    dr_path_configured "$lib" || brc=$?
    case "$brc" in
      0) printf '    %-34s %s\n' "in the backup set (config)" "all $n_orig" ;;
      1) printf '    %-34s %s\n' "in the backup set (config)" "NO -- not under any backup root" ;;
      *) printf '    %-34s %s\n' "in the backup set (config)" "UNKNOWN -- BACKUP_INCLUDE_PATHS unset" ;;
    esac
    # Claim 2: OBSERVED in a snapshot, not inferred from configuration.
    local sc
    if sc="$(dr_snapshot_coverage "$target")"; then
      local sc_present sc_orig sc_miss sc_snap
      sc_present="$(awk '{print $1}' <<< "$sc")"; sc_orig="$(awk '{print $2}' <<< "$sc")"
      sc_miss="$(awk '{print $3}' <<< "$sc")";    sc_snap="$(awk '{print $4}' <<< "$sc")"
      if [[ "${sc_miss:-0}" -gt 0 ]]; then
        printf '    %-34s %s\n' "IN a snapshot (observed)" \
          "$sc_present of $sc_orig -- $sc_miss MISSING from snapshot $sc_snap"
      else
        printf '    %-34s %s\n' "IN a snapshot (observed)" \
          "all $sc_present, snapshot $sc_snap"
      fi
      [[ "$sc_snap" == "$run_snap" ]] || \
        printf '    %-34s %s\n' "" "[reconciled against an earlier snapshot]"
      [[ "${sc_orig:-0}" == "$n_orig" ]] || \
        printf '    %-34s %s\n' "" "[the library has $n_orig originals now vs $sc_orig when reconciled]"
    else
      printf '    %-34s %s\n' "IN a snapshot (observed)" \
        "NOT CHECKED -- run verify-snapshot-coverage"
    fi

    local samp largeok=0
    samp="$(sample_verified_count "$target")"
    if [[ "${samp:-0}" -eq 0 && -f "$cov" ]]; then
      samp="$(jq -r '.sampled_files // 0' "$cov" 2>/dev/null || echo 0)"
    fi
    largeok="$(dr_large_proven_count "$target")"
    printf '    %-34s %s\n' "restore-tested (sampled, all runs)" "$samp"
    printf '    %-34s %s\n' "restore-tested (large files)" "$largeok of $of over the cap"
    local never=$(( n_orig - samp - largeok ))
    (( never < 0 )) && never=0
    printf '    %-34s %s\n' "NEVER restore-tested" "$never"
    # The application half, kept separate from the byte half. A started
    # application proves the database is usable; it proves nothing about files.
    local pa
    if pa="$(dr_last_phase_a "$target")"; then
      printf '    %-34s %s\n' "application startup (Phase A)" \
        "VERIFIED ${pa%% *} -- $(awk '{print $3}' <<< "$pa") record(s), snapshot $(awk '{print $2}' <<< "$pa")"
      printf '    %-34s %s\n' "" "(the app opened the database; no file was served)"
    else
      printf '    %-34s %s\n' "application startup (Phase A)" \
        "NOT TESTED -- run immich-phase-a"
    fi
    # The tier row above quotes the population RECORDED when the sample ran;
    # this block counts the library as it is NOW. They are different questions
    # and will diverge as photos are added, so say when they have rather than
    # printing two numbers that look like they should match.
    local rec_pop=""
    [[ -f "$cov" ]] && rec_pop="$(jq -r '.population_files // empty' "$cov" 2>/dev/null || true)"
    if [[ -n "$rec_pop" && "$rec_pop" != "$n_orig" ]]; then
      printf '    %-34s %s\n' "population drift" \
        "$n_orig now vs $rec_pop when last sampled -- the proof covers the older set"
    fi
    printf '    %-34s %s\n' "largest unproven set" \
      "$(( of - largeok )) file(s) over $(sample_human_bytes "$SAMPLE_MAX_FILE_BYTES")"
  else
    printf '    %-34s %s\n' "originals" "UNKNOWN -- the asset table could not be read"
  fi
  rm -f "$inv"

  # What an exclusion would save, measured now rather than quoted from a doc.
  local th_b ev_all_b ev_d_b
  th_b="$(find "$lib/thumbs" -type f -printf '%s\n' 2>/dev/null | awk '{b+=$1} END{print b+0}')"
  ev_all_b="$(find "$lib/encoded-video" -type f -printf '%s\n' 2>/dev/null | awk '{b+=$1} END{print b+0}')"
  ev_d_b="$(find "$lib/encoded-video" -type f -name '*[0-9a-f].mp4' -printf '%s\n' 2>/dev/null \
    | awk '{b+=$1} END{print b+0}')"
  echo "  REGENERABLE DATA (currently backed up)"
  printf '    %-34s %s\n' "thumbs/" "$(sample_human_bytes "${th_b:-0}")"
  printf '    %-34s %s\n' "encoded-video/ (whole subtree)" "$(sample_human_bytes "${ev_all_b:-0}")"
  printf '    %-34s %s\n' "  of which derivatives" "$(sample_human_bytes "${ev_d_b:-0}")"
  printf '    %-34s %s\n' "  of which ORIGINALS (kept)" \
    "$(sample_human_bytes $(( ${ev_all_b:-0} - ${ev_d_b:-0} )))"
  printf '    %-34s %s\n' "potential saving if excluded" \
    "$(sample_human_bytes $(( ${th_b:-0} + ${ev_d_b:-0} )))"
  printf '    %-34s %s\n' "exclusion currently applied" \
    "$([[ "${BACKUP_EXCLUDE_IMMICH_DERIVATIVES:-0}" == "1" ]] && echo yes || echo "no (BACKUP_EXCLUDE_IMMICH_DERIVATIVES=0)")"
}

# What the off-site repository is SUPPOSED to hold, checked against what the
# configuration actually says.
#
# The distinction this protects is irreplaceable vs reacquirable. Hetzner should
# hold the family originals, the Immich database dump, application state, small
# databases, recovery metadata and image archives. It should NOT hold films,
# television, music, books, thumbnails, transcodes or caches -- paying to store
# data whose recovery plan is "download it again".
#
# Reported rather than asserted: the include set is configuration, and a claim
# about it that was never read is worthless.
dr_backup_scope() {  # $1 = library root
  local lib="$1" root pat
  echo "  BACKUP SCOPE (what goes off-site)"
  if [[ -z "${BACKUP_INCLUDE_PATHS:-}" ]]; then
    printf '    %-34s %s\n' "include paths" "UNKNOWN -- BACKUP_INCLUDE_PATHS is not set"
    return 0
  fi
  for root in ${BACKUP_INCLUDE_PATHS:-}; do
    printf '    %-34s %s\n' "included" "$root"
  done
  while IFS= read -r pat; do
    [[ -n "$pat" ]] || continue
    printf '    %-34s %s\n' "excluded" "$pat"
  done < <(backup_exclude_patterns 2>/dev/null)

  # The replaceable tier must not be paid for off-site. State it either way.
  local media_in=1
  for root in ${BACKUP_INCLUDE_PATHS:-}; do
    case "${DOMUM_MEDIA_ROOT%/}" in
      "${root%/}"|"${root%/}"/*) media_in=0 ;;
    esac
  done
  if (( media_in == 0 )); then
    printf '    %-34s %s\n' "replaceable media tier" \
      "IN the backup set ($DOMUM_MEDIA_ROOT) -- reacquirable data is being stored off-site"
  else
    printf '    %-34s %s\n' "replaceable media tier" \
      "not in the backup set (correct: $DOMUM_MEDIA_ROOT is reacquirable)"
  fi
  local arch="$DOMUM_DATA_ROOT/backups/images" arch_n
  arch_n="$(find "$arch" -maxdepth 1 -name '*.tar' 2>/dev/null | grep -c . || true)"
  printf '    %-34s %s\n' "image archives" \
    "${arch_n:-0} in $arch$(dr_path_configured "$arch" && printf '%s' " (in the backup set)" || printf '%s' " (NOT in the backup set)")"
}

# The risks that remain, named rather than left for the reader to infer.
dr_remaining_risks() {  # $1 = target, $2 = library root
  local target="$1" lib="$2" n=0
  local cov
  cov="$(sample_coverage_file "$target")"
  echo "  REMAINING RISKS"
  if ! dr_last_dbimport "$target" >/dev/null; then
    n=$((n+1)); echo "    $n. The Immich dump has never been IMPORTED into a real PostgreSQL."
    echo "       Archive checks do not prove it can be read. Run verify-db-restore."
  fi
  if [[ ! -f "$cov" ]]; then
    n=$((n+1)); echo "    $n. No sample restore proof with a stated population exists."
  fi
  local of=0 largeok
  [[ -f "$cov" ]] && of="$(jq -r '.oversize_files // 0' "$cov" 2>/dev/null || echo 0)"
  largeok="$(dr_large_proven_count "$target")"
  if (( of > largeok )); then
    n=$((n+1)); echo "    $n. $(( of - largeok )) large original(s) have never been restore-tested."
    echo "       They are the home videos. Run verify-large to prove them a few at a time."
  fi
  if ! dr_snapshot_coverage "$target" >/dev/null; then
    n=$((n+1)); echo "    $n. No original has been RECONCILED against a real snapshot. Coverage"
    echo "       is inferred from configuration only. Run verify-snapshot-coverage;"
    echo "       it reads snapshot metadata and downloads nothing."
  else
    local scm; scm="$(awk '{print $3}' <<< "$(dr_snapshot_coverage "$target")")"
    if [[ "${scm:-0}" -gt 0 ]]; then
      n=$((n+1)); echo "    $n. $scm original(s) are NOT in the snapshot that was reconciled."
      echo "       They exist locally but are not protected off-site."
    fi
  fi
  if ! dr_last_phase_a "$target" >/dev/null; then
    n=$((n+1)); echo "    $n. No Immich has ever been started against a recovered database."
    echo "       The dump imports, but nothing shows the APPLICATION accepts the"
    echo "       schema. Run immich-phase-a; it restores ~28 MB, not the library."
  fi
  n=$((n+1)); echo "    $n. No tier is FULL RECOVERY VERIFIED: no run has restored a whole"
  echo "       tier and had Immich itself confirm it."
  if [[ "$(backup_target_names | grep -c .)" -gt 1 ]]; then
    local t enabled=0
    while read -r t; do backup_target_enabled "$t" 2>/dev/null && enabled=$((enabled+1)); done \
      < <(backup_target_names)
    if (( enabled < 2 )); then
      n=$((n+1)); echo "    $n. Only one backup target is enabled, so there is a single off-site copy."
    fi
  fi
}

# What is actually proven about recovery, per tier and per target.
#
# Read-only: it contacts no repository and restores nothing. It reports only
# what local evidence already records, which is the point -- a status command
# that had to perform a restore to answer would never be run.
do_dr_status() {
  local target targets lib worst=4 rank
  lib="${IMMICH_LIBRARY_DIR:-$DOMUM_DATA_ROOT/immich/library}"
  targets="$(backup_target_names 2>/dev/null || true)"

  echo "DISASTER RECOVERY STATUS"
  echo
  echo "Levels, weakest to strongest: UNKNOWN < CONFIGURED < BACKED UP <"
  echo "RESTORE TESTED < FULL RECOVERY VERIFIED. A level is claimed only where"
  echo "local evidence supports it; absence of evidence reports UNKNOWN."
  echo

  for target in $targets; do
    if ! backup_target_enabled "$target" 2>/dev/null; then
      echo "target: $target  (NOT ENABLED -- nothing is backed up here)"
      echo
      continue
    fi

    local run_ok run_ts="" run_snap=""
    if run_ok="$(dr_last_success_run "$target")"; then
      run_ts="${run_ok%% *}"; run_snap="${run_ok##* }"
      echo "target: $target  (last successful run $run_ts, snapshot $run_snap)"
    else
      echo "target: $target  (NO successful run is recorded)"
    fi
    echo

    # --- Immich originals: the family photo library -----------------------
    local lvl ev
    lvl=UNKNOWN; ev="no evidence"
    local cfg_rc=0
    dr_path_configured "$lib/upload" || cfg_rc=$?
    if (( cfg_rc == 2 )); then
      lvl=UNKNOWN; ev="BACKUP_INCLUDE_PATHS is not set, so coverage cannot be determined"
    elif (( cfg_rc == 1 )); then
      lvl=UNKNOWN; ev="NOT in the backup set, or matched by an exclusion"
    elif [[ -z "$run_ts" ]]; then
      lvl=CONFIGURED; ev="in the backup set; no successful run recorded"
    else
      lvl="BACKED UP"; ev="covered by snapshot $run_snap"
      local proof
      if proof="$(dr_sample_proof "$target")"; then
        # Positional, so read every field by INDEX. Taking the remainder with
        # ${proof##* } broke the moment a fourth field was appended: it silently
        # returned the large count instead, and the row claimed "0 never
        # restore-tested" for a library with 22,964 untested originals.
        local s p u
        s="$(awk '{print $1}' <<< "$proof")"
        p="$(awk '{print $2}' <<< "$proof")"
        u="$(awk '{print $3}' <<< "$proof")"
        lvl="RESTORE TESTED"
        local lg; lg="$(awk '{print $4}' <<< "$proof")"
        if [[ "${lg:-0}" -gt 0 ]]; then
          ev="$(( s + lg )) of $p original(s) proven ($s sampled + $lg large); $u never restore-tested"
        else
          ev="$s of $p original(s) restored and compared; $u never restore-tested"
        fi
      else
        ev="$ev; NO sample restore proof with a stated population"
      fi
    fi
    dr_row "immich originals" "$lvl" "$ev"
    rank="$(dr_level_rank "$lvl")"; (( rank < worst )) && worst="$rank"

    # --- Immich database --------------------------------------------------
    lvl=UNKNOWN; ev="no evidence"
    if [[ -z "$run_ts" ]]; then
      lvl=CONFIGURED; ev="dump is staged into the backup set; no successful run recorded"
    else
      lvl="BACKED UP"; ev="dump covered by snapshot $run_snap"
      local vok dbok
      # The archive checks are reported, but they do NOT promote the level:
      # gzip, size and footer prove the FILE is intact, not that PostgreSQL can
      # read it. Only an actual import earns RESTORE TESTED.
      # Each claim cites the snapshot it is ABOUT. In production the archive
      # check was two days older than the import, and the line showed neither
      # snapshot -- so two claims about different objects read as one. A proof
      # of an earlier snapshot is still a proof, but the reader has to be able
      # to see which one.
      if vok="$(dr_last_restore_verification "$target")"; then
        ev="archive validated ${vok%% *} (gzip, size, footer; snapshot ${vok##* })"
        [[ "${vok##* }" == "$run_snap" ]] || ev="$ev [not the current snapshot]"
      else
        ev="$ev; the archive has never been validated"
      fi
      if dbok="$(dr_last_dbimport "$target")"; then
        local db_snap db_assets
        db_snap="$(awk '{print $2}' <<< "$dbok")"
        db_assets="$(awk '{print $3}' <<< "$dbok")"
        lvl="RESTORE TESTED"
        ev="$ev; IMPORTED into a disposable PostgreSQL ${dbok%% *}, $db_assets asset(s), consistent (snapshot $db_snap)"
        [[ "$db_snap" == "$run_snap" ]] || ev="$ev [not the current snapshot]"
      else
        ev="$ev; NEVER imported -- archive checks do not prove PostgreSQL can read it"
      fi
    fi
    dr_row "immich database" "$lvl" "$ev"
    rank="$(dr_level_rank "$lvl")"; (( rank < worst )) && worst="$rank"

    echo
    dr_backup_scope "$lib"
    echo
    dr_immich_summary "$target" "$lib"
    echo
    dr_remaining_risks "$target" "$lib"
    echo
  done

  echo "Nothing above is FULL RECOVERY VERIFIED. That level requires restoring a"
  echo "whole tier and having the application that owns it confirm the result;"
  echo "no such run has been performed on this host."
  echo
  case "$worst" in
    0) echo "WEAKEST TIER: UNKNOWN -- recovery is not demonstrated." ; return 2 ;;
    1) echo "WEAKEST TIER: CONFIGURED -- a backup is intended but not proven." ; return 2 ;;
    2) echo "WEAKEST TIER: BACKED UP -- data is stored off-host but no restore has been tested." ; return 1 ;;
    3) echo "WEAKEST TIER: RESTORE TESTED -- a stated fraction has been proven restorable." ; return 0 ;;
    *) echo "WEAKEST TIER: FULL RECOVERY VERIFIED." ; return 0 ;;
  esac
}

# ---------------------------------------------------------------------------
# Database IMPORT verification: proving PostgreSQL can actually read the dump
# ---------------------------------------------------------------------------

# The three claims, which are not the same claim and must never be conflated:
#
#   ARCHIVE VALIDATED             the restored file is a well-formed gzip of the
#                                 expected size with an intact footer. This says
#                                 NOTHING about whether PostgreSQL can read it.
#   DATABASE IMPORT RESTORE TESTED  a disposable PostgreSQL of the production
#                                 version imported it with ON_ERROR_STOP=1, the
#                                 expected tables exist, and the data is
#                                 internally consistent.
#   FULL IMMICH RECOVERY VERIFIED  a rebuilt Immich served the restored library.
#                                 Not attempted by this command.
#
# `verify-restore` earns only the first. This command earns the second.

# The image a disposable instance must use.
#
# Read from the running production container rather than hardcoded: the dump
# declares `CREATE EXTENSION vectors WITH SCHEMA vectors`, which only the
# pgvecto-rs image provides, so a plain `postgres:14` would fail the import for
# a reason that has nothing to do with the backup. Measured: that image
# preloads vectors.so by default, so no extra configuration is needed.
dbimport_postgres_image() {
  local img
  img="$(docker inspect immich_postgres --format '{{.Config.Image}}' 2>/dev/null || true)"
  printf '%s' "${IMMICH_PG_IMAGE:-$img}"
}

dbimport_evidence_file() {
  printf '%s/%s-dbimport.env' "$(restore_verification_dir)" "$1"
}

# The checks run against the RESTORED copy. Internal consistency only: nothing
# here depends on production being reachable, because a disaster recovery proof
# that only works while the original is healthy proves nothing.
#
# Prints "<name>=<value>" lines.
dbimport_consistency_sql() {
  cat <<'SQL'
select 'tables='||count(*) from information_schema.tables
  where table_schema='public' and table_type='BASE TABLE'
union all select 'assets='||count(*) from asset
union all select 'asset_files='||count(*) from asset_file
union all select 'exif_rows='||count(*) from asset_exif
union all select 'extensions='||count(*) from pg_extension
union all select 'originals_upload='||count(*) from asset
  where "originalPath" like '%/upload/upload/%'
union all select 'originals_encoded_video='||count(*) from asset
  where "originalPath" like '%/upload/encoded-video/%'
union all select 'originals_elsewhere='||count(*) from asset
  where "originalPath" not like '%/upload/upload/%'
    and "originalPath" not like '%/upload/encoded-video/%'
union all select 'null_original_path='||count(*) from asset
  where coalesce("originalPath",'')=''
union all select 'duplicate_original_paths='||count(*) from (
  select "originalPath" from asset group by 1 having count(*)>1) d
union all select 'orphan_asset_files='||count(*) from asset_file f
  left join asset a on a.id=f."assetId" where a.id is null
union all select 'orphan_exif='||count(*) from asset_exif e
  left join asset a on a.id=e."assetId" where a.id is null
union all select 'assets_without_exif='||count(*) from asset a
  left join asset_exif e on e."assetId"=a.id where e."assetId" is null
union all select 'null_checksums='||count(*) from asset where checksum is null
SQL
}

# One fact out of the consistency output.
#
# A key the query never emitted returns the sentinel -1 rather than the empty
# string: `(( $(f missing) > 0 ))` with an empty substitution is a runtime
# syntax error, so under `set -e` a renamed check would ABORT the verification
# instead of failing it -- the metadata-key defect family again, where a key
# read but never written is silently empty.
dbimport_fact() {  # $1 = facts blob, $2 = key
  local v
  v="$(sed -nE "s/^$2=(.*)\$/\1/p" <<< "$1" | head -1)"
  [[ "$v" =~ ^-?[0-9]+$ ]] || v=-1
  printf '%s' "$v"
}

# Import the restored dump into a disposable PostgreSQL and verify it.
#
# Isolation is structural, not promised: the container runs with
# `--network none` so it cannot reach the production database even in
# principle, its PGDATA is a tmpfs that cannot outlive it, it publishes no
# port, and it is removed by a trap that also terminates on a signal. No
# production path is mounted into it.
#
# $1 = target. Exit 0 verified, 1 a check failed, 2 not attemptable.
do_verify_db_restore() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: domum-media-backup verify-db-restore <target>"
  backup_target_enabled "$target" || die "Backup target is not enabled: $target"
  cmd_exists gzip || die "gzip is required"
  cmd_exists docker || die "docker is required to run a disposable PostgreSQL"

  local image
  image="$(dbimport_postgres_image)"
  if [[ -z "$image" ]]; then
    echo "DATABASE IMPORT: NOT ATTEMPTED"
    echo "  Could not determine the PostgreSQL image. The dump requires the"
    echo "  'vectors' extension, so the disposable instance must use the same"
    echo "  image production uses; set IMMICH_PG_IMAGE to name it explicitly."
    return 2
  fi
  if ! docker image inspect "$image" >/dev/null 2>&1; then
    echo "DATABASE IMPORT: NOT ATTEMPTED"
    echo "  The image $image is not present locally. Refusing to pull during a"
    echo "  verification run: what gets tested must be what is already here."
    return 2
  fi

  local vdir scratch
  vdir="$(restore_verification_dir)"
  mkdir -p "$vdir"
  case "$vdir" in
    "${DOMUM_DATA_ROOT%/}"/*|"${DOMUM_MEDIA_ROOT%/}"/*|"${DOMUM_DATA_ROOT%/}"|"${DOMUM_MEDIA_ROOT%/}")
      die "Refusing to verify: the scratch location $vdir is inside a live data root." ;;
  esac
  scratch="$(mktemp -d "$vdir/dbimport.XXXXXX")" || die "Cannot create a scratch directory"

  local cname
  cname="domum-dbimport-$$-$(date +%s)"
  # One trap for both the scratch tree and the container, and the signal form
  # must TERMINATE: a cleanup-only trap would let execution fall through into
  # verification against a database that has just been destroyed.
  # shellcheck disable=SC2064
  trap "docker rm -f '$cname' >/dev/null 2>&1; rm -rf -- '$scratch'" EXIT
  # shellcheck disable=SC2064
  trap "docker rm -f '$cname' >/dev/null 2>&1; rm -rf -- '$scratch'; exit 143" HUP INT TERM

  local snapshot_id artifact rel
  snapshot_id="$(restic_for_target "$target" snapshots --latest 1 --json 2>/dev/null \
    | jq -r 'if length == 0 then "" else (.[-1].short_id // .[-1].id[0:8]) end' 2>/dev/null || true)"
  [[ -n "$snapshot_id" ]] || die "Could not determine the latest snapshot for $target"

  rel="$DOMUM_DATA_ROOT/immich/backup-staging/immich-postgres.dump.sql.gz"
  log "database import verification: $target snapshot $snapshot_id -> $cname (isolated)"
  if ! restic_for_target "$target" restore latest --target "$scratch" --include "$rel" \
       >/dev/null 2>&1; then
    die "Could not restore the dump from $target"
  fi
  artifact="$scratch$rel"
  [[ -s "$artifact" ]] || die "The restored dump is missing or empty at $artifact"

  local dump_bytes
  dump_bytes="$(stat -c %s "$artifact")"

  echo "[domum-media-backup] Database import verification for $target"
  echo "  snapshot      : $snapshot_id"
  echo "  dump          : $dump_bytes bytes (restored from the repository)"
  echo "  image         : $image"
  echo "  isolation     : --network none, tmpfs PGDATA, no published port, no bind mount"

  if ! docker run -d --name "$cname" \
        --network none \
        -e POSTGRES_PASSWORD="dbimport-verification-$RANDOM" \
        --tmpfs /var/lib/postgresql/data:rw,size=4g,mode=0700 \
        "$image" >/dev/null 2>&1; then
    echo "  result        : NOT ATTEMPTED -- the disposable instance did not start"
    return 2
  fi

  local ready=0 i
  for i in $(seq 1 60); do
    if docker exec "$cname" pg_isready -U postgres >/dev/null 2>&1; then ready=1; break; fi
    sleep 1
  done
  if (( ready == 0 )); then
    echo "  result        : NOT ATTEMPTED -- the disposable instance never became ready"
    return 2
  fi

  if ! docker exec "$cname" psql -U postgres -q -c 'create database immich' >/dev/null 2>&1; then
    echo "  result        : FAILED -- could not create the target database"
    return 1
  fi

  # ON_ERROR_STOP=1 is the point: without it psql reports success having skipped
  # every statement it could not run, which is exactly the false pass this
  # command exists to rule out.
  local err_file rc=0
  err_file="$scratch/import.err"
  if ! gzip -dc "$artifact" \
       | docker exec -i "$cname" psql -U postgres -d immich -q -v ON_ERROR_STOP=1 \
         >/dev/null 2>"$err_file"; then
    echo "  import        : FAILED"
    echo "  first errors  :"
    head -5 "$err_file" 2>/dev/null | sed 's/^/    /'
    record_dbimport_result "$target" failure "$snapshot_id" "$dump_bytes" "$image" "" \
      "psql exited non-zero under ON_ERROR_STOP=1"
    return 1
  fi
  local err_lines
  err_lines="$(grep -c . "$err_file" 2>/dev/null || true)"
  echo "  import        : COMPLETED under ON_ERROR_STOP=1 (${err_lines:-0} stderr line(s))"

  local facts
  facts="$(dbimport_consistency_sql \
    | docker exec -i "$cname" psql -U postgres -d immich -At 2>/dev/null || true)"
  [[ -n "$facts" ]] || { echo "  result        : FAILED -- the restored database answered nothing"; return 1; }

  local k v assets=0 tables=0
  echo "  verified      :"
  while IFS='=' read -r k v; do
    [[ -n "$k" ]] || continue
    printf '    %-26s %s\n' "$k" "$v"
    case "$k" in assets) assets="$v" ;; tables) tables="$v" ;; esac
  done <<< "$facts"

  # What must be true, stated as checks rather than left to the reader. A
  # sentinel of -1 (the key was not emitted at all) fails every one of these,
  # which is the intended direction: a check that cannot find its input is not
  # a check that passed.
  local problem=""
  (( $(dbimport_fact "$facts" assets) > 0 ))                    || problem="the restored database has no assets"
  (( $(dbimport_fact "$facts" tables) > 0 ))                    || problem="no tables were created"
  (( $(dbimport_fact "$facts" orphan_asset_files) == 0 ))       || problem="orphaned asset_file rows"
  (( $(dbimport_fact "$facts" orphan_exif) == 0 ))              || problem="orphaned exif rows"
  (( $(dbimport_fact "$facts" assets_without_exif) == 0 ))      || problem="assets with no exif row"
  (( $(dbimport_fact "$facts" null_original_path) == 0 ))       || problem="assets with no originalPath"
  (( $(dbimport_fact "$facts" duplicate_original_paths) == 0 )) || problem="two assets share an originalPath"
  (( $(dbimport_fact "$facts" originals_elsewhere) == 0 ))      || problem="originals outside upload/ and encoded-video/"
  (( $(dbimport_fact "$facts" null_checksums) == 0 ))           || problem="assets with no checksum"
  (( $(dbimport_fact "$facts" extensions) > 0 ))                || problem="no extensions were restored"

  if [[ -n "$problem" ]]; then
    echo "  result        : FAILED -- $problem"
    record_dbimport_result "$target" failure "$snapshot_id" "$dump_bytes" "$image" "$assets" "$problem"
    rc=1
  else
    echo "  result        : DATABASE IMPORT RESTORE TESTED"
    echo "                  $assets asset(s) imported into $tables table(s), internally consistent."
    record_dbimport_result "$target" success "$snapshot_id" "$dump_bytes" "$image" "$assets" ""
  fi

  echo
  echo "  This proves PostgreSQL can READ the backup and that the restored rows"
  echo "  are self-consistent. It does NOT prove a rebuilt Immich can serve the"
  echo "  library: that is FULL IMMICH RECOVERY VERIFIED and has not been done."
  echo "  The disposable instance and the restored dump are now removed."
  return "$rc"
}

record_dbimport_result() {
  local target="$1" result="$2" snap="$3" bytes="$4" image="$5" assets="$6" reason="${7:-}"
  local dir file tmp now prev_ok_ts="" prev_ok_snap=""
  dir="$(restore_verification_dir)"
  mkdir -p "$dir"
  file="$(dbimport_evidence_file "$target")"
  now="$(date -Iseconds)"
  # A later failure must never erase when the import last genuinely succeeded.
  if [[ -f "$file" ]]; then
    eval "$(
      unset RESULT VERIFIED_TS SNAPSHOT_ID LAST_SUCCESS_TS LAST_SUCCESS_SNAPSHOT_ID
      # shellcheck disable=SC1090
      . "$file" >/dev/null 2>&1 || true
      if [[ "${RESULT:-}" == "success" ]]; then
        printf 'prev_ok_ts=%q\nprev_ok_snap=%q\n' "${VERIFIED_TS:-}" "${SNAPSHOT_ID:-}"
      else
        printf 'prev_ok_ts=%q\nprev_ok_snap=%q\n' "${LAST_SUCCESS_TS:-}" "${LAST_SUCCESS_SNAPSHOT_ID:-}"
      fi
    )"
  fi
  local ok_ts ok_snap
  if [[ "$result" == "success" ]]; then ok_ts="$now"; ok_snap="$snap"
  else ok_ts="$prev_ok_ts"; ok_snap="$prev_ok_snap"; fi

  tmp="$(mktemp "$dir/.${target}-dbimport.env.XXXXXX")" || return 1
  {
    printf 'SCHEMA_VERSION=1\n'
    printf 'TARGET=%s\n' "$target"
    printf 'RESULT=%s\n' "$result"
    printf 'VERIFIED_TS=%s\n' "$now"
    printf 'LAST_SUCCESS_TS=%s\n' "$ok_ts"
    printf 'LAST_SUCCESS_SNAPSHOT_ID=%s\n' "$ok_snap"
    printf 'SNAPSHOT_ID=%s\n' "$snap"
    printf 'DUMP_BYTES=%s\n' "$bytes"
    printf 'PG_IMAGE=%s\n' "$image"
    printf 'ASSETS_IMPORTED=%s\n' "${assets:-0}"
    printf 'REASON=%s\n' "$reason"
  } > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 0600 "$tmp"
  mv -f "$tmp" "$file"
}

# ---------------------------------------------------------------------------
# Progressive verification of the LARGE originals
# ---------------------------------------------------------------------------

# The files the ordinary sample can never reach.
#
# Measured on this host: 17 originals exceed the 256 MiB per-file cap, totalling
# 7.9 GiB -- 15 .mov and 2 .mp4, from 274 MB to 1.38 GB. They are the home
# videos, i.e. the least replaceable things in the library and the least
# represented by a sample of photos.
#
# Raising the cap is the wrong fix: it would pull 7.9 GiB from Hetzner on every
# run to move a percentage. Instead this verifies a FEW of them per run, keeps a
# durable record of which have been proven, and never downloads a file twice
# unless asked. Coverage accumulates across runs instead of being re-bought.
LARGE_DEFAULT_COUNT="${LARGE_DEFAULT_COUNT:-2}"
# A hard ceiling on what ONE run may fetch. The point is accumulating coverage
# cheaply, not buying a percentage: the largest single original here is 1.38 GB,
# so an unbounded "verify 3" would pull 2.2 GiB. A run stops adding files once
# the budget is reached and says what it deferred.
LARGE_MAX_RUN_BYTES="${LARGE_MAX_RUN_BYTES:-1073741824}"  # 1 GiB

large_history_file() {
  printf '%s/%s-large-verified.jsonl' "$(restore_verification_dir)" "$1"
}

# Paths already proven, one per line. Absent history is not an error: it means
# nothing has been verified yet, which is the honest starting point.
# Paths already proven, one per line -- and only while the proof still
# describes the file that is there now.
#
# A recorded proof is about the BYTES that existed when it was taken. If the
# local file has since been replaced or truncated, the old proof says nothing
# about the new content, so the path must drop out of the proven set and be
# re-verified. Size is the cheap discriminator: re-hashing 6.5 GiB of home
# videos on every run to detect a change that has never happened would cost
# more than the verification it guards. Stated plainly rather than overclaimed
# -- this catches replacement and truncation, not a same-size edit.
large_verified_paths() {  # $1 = target
  local f; f="$(large_history_file "$1")"
  [[ -f "$f" ]] || return 0
  jq -r 'select(.result == "match") | [.path, (.size_bytes|tostring)] | @tsv' "$f" 2>/dev/null \
    | sort -u \
    | while IFS=$'\t' read -r path recorded; do
        [[ -n "$path" ]] || continue
        local now
        now="$(stat -c %s "$path" 2>/dev/null || true)"
        # A file that has vanished is not proven either: there is nothing left
        # for the proof to be about.
        [[ -n "$now" && "$now" == "$recorded" ]] && printf '%s\n' "$path"
      done
}

# Proofs that no longer describe the file on disk, so coverage must not count
# them. Printed so an invalidation is visible rather than silently reducing a
# number the operator saw last week.
large_invalidated_paths() {  # $1 = target
  local f; f="$(large_history_file "$1")"
  [[ -f "$f" ]] || return 0
  jq -r 'select(.result == "match") | [.path, (.size_bytes|tostring)] | @tsv' "$f" 2>/dev/null \
    | sort -u \
    | while IFS=$'\t' read -r path recorded; do
        [[ -n "$path" ]] || continue
        local now
        now="$(stat -c %s "$path" 2>/dev/null || true)"
        if [[ -z "$now" ]]; then
          printf '%s\tgone\n' "$path"
        elif [[ "$now" != "$recorded" ]]; then
          printf '%s\t%s bytes now, %s when proven\n' "$path" "$now" "$recorded"
        fi
      done
}

# The over-cap population, as "<size>\t<path>".
large_population() {  # $1 = inventory file
  inventory_usable "${1:-}" || return 1
  awk -F'\t' -v cap="$SAMPLE_MAX_FILE_BYTES" '$1 > cap' "$1" \
    | sort -t"$(printf '\t')" -k2,2
}

# Which large originals to verify next.
#
# Unverified first, and diverse by container format before size, so the second
# run does not simply fetch the next-largest .mov again. Deterministic: the same
# history and inventory always choose the same files.
large_select() {  # $1 = inventory, $2 = already-verified list file, $3 = count
  local inv="$1" done_file="$2" want="$3"
  large_population "$inv" \
    | awk -F'\t' -v dfile="$done_file" '
        BEGIN { while ((getline line < dfile) > 0) proven[line]=1 }
        !($2 in proven)' \
    | awk -F'\t' '
        {
          size[NR]=$1; path[NR]=$2
          base=$2; sub(/.*\//, "", base)
          ext = (base ~ /\./) ? tolower(base) : "none"
          if (ext != "none") sub(/.*\./, "", ext)
          n[ext]++; if (n[ext] == 1 || size[NR] < size[best[ext]]) best[ext]=NR
        }
        END {
          m=0; for (e in best) exts[++m]=e
          for (i=1; i<=m; i++) for (j=i+1; j<=m; j++)
            if (exts[j] < exts[i]) { t=exts[i]; exts[i]=exts[j]; exts[j]=t }
          picked=0
          for (i=1; i<=m; i++) { r=best[exts[i]]; if (!(r in chosen)) { chosen[r]=1; order[++picked]=r } }
          # then the rest smallest-first, so coverage grows per byte spent
          for (;;) {
            cand=0
            for (r=1; r<=NR; r++)
              if (!(r in chosen) && (cand==0 || size[r] < size[cand])) cand=r
            if (cand==0) break
            chosen[cand]=1; order[++picked]=cand
          }
          for (i=1; i<=picked; i++) printf "%s\t%s\n", size[order[i]], path[order[i]]
        }' \
    | head -n "$want"
}

# Verify a few of the large originals, or say exactly what it would cost.
#
# $1 = target, $2 = count, remaining args: --plan, --revalidate
do_verify_large() {
  local target="${1:-}" want="" plan=0 reval=0 a
  shift || true
  for a in "$@"; do
    case "$a" in
      --plan)       plan=1 ;;
      --revalidate) reval=1 ;;
      ''|*[!0-9]*)  [[ -n "$a" ]] && die "Unknown argument: $a" ;;
      *)            want="$a" ;;
    esac
  done
  want="${want:-$LARGE_DEFAULT_COUNT}"
  [[ -n "$target" ]] || die "Usage: domum-media-backup verify-large <target> [count] [--plan] [--revalidate]"
  (( plan == 1 )) || backup_target_enabled "$target" \
    || die "Backup target is not enabled: $target"
  [[ "$want" =~ ^[0-9]+$ ]] && (( want > 0 )) || die "Count must be a positive integer"

  local lib vdir inv counts n_orig n_missing
  lib="${IMMICH_LIBRARY_DIR:-$DOMUM_DATA_ROOT/immich/library}"
  [[ -d "$lib" ]] || die "Immich library not found at $lib"
  vdir="$(restore_verification_dir)"
  mkdir -p "$vdir"
  case "$vdir" in
    "${DOMUM_DATA_ROOT%/}"/*|"${DOMUM_MEDIA_ROOT%/}"/*|"${DOMUM_DATA_ROOT%/}"|"${DOMUM_MEDIA_ROOT%/}")
      die "Refusing: the scratch location $vdir is inside a live data root." ;;
  esac

  inv="$(mktemp "$vdir/.large-inv.XXXXXX")" || die "Cannot stage the inventory"
  local done_file; done_file="$(mktemp "$vdir/.large-done.XXXXXX")" || die "Cannot stage the history"
  # shellcheck disable=SC2064
  trap "rm -f -- '$inv' '$done_file'" EXIT
  # shellcheck disable=SC2064
  trap "rm -f -- '$inv' '$done_file'; exit 143" HUP INT TERM

  counts="$(immich_original_inventory "$inv")" \
    || die "Refusing: the Immich asset table could not be read, and it is the only
authority for which files are originals."
  read -r n_orig n_missing <<< "$counts"

  if (( reval == 1 )); then : > "$done_file"; else large_verified_paths "$target" > "$done_file"; fi

  local pop_files pop_bytes done_n done_bytes
  pop_files="$(large_population "$inv" | grep -c . || true)"
  pop_bytes="$(large_population "$inv" | awk -F'\t' '{b+=$1} END{print b+0}')"
  done_n="$(grep -c . < "$done_file" || true)"
  done_bytes="$(large_population "$inv" \
    | awk -F'\t' -v dfile="$done_file" '
        BEGIN { while ((getline line < dfile) > 0) proven[line]=1 }
        ($2 in proven) { b+=$1 }
        END { print b+0 }')"

  echo "[domum-media-backup] Large-original verification for $target"
  echo "  originals        : $n_orig (asset table); $pop_files exceed the $(sample_human_bytes "$SAMPLE_MAX_FILE_BYTES") per-file sample cap"
  echo "  large population : $pop_files file(s), $(sample_human_bytes "$pop_bytes")"
  echo "  already proven   : $done_n file(s), $(sample_human_bytes "${done_bytes:-0}")"
  local inval
  inval="$(large_invalidated_paths "$target")"
  if [[ -n "$inval" ]]; then
    echo "  proof INVALIDATED: $(grep -c . <<< "$inval") file(s) changed since they were proven"
    printf '%s\n' "$inval" | head -5 | sed "s|^$lib/|    |" | sed 's/\t/  -- /'
    echo "                     These are back in the unproven set."
  fi
  # What finishing the set would cost, so the decision is informed rather than
  # discovered one run at a time.
  local rem_files rem_bytes rem_runs
  rem_files=$(( pop_files - done_n ))
  rem_bytes=$(( pop_bytes - ${done_bytes:-0} ))
  if (( rem_files > 0 )); then
    rem_runs=$(( (rem_bytes + LARGE_MAX_RUN_BYTES - 1) / LARGE_MAX_RUN_BYTES ))
    echo "  still to prove   : $rem_files file(s), $(sample_human_bytes "$rem_bytes") -- about"
    echo "                     $rem_runs more run(s) at the $(sample_human_bytes "$LARGE_MAX_RUN_BYTES") per-run budget"
  fi

  if (( pop_files == 0 )); then
    echo "  nothing to do    : no original exceeds the per-file cap"
    return 0
  fi

  local -a paths=() sizes=()
  local size path total=0 deferred=0 deferred_bytes=0
  while IFS=$'\t' read -r size path; do
    [[ -n "$path" ]] || continue
    # Always allow the first file, or a budget smaller than one original would
    # make the command unable to make any progress at all.
    if (( ${#paths[@]} > 0 && total + size > LARGE_MAX_RUN_BYTES )); then
      deferred=$(( deferred + 1 )); deferred_bytes=$(( deferred_bytes + size )); continue
    fi
    paths+=("$path"); sizes+=("$size"); total=$(( total + size ))
  done < <(large_select "$inv" "$done_file" "$want")

  if (( ${#paths[@]} == 0 )); then
    echo "  this run         : nothing left to verify -- every large original is proven"
    echo "                     Use --revalidate to prove them again."
    return 0
  fi

  echo "  this run         : ${#paths[@]} file(s), $(sample_human_bytes "$total") to download"
  if (( deferred > 0 )); then
    echo "  deferred         : $deferred file(s), $(sample_human_bytes "$deferred_bytes") -- over the"
    echo "                     $(sample_human_bytes "$LARGE_MAX_RUN_BYTES") per-run budget. Raise LARGE_MAX_RUN_BYTES to include them."
  fi
  local i ext
  for i in "${!paths[@]}"; do
    ext="${paths[$i]##*/}"; ext="${ext##*.}"; ext="${ext,,}"
    printf '    %-6s %14s  %s\n' "$ext" "${sizes[$i]}" "${paths[$i]#"$lib"/}"
  done

  if (( plan == 1 )); then
    echo
    echo "  This is a PLAN. Nothing was restored, nothing was contacted, and no"
    echo "  evidence was recorded. Bytes above are what a real run would fetch."
    return 0
  fi

  local snapshot_id scratch
  snapshot_id="$(restic_for_target "$target" snapshots --latest 1 --json 2>/dev/null \
    | jq -r 'if length == 0 then "" else (.[-1].short_id // .[-1].id[0:8]) end' 2>/dev/null || true)"
  [[ -n "$snapshot_id" ]] || die "Could not determine the latest snapshot for $target"

  scratch="$(mktemp -d "$vdir/large.XXXXXX")" || die "Cannot create a scratch directory"
  # shellcheck disable=SC2064
  trap "rm -rf -- '$scratch'; rm -f -- '$inv' '$done_file'" EXIT
  # shellcheck disable=SC2064
  trap "rm -rf -- '$scratch'; rm -f -- '$inv' '$done_file'; exit 143" HUP INT TERM

  local -a include_args=()
  for path in "${paths[@]}"; do include_args+=(--include "$path"); done
  log "large verification: $target snapshot $snapshot_id, ${#paths[@]} file(s), $total bytes"
  if ! restic_for_target "$target" restore latest --target "$scratch" "${include_args[@]}" \
       >/dev/null 2>&1; then
    die "Large-original restore failed for $target"
  fi

  local hist tmp ok=0 bad=0 src dst verdict added=0
  hist="$(large_history_file "$target")"
  tmp="$(mktemp "${hist}.XXXXXX")" || die "Cannot stage the history"
  [[ -f "$hist" ]] && cat "$hist" >> "$tmp"
  echo
  for i in "${!paths[@]}"; do
    path="${paths[$i]}"; size="${sizes[$i]}"
    src="$(sha256sum "$path" 2>/dev/null | cut -d' ' -f1)"
    dst="$(sha256sum "$scratch$path" 2>/dev/null | cut -d' ' -f1)"
    if [[ -n "$src" && "$src" == "$dst" ]]; then
      verdict=match; ok=$(( ok + 1 )); added=$(( added + size ))
    else
      verdict=MISMATCH; bad=$(( bad + 1 ))
    fi
    ext="${path##*/}"; ext="${ext##*.}"; ext="${ext,,}"
    jq -cn --arg t "$target" --arg s "$snapshot_id" --arg p "$path" --arg e "$ext" \
      --argjson b "$size" --arg sh "${src:-}" --arg dh "${dst:-}" --arg v "$verdict" \
      --arg ts "$(date -Iseconds)" \
      '{target:$t,snapshot_id:$s,path:$p,media_type:$e,size_bytes:$b,
        source_sha256:($sh|select(length>0)),restored_sha256:($dh|select(length>0)),
        result:$v,verified_at:$ts}' >> "$tmp"
    printf '  %-9s %-6s %14s  %s\n' "$verdict" "$ext" "$size" "${path#"$lib"/}"
  done
  chmod 0600 "$tmp"; mv -f "$tmp" "$hist"

  local now_n now_bytes
  now_n=$(( done_n + ok ))
  now_bytes=$(( ${done_bytes:-0} + added ))
  echo
  echo "  verified now     : $ok matched, $bad mismatched"
  echo "  cumulative       : $now_n of $pop_files large original(s), $(sample_human_bytes "$now_bytes") of $(sample_human_bytes "$pop_bytes")"
  echo "  history          : $hist"
  if (( bad > 0 )); then
    echo "  result           : FAILED -- a large original did not match the backup"
    return 1
  fi
  if (( now_n < pop_files )); then
    echo "  result           : $(( pop_files - now_n )) large original(s) still unproven; run again to continue"
  else
    echo "  result           : every large original has now been proven restorable"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Snapshot coverage: is every original actually IN the off-site snapshot?
# ---------------------------------------------------------------------------

# Four claims about an original, which are not the same claim:
#
#   1 LOCAL           the file the asset table names exists on this host
#   2 IN SNAPSHOT     that path is present in an off-site restic snapshot
#   3 RESTORE TESTED  it was restored from that snapshot and compared byte-wise
#   4 APP USABLE      a recovered Immich served it
#
# Claim 2 was never checked. It was INFERRED from "the library is under the
# backup root and no exclusion matches it", which is an argument about
# configuration, not an observation of the repository. `restic ls` reads a
# snapshot's tree metadata and downloads no file content, so claim 2 can be
# established for all 23,033 originals cheaply -- which is why this does not
# need a 130 GiB restore.

snapshot_coverage_file() {
  printf '%s/%s-snapshot-coverage.json' "$(restore_verification_dir)" "$1"
}

# Every path in a snapshot, one per line, absolute.
#
# `restic ls` prints a human header and then paths; the paths are the lines
# starting with "/". Directories are listed too and are harmless here, because
# we only ever ask whether a specific FILE path is present.
snapshot_path_listing() {  # $1 = target, $2 = snapshot id, $3 = output file
  restic_for_target "$1" ls "$2" 2>/dev/null | grep '^/' > "$3" || true
  [[ -s "$3" ]] || return 1
  return 0
}

# Reconcile the asset table against a real snapshot.
#
# Exit 0 every original is present, 1 at least one is MISSING, 2 the question
# could not be answered. Fails closed: an empty or unobtainable listing is
# never read as "nothing missing".
do_verify_snapshot_coverage() {
  local target="${1:-}" want_json=0 a
  shift || true
  for a in "$@"; do
    case "$a" in
      --json) want_json=1 ;;
      *) [[ -n "$a" ]] && die "Unknown argument: $a" ;;
    esac
  done
  [[ -n "$target" ]] || die "Usage: domum-media-backup verify-snapshot-coverage <target> [--json]"
  backup_target_enabled "$target" || die "Backup target is not enabled: $target"

  local lib vdir inv listing missing counts n_orig n_absent snapshot_id
  lib="${IMMICH_LIBRARY_DIR:-$DOMUM_DATA_ROOT/immich/library}"
  vdir="$(restore_verification_dir)"
  mkdir -p "$vdir"
  inv="$(mktemp "$vdir/.cov-inv.XXXXXX")" || die "Cannot stage the inventory"
  listing="$(mktemp "$vdir/.cov-ls.XXXXXX")" || die "Cannot stage the listing"
  missing="$(mktemp "$vdir/.cov-missing.XXXXXX")" || die "Cannot stage the comparison"
  # shellcheck disable=SC2064
  trap "rm -f -- '$inv' '$listing' '$missing'" EXIT
  # shellcheck disable=SC2064
  trap "rm -f -- '$inv' '$listing' '$missing'; exit 143" HUP INT TERM

  counts="$(immich_original_inventory "$inv")" \
    || die "Refusing: the Immich asset table could not be read, and it is the only
authority for which files are originals."
  read -r n_orig n_absent <<< "$counts"

  snapshot_id="$(restic_for_target "$target" snapshots --latest 1 --json 2>/dev/null \
    | jq -r 'if length == 0 then "" else (.[-1].short_id // .[-1].id[0:8]) end' 2>/dev/null || true)"
  if [[ -z "$snapshot_id" ]]; then
    (( want_json == 1 )) && printf '{"target":"%s","result":"unknown","reason":"no snapshot"}\n' "$target"
    echo "SNAPSHOT COVERAGE: UNKNOWN -- no snapshot could be identified for $target"
    return 2
  fi

  if ! snapshot_path_listing "$target" "$snapshot_id" "$listing"; then
    (( want_json == 1 )) && printf '{"target":"%s","snapshot_id":"%s","result":"unknown","reason":"listing failed"}\n' \
      "$target" "$snapshot_id"
    echo "SNAPSHOT COVERAGE: UNKNOWN -- the snapshot's file list could not be read."
    echo "  Not treated as a pass: an unobtainable listing proves nothing."
    return 2
  fi

  # Set comparison on sorted files: cheap over 23k vs 64k paths.
  local sorted_inv sorted_ls n_listed n_missing n_present
  sorted_inv="$(mktemp "$vdir/.cov-a.XXXXXX")"; sorted_ls="$(mktemp "$vdir/.cov-b.XXXXXX")"
  # shellcheck disable=SC2064
  trap "rm -f -- '$inv' '$listing' '$missing' '$sorted_inv' '$sorted_ls'" EXIT
  cut -f2 "$inv" | LC_ALL=C sort -u > "$sorted_inv"
  LC_ALL=C sort -u "$listing" > "$sorted_ls"
  n_listed="$(grep -c . < "$sorted_ls" || true)"
  LC_ALL=C comm -23 "$sorted_inv" "$sorted_ls" > "$missing"
  n_missing="$(grep -c . < "$missing" || true)"
  n_present=$(( n_orig - n_missing ))

  # A listing that contains no library path at all means the comparison was
  # against the wrong thing -- the vacuity guard, in the place where "0 missing"
  # would otherwise be the most reassuring possible answer.
  local n_lib_paths
  n_lib_paths="$(grep -c "^${lib}/" "$sorted_ls" || true)"
  if [[ "${n_lib_paths:-0}" -eq 0 ]]; then
    (( want_json == 1 )) && printf '{"target":"%s","snapshot_id":"%s","result":"unknown","reason":"no library paths in listing"}\n' \
      "$target" "$snapshot_id"
    echo "SNAPSHOT COVERAGE: UNKNOWN -- the snapshot listing contains no path under"
    echo "  $lib, so the comparison had nothing to match against. Not a pass."
    return 2
  fi

  if (( want_json == 1 )); then
    jq -cn --arg t "$target" --arg s "$snapshot_id" --arg lib "$lib" \
      --argjson orig "$n_orig" --argjson present "$n_present" \
      --argjson miss "$n_missing" --argjson listed "${n_listed:-0}" \
      --arg res "$([[ "$n_missing" -eq 0 ]] && echo covered || echo incomplete)" \
      '{target:$t,snapshot_id:$s,library:$lib,originals:$orig,
        in_snapshot:$present,missing_from_snapshot:$miss,
        snapshot_paths:$listed,result:$res}'
  fi

  echo "[domum-media-backup] Snapshot coverage for $target"
  echo "  snapshot          : $snapshot_id"
  echo "  originals         : $n_orig (from the Immich asset table)"
  echo "  paths in snapshot : $n_listed"
  echo "  IN the snapshot   : $n_present of $n_orig"
  if (( n_absent > 0 )); then
    echo "  absent on disk    : $n_absent original(s) the table names are not on this host"
  fi

  # Record the proof so dr-status can report claim 2 without re-listing.
  local cov_file
  cov_file="$(snapshot_coverage_file "$target")"
  if jq -cn --arg t "$target" --arg s "$snapshot_id" --arg ts "$(date -Iseconds)" \
       --argjson orig "$n_orig" --argjson present "$n_present" --argjson miss "$n_missing" \
       --argjson listed "${n_listed:-0}" \
       '{target:$t,snapshot_id:$s,recorded_at:$ts,originals:$orig,
         in_snapshot:$present,missing_from_snapshot:$miss,snapshot_paths:$listed}' \
       > "$cov_file.tmp" 2>/dev/null; then
    chmod 0600 "$cov_file.tmp"; mv -f "$cov_file.tmp" "$cov_file"
    echo "  evidence          : $cov_file"
  else
    rm -f "$cov_file.tmp"
    echo "  evidence          : NOT RECORDED -- could not write $cov_file"
  fi

  if (( n_missing > 0 )); then
    echo
    echo "  MISSING FROM THE SNAPSHOT: $n_missing original(s)."
    echo "  These exist in the asset table but their path is not in the snapshot,"
    echo "  so they are NOT protected off-site:"
    sed "s|^$lib/||" "$missing" | head -20 | sed 's/^/    /'
    (( n_missing > 20 )) && echo "    ... and $(( n_missing - 20 )) more"
    echo
    echo "  result            : INCOMPLETE -- off-site coverage is not total."
    return 1
  fi

  echo "  result            : every original the asset table names is present in"
  echo "                      snapshot $snapshot_id. That is claim 2 of 4 --"
  echo "                      PRESENT off-site, not yet restored or proven usable."
  return 0
}

# ---------------------------------------------------------------------------
# Immich PHASE B: does the recovered application SERVE recovered media?
# ---------------------------------------------------------------------------

# Phase A proved the application opens the database. It served no file, so it
# said nothing about the library. Phase B restores a small, representative set
# of ORIGINALS from the snapshot and asks the application for them through its
# own API, comparing the returned bytes with the restored file.
#
# The claim it can earn is narrow and says its own denominator:
#
#   REPRESENTATIVE RECOVERY VERIFIED (n of 23033)
#
# It is NOT full recovery. A subset that serves proves the PATH from repository
# to application works for those media types; it cannot speak for 23,033 files.
#
# Two distinctions the report keeps, because conflating them would overstate it:
#
#   /api/assets/<id>/original   returns the stored file. Its bytes may be
#                               compared to the restored original by hash.
#   /api/assets/<id>/thumbnail  returns a GENERATED preview. It is fetched to
#                               show the application is functional, and its
#                               bytes are NEVER claimed to match an original.
PHASEB_MAX_BYTES="${PHASEB_MAX_BYTES:-268435456}"   # 256 MiB per run

# One representative asset per category, chosen from the RESTORED database.
#
# Smallest-first within each category, because the point is coverage of media
# types and of the live-photo relationship, not volume. Emitted as
# "<category>|<asset id>|<container path>|<bytes>".
#
# The live-photo pair is selected as a pair: an image and the hidden video its
# livePhotoVideoId points at. Measured on this library, 7,432 images link to
# 7,428 distinct hidden videos, so 4 videos are shared by two images each --
# the relationship is not 1:1 and a query assuming it would be wrong.
phaseb_selection_sql() {  # $1 = owner id to scope to
  # Each UNION branch is PARENTHESISED. Without that, PostgreSQL applies the
  # ORDER BY/LIMIT to the whole union and the statement is a syntax error --
  # which the first version was, and the tool reported only "no representative
  # asset could be selected" because it swallowed stderr. The error is now
  # surfaced by the caller.
  # Scoped to ONE owner, deliberately. Immich enforces per-user ownership, so
  # asking the admin's session for another user's asset returns nothing -- that
  # is correct authorization, not a recovery failure. The first rehearsal
  # selected a PNG belonging to the non-admin user and reported
  # a failed fetch, which looked like a serving defect and was not.
  cat <<SQL
with sized as (
  select a.id, a."originalPath", a.type, a.visibility,
         lower(regexp_replace(a."originalPath", '.*\\.', '')) as ext,
         coalesce(e."fileSizeInByte", 0) as bytes
  from asset a left join asset_exif e on e."assetId" = a.id
  where coalesce(e."fileSizeInByte", 0) > 0
    and a."ownerId" = '$1'
)
(select 'photo jpeg|'     || id || '|' || "originalPath" || '|' || bytes from sized where ext in ('jpeg','jpg') and type='IMAGE' order by bytes limit 1)
union all
(select 'photo heic|'     || id || '|' || "originalPath" || '|' || bytes from sized where ext='heic' and type='IMAGE' order by bytes limit 1)
union all
(select 'photo png|'      || id || '|' || "originalPath" || '|' || bytes from sized where ext='png'  and type='IMAGE' order by bytes limit 1)
union all
(select 'photo raw|'      || id || '|' || "originalPath" || '|' || bytes from sized where ext in ('dng','cr2') and type='IMAGE' order by bytes limit 1)
union all
(select 'video ordinary|' || id || '|' || "originalPath" || '|' || bytes from sized where type='VIDEO' and visibility='timeline' order by bytes limit 1)
union all
(select 'video larger|'   || id || '|' || "originalPath" || '|' || bytes from sized where type='VIDEO' and visibility='timeline' and bytes > 20971520 order by bytes limit 1)
union all
(select 'livephoto image|' || i.id || '|' || i."originalPath" || '|' || coalesce(ei."fileSizeInByte",0)
  from asset i join asset v on v.id = i."livePhotoVideoId"
  left join asset_exif ei on ei."assetId" = i.id
  left join asset_exif ev on ev."assetId" = v.id
  where i."livePhotoVideoId" is not null and i."ownerId" = '$1'
  order by coalesce(ei."fileSizeInByte",0) + coalesce(ev."fileSizeInByte",0) limit 1)
SQL
}

# The hidden video belonging to the chosen live-photo image.
phaseb_livephoto_video_sql() {  # $1 = image asset id
  printf "select 'livephoto video|' || v.id || '|' || v.\"originalPath\" || '|' || coalesce(e.\"fileSizeInByte\",0) from asset i join asset v on v.id = i.\"livePhotoVideoId\" left join asset_exif e on e.\"assetId\"=v.id where i.id = '%s'" "$1"
}

# Fetch one asset through the API and compare with the restored file.
#
# Prints "<verdict> [detail]". That string is this function's RETURN VALUE --
# the caller captures it -- so the verdict words are drawn from the same
# vocabulary as the rest of the file (match / MISMATCH / NO-RESPONSE /
# NO-LOCAL-FILE) and never from the LOGGING vocabulary. `ERROR no-response`
# was the first form, and `tests/captured-stdout-purity-smoke.sh` rightly
# rejected it: WARN and ERROR on a captured function's stdout are
# indistinguishable from the log-line contamination that audit exists to catch,
# and the prefix said nothing `no-response` did not already say.
#
# The ORIGINAL endpoint is the only one whose bytes are compared; a mismatch
# there is a failure, not a note.
phaseb_fetch_and_compare() {  # $1=container $2=token $3=asset id $4=local file
  local c="$1" tok="$2" id="$3" local_file="$4"
  local want got
  want="$(sha256sum "$local_file" 2>/dev/null | cut -d' ' -f1)"
  [[ -n "$want" ]] || { printf 'NO-LOCAL-FILE'; return 1; }
  got="$(docker exec "$c" sh -lc \
    "curl -sf -m 120 -H 'Authorization: Bearer $tok' \
      'http://127.0.0.1:2283/api/assets/$id/original' | sha256sum | cut -d' ' -f1" 2>/dev/null || true)"
  if [[ -z "$got" || "$got" == "$(printf '' | sha256sum | cut -d' ' -f1)" ]]; then
    printf 'NO-RESPONSE'; return 1
  fi
  if [[ "$got" == "$want" ]]; then printf 'match %s' "${want:0:12}"; return 0; fi
  printf 'MISMATCH local=%s served=%s' "${want:0:12}" "${got:0:12}"
  return 1
}

# ---------------------------------------------------------------------------
# Immich PHASE A: can a fresh application open a recovered database?
# ---------------------------------------------------------------------------

# This answers the one question the PostgreSQL import cannot. The import proves
# PostgreSQL can READ the dump; it says nothing about whether Immich will mount
# the schema, because Immich checks its own schema version and runs migrations
# on startup. A database PostgreSQL accepts is not necessarily one Immich will
# open.
#
# What Phase A establishes, and the name is deliberately narrow:
#
#   APPLICATION STARTUP VERIFIED  a fresh Immich of the production version
#                                 started against the restored database,
#                                 migrated it, and served its own API over the
#                                 recovered users and asset records.
#
# What it does NOT establish: that the library can be served. The originals are
# not restored here -- that is ~130 GiB and a separate, approved exercise. Never
# report this as FULL RECOVERY VERIFIED.
#
# Isolation is structural rather than promised:
#
#   * images are pinned by ID, read from the RUNNING production containers. The
#     tag is `:release`, which is mutable, and the running image's RepoDigest
#     equals its image ID here -- so it is effectively identity,local and a tag
#     could silently test a different application than production runs.
#   * an INTERNAL docker network. Measured: container-to-container DNS works and
#     the internet is unreachable (curl returns 000), so a disposable Immich
#     cannot send mail, reach an integration, or ping for versions. That is the
#     only honest way to satisfy "no external side effects" -- configuration
#     lives in the restored database and may well have SMTP set up.
#   * unique container and network names, refused on any collision.
#   * tmpfs PGDATA and a scratch upload directory; no production path is mounted
#     at all, read-only or otherwise.
#   * no published port. The API is exercised from inside the container.
#
# Only the variables production itself sets are passed, plus a disposable
# JWT_SECRET. Speculative "make it quieter" variables are NOT set: the first
# rehearsal added IMMICH_TELEMETRY_INCLUDE=none and Immich refused to boot with
# `Error: Invalid telemetry found: none`, because that variable is real and
# validated. An unknown variable is ignored; a known one with a wrong value is
# fatal. The internal network is what actually prevents egress, so nothing is
# gained by guessing at feature switches -- and Phase A existing is how that
# was found before it mattered.
PHASEA_READY_TIMEOUT="${PHASEA_READY_TIMEOUT:-180}"
PHASEA_PASSWORD="${PHASEA_PASSWORD:-phase-a-disposable-$$}"

phasea_evidence_file() {
  printf '%s/%s-phase-a.env' "$(restore_verification_dir)" "$1"
}

# The image a disposable copy must use: the ID the production container is
# actually running, never the tag.
phasea_pinned_image() {  # $1 = production container name
  local id
  id="$(docker inspect "$1" --format '{{.Image}}' 2>/dev/null || true)"
  [[ -n "$id" ]] || return 1
  docker image inspect "$id" >/dev/null 2>&1 || return 1
  printf '%s' "$id"
}

# Refuse any name that already exists. A collision would mean operating on
# something that is not ours, and the production stack is the thing most likely
# to be on the other end of that mistake.
phasea_name_free() {  # $1 = container name
  docker ps -a --format '{{.Names}}' | grep -qxF "$1" && return 1
  return 0
}

do_immich_phase_a() {
  local target="${1:-}" a keep=0 serve=0
  shift || true
  for a in "$@"; do
    case "$a" in
      --keep)  keep=1 ;;
      --serve) serve=1 ;;
      *) [[ -n "$a" ]] && die "Unknown argument: $a" ;;
    esac
  done
  [[ -n "$target" ]] || die "Usage: domum-media-backup immich-phase-a <target> [--keep]"
  backup_target_enabled "$target" || die "Backup target is not enabled: $target"
  cmd_exists docker || die "docker is required"
  cmd_exists jq || die "jq is required"

  # ---- preflight: pin every image before anything is created ---------------
  local img_pg img_redis img_server
  img_pg="$(phasea_pinned_image immich_postgres)" \
    || die "Cannot pin the PostgreSQL image: immich_postgres is not running, or its
image is not present locally. Phase A must test the application version
production actually runs, so it will not substitute a tag."
  img_redis="$(phasea_pinned_image immich_redis)" \
    || die "Cannot pin the Redis image from immich_redis."
  img_server="$(phasea_pinned_image immich_server)" \
    || die "Cannot pin the Immich server image from immich_server."

  local stamp base net c_pg c_redis c_srv
  stamp="$(date +%Y%m%d-%H%M%S)"
  base="domum-phasea-$$-$stamp"
  net="${base}-net"; c_pg="${base}-pg"; c_redis="${base}-redis"; c_srv="${base}-server"
  local n
  for n in "$c_pg" "$c_redis" "$c_srv"; do
    phasea_name_free "$n" || die "Refusing: a container named $n already exists."
  done
  docker network ls --format '{{.Name}}' | grep -qxF "$net" \
    && die "Refusing: a network named $net already exists."

  local vdir scratch
  vdir="$(restore_verification_dir)"
  mkdir -p "$vdir"
  case "$vdir" in
    "${DOMUM_DATA_ROOT%/}"/*|"${DOMUM_MEDIA_ROOT%/}"/*|"${DOMUM_DATA_ROOT%/}"|"${DOMUM_MEDIA_ROOT%/}")
      die "Refusing: the scratch location $vdir is inside a live data root." ;;
  esac
  scratch="$(mktemp -d "$vdir/phasea.XXXXXX")" || die "Cannot create a scratch directory"
  mkdir -p "$scratch/upload"

  # One teardown for everything, and the signal form must TERMINATE: a
  # cleanup-only trap would let execution fall through into assertions against
  # containers that have just been destroyed.
  # shellcheck disable=SC2064
  trap "phasea_teardown '$c_srv' '$c_redis' '$c_pg' '$net' '$scratch' $keep" EXIT
  # shellcheck disable=SC2064
  trap "phasea_teardown '$c_srv' '$c_redis' '$c_pg' '$net' '$scratch' $keep; exit 143" HUP INT TERM

  echo "[domum-media-backup] Immich Phase A rehearsal for $target"
  echo "  server image      : ${img_server:0:19} (pinned from the running container)"
  echo "  postgres image    : ${img_pg:0:19}"
  echo "  redis image       : ${img_redis:0:19}"
  echo "  network           : $net (INTERNAL -- no route off this host)"
  echo "  upload location   : $scratch/upload (scratch; NO production path is mounted)"

  # ---- the dump, from the repository ---------------------------------------
  local snapshot_id rel artifact
  snapshot_id="$(restic_for_target "$target" snapshots --latest 1 --json 2>/dev/null \
    | jq -r 'if length == 0 then "" else (.[-1].short_id // .[-1].id[0:8]) end' 2>/dev/null || true)"
  [[ -n "$snapshot_id" ]] || die "Could not determine the latest snapshot for $target"
  rel="$DOMUM_DATA_ROOT/immich/backup-staging/immich-postgres.dump.sql.gz"
  log "immich phase A: $target snapshot $snapshot_id -> $base (isolated)"
  restic_for_target "$target" restore latest --target "$scratch" --include "$rel" \
    >/dev/null 2>&1 || die "Could not restore the dump from $target"
  artifact="$scratch$rel"
  [[ -s "$artifact" ]] || die "The restored dump is missing or empty"
  echo "  snapshot          : $snapshot_id"
  echo "  dump              : $(stat -c %s "$artifact") bytes"

  # Immich verifies its own library scaffold before it will serve anything.
  # Measured: with an empty upload directory the microservices worker dies with
  #   Failed to read "<UPLOAD_LOCATION>/encoded-video/.immich"
  # after reporting mountChecks for thumbs, upload, backups, library, profile
  # and encoded-video. Those `.immich` files are Immich's OWN 13-byte integrity
  # markers, which exist to detect a wrong or unmounted volume -- so they are
  # real backed-up files, and Phase A RESTORES them from the snapshot rather
  # than creating them. 78 bytes in total.
  #
  # This matters for honesty: nothing on the filesystem is fabricated to make
  # the application look healthy. The library itself is still absent, and any
  # attempt to serve an asset will fail -- which is reported, not hidden.
  local lib marker sub restored_markers=0
  lib="${IMMICH_LIBRARY_DIR:-$DOMUM_DATA_ROOT/immich/library}"
  local -a marker_args=()
  for sub in upload thumbs encoded-video library profile backups; do
    marker_args+=(--include "$lib/$sub/.immich")
  done
  restic_for_target "$target" restore latest --target "$scratch" "${marker_args[@]}" \
    >/dev/null 2>&1 || true
  for sub in upload thumbs encoded-video library profile backups; do
    marker="$scratch$lib/$sub/.immich"
    if [[ -f "$marker" ]]; then
      mkdir -p "$scratch/upload/$sub"
      cp -- "$marker" "$scratch/upload/$sub/.immich"
      restored_markers=$(( restored_markers + 1 ))
    fi
  done
  echo "  library scaffold  : $restored_markers of 6 .immich marker(s) restored from the snapshot"
  if (( restored_markers < 6 )); then
    echo "                      Immich checks all six and will refuse to start without"
    echo "                      them. Missing markers mean the snapshot does not hold a"
    echo "                      complete library scaffold, which is itself a finding."
  fi

  docker network create --internal "$net" >/dev/null 2>&1 \
    || die "Could not create the isolated network"

  # ---- disposable PostgreSQL ------------------------------------------------
  local pgpass="phasea-$$-$RANDOM"
  docker run -d --name "$c_pg" --network "$net" --network-alias database \
    -e POSTGRES_PASSWORD="$pgpass" -e POSTGRES_DB=postgres \
    --tmpfs /var/lib/postgresql/data:rw,size=6g,mode=0700 \
    "$img_pg" >/dev/null 2>&1 || die "The disposable PostgreSQL did not start"
  local i ready=0
  for i in $(seq 1 60); do
    docker exec "$c_pg" pg_isready -U postgres >/dev/null 2>&1 && { ready=1; break; }
    sleep 1
  done
  (( ready == 1 )) || die "The disposable PostgreSQL never became ready"
  docker exec "$c_pg" psql -U postgres -q -c 'create database immich' >/dev/null 2>&1 \
    || die "Could not create the target database"
  gzip -dc "$artifact" \
    | docker exec -i "$c_pg" psql -U postgres -d immich -q -v ON_ERROR_STOP=1 \
      >/dev/null 2>"$scratch/import.err" \
    || { echo "  import            : FAILED"; head -5 "$scratch/import.err" | sed 's/^/    /'; return 1; }
  echo "  import            : COMPLETED under ON_ERROR_STOP=1"

  # Baseline BEFORE Immich touches it, so a migration that destroys data is
  # visible as a change rather than assumed not to happen.
  local before_assets before_users
  before_assets="$(phasea_sql "$c_pg" 'select count(*) from asset')"
  before_users="$(phasea_sql "$c_pg" 'select count(*) from "user"')"
  echo "  restored records  : $before_assets asset(s), $before_users user(s) before startup"

  # ---- disposable Redis ----------------------------------------------------
  docker run -d --name "$c_redis" --network "$net" --network-alias redis \
    "$img_redis" >/dev/null 2>&1 || die "The disposable Redis did not start"

  # ---- disposable Immich server -------------------------------------------
  # No production path is mounted. The upload location is scratch, so anything
  # Immich generates lands there and dies with the scratch directory.
  docker run -d --name "$c_srv" --network "$net" \
    -e DB_HOSTNAME=database -e DB_USERNAME=postgres -e DB_PASSWORD="$pgpass" \
    -e DB_DATABASE_NAME=immich \
    -e REDIS_HOSTNAME=redis \
    -e UPLOAD_LOCATION=/usr/src/app/upload \
    -e JWT_SECRET="phase-a-disposable-secret-$$" \
    -v "$scratch/upload:/usr/src/app/upload:rw" \
    "$img_server" >/dev/null 2>&1 || die "The disposable Immich server did not start"

  # ---- readiness -----------------------------------------------------------
  local ver=""
  for i in $(seq 1 "$PHASEA_READY_TIMEOUT"); do
    ver="$(docker exec "$c_srv" curl -sf -m 3 http://127.0.0.1:2283/api/server/version 2>/dev/null || true)"
    [[ -n "$ver" ]] && break
    docker ps --format '{{.Names}}' | grep -qxF "$c_srv" \
      || { echo "  startup           : FAILED -- the server container exited"; docker logs --tail 20 "$c_srv" 2>&1 | sed 's/^/    /'; return 1; }
    sleep 1
  done
  if [[ -z "$ver" ]]; then
    echo "  startup           : FAILED -- no API response within ${PHASEA_READY_TIMEOUT}s"
    docker logs --tail 25 "$c_srv" 2>&1 | sed 's/^/    /'
    return 1
  fi
  echo "  startup           : API answered -- version $(jq -r '[.major,.minor,.patch]|map(tostring)|join(".")' <<< "$ver" 2>/dev/null || echo "$ver")"

  # ---- did it keep the recovered data? ------------------------------------
  local after_assets after_users
  after_assets="$(phasea_sql "$c_pg" 'select count(*) from asset')"
  after_users="$(phasea_sql "$c_pg" 'select count(*) from "user"')"
  echo "  after migrations  : $after_assets asset(s), $after_users user(s)"
  if [[ "$after_assets" != "$before_assets" || "$after_users" != "$before_users" ]]; then
    echo "  result            : FAILED -- startup CHANGED the recovered record counts"
    echo "                      assets $before_assets -> $after_assets, users $before_users -> $after_users"
    return 1
  fi

  # ---- the application layer ----------------------------------------------
  # A known password is set on the admin user in the DISPOSABLE database only,
  # using the database's own pgcrypto so no credential tooling or network is
  # needed. Production is untouched: this database exists only inside this
  # container's tmpfs. Without this there is no way to ask the application what
  # it can see, and a DB query would only re-prove what the import already did.
  local email token stats photos videos api_total
  email="$(phasea_sql "$c_pg" 'select email from "user" where "isAdmin" order by "createdAt" limit 1')"
  [[ -n "$email" ]] || { echo "  result            : FAILED -- no admin user in the recovered database"; return 1; }
  phasea_sql "$c_pg" "create extension if not exists pgcrypto" >/dev/null
  phasea_sql "$c_pg" "update \"user\" set password = crypt('$PHASEA_PASSWORD', gen_salt('bf',10)), \"shouldChangePassword\" = false where email = '$email'" >/dev/null
  token="$(docker exec "$c_srv" curl -sf -m 10 -X POST \
    -H 'Content-Type: application/json' \
    -d "{\"email\":\"$email\",\"password\":\"$PHASEA_PASSWORD\"}" \
    http://127.0.0.1:2283/api/auth/login 2>/dev/null | jq -r '.accessToken // empty' 2>/dev/null || true)"
  if [[ -z "$token" ]]; then
    echo "  application layer : FAILED -- could not authenticate as the recovered admin user"
    return 1
  fi
  echo "  application layer : authenticated as the recovered admin user"

  stats="$(docker exec "$c_srv" curl -sf -m 20 \
    -H "Authorization: Bearer $token" \
    http://127.0.0.1:2283/api/server/statistics 2>/dev/null || true)"
  photos="$(jq -r '.photos // empty' <<< "$stats" 2>/dev/null || true)"
  videos="$(jq -r '.videos // empty' <<< "$stats" 2>/dev/null || true)"
  if [[ -z "$photos" || -z "$videos" ]]; then
    echo "  application layer : FAILED -- the API returned no asset statistics"
    return 1
  fi
  api_total=$(( photos + videos ))
  # The API reports TIMELINE-VISIBLE assets, not every row. Measured on this
  # library: 13,893 timeline images + 1,712 timeline videos + 7,428 HIDDEN
  # videos = 23,033. The hidden ones are the motion-photo components of live
  # photos -- irreplaceable originals that are backed up but never shown in a
  # timeline. Comparing the API total against every row therefore fails on a
  # perfectly healthy recovery, which is what the first run of this check did.
  local db_vis_img db_vis_vid db_hidden
  db_vis_img="$(phasea_sql "$c_pg" "select count(*) from asset where type='IMAGE' and visibility='timeline'")"
  db_vis_vid="$(phasea_sql "$c_pg" "select count(*) from asset where type='VIDEO' and visibility='timeline'")"
  db_hidden="$(phasea_sql "$c_pg" "select count(*) from asset where visibility <> 'timeline'")"
  echo "  API asset counts  : $photos photo(s) + $videos video(s) = $api_total visible"
  if [[ -z "$db_vis_img" || -z "$db_vis_vid" ]]; then
    # A schema without `visibility` cannot be compared this way. Say so rather
    # than falling back to a comparison that is known to be wrong.
    echo "  result            : INCONCLUSIVE -- this schema has no visibility column, so"
    echo "                      the API total cannot be reconciled with the row count."
    phasea_record "$target" inconclusive "$snapshot_id" "$img_server" "$after_assets" "$after_users" \
      "no visibility column; API total not reconcilable"
    return 1
  fi
  echo "  database (visible): $db_vis_img image(s) + $db_vis_vid video(s)"
  echo "  database (hidden) : $db_hidden -- motion-photo components, backed up, not in a timeline"
  if [[ "$photos" != "$db_vis_img" || "$videos" != "$db_vis_vid" ]]; then
    echo "  result            : FAILED -- the application and the database disagree."
    echo "                      API $photos/$videos vs database $db_vis_img/$db_vis_vid"
    phasea_record "$target" failure "$snapshot_id" "$img_server" "$after_assets" "$after_users" \
      "API/database asset counts disagree"
    return 1
  fi

  # ---- PHASE B: serve real recovered media --------------------------------
  local served=0 served_ok=0 served_bad=0 served_bytes=0
  if (( serve == 1 )); then
    echo
    echo "  PHASE B -- serving recovered originals"
    local sel_lines cat aid apath abytes
    local sel_err; sel_err="$scratch/select.err"
    local owner_id other_assets
    owner_id="$(phasea_sql "$c_pg" "select id from \"user\" where email = '$email'")"
    sel_lines="$(phaseb_selection_sql "$owner_id" | docker exec -i "$c_pg" \
      psql -U postgres -d immich -At 2>"$sel_err" || true)"
    other_assets="$(phasea_sql "$c_pg" "select count(*) from asset where \"ownerId\" <> '$owner_id'")"
    # The live-photo VIDEO is selected from the chosen image, because the
    # relationship is not 1:1 and must be followed rather than guessed.
    local lp_img
    lp_img="$(grep '^livephoto image|' <<< "$sel_lines" | cut -d'|' -f2 | head -1)"
    if [[ -n "$lp_img" ]]; then
      sel_lines="$sel_lines
$(phaseb_livephoto_video_sql "$lp_img" | docker exec -i "$c_pg" psql -U postgres -d immich -At 2>/dev/null || true)"
    fi
    sel_lines="$(grep -E '^[a-z]' <<< "$sel_lines" | grep '|' || true)"
    if [[ -z "$sel_lines" ]]; then
      echo "  result            : FAILED -- no representative asset could be selected"
      # An unactionable FAIL trains the operator to ignore it. Say why.
      [[ -s "$sel_err" ]] && { echo "  selection error   :"; head -4 "$sel_err" | sed 's/^/    /'; }
      return 1
    fi

    # Restore just these originals. Bounded: the run refuses to exceed its
    # byte budget rather than quietly growing into a library download.
    local -a want_paths=() want_ids=() want_cats=()
    local total_sel=0
    while IFS='|' read -r cat aid apath abytes; do
      [[ -n "$aid" && -n "$apath" ]] || continue
      if (( total_sel + abytes > PHASEB_MAX_BYTES )); then
        echo "    skipped $cat ($abytes bytes) -- would exceed the $(sample_human_bytes "$PHASEB_MAX_BYTES") run budget"
        continue
      fi
      want_cats+=("$cat"); want_ids+=("$aid"); want_paths+=("$apath")
      total_sel=$(( total_sel + abytes ))
    done <<< "$sel_lines"
    echo "    selected        : ${#want_ids[@]} asset(s), $(sample_human_bytes "$total_sel") to restore"
    echo "    ownership scope : the authenticated user only"
    if [[ "${other_assets:-0}" -gt 0 ]]; then
      echo "                      ${other_assets} asset(s) belong to OTHER user(s) and were not"
      echo "                      tested. Immich enforces per-user ownership, so proving one"
      echo "                      user's assets serve does not prove another's."
    fi

    # Container path -> host path under the library root, then into scratch at
    # the SAME relative position so the application finds it where the database
    # says it is.
    local cprefix rel hostp
    cprefix="$(immich_container_library_prefix)"
    local -a local_files=()
    local -a include_args2=()
    local i2
    for i2 in "${!want_paths[@]}"; do
      rel="${want_paths[$i2]#"$cprefix"/}"
      include_args2+=(--include "$lib/$rel")
    done
    if (( ${#include_args2[@]} > 0 )); then
      restic_for_target "$target" restore latest --target "$scratch" "${include_args2[@]}" \
        >/dev/null 2>&1 || true
    fi
    for i2 in "${!want_paths[@]}"; do
      rel="${want_paths[$i2]#"$cprefix"/}"
      hostp="$scratch$lib/$rel"
      if [[ -f "$hostp" ]]; then
        mkdir -p "$(dirname "$scratch/upload/$rel")"
        cp -- "$hostp" "$scratch/upload/$rel"
        local_files+=("$scratch/upload/$rel")
        served_bytes=$(( served_bytes + $(stat -c %s "$scratch/upload/$rel") ))
      else
        local_files+=("")
      fi
    done
    echo "    restored        : $(printf '%s\n' "${local_files[@]}" | grep -c . || true) of ${#want_ids[@]} original(s), $(sample_human_bytes "$served_bytes")"

    # Ask the application for each one.
    local verdict
    for i2 in "${!want_ids[@]}"; do
      if [[ -z "${local_files[$i2]}" ]]; then
        printf '    %-18s %s\n' "${want_cats[$i2]}" "NOT RESTORED -- not in the snapshot"
        served_bad=$(( served_bad + 1 )); continue
      fi
      served=$(( served + 1 ))
      verdict="$(phaseb_fetch_and_compare "$c_srv" "$token" "${want_ids[$i2]}" "${local_files[$i2]}")" \
        && served_ok=$(( served_ok + 1 )) || served_bad=$(( served_bad + 1 ))
      printf '    %-18s %s\n' "${want_cats[$i2]}" "$verdict"
    done

    # A generated preview, fetched to show the application works -- and
    # deliberately NOT compared to any original.
    local thumb_bytes=""
    if (( ${#want_ids[@]} > 0 )); then
      thumb_bytes="$(docker exec "$c_srv" sh -lc \
        "curl -sf -m 60 -o /dev/null -w '%{size_download}' -H 'Authorization: Bearer $token' \
          'http://127.0.0.1:2283/api/assets/${want_ids[0]}/thumbnail'" 2>/dev/null || true)"
    fi
    if [[ -n "$thumb_bytes" && "$thumb_bytes" != "0" ]]; then
      echo "    thumbnail        : ${thumb_bytes} byte(s) returned -- GENERATED, not compared to any original"
    else
      echo "    thumbnail        : none returned (derivatives were not restored; not a failure)"
    fi

    if (( served_bad > 0 || served_ok == 0 )); then
      echo "  result            : FAILED -- $served_ok of $served served original(s) matched"
      phasea_record "$target" failure "$snapshot_id" "$img_server" "$after_assets" "$after_users" \
        "phase B: $served_ok of $served originals matched"
      return 1
    fi
  fi

  # ---- record and report --------------------------------------------------
  phasea_record "$target" success "$snapshot_id" "$img_server" "$after_assets" "$after_users" ""
  echo
  if (( serve == 1 )); then
    echo "  result            : REPRESENTATIVE RECOVERY VERIFIED ($served_ok of $after_assets)"
    echo "                      $served_ok original(s) were restored from the snapshot and"
    echo "                      served by a fresh Immich with bytes identical to the"
    echo "                      restored files, across the media types listed above."
    echo "                      $(sample_human_bytes "$served_bytes") transferred."
    echo
    echo "  This is NOT full recovery. $(( after_assets - served_ok )) originals were never"
    echo "  restored or served, and only ONE user's assets were tested. A subset"
    echo "  proves the PATH works for these types; it cannot speak for the whole"
    echo "  library or for other users."
    return 0
  fi
  echo "  result            : APPLICATION STARTUP VERIFIED"
  echo "                      A fresh Immich of the production image opened the"
  echo "                      restored database, migrated it without changing the"
  echo "                      recovered records, authenticated a recovered user,"
  echo "                      and reported $api_total timeline assets through its own"
  echo "                      API, matching the database exactly per media type."
  echo "                      $db_hidden further originals are hidden motion-photo"
  echo "                      components: backed up, but never shown in a timeline."
  echo
  echo "  This is NOT full recovery. No original was restored, so nothing proves"
  echo "  the library can be SERVED. That needs ~130 GiB and separate approval."
  return 0
}

# One SQL value out of the disposable database.
phasea_sql() {  # $1 = container, $2 = query
  docker exec "$1" psql -U postgres -d immich -At -c "$2" 2>/dev/null | head -1
}

# Remove everything this rehearsal created, and say what survived.
#
# A test that leaves containers behind has changed the host it was supposed to
# leave alone, so the removal is asserted rather than assumed.
phasea_teardown() {  # $1=srv $2=redis $3=pg $4=net $5=scratch $6=keep
  local srv="$1" redis="$2" pg="$3" net="$4" scratch="$5" keep="${6:-0}"
  if [[ "$keep" == "1" ]]; then
    echo "  --keep: leaving $srv, $redis, $pg, $net and $scratch in place." >&2
    return 0
  fi
  docker rm -f "$srv" "$redis" "$pg" >/dev/null 2>&1 || true
  docker network rm "$net" >/dev/null 2>&1 || true
  rm -rf -- "$scratch" 2>/dev/null || true
  local leaked=""
  local n
  for n in "$srv" "$redis" "$pg"; do
    docker ps -a --format '{{.Names}}' | grep -qxF "$n" && leaked="$leaked $n"
  done
  docker network ls --format '{{.Name}}' | grep -qxF "$net" && leaked="$leaked $net"
  [[ -e "$scratch" ]] && leaked="$leaked $scratch"
  if [[ -n "$leaked" ]]; then
    echo "WARNING: Phase A could not remove:$leaked" >&2
    return 1
  fi
  return 0
}

phasea_record() {
  local target="$1" result="$2" snap="$3" image="$4" assets="$5" users="$6" reason="${7:-}"
  local dir file tmp now prev_ok_ts="" prev_ok_snap=""
  dir="$(restore_verification_dir)"; mkdir -p "$dir"
  file="$(phasea_evidence_file "$target")"
  now="$(date -Iseconds)"
  if [[ -f "$file" ]]; then
    eval "$(
      unset RESULT VERIFIED_TS SNAPSHOT_ID LAST_SUCCESS_TS LAST_SUCCESS_SNAPSHOT_ID
      # shellcheck disable=SC1090
      . "$file" >/dev/null 2>&1 || true
      if [[ "${RESULT:-}" == "success" ]]; then
        printf 'prev_ok_ts=%q\nprev_ok_snap=%q\n' "${VERIFIED_TS:-}" "${SNAPSHOT_ID:-}"
      else
        printf 'prev_ok_ts=%q\nprev_ok_snap=%q\n' "${LAST_SUCCESS_TS:-}" "${LAST_SUCCESS_SNAPSHOT_ID:-}"
      fi
    )"
  fi
  local ok_ts ok_snap
  if [[ "$result" == "success" ]]; then ok_ts="$now"; ok_snap="$snap"
  else ok_ts="$prev_ok_ts"; ok_snap="$prev_ok_snap"; fi
  tmp="$(mktemp "$dir/.${target}-phase-a.env.XXXXXX")" || return 1
  {
    printf 'SCHEMA_VERSION=1\n'
    printf 'TARGET=%s\n' "$target"
    printf 'RESULT=%s\n' "$result"
    printf 'VERIFIED_TS=%s\n' "$now"
    printf 'LAST_SUCCESS_TS=%s\n' "$ok_ts"
    printf 'LAST_SUCCESS_SNAPSHOT_ID=%s\n' "$ok_snap"
    printf 'SNAPSHOT_ID=%s\n' "$snap"
    printf 'SERVER_IMAGE_ID=%s\n' "$image"
    printf 'ASSETS=%s\n' "${assets:-0}"
    printf 'USERS=%s\n' "${users:-0}"
    printf 'REASON=%s\n' "$reason"
  } > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 0600 "$tmp"; mv -f "$tmp" "$file"
}

# ---------------------------------------------------------------------------
# Off-host recovery audit: could a NEW machine rebuild from Hetzner?
# ---------------------------------------------------------------------------

# Every proof so far has run on the N100, using the N100's credentials, against
# images already in the N100's docker store. None of that survives the machine.
# This audit asks the only question that matters if the host is destroyed:
#
#   with Hetzner and nothing else, can a new Debian machine read the repository
#   and rebuild the application?
#
# It reports, never fixes, and it is explicit about what it CANNOT determine
# from the very host whose loss is being assumed -- an audit that scored itself
# a pass from inside the thing it is testing would be worthless.
offhost_audit_row() {  # $1 = item, $2 = verdict, $3 = detail
  printf '  %-34s %-14s %s\n' "$1" "$2" "$3"
}

# The credential files required to READ the repository, by name only.
#
# Never their values. The audit's job is to establish that recovery material
# exists and has an off-host route, not to handle it.
offhost_required_secrets() {  # prints "<label>|<path>"
  local t type
  while IFS= read -r t; do
    backup_target_enabled "$t" 2>/dev/null || continue
    type="$(backup_target_value "$t" TYPE repository 2>/dev/null)"
    printf '%s|%s\n' "restic password ($t)" "$(backup_target_password_file "$t")"
    local envf; envf="$(backup_target_value "$t" ENV_FILE 2>/dev/null)"
    [[ -n "$envf" ]] && printf '%s|%s\n' "repository endpoint ($t)" "$envf"
    if [[ "$type" == "repository" && "$(backup_target_value "$t" REPOSITORY 2>/dev/null)" == sftp:* ]]; then
      printf '%s|%s\n' "SFTP key ($t)" "$(backup_target_value "$t" SFTP_KEY_FILE 2>/dev/null)"
      printf '%s|%s\n' "SFTP known_hosts ($t)" "$(backup_target_value "$t" SFTP_KNOWN_HOSTS_FILE 2>/dev/null)"
    fi
  done < <(backup_target_names)
}

# The images a rebuild needs, and whether each carries a REGISTRY-resolvable
# reference.
#
# An image ID in the local store proves nothing after the host is gone, and the
# ID is not even portable: measured on this host, the local Id of
# immich-server equals the multi-arch INDEX digest, not the config digest, so
# comparing Ids between machines is meaningless. The durable reference is the
# RepoDigest -- the `name@sha256:...` form -- which is what a new machine can
# pull.
offhost_recovery_images() {  # prints "<role>|<container>"
  printf '%s\n' "immich server|immich_server" \
                "postgresql|immich_postgres" \
                "redis|immich_redis"
}

offhost_image_digest() {  # $1 = container -> repo digest or empty
  local id
  id="$(docker inspect "$1" --format '{{.Image}}' 2>/dev/null || true)"
  [[ -n "$id" ]] || return 1
  docker image inspect "$id" --format '{{range .RepoDigests}}{{.}}{{"\n"}}{{end}}' 2>/dev/null \
    | grep -m1 '@sha256:' || return 1
}

# $1 = "--probe" to contact the registry (read-only, no pull)
do_dr_offhost_audit() {
  local probe=0 a want_json=0
  for a in "$@"; do
    case "$a" in
      --probe) probe=1 ;;
      --json)  want_json=1 ;;
      *) [[ -n "$a" ]] && die "Usage: domum-media-backup dr-offhost-audit [--probe] [--json]" ;;
    esac
  done
  local problems=0 unknowns=0

  echo "OFF-HOST RECOVERY AUDIT"
  echo
  echo "Assumes this machine is gone: system disk and data disk both unavailable."
  echo "Anything reachable only from here does not count."
  echo

  # ---- 1. credentials ------------------------------------------------------
  echo "  1. CREDENTIALS NEEDED TO READ THE REPOSITORY"
  local label path missing=0 total=0
  while IFS='|' read -r label path; do
    [[ -n "$path" ]] || continue
    total=$(( total + 1 ))
    # "absent" and "I cannot look" are different answers. Reporting the second
    # as the first makes the audit cry wolf, and an audit that cries wolf gets
    # ignored -- which is worse than not having one.
    if [[ -f "$path" ]]; then
      offhost_audit_row "$label" "present" "$(basename "$path")"
    elif [[ ! -r "$(dirname "$path")" ]]; then
      offhost_audit_row "$label" "UNREADABLE" "$(dirname "$path") needs root"
      unknowns=$(( unknowns + 1 ))
    else
      offhost_audit_row "$label" "MISSING" "$path"
      missing=$(( missing + 1 ))
    fi
  done < <(offhost_required_secrets)
  if (( total == 0 )); then
    offhost_audit_row "credential inventory" "UNKNOWN" "no enabled target, or config unreadable"
    unknowns=$(( unknowns + 1 ))
  elif (( missing > 0 )); then
    problems=$(( problems + 1 ))
  fi
  echo "     Without these the repository cannot be opened at all, so they are the"
  echo "     first thing a rebuild needs -- before any snapshot is useful."
  echo

  # ---- 2. the recovery pack -----------------------------------------------
  echo "  2. THE RECOVERY PACK (the only designed route off this host)"
  # The age is taken from the newest pack FILE, not from a recorded timestamp.
  #
  # The first version called recovery_pack_state_file, which is defined in
  # bin/domum-media -- a different script that this one does not source. At run
  # time that is "command not found", the `|| true` swallowed it, and the pack
  # age was silently never reported. The function-definition audit caught it;
  # nothing else would have, because the failure looked exactly like "no state
  # file yet". Measuring the files removes the cross-script dependency and
  # reports what EXISTS rather than what was once recorded.
  local pack_dir pack_age="" pack_ts="" newest=""
  pack_dir="${RECOVERY_PACK_DEST:-$DOMUM_STATE_ROOT/recovery-pack}"
  if [[ -d "$pack_dir" ]]; then
    newest="$(find "$pack_dir" -maxdepth 1 -type f -name '*.age' -printf '%T@ %p\n' 2>/dev/null \
      | sort -rn | head -1 | cut -d' ' -f2- || true)"
    if [[ -n "$newest" && -f "$newest" ]]; then
      local ep now
      ep="$(stat -c %Y "$newest" 2>/dev/null || true)"
      now="$(date +%s)"
      if [[ -n "$ep" ]]; then
        pack_age=$(( (now - ep) / 86400 ))
        pack_ts="$(date -d "@$ep" -Iseconds 2>/dev/null || true)"
      fi
    fi
  fi
  local packs=0
  [[ -d "$pack_dir" ]] && packs="$(find "$pack_dir" -maxdepth 1 -type f -name '*.age' 2>/dev/null | grep -c . || true)"
  if [[ ! -d "$pack_dir" ]]; then
    offhost_audit_row "pack present" "UNKNOWN" "$pack_dir not readable from here"
    unknowns=$(( unknowns + 1 ))
  elif [[ "${packs:-0}" -gt 0 ]]; then
    offhost_audit_row "pack present" "yes" "${packs} encrypted pack(s) in $pack_dir"
    [[ -n "$pack_age" ]] && offhost_audit_row "newest pack age" "${pack_age}d" "created $pack_ts"
  else
    offhost_audit_row "pack present" "NONE" "no encrypted pack in $pack_dir"
    problems=$(( problems + 1 ))
  fi

  # The decisive question. A pack that never leaves is lost with the machine.
  # Likewise: a configuration value that was never read is not a value of 0.
  if [[ -n "${CFG_FILE:-}" && ! -r "${CFG_FILE:-/nonexistent}" ]]; then
    offhost_audit_row "off-host delivery" "UNKNOWN" "$CFG_FILE needs root; nothing can be said"
    unknowns=$(( unknowns + 1 ))
  elif [[ "${RECOVERY_PACK_EMAIL_ENABLED:-0}" == "1" ]]; then
    offhost_audit_row "off-host delivery" "ENABLED" "emailed to ${RECOVERY_PACK_EMAIL_TO:-\$DOMUM_EMAIL}"
  else
    offhost_audit_row "off-host delivery" "DISABLED" "RECOVERY_PACK_EMAIL_ENABLED is not 1"
    echo "     The pack is written to this host and never sent anywhere. If both disks"
    echo "     are lost it is lost with them, and with it the ability to open the"
    echo "     repository. This is the single highest-consequence gap in the system."
    problems=$(( problems + 1 ))
  fi

  # Storing the pack inside the backup would be circular: you would need the
  # credentials in order to fetch the credentials.
  local in_set=1 root
  for root in ${BACKUP_INCLUDE_PATHS:-}; do
    case "$pack_dir" in "${root%/}"|"${root%/}"/*) in_set=0 ;; esac
  done
  if (( in_set == 0 )); then
    offhost_audit_row "pack inside the backup" "CIRCULAR" "the credentials would be inside the repository they open"
    problems=$(( problems + 1 ))
  else
    offhost_audit_row "pack inside the backup" "no" "correct -- that would be circular"
  fi

  # The age PRIVATE key is deliberately not on this host, so its presence
  # cannot be checked from here. Saying so is the honest answer.
  offhost_audit_row "age private key" "UNPROVABLE" "held by the operator; not checkable from this host"
  unknowns=$(( unknowns + 1 ))
  echo "     The pack is encrypted to $(basename "${RECOVERY_PACK_AGE_PUBKEY_FILE:-recovery_pack_pubkey}")."
  echo "     Without the matching PRIVATE key the pack cannot be opened, so that key"
  echo "     must exist somewhere that is neither this machine nor the pack."
  echo

  # ---- 3. images -----------------------------------------------------------
  echo "  3. APPLICATION IMAGES A REBUILD NEEDS"
  local role cont dig
  while IFS='|' read -r role cont; do
    if dig="$(offhost_image_digest "$cont")"; then
      if (( probe == 1 )); then
        if timeout 60 docker manifest inspect "$dig" >/dev/null 2>&1; then
          offhost_audit_row "$role" "obtainable" "${dig##*@}"
        else
          offhost_audit_row "$role" "NOT IN REGISTRY" "${dig##*@}"
          problems=$(( problems + 1 ))
        fi
      else
        offhost_audit_row "$role" "pinned" "${dig##*@} (--probe to contact the registry)"
      fi
    else
      offhost_audit_row "$role" "NO DIGEST" "local only -- not obtainable after this host is gone"
      problems=$(( problems + 1 ))
    fi
  done < <(offhost_recovery_images)
  echo "     A local image ID proves nothing once the store is gone, and is not even"
  echo "     portable: this host's immich-server Id equals the multi-arch INDEX"
  echo "     digest rather than the config digest, so IDs cannot be compared between"
  echo "     machines. The durable reference is the RepoDigest."
  echo

  # ---- 4. the version trap ------------------------------------------------
  echo "  4. VERSION COMPATIBILITY OF THE RECOVERY POINT"
  local pgext
  pgext="$(docker exec immich_postgres psql -U "${IMMICH_DB_USERNAME:-postgres}" \
    -d "${IMMICH_DB_DATABASE_NAME:-immich}" -At \
    -c "select extname from pg_extension where extname in ('vectors','vchord')" 2>/dev/null | tr '\n' ' ' || true)"
  if [[ "$pgext" == *vectors* ]]; then
    offhost_audit_row "vector extension" "pgvecto.rs" "DEPRECATED by Immich -- see note"
    echo "     Immich warns that pgvecto.rs support will be removed. The dump can only"
    echo "     be imported by an Immich that still supports it, so the set of"
    echo "     applications able to read today's backup SHRINKS over time. Pin the"
    echo "     image digest in the recovery pack, or migrate to VectorChord."
    unknowns=$(( unknowns + 1 ))
  elif [[ -n "$pgext" ]]; then
    offhost_audit_row "vector extension" "$pgext" "current"
  else
    offhost_audit_row "vector extension" "UNKNOWN" "could not query the live database"
    unknowns=$(( unknowns + 1 ))
  fi
  echo

  # ---- verdict -------------------------------------------------------------
  echo "  VERDICT"
  if (( problems > 0 )); then
    echo "    NOT READY -- $problems blocking gap(s) above. A new machine could not"
    echo "    rebuild from Hetzner today."
  elif (( unknowns > 0 )); then
    echo "    UNPROVEN -- no blocking gap was found, but $unknowns item(s) cannot be"
    echo "    established from this host. That is not the same as ready."
  else
    echo "    No gap found that this host can detect."
  fi
  if (( want_json == 1 )); then
    jq -cn --argjson p "$problems" --argjson u "$unknowns" \
      --arg res "$(if (( problems > 0 )); then echo not_ready; elif (( unknowns > 0 )); then echo unproven; else echo clean; fi)" \
      '{problems:$p,unknowns:$u,result:$res}'
  fi
  (( problems > 0 )) && return 1
  (( unknowns > 0 )) && return 2
  return 0
}

main() {
  need_root
  load_cfg
  export_compose_env
  ensure_dirs

  case "${1:-}" in
    "")                   do_daily_backup ;;
    --check)              do_check ;;
    --check-deep)         shift; do_check_deep "${1:-}" ;;
    --check-cloud-deep)   shift; do_check_full "${1:-}" ;;
    --weekly-retention)   do_weekly_retention ;;
    --weekly-cloud-forget) do_weekly_retention ;;
    --restore)            shift; do_restore "$@" ;;
    --snapshots)          list_latest_snapshots ;;
    --latest-snapshot-json) shift; latest_snapshot_json "${1:-}" ;;
    init)                 shift; do_init_repo "$@" ;;
    plan)                 shift; do_plan_target "${1:-}" ;;
    verify)               shift; do_verify_target "${1:-}" ;;
    adopt-repo)           shift; do_adopt_repo "${1:-}" ;;
    verify-restore)       shift; do_verify_restore "${1:-}" ;;
    verify-sample)        shift; do_verify_sample "$@" ;;
    sample-plan)          shift; do_sample_plan "${1:-}" "${2:-}" ;;
    exclusion-audit)      shift; do_exclusion_audit "${1:-}" ;;
    verify-db-restore)    shift; do_verify_db_restore "${1:-}" ;;
    verify-large)         shift; do_verify_large "$@" ;;
    verify-snapshot-coverage) shift; do_verify_snapshot_coverage "$@" ;;
    immich-phase-a)       shift; do_immich_phase_a "$@" ;;
    immich-phase-b)       shift; do_immich_phase_a "$1" --serve "${@:2}" ;;
    dr-offhost-audit)     shift; do_dr_offhost_audit "$@" ;;
    dr-status)            do_dr_status ;;
    -h|--help)
      cat <<EOF
domum-media-backup — restic wrapper

Usage:
  domum-media-backup                         Daily backup for all enabled targets
  domum-media-backup --check                Metadata check on all enabled targets
  domum-media-backup --check-deep [target]  Read-data-subset check on one target
  domum-media-backup --check-cloud-deep [target]
                                            Full read-data check on one target
  domum-media-backup --weekly-retention     Run weekly retention targets
  domum-media-backup --restore <snap> <target> [--repo target-name]
  domum-media-backup --snapshots            Show latest snapshot per target
  domum-media-backup --latest-snapshot-json <target>
                                            Machine-readable latest snapshot
  domum-media-backup init <target> [--adopt-existing]
                                            Initialize restic repository
  domum-media-backup plan <target>          Show what would be backed up
  domum-media-backup verify <target>        Verify repository health
  domum-media-backup adopt-repo <target>    Adopt existing repository by ID
  domum-media-backup verify-restore <target>
                                            Restore the Immich dump into an
                                            isolated scratch dir, revalidate it,
                                            and record the result
  domum-media-backup verify-sample <target> [count] [--revalidate]
                                            Restore a diverse sample of Immich
                                            originals and compare them
                                            byte-for-byte. Already-proven files
                                            are SKIPPED, so repeated runs widen
                                            coverage instead of re-proving the
                                            same twelve; --revalidate proves
                                            them again
  domum-media-backup sample-plan [count] [target]
                                            Show which originals verify-sample
                                            would pick. Read-only: restores
                                            nothing, contacts nothing, records
                                            nothing
  domum-media-backup exclusion-audit [--proposed]
                                            Check every backup exclusion pattern
                                            against the Immich asset table and
                                            report whether any ORIGINAL would
                                            stop being backed up. Read-only.
                                            With --proposed, also audits the
                                            reviewed-but-unapplied patterns.
                                            Exit 0 clean, 1 an original is
                                            matched, 2 not answerable
  domum-media-backup verify-db-restore <target>
                                            Import the Restic-restored Immich
                                            dump into a DISPOSABLE PostgreSQL
                                            (--network none, tmpfs PGDATA) and
                                            verify tables, counts and
                                            referential consistency. Proves
                                            PostgreSQL can READ the backup,
                                            which the archive checks do not.
                                            Touches no production database.
  domum-media-backup verify-large <target> [count] [--plan] [--revalidate]
                                            Verify a few of the LARGE originals
                                            the per-file sample cap can never
                                            reach, keeping a durable record so
                                            coverage accumulates across runs and
                                            no file is downloaded twice. --plan
                                            shows the byte cost and fetches
                                            nothing. Default 2 files per run.
  domum-media-backup verify-snapshot-coverage <target> [--json]
                                            Reconcile EVERY originalPath in the
                                            Immich asset table against the file
                                            list of a real snapshot. Reads
                                            snapshot metadata only -- downloads
                                            no file content -- so it proves
                                            off-site PRESENCE for the whole
                                            library cheaply. Exit 0 covered,
                                            1 an original is missing, 2 not
                                            answerable
  domum-media-backup immich-phase-a <target> [--keep]
                                            Start a FRESH, isolated Immich of
                                            the production image against the
                                            database restored from a snapshot,
                                            and ask the application what it can
                                            see. Internal network (no route off
                                            the host), tmpfs database, scratch
                                            upload dir, no production path
                                            mounted, images pinned by ID.
                                            Earns APPLICATION STARTUP VERIFIED
                                            -- never full recovery
  domum-media-backup immich-phase-b <target> [--keep]
                                            Phase A, plus: restore a small
                                            representative set of ORIGINALS
                                            from the snapshot and have the
                                            recovered Immich SERVE them,
                                            comparing bytes by hash. Bounded by
                                            PHASEB_MAX_BYTES (256 MiB default).
                                            Earns REPRESENTATIVE RECOVERY
                                            VERIFIED (n of N) -- never full
                                            recovery
  domum-media-backup dr-offhost-audit [--probe] [--json]
                                            Could a NEW machine rebuild from
                                            Hetzner if this one were destroyed?
                                            Audits the credentials, the recovery
                                            pack and its off-host route, the
                                            obtainability of every image, and
                                            the vector-extension version trap.
                                            Reports only; never prints a secret.
                                            Exit 0 clean, 1 a blocking gap,
                                            2 not establishable from this host
  domum-media-backup dr-status              What is actually PROVEN about
                                            recovery, per tier and per target,
                                            on the five levels UNKNOWN /
                                            CONFIGURED / BACKED UP / RESTORE
                                            TESTED / FULL RECOVERY VERIFIED.
                                            Read-only: restores nothing and
                                            contacts no repository. Exit 0 when
                                            the weakest tier is restore-tested,
                                            1 backed up only, 2 weaker
EOF
      ;;
    *)
      die "Unknown command: $1 (try --help)"
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
