}

service_lifecycle_specs() {
  cat <<'EOF'
traefik|ENABLE_TRAEFIK|A|14|traefik|TRAEFIK_IMAGE|
tailscale|ENABLE_TAILSCALE|A|14|tailscale|TAILSCALE_IMAGE|
uptime-kuma|ENABLE_UPTIME_KUMA|A|14|uptime-kuma|UPTIME_KUMA_IMAGE|
jellyfin|ENABLE_JELLYFIN|B|21|jellyfin|JELLYFIN_IMAGE|
plex|ENABLE_PLEX|B|21|plex|PLEX_IMAGE|
navidrome|ENABLE_NAVIDROME|B|21|navidrome|NAVIDROME_IMAGE|
calibre-web|ENABLE_CALIBRE_WEB|B|21|calibre-web|CALIBRE_WEB_IMAGE|
kavita|ENABLE_KAVITA|B|21|kavita|KAVITA_IMAGE|
immich|ENABLE_IMMICH|C|21|immich_server immich_machine_learning immich_postgres immich_redis|IMMICH_SERVER_IMAGE|
EOF
}

# Every case carries a default. Without one, a config that omits a *_CONFIG_DIR
# makes this fail with "unbound variable" under `set -u` -- which is what a host
# bootstrapped from config/domum-media.conf.example would have done for
# calibre-web and kavita, including on the disaster-recovery rebuild path.
# These services' config values point at the CONFIG directory; the service's
# state root is its parent. A plain `${dir%/config}` does not strip when the
# value carries a trailing slash ("…/jellyfin/config/"), so the resolved path
# stayed at the config directory -- and a migration would then have converted
# that subdirectory into a subvolume while its parent remained an ordinary
# directory, leaving `report` still saying "unprotected" after a migration that
# claimed success.
strip_config_suffix() {
  local dir="${1%/}"
  printf '%s' "${dir%/config}"
}

service_data_path() {
  local dir
  case "$1" in
    traefik) echo "$DOMUM_DATA_ROOT/traefik" ;;
    immich)  echo "$DOMUM_DATA_ROOT/immich" ;;
    jellyfin)
      dir="${JELLYFIN_CONFIG_DIR:-$DOMUM_DATA_ROOT/jellyfin/config}"; strip_config_suffix "$dir" ;;
    plex)
      dir="${PLEX_CONFIG_DIR:-$DOMUM_DATA_ROOT/plex/config}"; strip_config_suffix "$dir" ;;
    navidrome)
      dir="${NAVIDROME_DATA_DIR:-$DOMUM_DATA_ROOT/navidrome}"; printf '%s' "${dir%/}" ;;
    calibre-web)
      dir="${CALIBRE_WEB_CONFIG_DIR:-$DOMUM_DATA_ROOT/calibre-web/config}"; strip_config_suffix "$dir" ;;
    kavita)
      dir="${KAVITA_CONFIG_DIR:-$DOMUM_DATA_ROOT/kavita/config}"; strip_config_suffix "$dir" ;;
    uptime-kuma) echo "$DOMUM_DATA_ROOT/uptime-kuma" ;;
    *) return 1 ;;
  esac
}

service_configured_version() {
  local key="$1"
  printf '%s' "${!key:-unknown}"
}

service_backup_required() {
  case "$1" in
    jellyfin|plex|navidrome|calibre-web|kavita|immich) return 0 ;;
    *) return 1 ;;
  esac
}

service_strict_backup_required() {
  case "$1" in
    immich) return 0 ;;
    *) return 1 ;;
  esac
}

service_compose_services() {
  while IFS='|' read -r name _ _ _ compose_svcs _ _; do
    [[ "$name" == "$1" ]] || continue
    printf '%s' "$compose_svcs"
    return 0
  done < <(service_lifecycle_specs)
  return 1
}

service_health_url() {
  while IFS='|' read -r name _ _ _ _ _ url; do
    [[ "$name" == "$1" ]] || continue
    printf '%s' "$url"
    return 0
  done < <(service_lifecycle_specs)
  return 1
}

# IN-CONTAINER readiness probe.
#
# The health_url column above is empty for every service, and for plex it could
# not be filled: plex runs on `domum-internal` with no host-published port
# (measured: 32400/tcp -> []), reachable only through Traefik on an authenticated
# hostname. A host-side curl cannot see it.
#
# So the probe runs INSIDE the container, over loopback, against an endpoint the
# application already serves. It adds no healthcheck, publishes no port and
# touches no authentication -- it only reads something that is already there.
#
# plex: GET /identity is unauthenticated and returns
#   <MediaContainer ... machineIdentifier="..." version="1.43.2.10687-563d026ea">
# which is strictly stronger evidence than the readiness LOG line. The log line
# is the container entrypoint reporting that a TCP connect to 32400 succeeded --
# a LISTENER exists. An HTTP 200 carrying a machineIdentifier proves the
# application answered and had read its own preferences.
#
# What it still does NOT prove: that the library database opened. /identity does
# not touch it, and anything that does requires an X-Plex-Token. The database
# question is answered separately and more rigorously, by integrity_check and
# foreign_key_check run on DISPOSABLE COPIES in migrate_sqlite_integrity.
service_ready_probe() {  # $1 = service -> "url|expected-substring", or non-zero
  case "$1" in
    plex) printf 'http://127.0.0.1:32400/identity|machineIdentifier' ;;
    *) return 1 ;;
  esac
}

# 0 = responded as expected, 1 = did not, 2 = no probe defined for this service.
# "No probe" must never read as "ready": the caller distinguishes them.
service_probe_ready() {  # $1 = service
  local spec url want cid out
  spec="$(service_ready_probe "$1" 2>/dev/null)" || return 2
  url="${spec%%|*}"; want="${spec##*|}"
  cid="$(tracked_service_container_id_any "$1" 2>/dev/null || true)"
  [[ -n "$cid" ]] || return 2
  out="$(docker exec "$cid" curl -fsS --max-time 10 "$url" 2>/dev/null || true)"
  [[ -n "$out" ]] || return 1
  grep -qF -- "$want" <<< "$out" || return 1
  return 0
}

# The application's own version string, read from the same probe. Recorded as
# recovery evidence so the running application can be tied to the image we
# believe is running, rather than trusting the image label alone.
service_probe_version() {  # $1 = service
  local spec url cid out
  spec="$(service_ready_probe "$1" 2>/dev/null)" || return 1
  url="${spec%%|*}"
  cid="$(tracked_service_container_id_any "$1" 2>/dev/null || true)"
  [[ -n "$cid" ]] || return 1
  out="$(docker exec "$cid" curl -fsS --max-time 10 "$url" 2>/dev/null || true)"
  [[ -n "$out" ]] || return 1
  # Anchor on the line that carries the expected marker. Matching `version="`
  # anywhere grabs the XML declaration first -- measured: it returned "1.0" from
  # `<?xml version="1.0" encoding="UTF-8"?>` instead of the application version.
  local want="${spec##*|}"
  grep -F -- "$want" <<< "$out" \
    | sed -nE 's/.*[^a-zA-Z]version="([^"]+)".*/\1/p' | head -1
}

backup_last_success_epoch() {
  local file="${DOMUM_LOG_DIR}/last-success"
  [[ -f "$file" ]] || return 1
  date -d "$(head -n1 "$file")" +%s 2>/dev/null || return 1
}

verify_backup_freshness() {
  local svc="$1"
  service_backup_required "$svc" || return 0

  local policy="${BACKUP_POLICY^^}"
  local max_age_hours="${BACKUP_REQUIRED_MAX_AGE_HOURS:-48}"
  local now last_success age_hours
  now="$(date +%s)"
  if ! last_success="$(backup_last_success_epoch)"; then
    if [[ "$policy" == "STRICT" ]] || { [[ "$policy" == "BALANCED" ]] && service_strict_backup_required "$svc"; }; then
      die "Refusing to update $svc: no successful backup timestamp found in $DOMUM_LOG_DIR/last-success"
    fi
    echo "[domum-media] WARNING: no successful backup timestamp found; continuing because BACKUP_POLICY=$BACKUP_POLICY"
    return 0
  fi
  age_hours=$(( (now - last_success) / 3600 ))
  if (( age_hours > max_age_hours )); then
    if [[ "$policy" == "STRICT" ]] || { [[ "$policy" == "BALANCED" ]] && service_strict_backup_required "$svc"; }; then
      die "Refusing to update $svc: latest successful backup is ${age_hours}h old (limit ${max_age_hours}h)"
    fi
    echo "[domum-media] WARNING: latest successful backup for $svc is ${age_hours}h old; continuing because BACKUP_POLICY=$BACKUP_POLICY"
  fi
}

# Docker health as THREE answers, not two.
#
# `starting` is the one that matters. For StartPeriod after a restart Docker
# reports `starting`, and the previous code only rejected `unhealthy` -- so
# `starting` read as healthy and `wait_for_service_health` returned on its FIRST
# poll, before the healthcheck had run even once. Measured on this host:
#
#   kavita   Healthcheck.Test = ["CMD-SHELL","curl -fsS http://localhost:5000/api/health || exit 1"]
#            StartPeriod=30s Interval=30s Timeout=15s Retries=3
#
# So for the first ~30 seconds after the migration restarts kavita, "healthy"
# meant nothing more than "docker start returned". Kavita was chosen as migration
# #2 precisely because that healthcheck is a real HTTP request to the application,
# and the migration was throwing the only application-level signal it has away.
#
# `none` is kept distinct from `healthy` for the opposite reason: jellyfin, plex,
# navidrome, calibre-web and traefik have no healthcheck at all, so there is
# nothing to wait for and "the container is running" is the whole claim. Callers
# must not report that as application health.
#
# Precedence across a multi-container service (immich has four): unhealthy >
# starting > healthy > none. One container still starting means the service is
# still starting.
# An application-level readiness signal for services with no healthcheck and no
# host-published port, needing no networking, no credentials and no production
# change: the line the application itself writes when it is actually serving.
#
# "the container is running" is not application health, and for navidrome it was
# all that could be claimed -- no Docker healthcheck, port 4533 published only to
# the proxy network. But it logs, on stdout, after opening and migrating its
# database and binding its listener:
#
#   goose: successfully migrated database to version: 20260703013908
#   Started watcher for library libraryID=1 path=/music
#   ----> Navidrome server is ready! address="0.0.0.0:4533" startupTime=128.3ms
#
# That is strictly stronger than a process check: it proves the application opened
# the MIGRATED database and reached its listener.
#
# A log pattern is admittedly fragile -- an upstream wording change breaks it. The
# failure is safe (the migration refuses, having deleted nothing) and says exactly
# what it looked for, which is the right trade for the only application evidence
# some services offer. Patterns are pinned by tests.
#
# Empty means "no pattern known": callers must then say that plainly rather than
# implying application health.
service_ready_log_pattern() {  # $1 = service
  case "$1" in
    navidrome)   printf 'Navidrome server is ready!' ;;
    # The LinuxServer.io init script's own probe of PMS's listener, observed on
    # this host across a real restart:
    #
    #   Starting Plex Media Server. . . (you can ignore the libusb_init error)
    #   Connection to localhost (::1) 32400 port [tcp/*] succeeded!
    #   [ls.io-init] done.
    #
    # WEAKER than navidrome's, and the difference matters: navidrome logs readiness
    # after opening and migrating its database, whereas this proves only that the
    # TCP listener came up. Plex's databases are covered instead by the snapshot
    # integrity check, which opens both of them.
    #
    # `Critical: libusb_init failed` arrives about 12s later and is benign -- the
    # image says so itself -- which is why readiness is matched on a positive
    # signal rather than inferred from an absence of scary words.
    plex)        printf 'port [tcp/*] succeeded!' ;;
    # kavita has a real HTTP healthcheck (curl /api/health), which is a stronger
    # signal than a log line, so nothing is added here.
    *)           printf '' ;;
  esac
}

# Did the application log readiness at or after $2? 0 yes, 1 no, 2 nothing to look for.
#
# $2 is UTC, `YYYY-MM-DDTHH:MM:SS`, as `date -u` produces it.
#
# `docker logs --since` is NOT trusted to decide this. A bare timestamp with no
# zone is interpreted in the CALLER'S timezone, so the same call gives different
# answers on the same host. Measured, against a readiness line at 17:56:58Z:
#
#   TZ=UTC               --since 2026-09-29T17:56:00   -> 1 match
#   TZ=America/New_York  --since 2026-09-29T17:56:00   -> 0 matches
#   any TZ               --since 2026-09-29T17:56:00Z  -> 1 match
#
# West of UTC that is a false NEGATIVE: a correct migration aborts because the
# window starts in the future. East of UTC it is a false POSITIVE, which is worse
# -- the window opens hours early and a readiness line from a PREVIOUS start
# satisfies the check. The navidrome migration passed only because the environment
# it ran under happened to resolve the bare stamp as UTC.
#
# So the `Z` is appended, and the line's OWN timestamp is compared as well, which
# removes the dependence on how `--since` is parsed at all. Compared to
# whole-second precision: docker stamps `17:56:58.386777720Z` and the boundary is
# `17:56:58`, and lexicographically '.' sorts before 'Z', so a nanosecond stamp in
# the same second would otherwise be read as earlier than the boundary.
service_logged_ready_since() {  # $1 = service, $2 = UTC YYYY-MM-DDTHH:MM:SS
  local svc="$1" since="$2" pat compose_svcs compose_svc cid logs line stamp
  pat="$(service_ready_log_pattern "$svc")"
  [[ -n "$pat" ]] || return 2
  compose_svcs="$(service_compose_services "$svc" || true)"
  [[ -n "$compose_svcs" ]] || return 1
  local boundary="${since:0:19}"
  for compose_svc in $compose_svcs; do
    cid="$(tracked_service_container_id_any "$compose_svc" 2>/dev/null || true)"
    [[ -n "$cid" ]] || continue
    # `-t` prefixes each line with an RFC3339Nano UTC timestamp, which is what the
    # comparison below reads. Captured first, NOT piped into `grep -q`: under
    # pipefail grep exits at the first match, docker takes SIGPIPE, and the
    # pipeline reports 141 -- so a match reads as no-match. CLAUDE.md section 8.
    logs="$(docker logs -t --since "${boundary}Z" "$cid" 2>&1 || true)"
    while IFS= read -r line; do
      [[ "$line" == *"$pat"* ]] || continue
      stamp="${line:0:19}"
      # Not older than the boundary. A readiness line from a previous start is
      # exactly what this must not accept.
      [[ "$stamp" < "$boundary" ]] || return 0
    done <<< "$logs"
  done
  return 1
}

service_health_state() {  # -> healthy | starting | unhealthy | stopped | none
  local svc="$1" compose_svcs compose_svc cid status health worst=none

  compose_svcs="$(service_compose_services "$svc" || true)"
  [[ -n "$compose_svcs" ]] || { printf 'stopped'; return 0; }

  for compose_svc in $compose_svcs; do
    cid="$(tracked_service_container_id "$compose_svc")"
    [[ -n "$cid" ]] || { printf 'stopped'; return 0; }
    status="$(docker inspect --format '{{.State.Status}}' "$cid" 2>/dev/null || true)"
    [[ "$status" == "running" ]] || { printf 'stopped'; return 0; }
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || true)"
    case "$health" in
      unhealthy) printf 'unhealthy'; return 0 ;;
      starting)  worst=starting ;;
      healthy)   [[ "$worst" == "none" ]] && worst=healthy ;;
      *)         ;;
    esac
  done

  printf '%s' "$worst"
}

service_is_healthy() {
  local svc="$1"
  local state health_url

  state="$(service_health_state "$svc")"
  case "$state" in
    healthy|none) ;;
    *) return 1 ;;
  esac

  health_url="$(service_health_url "$svc" || true)"
  if [[ -n "$health_url" ]] && cmd_exists curl; then
    curl -fsS --max-time 10 "$health_url" >/dev/null 2>&1 || return 1
  fi

  return 0
}

# What a service is RUNNING, versus what its image tag resolves to right now.
#
# `docker compose up -d` recreates a container whose image has changed. That is
# what it is for -- and it means every command that restarts a service deploys
# whatever image has been pulled since the service last started. CLAUDE.md section 4
# says image discovery, pulling and staging must never automatically imply
# deployment, and section 11 makes application/image deployment and broad container
# recreation operator boundaries. A storage migration restarting a service is
# therefore an image-deployment vector, and it fired:
#
#   the Kavita migration recreated its container on jvmilazz0/kavita:latest built
#   2026-08-28, and Kavita forward-migrated its database on startup -- schema
#   migrations dated 2026-08-12..18 that the proof snapshot, taken minutes
#   earlier, does not contain. Nothing was lost and the service is healthy, but
#   the application was upgraded by a storage operation, and the recovery point
#   is now an OLDER schema than the running binary.
#
# Measured on this host the same day: uptime-kuma, traefik, plex and calibre-web
# all have a newer image staged under their existing tag. Two of them are
# migration candidates.
#
# Prints one line per compose service, prefixed with a verdict, and NEVER nothing
# for a case it could not decide.
#
#   STAGED  <svc> <running> <tag-now>   the tag resolves to a different image
#   UNKNOWN <svc> <reason>              could not be determined
#   ABSENT  <svc>                       no container at all, running or stopped to compare against
#
# The first version returned nothing for every undecidable case, so it reported
# "no staged image" when it had simply failed to look -- and it failed to look
# unprivileged, where `compose ps -q` produces no container id. Measured: four
# services with a newer image staged came back clean. A guard that fails OPEN is
# worse than no guard, because it is trusted.
#
# ABSENT is not the same as stopped. A STOPPED container still has an image, and
# it is inspected like any other. Only a service with no container at all has no
# identity to preserve -- and the migration's answer to that is to leave it with
# no container, not to create one.
service_staged_image_changes() {  # $1 = service
  local svc="$1" compose_svcs compose_svc cid run_img tag tag_img
  compose_svcs="$(service_compose_services "$svc" || true)"
  if [[ -z "$compose_svcs" ]]; then
    printf 'UNKNOWN %s no compose services mapped\n' "$svc"
    return 0
  fi
  for compose_svc in $compose_svcs; do
    # -qa, so a STOPPED container is inspected rather than reported as absent:
    # its image identity is exactly as knowable as a running one's.
    cid="$(tracked_service_container_id_any "$compose_svc" 2>/dev/null || true)"
    if [[ -z "$cid" ]]; then
      printf 'ABSENT %s\n' "$compose_svc"
      continue
    fi
    run_img="$(docker inspect --format '{{.Image}}' "$cid" 2>/dev/null || true)"
    tag="$(docker inspect --format '{{.Config.Image}}' "$cid" 2>/dev/null || true)"
    if [[ -z "$run_img" || -z "$tag" ]]; then
      printf 'UNKNOWN %s could not inspect container %s\n' "$compose_svc" "$cid"
      continue
    fi
    tag_img="$(docker inspect --format '{{.Id}}' "$tag" 2>/dev/null || true)"
    if [[ -z "$tag_img" ]]; then
      # The tag is not present locally, so `up -d` would pull it and there is
      # nothing here to compare. Reported, not swallowed: the post-restart
      # comparison is what catches the outcome.
      printf 'UNKNOWN %s tag %s is not present locally; up -d would pull\n' "$compose_svc" "$tag"
      continue
    fi
    if [[ "$run_img" != "$tag_img" ]]; then
      printf 'STAGED %s %s %s\n' "$compose_svc" "$run_img" "$tag_img"
    fi
  done
}

# The image each of a service's containers is running, as "<svc> <image-id>" lines.
# Compared across a stop/start to catch a deployment that happened anyway --
# including the one service_staged_image_changes cannot predict, where the tag is
# not present locally and `up -d` pulls it.
service_running_images() {  # $1 = service
  local svc="$1" compose_svcs compose_svc cid img
  compose_svcs="$(service_compose_services "$svc" || true)"
  [[ -n "$compose_svcs" ]] || return 0
  for compose_svc in $compose_svcs; do
    cid="$(tracked_service_container_id_any "$compose_svc")"
    [[ -n "$cid" ]] || continue
    img="$(docker inspect --format '{{.Image}}' "$cid" 2>/dev/null || true)"
    printf '%s %s\n' "$compose_svc" "${img:-none}"
  done
}

wait_for_service_health() {
  local svc="$1"
  local timeout="${2:-120}"
  local interval="${3:-5}"
  local elapsed=0

  while (( elapsed < timeout )); do
    if service_is_healthy "$svc"; then
      return 0
    fi
    sleep "$interval"
    elapsed=$(( elapsed + interval ))
  done

  service_is_healthy "$svc"
}

# ---- compose layering ------------------------------------------------------

compose_files_for_enabled_services() {
  local files=()
  files+=("$DOMUM_DIR/compose/base.yml")

  if [[ "${ENABLE_TRAEFIK:-0}" == "1" ]]; then
    files+=("$DOMUM_DIR/compose/proxy/traefik.yml")
  fi
  if [[ "${ENABLE_TAILSCALE:-0}" == "1" ]]; then
    files+=("$DOMUM_DIR/compose/security/tailscale.yml")
  fi
  if [[ "${ENABLE_IMMICH:-0}" == "1" ]]; then
    files+=("$DOMUM_DIR/compose/photos/immich.yml")
  fi
  if [[ "${ENABLE_JELLYFIN:-0}" == "1" ]]; then
    files+=("$DOMUM_DIR/compose/media/jellyfin.yml")
  fi
  if [[ "${ENABLE_PLEX:-0}" == "1" ]]; then
    files+=("$DOMUM_DIR/compose/media/plex.yml")
  fi
  if [[ "${ENABLE_NAVIDROME:-0}" == "1" ]]; then
    files+=("$DOMUM_DIR/compose/media/navidrome.yml")
  fi
  if [[ "${ENABLE_CALIBRE_WEB:-0}" == "1" ]]; then
    files+=("$DOMUM_DIR/compose/media/calibre-web.yml")
  fi
  if [[ "${ENABLE_KAVITA:-0}" == "1" ]]; then
    files+=("$DOMUM_DIR/compose/media/kavita.yml")
  fi
  if [[ "${ENABLE_UPTIME_KUMA:-0}" == "1" ]]; then
    files+=("$DOMUM_DIR/compose/monitoring/uptime-kuma.yml")
  fi
  if [[ "${ENABLE_RESTIC_REST_SERVER:-0}" == "1" ]]; then
    files+=("$DOMUM_DIR/compose/backups/restic-rest-server.yml")
  fi

  for f in "${files[@]}"; do
    [[ -f "$f" ]] || die "Missing compose file: $f"
    echo "-f"
    echo "$f"
  done
}

