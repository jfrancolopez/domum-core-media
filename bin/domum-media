#!/usr/bin/env bash
set -euo pipefail

# domum-media — host CLI for domum-core-media.
# Adds config-driven service toggles, timer schedule syncing, and a simple
# interactive configuration flow on top of the compose + restic wrappers.

DOMUM_DIR="${DOMUM_DIR:-/opt/domum-core-media}"
CFG_FILE="${CFG_FILE:-$DOMUM_DIR/config/domum-media.conf}"
SECRETS_DIR="${SECRETS_DIR:-/etc/domum-core-media/secrets}"
DATA_ROOT_DEFAULT="/srv/data"
MEDIA_ROOT_DEFAULT="/srv/media"
SNAPSHOT_ROOT_DEFAULT="/srv/snapshots"
LOG_DIR_DEFAULT="/var/log/domum-media"
STATE_ROOT_DEFAULT="/var/lib/domum-media"
# Disposable, regenerable caches/transcodes live under $DOMUM_MEDIA_ROOT/.cache
# on the media (OS) disk; see DOMUM_CACHE_ROOT in load_cfg.

die()  { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "[domum-media] WARN: $*" >&2; }

need_root() {
  [[ "${EUID}" -eq 0 ]] || die "Run as root (use sudo)."
}

cmd_exists() { command -v "$1" >/dev/null 2>&1; }

uppercase_token() {
  printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_' | tr -c 'A-Z0-9_' '_'
}

load_cfg() {
  [[ -f "$CFG_FILE" ]] || die "Missing config: $CFG_FILE (copy domum-media.conf.example or run 'domum-media configure')"
  # shellcheck disable=SC1090
  source "$CFG_FILE"
  DOMUM_DATA_ROOT="${DOMUM_DATA_ROOT:-$DATA_ROOT_DEFAULT}"
  DOMUM_MEDIA_ROOT="${DOMUM_MEDIA_ROOT:-$MEDIA_ROOT_DEFAULT}"
  DOMUM_SNAPSHOT_ROOT="${DOMUM_SNAPSHOT_ROOT:-$SNAPSHOT_ROOT_DEFAULT}"
  DOMUM_LOG_DIR="${DOMUM_LOG_DIR:-$LOG_DIR_DEFAULT}"
  DOMUM_STATE_ROOT="${DOMUM_STATE_ROOT:-$STATE_ROOT_DEFAULT}"
  DOMUM_CACHE_ROOT="${DOMUM_CACHE_ROOT:-$DOMUM_MEDIA_ROOT/.cache}"
  # Deprecated: DOMUM_HOT_ROOT was a misnamed "hot tier". Caches now live on the
  # disposable media disk under $DOMUM_MEDIA_ROOT/.cache. Old configs that still
  # set it keep working — the value is ignored, with one deprecation warning.
  if [[ -n "${DOMUM_HOT_ROOT:-}" ]]; then
    warn "DOMUM_HOT_ROOT is deprecated and ignored. Caches now live under ${DOMUM_CACHE_ROOT}. Remove it (and KAVITA_STAGING_DIR/NAVIDROME_CACHE_DIR/HOT_STORAGE_PRUNE_*) from $CFG_FILE."
  fi
  BACKUP_POLICY="${BACKUP_POLICY:-STRICT}"
  BACKUP_REQUIRED_MAX_AGE_HOURS="${BACKUP_REQUIRED_MAX_AGE_HOURS:-48}"
  AUTO_ROLLBACK_ENABLED="${AUTO_ROLLBACK_ENABLED:-1}"
  RECOVERY_PACK_ENABLED="${RECOVERY_PACK_ENABLED:-1}"
  RECOVERY_PACK_ENCRYPTION="${RECOVERY_PACK_ENCRYPTION:-age}"
  RECOVERY_PACK_AGE_PUBKEY_FILE="${RECOVERY_PACK_AGE_PUBKEY_FILE:-$SECRETS_DIR/recovery_pack_pubkey}"
  RECOVERY_PACK_DEST="${RECOVERY_PACK_DEST:-$DOMUM_STATE_ROOT/recovery-pack}"
  RECOVERY_PACK_REMINDER_DAYS="${RECOVERY_PACK_REMINDER_DAYS:-30}"
  RECOVERY_PACK_EMAIL_ENABLED="${RECOVERY_PACK_EMAIL_ENABLED:-0}"
  RECOVERY_PACK_EMAIL_TO="${RECOVERY_PACK_EMAIL_TO:-${DOMUM_EMAIL:-}}"
  RECOVERY_PACK_EMAIL_FROM="${RECOVERY_PACK_EMAIL_FROM:-${DOMUM_EMAIL:-}}"
  RECOVERY_PACK_SMTP_HOST="${RECOVERY_PACK_SMTP_HOST:-}"
  RECOVERY_PACK_SMTP_PORT="${RECOVERY_PACK_SMTP_PORT:-465}"
  RECOVERY_PACK_SMTP_USERNAME_FILE="${RECOVERY_PACK_SMTP_USERNAME_FILE:-$SECRETS_DIR/recovery_pack_smtp_username}"
  RECOVERY_PACK_SMTP_PASSWORD_FILE="${RECOVERY_PACK_SMTP_PASSWORD_FILE:-$SECRETS_DIR/recovery_pack_smtp_password}"
  HOST_SECURITY_AUTO_UPDATE_ENABLED="${HOST_SECURITY_AUTO_UPDATE_ENABLED:-1}"
  HOST_AUTO_REBOOT_ENABLED="${HOST_AUTO_REBOOT_ENABLED:-0}"
  HOST_AUTO_REBOOT_WINDOW_START="${HOST_AUTO_REBOOT_WINDOW_START:-03:00}"
  HOST_AUTO_REBOOT_WINDOW_END="${HOST_AUTO_REBOOT_WINDOW_END:-05:00}"
}

ensure_cfg_file() {
  if [[ ! -f "$CFG_FILE" ]]; then
    echo "[domum-media] Creating config from example at $CFG_FILE"
    install -D -m 0644 "$DOMUM_DIR/config/domum-media.conf.example" "$CFG_FILE"
  fi
}

backup_target_names() {
  local names="${BACKUP_TARGETS:-nas cloud archive}"
  for name in $names; do
    [[ -n "$name" ]] && echo "$name"
  done
}

backup_target_default_enabled() {
  case "$1" in
    nas|cloud) echo "1" ;;
    *)         echo "0" ;;
  esac
}

backup_target_value() {
  local target="$1"
  local field="$2"
  local fallback="${3:-}"
  local key
  key="BACKUP_TARGET_$(uppercase_token "$target")_${field}"
  if [[ -n "${!key:-}" ]]; then
    printf '%s' "${!key}"
  else
    printf '%s' "$fallback"
  fi
}

backup_target_enabled() {
  [[ "$(backup_target_value "$1" ENABLED "$(backup_target_default_enabled "$1")")" == "1" ]]
}

enabled_backup_targets() {
  while IFS= read -r target; do
    backup_target_enabled "$target" || continue
    echo "$target"
  done < <(backup_target_names)
}

backup_target_password_file() {
  backup_target_value "$1" PASSWORD_FILE "$SECRETS_DIR/restic_password_$1"
}

backup_target_legacy_env_file() {
  printf '%s/restic_%s_env' "$SECRETS_DIR" "$1"
}

shell_join_quoted() {
  local joined=""
  printf -v joined '%q ' "$@"
  printf '%s' "${joined% }"
}

sftp_command_option_for_target() {
  local target="$1"
  local sftp_key sftp_known_hosts sftp_port repo
  local -a ssh_cmd=()
  local -a sftp_parts=()
  sftp_key="$(backup_target_value "$target" SFTP_KEY_FILE)"
  sftp_known_hosts="$(backup_target_value "$target" SFTP_KNOWN_HOSTS_FILE)"
  sftp_port="$(backup_target_value "$target" SFTP_PORT)"
  [[ -n "$sftp_key" ]] || return 1
  [[ -f "$sftp_key" ]] || return 1
  repo="$(backup_target_value "$target" REPOSITORY)"
  mapfile -t sftp_parts < <(sftp_repo_user_host "$repo") || return 1
  [[ -n "${sftp_parts[0]:-}" && -n "${sftp_parts[1]:-}" ]] || return 1
  ssh_cmd=(ssh -F /dev/null -i "$sftp_key")
  ssh_cmd+=(-o IdentitiesOnly=yes)
  ssh_cmd+=(-o PreferredAuthentications=publickey)
  ssh_cmd+=(-o PasswordAuthentication=no)
  ssh_cmd+=(-o StrictHostKeyChecking=yes)
  if [[ -n "$sftp_known_hosts" ]]; then
    [[ -f "$sftp_known_hosts" ]] || return 1
    ssh_cmd+=(-o UserKnownHostsFile="$sftp_known_hosts")
  fi
  if [[ -n "$sftp_port" ]]; then
    sftp_port_is_valid "$sftp_port" || return 1
    ssh_cmd+=(-p "$sftp_port")
  fi
  ssh_cmd+=("${sftp_parts[0]}@${sftp_parts[1]}" -s sftp)
  printf 'sftp.command=%s' "$(shell_join_quoted "${ssh_cmd[@]}")"
}

sftp_repo_user_host() {
  local repo="$1"
  local path
  [[ "$repo" =~ ^sftp:([A-Za-z0-9._-]+)@([A-Za-z0-9.-]+):(/.*)$ ]] || return 1
  path="${BASH_REMATCH[3]}"
  [[ "$path" != "/" && "$path" != *:* && "$path" != *[[:space:]]* ]] || return 1
  [[ "$path" != "/./"* && "$path" != *"/./"* && "$path" != *"/../"* ]] || return 1
  [[ "$path" != */. && "$path" != */.. ]] || return 1
  printf '%s\n%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
}

sftp_port_is_valid() {
  local port="$1"
  [[ "$port" =~ ^[0-9]+$ ]] || return 1
  (( 10#$port >= 1 && 10#$port <= 65535 ))
}

sftp_key_auth_works() {
  local target="$1"
  local repo user host sftp_key sftp_known_hosts sftp_port
  local -a ssh_cmd=()
  local -a sftp_parts=()
  repo="$(backup_target_value "$target" REPOSITORY)"
  mapfile -t sftp_parts < <(sftp_repo_user_host "$repo") || return 1
  user="${sftp_parts[0]:-}"
  host="${sftp_parts[1]:-}"
  sftp_key="$(backup_target_value "$target" SFTP_KEY_FILE)"
  sftp_known_hosts="$(backup_target_value "$target" SFTP_KNOWN_HOSTS_FILE)"
  sftp_port="$(backup_target_value "$target" SFTP_PORT)"
  [[ -z "$sftp_port" ]] || sftp_port_is_valid "$sftp_port" || return 1
  [[ -n "$user" && -n "$host" && -f "$sftp_key" ]] || return 1
  ssh_cmd=(ssh -F /dev/null -i "$sftp_key")
  ssh_cmd+=(-o BatchMode=yes)
  ssh_cmd+=(-o IdentitiesOnly=yes)
  ssh_cmd+=(-o PreferredAuthentications=publickey)
  ssh_cmd+=(-o PasswordAuthentication=no)
  ssh_cmd+=(-o StrictHostKeyChecking=yes)
  [[ -n "$sftp_known_hosts" ]] && ssh_cmd+=(-o UserKnownHostsFile="$sftp_known_hosts")
  [[ -n "$sftp_port" ]] && ssh_cmd+=(-p "$sftp_port")
  ssh_cmd+=("${user}@${host}" -s sftp)
  if cmd_exists timeout; then
    timeout 15 "${ssh_cmd[@]}" </dev/null >/dev/null 2>&1
  else
    "${ssh_cmd[@]}" </dev/null >/dev/null 2>&1
  fi
}

backup_env_line_is_valid() {
  local line="$1"
  [[ "$line" =~ ^[[:space:]]*$ ]] && return 0
  [[ "$line" =~ ^[[:space:]]*# ]] && return 0
  [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*= ]] && return 0
  return 1
}

validate_backup_env_file() {
  local path="$1"
  local line
  bash -n "$path" >/dev/null 2>&1 || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    backup_env_line_is_valid "$line" || return 1
  done < "$path"
}

validate_backup_env_content() {
  local tmp
  tmp="$(mktemp)"
  printf '%s' "$1" > "$tmp"
  if validate_backup_env_file "$tmp"; then
    rm -f "$tmp"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

validate_backup_env_file_or_die() {
  local path="$1"
  validate_backup_env_file "$path" \
    || die "Invalid backup env file: $path. It must contain valid shell export/key=value lines."
}

backup_target_has_repository_source() {
  local target="$1"
  [[ -n "$(backup_target_value "$target" REPOSITORY)" ]] && return 0
  [[ -f "$(backup_target_legacy_env_file "$target")" ]]
}

missing_if_absent() {
  local path="$1"
  local label="$2"
  [[ -f "$path" ]] || echo "$label"
}

ensure_secret_dir() {
  install -d -m 0700 "$SECRETS_DIR"
}

ensure_state_dirs() {
  install -d -m 0700 "$DOMUM_STATE_ROOT"
  install -d -m 0700 "$DOMUM_STATE_ROOT/image-updates"
  install -d -m 0700 "$DOMUM_STATE_ROOT/immich"
  install -d -m 0700 "$DOMUM_STATE_ROOT/snapshots"
  install -d -m 0700 "$DOMUM_STATE_ROOT/rollback"
  install -d -m 0700 "$DOMUM_STATE_ROOT/update-history"
  install -d -m 0700 "$RECOVERY_PACK_DEST"
}

update_history_dir() {
  printf '%s/update-history' "$DOMUM_STATE_ROOT"
}

rollback_index_dir() {
  printf '%s/rollback' "$DOMUM_STATE_ROOT"
}

recovery_pack_state_file() {
  printf '%s/last.env' "$RECOVERY_PACK_DEST"
}

epoch_to_iso() {
  date -d "@$1" +%Y-%m-%dT%H:%M:%S%z
}

human_age_from_epoch() {
  local then="$1"
  local now delta
  now="$(date +%s)"
  delta=$(( now - then ))
  if (( delta < 60 )); then
    printf '%ss' "$delta"
  elif (( delta < 3600 )); then
    printf '%sm' $(( delta / 60 ))
  elif (( delta < 86400 )); then
    printf '%sh' $(( delta / 3600 ))
  else
    printf '%sd' $(( delta / 86400 ))
  fi
}

json_escape() {
  jq -Rsa .
}

write_env_kv() {
  local path="$1"
  shift
  : > "$path"
  while (( $# >= 2 )); do
    printf "%s=%q\n" "$1" "$2" >> "$path"
    shift 2
  done
  chmod 600 "$path"
}

record_update_history() {
  local service="$1"
  local event="$2"
  local from_image="${3:-}"
  local to_image="${4:-}"
  local snapshot="${5:-}"
  local result="${6:-success}"
  local note="${7:-}"
  local ts stamp file
  ts="$(date +%s)"
  stamp="$(date +%Y%m%d-%H%M%S)"
  file="$(update_history_dir)/${service}-${stamp}.env"
  write_env_kv "$file" \
    SERVICE "$service" \
    EVENT "$event" \
    FROM_IMAGE "$from_image" \
    TO_IMAGE "$to_image" \
    SNAPSHOT "$snapshot" \
    RESULT "$result" \
    NOTE "$note" \
    TS "$ts"
}

record_rollback_entry() {
  local service="$1"
  local event="$2"
  local snapshot_name="$3"
  local image_before="${4:-}"
  local image_after="${5:-}"
  local status="${6:-available}"
  local ts id file
  ts="$(date +%s)"
  id="${service}-$(date +%Y%m%d-%H%M%S)"
  file="$(rollback_index_dir)/${id}.env"
  write_env_kv "$file" \
    ID "$id" \
    SERVICE "$service" \
    EVENT "$event" \
    SNAPSHOT "$DOMUM_SNAPSHOT_ROOT/$snapshot_name" \
    SNAPSHOT_NAME "$snapshot_name" \
    IMAGE_BEFORE "$image_before" \
    IMAGE_AFTER "$image_after" \
    TS "$ts" \
    STATUS "$status"
  printf '%s' "$id"
}

update_rollback_entry_status() {
  local file="$1"
  local new_status="$2"
  [[ -f "$file" ]] || return 0
  awk -v status="$new_status" '
    /^STATUS=/ { print "STATUS='\''" status "'\''"; next }
    { print }
  ' "$file" > "${file}.tmp"
  mv "${file}.tmp" "$file"
  chmod 600 "$file"
}

immich_postgres_data_dir() {
  printf '%s/immich/postgres' "$DOMUM_DATA_ROOT"
}

immich_postgres_marker() {
  printf '%s/PG_VERSION' "$(immich_postgres_data_dir)"
}

immich_db_password_file() {
  printf '%s/immich_db_password' "$SECRETS_DIR"
}

immich_jwt_secret_file() {
  printf '%s/immich_jwt_secret' "$SECRETS_DIR"
}

immich_db_password_fingerprint_file() {
  printf '%s/immich/db_password.sha256' "$DOMUM_STATE_ROOT"
}

immich_db_password_initialized() {
  [[ -f "$(immich_postgres_marker)" ]]
}

immich_library_data_dir() {
  printf '%s/immich/library' "$DOMUM_DATA_ROOT"
}

read_secret_file_value() {
  local path="$1"
  local value=""
  [[ -f "$path" ]] || return 1
  IFS= read -r -d '' value < "$path" || true
  # Trim all leading/trailing whitespace (spaces, tabs, CR, newlines). A stray
  # leading newline is non-empty, so it sails through compose's ${VAR:?} guard
  # and renders as "set" in `docker compose config`, yet the running container
  # ends up with an empty-looking value and Postgres/Immich auth mismatches.
  trim_spaces "$value"
}

immich_secret_empty_error() {
  local env_name="$1"
  local secret_file="$2"
  cat >&2 <<EOF
[domum-media] ERROR: Immich is enabled but ${env_name} is empty.
Expected secret file: ${secret_file}
Run: sudo domum-media configure
EOF
  exit 1
}

load_immich_secret_exports() {
  local db_file jwt_file
  db_file="$(immich_db_password_file)"
  jwt_file="$(immich_jwt_secret_file)"

  unset IMMICH_DB_PASSWORD IMMICH_JWT_SECRET

  if [[ -f "$db_file" ]]; then
    IMMICH_DB_PASSWORD="$(read_secret_file_value "$db_file")"
    export IMMICH_DB_PASSWORD
  fi
  if [[ -f "$jwt_file" ]]; then
    IMMICH_JWT_SECRET="$(read_secret_file_value "$jwt_file")"
    export IMMICH_JWT_SECRET
  fi
}

load_runtime_secrets() {
  unset CF_DNS_API_TOKEN

  if [[ -f "$SECRETS_DIR/cloudflare_api_token" ]]; then
    CF_DNS_API_TOKEN="$(read_secret_file_value "$SECRETS_DIR/cloudflare_api_token")"
    export CF_DNS_API_TOKEN
  fi

  load_immich_secret_exports
}

validate_immich_secret_exports() {
  [[ "${ENABLE_IMMICH:-0}" == "1" ]] || return 0

  local db_file jwt_file
  db_file="$(immich_db_password_file)"
  jwt_file="$(immich_jwt_secret_file)"

  [[ -f "$db_file" ]] || immich_secret_empty_error "IMMICH_DB_PASSWORD" "$db_file"
  [[ -f "$jwt_file" ]] || immich_secret_empty_error "IMMICH_JWT_SECRET" "$jwt_file"
  [[ -n "${IMMICH_DB_PASSWORD:-}" ]] || immich_secret_empty_error "IMMICH_DB_PASSWORD" "$db_file"
  [[ -n "${IMMICH_JWT_SECRET:-}" ]] || immich_secret_empty_error "IMMICH_JWT_SECRET" "$jwt_file"
}

# Rewrite Immich secret files with their trimmed value so any tool that reads
# the file directly (not via read_secret_file_value) also gets a clean value,
# and the on-disk sha256 fingerprint stays consistent with what compose loads.
# Trimming an already-clean file is a no-op.
sanitize_immich_secret_files() {
  [[ "${ENABLE_IMMICH:-0}" == "1" ]] || return 0

  local file raw trimmed
  for file in "$(immich_db_password_file)" "$(immich_jwt_secret_file)"; do
    [[ -f "$file" ]] || continue
    IFS= read -r -d '' raw < "$file" || true
    trimmed="$(trim_spaces "$raw")"
    if [[ "$raw" != "$trimmed" ]]; then
      echo "[domum-media] Sanitizing whitespace in $(basename "$file")"
      write_secret_file "$file" "$trimmed"
    fi
  done
}

trim_spaces() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

yaml_scalar_plaintext() {
  local value
  value="$(trim_spaces "$1")"
  if [[ "$value" == \"*\" && "$value" == *\" && "${#value}" -ge 2 ]]; then
    value="${value:1:${#value}-2}"
  elif [[ "$value" == \'*\' && "$value" == *\' && "${#value}" -ge 2 ]]; then
    value="${value:1:${#value}-2}"
  fi
  printf '%s' "$value"
}

yaml_scalar_is_set() {
  local value
  value="$(yaml_scalar_plaintext "$1")"
  [[ -n "$value" && "$value" != "null" && "$value" != "~" ]]
}

render_compose_config_file() {
  local output_file="$1"
  compose_cmd config > "$output_file"
}

compose_rendered_env_value() {
  local rendered_file="$1"
  local service_name="$2"
  local env_key="$3"

  awk -v service="$service_name" -v key="$env_key" '
    /^services:/ {
      in_services = 1
      next
    }
    in_services && $0 ~ "^  " service ":$" {
      in_service = 1
      in_env = 0
      next
    }
    in_service && $0 ~ "^  [^ ]" && $0 !~ "^  " service ":$" {
      in_service = 0
      in_env = 0
    }
    in_service && $0 ~ "^    environment:$" {
      in_env = 1
      next
    }
    in_service && in_env && $0 ~ "^    [^ ]" && $0 !~ "^    environment:$" {
      in_env = 0
    }
    in_service && in_env && $0 ~ "^      " key ":" {
      sub("^      " key ":[[:space:]]*", "", $0)
      print
      exit
    }
  ' "$rendered_file"
}

validate_immich_compose_config() {
  [[ "${ENABLE_IMMICH:-0}" == "1" ]] || return 0

  local rendered_file server_db_raw server_jwt_raw postgres_db_raw
  local server_db postgres_db

  validate_immich_secret_exports
  rendered_file="$(mktemp)"

  if ! render_compose_config_file "$rendered_file"; then
    rm -f "$rendered_file"
    die "docker compose config failed while validating Immich secrets."
  fi

  server_db_raw="$(compose_rendered_env_value "$rendered_file" "immich_server" "DB_PASSWORD")"
  server_jwt_raw="$(compose_rendered_env_value "$rendered_file" "immich_server" "JWT_SECRET")"
  postgres_db_raw="$(compose_rendered_env_value "$rendered_file" "immich_postgres" "POSTGRES_PASSWORD")"

  if ! yaml_scalar_is_set "$server_db_raw"; then
    rm -f "$rendered_file"
    die "Immich compose validation failed: immich_server DB_PASSWORD resolved empty from $(immich_db_password_file)"
  fi
  if ! yaml_scalar_is_set "$server_jwt_raw"; then
    rm -f "$rendered_file"
    die "Immich compose validation failed: immich_server JWT_SECRET resolved empty from $(immich_jwt_secret_file)"
  fi
  if ! yaml_scalar_is_set "$postgres_db_raw"; then
    rm -f "$rendered_file"
    die "Immich compose validation failed: immich_postgres POSTGRES_PASSWORD resolved empty from $(immich_db_password_file)"
  fi

  server_db="$(yaml_scalar_plaintext "$server_db_raw")"
  postgres_db="$(yaml_scalar_plaintext "$postgres_db_raw")"

  if [[ "$server_db" != "$postgres_db" ]]; then
    rm -f "$rendered_file"
    die "Immich compose validation failed: immich_server DB_PASSWORD and immich_postgres POSTGRES_PASSWORD do not match."
  fi

  echo "[domum-media] Immich compose env validation:"
  echo "  DB_PASSWORD: set"
  echo "  POSTGRES_PASSWORD: set"
  echo "  JWT_SECRET: set"
  echo "  DB_PASSWORD == POSTGRES_PASSWORD: yes"

  rm -f "$rendered_file"
}

sha256_of_file() {
  local path="$1"
  [[ -f "$path" ]] || return 1
  if cmd_exists sha256sum; then
    sha256sum "$path" | awk '{print $1}'
  elif cmd_exists shasum; then
    shasum -a 256 "$path" | awk '{print $1}'
  elif cmd_exists openssl; then
    openssl dgst -sha256 "$path" | awk '{print $NF}'
  else
    die "No sha256 utility available (need sha256sum, shasum, or openssl)."
  fi
}

write_immich_db_password_fingerprint() {
  local secret_file fp_file digest
  secret_file="$(immich_db_password_file)"
  fp_file="$(immich_db_password_fingerprint_file)"
  [[ -f "$secret_file" ]] || return 0
  digest="$(sha256_of_file "$secret_file")"
  install -d -m 0700 "$(dirname "$fp_file")"
  umask 077
  printf '%s\n' "$digest" > "$fp_file"
  chmod 600 "$fp_file"
}

validate_immich_db_password_state() {
  [[ "${ENABLE_IMMICH:-0}" == "1" ]] || return 0

  local secret_file fp_file pg_marker
  secret_file="$(immich_db_password_file)"
  fp_file="$(immich_db_password_fingerprint_file)"
  pg_marker="$(immich_postgres_marker)"

  validate_immich_secret_exports

  if [[ ! -f "$pg_marker" ]]; then
    # First boot path. apply() will write the fingerprint after compose up.
    return 0
  fi

  local current_digest stored_digest
  current_digest="$(sha256_of_file "$secret_file")"

  if [[ ! -f "$fp_file" ]]; then
    die "Immich Postgres data exists at $(immich_postgres_data_dir) but no password fingerprint is recorded at $fp_file.
  Refusing to apply because the original database password cannot be verified.
  Restore the original fingerprint or run: sudo domum-media immich reset-db"
  fi

  stored_digest="$(head -n1 "$fp_file" | tr -d '[:space:]')"

  if [[ "$current_digest" == "$stored_digest" ]]; then
    return 0
  fi

  cat >&2 <<EOF
[domum-media] ERROR: Immich Postgres password mismatch.

  The password stored in $secret_file
  does not match what $(immich_postgres_data_dir) was initialized with.

  Postgres only applies POSTGRES_PASSWORD during the very first initdb,
  so changing the secret after Immich was deployed leaves the database
  with the old password and Immich looping on auth failure.

  To recover, do exactly one of:

    1. Restore the previous password:
         sudo domum-media configure
       and re-enter the password Postgres was born with.

    2. Wipe the existing Immich database (DESTROYS PHOTOS METADATA;
       blobs in $DOMUM_DATA_ROOT/immich/library are untouched but unusable
       until you re-import):
         sudo domum-media immich reset-db

  Refusing to apply.
EOF
  exit 1
}

converge_local_installation() {
  install -m 0755 "$DOMUM_DIR/bin/domum-media" /usr/local/bin/domum-media
  install -m 0755 "$DOMUM_DIR/bin/domum-media-backup" /usr/local/bin/domum-media-backup
  install -D -m 0755 "$DOMUM_DIR/bin/domum-media-report" /usr/local/lib/domum-media/domum-media-report
  install -D -m 0644 "$DOMUM_DIR/logrotate/domum-media" /etc/logrotate.d/domum-media
  install -m 0644 "$DOMUM_DIR"/systemd/*.service /etc/systemd/system/
  install -m 0644 "$DOMUM_DIR"/systemd/*.timer /etc/systemd/system/
  # Drop-ins for units this project does not own. Currently one: docker.service
  # must not start before /srv/data is mounted, or it would create the missing
  # bind-mount sources on the OS disk and every service would come up empty.
  # Installed here so it survives a reinstall; it changes nothing until the next
  # boot, and does not restart Docker.
  local dropin
  for dropin in "$DOMUM_DIR"/systemd/*.service.d/*.conf; do
    [[ -e "$dropin" ]] || continue
    install -D -m 0644 "$dropin" \
      "/etc/systemd/system/$(basename "$(dirname "$dropin")")/$(basename "$dropin")"
  done
  systemctl daemon-reload
}

write_secret_file() {
  local path="$1"
  local value="$2"
  ensure_secret_dir
  umask 077
  printf '%s' "$value" > "$path"
  chmod 600 "$path"
}

generate_secret() {
  local bytes="${1:-32}"
  openssl rand -hex "$bytes"
}

prompt_secret_value() {
  local label="$1"
  local current_file="${2:-}"
  local reply
  if [[ -n "$current_file" && -f "$current_file" ]]; then
    read -r -s -p "$label [saved, leave blank to keep]: " reply
  else
    read -r -s -p "$label: " reply
  fi
  echo
  printf '%s' "$reply"
}

prompt_multiline_value() {
  local label="$1"
  local current_file="${2:-}"
  local line content=""
  local saw_input=0

  if [[ -n "$current_file" && -f "$current_file" ]]; then
    echo "$label [saved]" >&2
  else
    echo "$label" >&2
  fi
  echo "Enter lines now. Finish with a single '.' on its own line." >&2
  echo "Submit just '.' to keep the current file unchanged." >&2

  while IFS= read -r line; do
    if [[ "$line" == "." ]]; then
      (( saw_input == 0 )) && return 10
      break
    fi
    saw_input=1
    content+="${line}"$'\n'
  done

  (( saw_input == 0 )) && return 10
  printf '%s' "$content"
}

htpasswd_hash() {
  local username="$1"
  local password="$2"

  if cmd_exists htpasswd; then
    htpasswd -nbB "$username" "$password"
    return 0
  fi

  if cmd_exists docker; then
    docker run --rm --entrypoint htpasswd httpd:2.4-alpine -nbB "$username" "$password"
    return 0
  fi

  die "Need either 'htpasswd' or Docker to generate Traefik dashboard credentials."
}

