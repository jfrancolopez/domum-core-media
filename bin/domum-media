render_traefik_dynamic() {
  [[ "${ENABLE_TRAEFIK:-0}" == "1" ]] || return 0

  local dir="$DOMUM_DIR/compose/proxy/traefik/dynamic"
  [[ -d "$dir" ]] || return 0

  : "${TRAEFIK_DASHBOARD_HOST:?TRAEFIK_DASHBOARD_HOST is empty}"
  : "${DOMUM_DOMAIN:?DOMUM_DOMAIN is empty}"

  if ! cmd_exists envsubst; then
    die "envsubst not found. Install gettext-base (apt install -y gettext-base) and retry."
  fi

  local src dst rendered
  shopt -s nullglob
  for src in "$dir"/*.tmpl; do
    dst="${src%.tmpl}"
    # envsubst takes the literal '${VAR}' allowlist; we do not want shell expansion here.
    # shellcheck disable=SC2016
    rendered="$(envsubst '${TRAEFIK_DASHBOARD_HOST} ${DOMUM_DOMAIN}' < "$src")"
    if [[ "$rendered" == *'{{'* ]] || printf '%s' "$rendered" | grep -qE '\$\{[A-Z_][A-Z0-9_]*\}'; then
      die "Unresolved placeholder in $src after render — refusing to write $dst"
    fi
    printf '%s' "$rendered" > "$dst.partial"
    mv "$dst.partial" "$dst"
    chmod 0644 "$dst"
    echo "[domum-media] Rendered $(basename "$dst")"
  done
  shopt -u nullglob
}

ensure_networks() {
  local nets=("domum-proxy" "domum-internal")
  for n in "${nets[@]}"; do
    if ! docker network inspect "$n" >/dev/null 2>&1; then
      echo "[domum-media] Creating docker network: $n"
      docker network create "$n" >/dev/null
    fi
  done
}

ensure_navidrome_permissions() {
  [[ "${ENABLE_NAVIDROME:-0}" == "1" ]] || return 0
  local data_dir="${NAVIDROME_DATA_DIR:-$DOMUM_DATA_ROOT/navidrome}"
  local music_root="${NAVIDROME_MUSIC_ROOT:-$DOMUM_MEDIA_ROOT/music}"
  local user="${NAVIDROME_USER:-0:0}"
  mkdir -p "$data_dir"
  # Only chown the durable Navidrome state dir — never the music library
  # (mounted :ro, read-only access is enough). Skip when running as root.
  if [[ "$user" != "0:0" && "$user" != "root" && -n "$user" ]]; then
    local uid="${user%%:*}" gid="${user##*:}"
    chown -R "${uid}:${gid}" "$data_dir" \
      || warn "Navidrome: could not chown $data_dir to $user"
  fi
  # Music root only needs to be readable/traversable by the configured uid.
  [[ -r "$music_root" && -x "$music_root" ]] \
    || warn "Navidrome: $music_root may not be readable by uid ${user%%:*}."
}

ensure_dirs() {
  ensure_secret_dir
  ensure_state_dirs
  mkdir -p "$DOMUM_LOG_DIR"
  mkdir -p "$DOMUM_DATA_ROOT" "$DOMUM_SNAPSHOT_ROOT" "$DOMUM_CACHE_ROOT"
  mkdir -p "${JELLYFIN_CONFIG_DIR:-$DOMUM_DATA_ROOT/jellyfin/config}"
  mkdir -p "${JELLYFIN_CACHE_DIR:-$DOMUM_CACHE_ROOT/jellyfin}"
  mkdir -p "${PLEX_CONFIG_DIR:-$DOMUM_DATA_ROOT/plex/config}"
  mkdir -p "${PLEX_TRANSCODE_DIR:-$DOMUM_CACHE_ROOT/plex-transcode}"
  mkdir -p "${NAVIDROME_DATA_DIR:-$DOMUM_DATA_ROOT/navidrome}"
  ensure_navidrome_permissions
  mkdir -p "${CALIBRE_WEB_CONFIG_DIR:-$DOMUM_DATA_ROOT/calibre-web/config}"
  mkdir -p "${KAVITA_CONFIG_DIR:-$DOMUM_DATA_ROOT/kavita/config}"
  # Parent root only; music sources (subfolders / NFS / rclone mounts) are
  # assembled by the operator per docs/SETUP-NAVIDROME.md.
  mkdir -p "${NAVIDROME_MUSIC_ROOT:-$DOMUM_MEDIA_ROOT/music}"
  mkdir -p "${CALIBRE_WEB_LIBRARY_DIR:-$DOMUM_MEDIA_ROOT/books}"
  mkdir -p "${KAVITA_LIBRARY_DIR:-$DOMUM_MEDIA_ROOT/books}"

  if [[ "${ENABLE_CALIBRE_WEB:-0}" == "1" ]]; then
    local lib_dir="${CALIBRE_WEB_LIBRARY_DIR:-$DOMUM_MEDIA_ROOT/books}"
    if [[ ! -f "$lib_dir/metadata.db" ]]; then
      warn "Calibre-Web: no Calibre library found at $lib_dir."
      warn "  Initialize one after 'apply' completes — see docs/SETUP-PLEX-BOOKS-STORAGE.md."
    fi
  fi
}

compose_cmd() {
  local -a args
  export_env_for_compose
  mapfile -t args < <(compose_files_for_enabled_services)
  cd "$DOMUM_DIR"
  # Close the operation lock's descriptor for this command.
  #
  # The lock lives in an open fd, which every child INHERITS. A child that
  # outlives the process that acquired the lock therefore keeps holding it --
  # and because there is deliberately no stale-lock reaper, the next backup
  # would wait its full timeout and then fail, every night, until reboot.
  #
  # `docker compose up -d` is the one place a locked operation execs something
  # that starts long-lived processes, so the fd is dropped here rather than
  # relying on every future caller to remember.
  if [[ -n "${DOMUM_LOCK_FD:-}" ]]; then
    docker compose "${args[@]}" "$@" {DOMUM_LOCK_FD}>&-
  else
    docker compose "${args[@]}" "$@"
  fi
}

# ---- btrfs snapshots ------------------------------------------------------

# BEGIN SHARED SUBVOLUME HELPER
# Kept byte-identical between bin/domum-media and bin/domum-media-report;
# tests/subvolume-detection-smoke.sh fails if they drift.
#
# There used to be THREE different answers to "is this a subvolume?":
#
#   * `btrfs subvolume show` in snapshot_create and create_service_snapshot
#   * inode == 256 in the migration path
#   * `btrfs subvolume show` again, inline, in the report
#
# They agree for a real nested subvolume, but not everywhere:
#
#   * `btrfs subvolume show` needs the btrfs tool AND root. Unprivileged, it
#     answers "no" for a genuine subvolume.
#   * inode 256 is a NECESSARY condition for a btrfs subvolume root, but not a
#     sufficient one: inode 256 is perfectly ordinary on ext4. `/srv/media` is
#     ext4, so that false positive is reachable on this host.
#
# One function, both signals, and the fallback no longer guesses across
# filesystems. The tool is authoritative when it can answer; otherwise inode 256
# is accepted only on a filesystem that is actually btrfs.
domum_is_subvolume() {
  local path="$1"
  [[ -n "$path" && -d "$path" ]] || return 1

  if command -v btrfs >/dev/null 2>&1 && [[ "$(id -u)" == "0" ]]; then
    btrfs subvolume show "$path" >/dev/null 2>&1
    return $?
  fi

  [[ "$(stat -f -c %T "$path" 2>/dev/null)" == "btrfs" ]] || return 1
  [[ "$(stat -c %i "$path" 2>/dev/null)" == "256" ]]
}
# Btrfs snapshots are NOT recursive: a snapshot of S contains an EMPTY DIRECTORY
# wherever a nested subvolume used to be. So a path being a subvolume does not
# mean a snapshot of it would contain everything under it.
#
# `-xdev` makes this cheap: nested subvolumes have their own st_dev, so find
# reports the boundary and never descends into it. Measured at 0.38s against the
# real 213 GB Immich tree.
domum_subvolume_nested_children() {
  local root="$1"
  [[ -d "$root" ]] || return 0
  find "$root" -xdev -mindepth 1 -type d -inum 256 2>/dev/null
}
# END SHARED SUBVOLUME HELPER

# Retained as names the call sites already read well with. Both now resolve to
# the single implementation above, so they can no longer disagree.
is_btrfs_subvol()   { domum_is_subvolume "$1"; }
path_is_subvolume() { domum_is_subvolume "$1"; }

# Resolved through service_data_path, NOT from hardcoded "$DOMUM_DATA_ROOT/<name>"
# literals.
#
# service_data_path honours JELLYFIN_CONFIG_DIR, PLEX_CONFIG_DIR,
# NAVIDROME_DATA_DIR, CALIBRE_WEB_CONFIG_DIR and KAVITA_CONFIG_DIR. The migration,
# create_service_snapshot and the report all go through it. This function did not,
# so with any of those set outside the default it operated on a path that does not
# exist -- silently skipped -- while per-service snapshots and the report worked
# fine against the real one. Same shape as the "three answers to is this a
# subvolume" defect, one layer up: two sources of truth for where a service lives.
snapshot_subvolumes() {
  local svc path
  for svc in immich jellyfin plex navidrome calibre-web kavita uptime-kuma traefik; do
    path="$(service_data_path "$svc" 2>/dev/null)" || continue
    [[ -n "$path" && -d "$path" ]] && printf '%s\n' "$path"
  done
}

# Returns non-zero when it created no snapshot at all. A run that protected
# nothing must never read as success to its caller.
snapshot_create() {
  local tag="${1:-manual}"
  local stamp created=0 skipped=0 failed=0
  stamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$DOMUM_SNAPSHOT_ROOT"
  while IFS= read -r subvol; do
    local name target service
    name="$(basename "$subvol")"
    target="$DOMUM_SNAPSHOT_ROOT/${name}-${stamp}-${tag}"
    if is_btrfs_subvol "$subvol"; then
      local nested_children
      nested_children="$(subvolume_nested_children "$subvol")"
      if [[ -n "$nested_children" ]]; then
        echo "[domum-media] Snapshot FAILED for $subvol: it contains nested subvolume(s), which would be empty in the snapshot" >&2
        printf '  %s\n' $nested_children >&2
        failed=$(( failed + 1 ))
        continue
      fi
      echo "[domum-media] Snapshot: $subvol -> $target"
      # Count a SUCCESS, never an attempt: `btrfs subvolume snapshot` can fail
      # (ENOSPC, target exists) on a path that really is a subvolume, and a gate
      # that counted the attempt would pass with no snapshot.
      if btrfs subvolume snapshot -r "$subvol" "$target" && [[ -d "$target" ]]; then
        service="$name"
        record_rollback_entry "$service" "$tag" "$(basename "$target")" "" "" >/dev/null
        created=$(( created + 1 ))
      else
        echo "[domum-media] Snapshot FAILED for $subvol" >&2
        failed=$(( failed + 1 ))
      fi
    else
      echo "[domum-media] Skipping non-subvolume path: $subvol"
      skipped=$(( skipped + 1 ))
    fi
  done < <(snapshot_subvolumes)
  echo "[domum-media] Snapshot '${tag}': ${created} created, ${skipped} skipped (not Btrfs subvolumes), ${failed} failed."
  # Any outright failure means protection cannot be claimed, even if another
  # subvolume succeeded.
  (( created > 0 && failed == 0 ))
}

snapshot_list() {
  if [[ ! -d "$DOMUM_SNAPSHOT_ROOT" ]]; then
    echo "[domum-media] No snapshot root at $DOMUM_SNAPSHOT_ROOT"
    return 0
  fi
  ls -1tr "$DOMUM_SNAPSHOT_ROOT"
}

snapshot_path_mtime() {
  local path="$1"
  if stat -c %Y "$path" >/dev/null 2>&1; then
    stat -c %Y "$path"
  else
    stat -f %m "$path"
  fi
}

service_snapshot_base_name() {
  local service="$1"
  local path
  path="$(service_data_path "$service" 2>/dev/null || echo "$service")"
  basename -- "$path"
}

# Ordered OLDEST FIRST, by the timestamp this code puts in the snapshot name --
# not by the directory mtime.
#
# `btrfs subvolume snapshot` copies the SOURCE subvolume root's mtime into the
# snapshot, so mtime is useless as a creation order. Measured on this host:
#
#   1790343086   s-20260101-000000-old
#   1790343087   s-20260601-000000-mid
#   1790343086   s-20261231-235959-newest     <- taken last, after a rollback
#
# Every snapshot of one service ties while the source root is untouched, and
# after a rollback -- when the live subvolume is recreated from an OLD snapshot
# and inherits its mtime -- a NEW snapshot sorts before existing ones. Ordered by
# mtime that list reads old, newest, mid: `snapshot_prune` deletes
# `snaps[0..drop-1]`, so it would have deleted the newest recovery point while
# keeping an older one, and `latest_snapshot_for_service` (tail -1) would have
# named the wrong snapshot as the latest -- which the report then quotes.
#
# The name carries `-YYYYMMDD-HHMMSS-` and this code generates it, so it is both
# authoritative and stable. A name without that field is EXCLUDED rather than
# ordered arbitrarily: it would otherwise be either pruned first (deleting
# something we did not create) or reported as the latest snapshot. It is
# announced on stderr so it is not simply invisible; `snapshot list` still shows it.
list_snapshots_for_base() {
  local base="$1"
  local tmp_file path name stamp

  [[ -d "$DOMUM_SNAPSHOT_ROOT" ]] || return 0

  tmp_file="$(mktemp)"
  shopt -s nullglob
  for path in "$DOMUM_SNAPSHOT_ROOT"/"$base"-*; do
    [[ -d "$path" ]] || continue
    name="$(basename -- "$path")"
    # ANCHORED to the base name. Unanchored, `^.*-` is greedy and matches the last
    # stamp anywhere in the name, so the glob "jellyfin-*" pulled in
    # "jellyfin-extra-20260301-000000-c" and counted another service's snapshots
    # toward jellyfin's retention -- and with a tight keep would have deleted
    # jellyfin's real snapshots while preserving the other service's. Measured:
    #
    #   list_snapshots_for_base jellyfin  ->  jellyfin-20260101-000000-a
    #                                         jellyfin-20260201-000000-b
    #                                         jellyfin-extra-20260301-000000-c   <-- wrong
    #                                         jellyfin-extra-20260401-000000-d   <-- wrong
    #
    # Not reachable with today's service names, because none is a "-"-prefix of
    # another. Adding one (plex-hd, immich-ml) would arm it silently.
    # Two different questions, and conflating them produced noise: "is this a
    # snapshot at all?" and "is it THIS base's snapshot?".
    if [[ ! "$name" =~ -[0-9]{8}-[0-9]{6}(-|$) ]]; then
      # No timestamp anywhere: not something this code created. Announced, because
      # it is then neither pruned nor reported as the latest snapshot.
      printf '%s\n' "[domum-media] Ignoring snapshot with an unrecognised name: $name" >&2
      continue
    fi
    stamp="$(printf '%s' "$name" | sed -nE "s/^${base}-([0-9]{8})-([0-9]{6})(-.*)?\$/\1\2/p")"
    # A valid snapshot belonging to a DIFFERENT base. Silently not ours.
    [[ -n "$stamp" ]] || continue
    printf '%s\t%s\n' "$stamp" "$name" >> "$tmp_file"
  done
  shopt -u nullglob

  if [[ -s "$tmp_file" ]]; then
    sort "$tmp_file" | cut -f2-
  fi
  rm -f "$tmp_file"
}

snapshot_metadata_dir() {
  printf '%s/snapshots' "$DOMUM_STATE_ROOT"
}

# The recovery evidence a filesystem snapshot cannot carry.
#
# `.premigration == proof snapshot` proves the DATA came across intact. It says
# nothing about which application wrote that data -- and an application that
# forward-migrates its schema on startup makes that the difference between a
# recovery point and a museum piece. The Kavita migration proved it: the snapshot
# holds a Kavita 0.9.0.2 database, and the service now runs 0.9.1.0.
#
# So a recovery point is not `service + snapshot`. It is
#
#     service + snapshot + the exact application image that wrote it
#
# and this is a REQUIRED part, not a note. Two phases, because the two facts
# become available at different times:
#
#   STAGE  before anything is stopped, while the containers that wrote the state
#          are still the ones running. The recovery point has no name yet.
#   BIND   once the proof snapshot exists and has its final name: append it and
#          rename atomically into place.
#
# Staging first is what makes the evidence describe the snapshot rather than
# whatever came up afterwards, and the atomic rename is what stops a half-written
# file from ever being mistaken for evidence.
#
# Deliberately NOT the rendered compose configuration: `docker compose config`
# interpolates secrets, and recovery evidence is kept for months in a file an
# operator will read. The compose CONFIG HASH that docker itself computes per
# container, plus the list of config files and their digests, identifies the
# configuration that produced the container without reproducing any of its values.
#
# Format is line-oriented `KEY='value'` so it can be sourced, with a header
# explaining itself to whoever finds it much later.
RECOVERY_METADATA_FORMAT=1

# An image ID proves IDENTITY. It does not prove the image can still be obtained:
# a local object can be pruned, and a mutable tag says nothing about what it will
# resolve to next year. Those are different claims and conflating them is how
# "application recovery verified" comes to rest on a string.
#
#   identity        the exact image this state was written by is known
#   local           that object is present on this host right now
#   registry-digest an immutable repo@sha256 reference is recorded
#   version-only    only the application version is known, not the image
#   unknown         nothing
#
# Recorded per container, never aggregated into a single reassuring word.
recovery_image_availability() {  # $1 = image id, $2 = repo digests (comma-separated)
  local img="$1" digests="$2" out=""
  [[ -n "$img" ]] && out="identity"
  [[ -n "$img" ]] && docker image inspect "$img" >/dev/null 2>&1 && out="${out},local"
  # A RepoDigest equal to the image ID is NOT an independent registry reference.
  # Measured on this host: docker reports
  #   RepoDigests = [jvmilazz0/kavita@sha256:454f2a77...]  ==  .Image
  # so treating it as a manifest digest would claim retrievability that has not
  # been established.
  if [[ -n "$digests" ]]; then
    local d bare
    for d in ${digests//,/ }; do
      bare="${d##*@}"
      [[ "$bare" == "$img" ]] && continue
      out="${out},registry-digest"
      break
    done
  fi
  printf '%s' "${out:-unknown}"
}

# Every key a complete recovery point must carry. Checked after the write, on the
# file as it lands, so a truncated or half-written file is a failure rather than
# evidence.
recovery_metadata_required_keys() {
  printf '%s\n' FORMAT SERVICE RECOVERY_POINT CAPTURED_AT DATA_PATH RUNTIME_STATE_BEFORE
}

# Validates a recovery file against what it claims to describe. Prints the first
# problem and returns non-zero.
verify_recovery_point_metadata() {  # $1 = file, $2 = expected service, $3 = expected point
  local file="$1" want_service="$2" want_point="$3" key
  [[ -s "$file" ]] || { printf 'missing or empty: %s' "$file"; return 1; }
  while IFS= read -r key; do
    grep -q "^${key}=" "$file" || { printf 'missing key %s' "$key"; return 1; }
  done < <(recovery_metadata_required_keys)

  local got_service got_point
  got_service="$(sed -nE "s/^SERVICE='(.*)'\$/\1/p" "$file" | head -1)"
  got_point="$(sed -nE "s/^RECOVERY_POINT='(.*)'\$/\1/p" "$file" | head -1)"
  [[ "$got_service" == "$want_service" ]] \
    || { printf 'names service %s, expected %s' "${got_service:-<none>}" "$want_service"; return 1; }
  [[ "$got_point" == "$want_point" ]] \
    || { printf 'names recovery point %s, expected %s' "${got_point:-<none>}" "$want_point"; return 1; }

  grep -q "^CONTAINER_1_SERVICE=" "$file" \
    || { printf 'records no containers at all'; return 1; }

  # A container claiming known identity must actually carry an image id. This is
  # the case a truncated write produces.
  local n ident img
  n=1
  while grep -q "^CONTAINER_${n}_SERVICE=" "$file"; do
    ident="$(sed -nE "s/^CONTAINER_${n}_IMAGE_IDENTITY='(.*)'\$/\1/p" "$file" | head -1)"
    img="$(sed -nE "s/^CONTAINER_${n}_IMAGE_ID='(.*)'\$/\1/p" "$file" | head -1)"
    [[ -n "$ident" ]] || { printf 'container %s has no IMAGE_IDENTITY' "$n"; return 1; }
    if [[ "$ident" == "known" && -z "$img" ]]; then
      printf 'container %s claims known identity with no image id' "$n"; return 1
    fi
    n=$(( n + 1 ))
  done
  return 0
}

# Phase 1: capture, before anything stops. Prints the staged file's path.
stage_recovery_point_metadata() {  # $1 = service, $2 = runtime state
  local service="$1" runtime_state="$2"
  local meta_dir staged compose_svcs compose_svc cid n=0
  meta_dir="$(snapshot_metadata_dir)"
  install -d -m 0700 "$meta_dir" || return 1
  staged="$(mktemp "$meta_dir/.staged-recovery.XXXXXX")" || return 1

  {
    printf '# domum-media recovery point evidence.\n'
    printf '#\n'
    printf '# What application was operating this state when the snapshot was taken.\n'
    printf '# A filesystem snapshot alone is NOT a complete rollback point: an application\n'
    printf '# that migrates its own schema on startup will forward-migrate restored data,\n'
    printf '# so restoring it under a newer image does not return the service to this state.\n'
    printf '#\n'
    printf '# IMAGE_AVAILABILITY says what is actually recoverable, and is not the same\n'
    printf '# claim as identity: identity,local means the object is here TODAY; without\n'
    printf '# registry-digest there is no immutable reference to fetch it again later.\n'
    printf '#\n'
    printf '# No secrets are recorded. The compose configuration is identified by digest,\n'
    printf '# not reproduced, because rendering it would interpolate secret values.\n'
    printf '#\n'
    printf '# RUNTIME_STATE_BEFORE is what the operator had: a migration preserves it.\n'
    printf '\n'
    printf "FORMAT='%s'\n" "$RECOVERY_METADATA_FORMAT"
    printf "SERVICE='%s'\n" "$service"
    printf "CAPTURED_AT='%s'\n" "$(date -Iseconds)"
    printf "DATA_PATH='%s'\n" "$(service_data_path "$service" 2>/dev/null || true)"
    printf "RUNTIME_STATE_BEFORE='%s'\n" "$runtime_state"
    printf "COMPOSE_PROJECT='%s'\n" "${COMPOSE_PROJECT_NAME:-domum-media}"
  } > "$staged" || { rm -f "$staged"; return 1; }

  # The same layered list compose_cmd passes, with the "-f" markers dropped.
  local f
  for f in $(compose_files_for_enabled_services 2>/dev/null | grep -v '^-f$' || true); do
    [[ -r "$f" ]] || continue
    n=$(( n + 1 ))
    printf "COMPOSE_FILE_%s='%s'\n" "$n" "$f" >> "$staged" || { rm -f "$staged"; return 1; }
    printf "COMPOSE_FILE_%s_SHA256='%s'\n" "$n" "$(sha256sum "$f" | cut -d' ' -f1)" >> "$staged" \
      || { rm -f "$staged"; return 1; }
  done

  compose_svcs="$(service_compose_services "$service" || true)"
  n=0
  for compose_svc in $compose_svcs; do
    n=$(( n + 1 ))
    cid="$(tracked_service_container_id_any "$compose_svc" 2>/dev/null || true)"
    if [[ -z "$cid" ]]; then
      {
        printf "CONTAINER_%s_SERVICE='%s'\n" "$n" "$compose_svc"
        printf "CONTAINER_%s_IMAGE_IDENTITY='unknown'\n" "$n"
        printf "CONTAINER_%s_IMAGE_AVAILABILITY='unknown'\n" "$n"
        printf "CONTAINER_%s_NOTE='no container existed when this point was captured'\n" "$n"
      } >> "$staged" || { rm -f "$staged"; return 1; }
      continue
    fi
    local img ref digests created ver rev chash avail
    img="$(docker inspect --format '{{.Image}}' "$cid" 2>/dev/null || true)"
    ref="$(docker inspect --format '{{.Config.Image}}' "$cid" 2>/dev/null || true)"
    chash="$(docker inspect --format '{{index .Config.Labels "com.docker.compose.config-hash"}}' "$cid" 2>/dev/null || true)"
    digests="$(docker image inspect --format '{{join .RepoDigests ","}}' "$img" 2>/dev/null || true)"
    created="$(docker image inspect --format '{{.Created}}' "$img" 2>/dev/null || true)"
    ver="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "$img" 2>/dev/null || true)"
    rev="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$img" 2>/dev/null || true)"
    avail="$(recovery_image_availability "$img" "$digests")"
    {
      printf "CONTAINER_%s_SERVICE='%s'\n" "$n" "$compose_svc"
      printf "CONTAINER_%s_IMAGE_IDENTITY='%s'\n" "$n" "$([[ -n "$img" ]] && printf 'known' || printf 'unknown')"
      printf "CONTAINER_%s_IMAGE_AVAILABILITY='%s'\n" "$n" "$avail"
      printf "CONTAINER_%s_ID='%s'\n" "$n" "$cid"
      printf "CONTAINER_%s_IMAGE_ID='%s'\n" "$n" "$img"
      # The tag the container was created from. MUTABLE: it may point elsewhere
      # already, which is the whole reason the image ID above is recorded.
      printf "CONTAINER_%s_IMAGE_REF='%s'\n" "$n" "$ref"
      printf "CONTAINER_%s_IMAGE_REPO_DIGESTS='%s'\n" "$n" "$digests"
      printf "CONTAINER_%s_IMAGE_CREATED='%s'\n" "$n" "$created"
      printf "CONTAINER_%s_IMAGE_LABEL_VERSION='%s'\n" "$n" "$ver"
      printf "CONTAINER_%s_IMAGE_LABEL_REVISION='%s'\n" "$n" "$rev"
      printf "CONTAINER_%s_COMPOSE_CONFIG_HASH='%s'\n" "$n" "$chash"
    } >> "$staged" || { rm -f "$staged"; return 1; }
  done

  chmod 600 "$staged" 2>/dev/null || true
  printf '%s' "$staged"
}

# Phase 2: bind the staged evidence to the recovery point that now exists, and
# prove it landed. Atomic: the name only appears once the content is complete.
bind_recovery_point_metadata() {  # $1 = staged file, $2 = service, $3 = point
  local staged="$1" service="$2" point="$3"
  local meta_dir final problem
  [[ -s "$staged" ]] || { warn "recovery evidence: staged file is missing or empty"; return 1; }
  meta_dir="$(snapshot_metadata_dir)"
  final="$meta_dir/${point}.recovery"

  printf "RECOVERY_POINT='%s'\n" "$point" >> "$staged" \
    || { warn "recovery evidence: could not bind it to $point"; return 1; }
  # Durable before it is visible: a rename that survives while the content does
  # not is the one outcome worse than no file.
  sync -f "$staged" 2>/dev/null || sync 2>/dev/null || true
  mv -- "$staged" "$final" \
    || { warn "recovery evidence: could not move it into place at $final"; return 1; }

  if ! problem="$(verify_recovery_point_metadata "$final" "$service" "$point")"; then
    warn "recovery evidence at $final is not usable: $problem"
    return 1
  fi
  printf '%s' "$final"
}

record_service_snapshot_metadata() {
  local service="$1"
  local before_version="$2"
  local after_version="$3"
  local snapshot_name="$4"
  local status="${5:-created}"
  local meta_dir meta_file
  meta_dir="$(snapshot_metadata_dir)"
  install -d -m 0700 "$meta_dir"
  meta_file="$meta_dir/${snapshot_name}.env"
  cat > "$meta_file" <<EOF
SERVICE='$service'
VERSION_BEFORE='$before_version'
VERSION_AFTER='$after_version'
SNAPSHOT_NAME='$snapshot_name'
TIMESTAMP='$(date -Iseconds)'
STATUS='$status'
EOF
  chmod 600 "$meta_file"
}

# Btrfs snapshots are NOT recursive. A snapshot of subvolume S contains an
# EMPTY DIRECTORY wherever a nested subvolume used to be, so "S was snapshotted"
# does not imply "everything under S is recoverable".
#
# Two independent checks, because each has a blind spot the other covers:
#
#  1. st_dev. Each btrfs subvolume gets its own anonymous device, so a differing
#     st_dev proves a boundary was crossed somewhere between the two paths --
#     including deep inside, where a leaf check would see nothing. Verified on
#     this host: /srv/data (45) and /srv/snapshots (46) are two subvolumes of
#     ONE filesystem (/dev/sda1, UUID 211e06b3-…) and their st_dev differs.
#     Verified only for separately MOUNTED subvolumes; the nested unmounted case
#     is documented btrfs behaviour but is not yet demonstrated on this host,
#     which is why it is not the only check.
#
#  2. inode 256. A btrfs subvolume root always has inode 256, so if the target
#     path is itself a subvolume root distinct from the one snapshotted, it is a
#     nested subvolume and its contents are NOT in the parent's snapshot. This
#     holds whether or not the st_dev premise does.
#
# Either check failing means "not covered". Fail closed.
path_covered_by_subvolume() {
  local subvol="$1" path="$2" dev_root dev_path
  [[ -n "$subvol" && -n "$path" ]] || return 1
  [[ "$path" == "$subvol" || "$path" == "$subvol"/* ]] || return 1

  dev_root="$(stat -c %d "$subvol" 2>/dev/null)" || return 1
  dev_path="$(stat -c %d "$path" 2>/dev/null)" || return 1
  [[ -n "$dev_root" && "$dev_root" == "$dev_path" ]] || return 1

  if [[ "$path" != "$subvol" ]] && path_is_subvolume "$path"; then
    return 1
  fi
  return 0
}

# Gate a destructive operation on a snapshot that actually covers the paths it
# is about to destroy.
#
# `snapshot_create` returns success on a GLOBAL count: once ANY service path is
# a subvolume, it succeeds even when the service being wiped was skipped. Using
# it as the gate for `immich reset-db` meant a Jellyfin snapshot could authorise
# `rm -rf` of the Immich database. Gate on the service, never on the fleet.
#
# Echoes the snapshot name on success; the caller decides what to do on failure
# so `die` fires in the calling shell.
assert_service_snapshot_covers() {
  local service="$1" tag="$2"; shift 2
  local root name p
  local -a uncovered=()

  root="$(service_data_path "$service")" || return 1
  name="$(create_service_snapshot "$service" "$tag")" || name=""

  for p in "$@"; do
    [[ -e "$p" ]] || continue
    if [[ -z "$name" ]] || ! path_covered_by_subvolume "$root" "$p"; then
      uncovered+=("$p")
    fi
  done

  if (( ${#uncovered[@]} > 0 )); then
    printf '%s\n' "[domum-media] Not covered by any snapshot: ${uncovered[*]}" >&2
    return 1
  fi
  printf '%s' "$name"
}

# Btrfs snapshots are NOT recursive: a snapshot of S contains an EMPTY DIRECTORY
# wherever a nested subvolume used to be. Proven on this host -- a parent
# holding a nested subvolume with data.db in it was snapshotted read-only, and
# the snapshot's copy of that directory was empty.
#
# So "a snapshot of the service was created" does not mean "the service's state
# is recoverable". If /srv/data/immich/postgres were ever a nested subvolume,
# create_service_snapshot would succeed, every gate built on it would pass, and
# the pre-update snapshot would hold an empty database directory. A rollback
# from it would restore nothing.
#
# `-xdev` makes this cheap: nested subvolumes have their own st_dev, so find
# reports the boundary and never descends into it. No full-tree walk, even for
# the 213 GB Immich library.
# Retained as the name the call sites read well with; one implementation, in the
# shared block above, so the CLI and the report cannot disagree about it.
subvolume_nested_children() { domum_subvolume_nested_children "$1"; }

create_service_snapshot() {
  local service="$1"
  local tag="$2"
  local before_version="${3:-unknown}"
  local after_version="${4:-unknown}"
  local data_path snapshot_name event

  data_path="$(service_data_path "$service")" || return 1
  [[ -d "$data_path" ]] || return 1
  snapshot_name="$(basename "$data_path")-$(date +%Y%m%d-%H%M%S)-${tag}"
  if is_btrfs_subvol "$data_path"; then
    # Refuse BEFORE creating anything: a snapshot that silently omits part of
    # the tree is worse than no snapshot, because every gate would accept it.
    local nested
    nested="$(subvolume_nested_children "$data_path")"
    if [[ -n "$nested" ]]; then
      echo "[domum-media] Refusing to snapshot $data_path: it contains nested subvolume(s):" >&2
      printf '  %s\n' $nested >&2
      echo "[domum-media] Btrfs snapshots are not recursive, so those would be EMPTY in the snapshot." >&2
      return 1
    fi
    mkdir -p "$DOMUM_SNAPSHOT_ROOT"
    # STDERR, not stdout. This function RETURNS the snapshot name on stdout, and
    # every caller captures it with $(...). A progress line on stdout is
    # therefore part of the return value: callers received
    #
    #   "[domum-media] Snapshot: /srv/data/jellyfin -> /srv/snapshots/jellyfin-...
    #    jellyfin-20260924-125809-pre-update"
    #
    # and then passed that to restore_snapshot_for_service, which cannot find it.
    # The auto-rollback after a failed health check would refuse -- leaving the
    # service on the broken image with a perfectly good snapshot sitting unused --
    # and record_update_history would store the mangled name as the rollback
    # pointer. Unreachable while no service path was a subvolume (the function
    # returns 1 before printing anything), and armed by the first migration.
    echo "[domum-media] Snapshot: $data_path -> $DOMUM_SNAPSHOT_ROOT/$snapshot_name" >&2
    # Report failure unless the snapshot actually exists afterwards. Returning
    # the name for a snapshot that was never created would let the caller's gate
    # pass and record rollback metadata pointing at nothing.
    # `btrfs subvolume snapshot` prints "Create readonly snapshot of ..." on
    # STDOUT. Inside this function that is the return value, so the caller would
    # capture the tool's chatter as part of the snapshot name -- the same defect
    # as the log line above, arriving from an external command instead of from
    # us. Stubbed btrfs in the unit tests printed nothing and hid it; the real
    # tool on real Btrfs is what exposed it.
    if ! btrfs subvolume snapshot -r "$data_path" "$DOMUM_SNAPSHOT_ROOT/$snapshot_name" >&2 \
       || [[ ! -d "$DOMUM_SNAPSHOT_ROOT/$snapshot_name" ]]; then
      echo "[domum-media] Snapshot FAILED for $data_path" >&2
      return 1
    fi
    record_service_snapshot_metadata "$service" "$before_version" "$after_version" "$snapshot_name"
    event="${tag#pre-}"
    record_rollback_entry "$service" "$event" "$snapshot_name" "$before_version" "$after_version" >/dev/null
    printf '%s' "$snapshot_name"
    return 0
  fi
  return 1
}

# ---- snapshot safety gate --------------------------------------------------
#
# Principle: if an operation depends on a snapshot as a safety prerequisite,
# failing to create that snapshot must not silently become success.
#
# Service state paths below $DOMUM_DATA_ROOT must be Btrfs subvolumes for
# snapshots to work. Where they are ordinary directories the snapshot is
# skipped, and an operation that would have relied on it has no rollback point.
#
# These helpers run in the CALLING shell, never inside a command substitution,
# so that `die` actually stops the script instead of only the subshell.

snapshot_policy() {
  local policy="${SNAPSHOT_POLICY:-REQUIRED}"
  printf '%s' "${policy^^}"
}

# $1 = what wanted the snapshot, $2 = why it was not created.
# ---- operation locking ------------------------------------------------------
# BEGIN SHARED LOCK HELPER
# Kept byte-identical between bin/domum-media and bin/domum-media-backup, and
# tests/operation-lock-smoke.sh fails if they drift. Duplicated rather than
# sourced from a new file on purpose: a shared library is one more artefact a
# partial deployment can leave missing, and the failure mode there is a CLI that
# will not start at all. Two scripts that already exist, pinned by a test, is
# the smaller risk.
#
# Why this exists: the nightly backup fires at 02:30 (+15m jitter) and reads all
# of /srv/data with no exclude for .new / .premigration / .rollback-*. A
# migration overlapping it has restic walking a tree that is being renamed
# underneath it -- it captures a half-copied .new, hits vanished paths, exits
# non-zero, and the last-success marker is not refreshed. Fail-safe, but the
# operator is left with a failed backup and no obvious cause.
#
# The lock lives in an open file descriptor, so the kernel releases it when the
# process exits for ANY reason, SIGKILL included. There is no stale lock file to
# detect or clean up, which is the usual way lock schemes become the outage.
domum_lock_file() {
  printf '%s/operation.lock' "${DOMUM_STATE_ROOT:-/var/lib/domum-media}"
}

# $1 = label recorded for diagnostics, $2 = seconds to wait (0 = fail at once)
domum_acquire_lock() {
  local label="$1" wait_seconds="${2:-0}" lock_file
  [[ -n "${DOMUM_LOCK_FD:-}" ]] && return 0
  lock_file="$(domum_lock_file)"
  mkdir -p "$(dirname "$lock_file")" || return 1
  exec {DOMUM_LOCK_FD}>>"$lock_file" || return 1
  if (( wait_seconds > 0 )); then
    flock -w "$wait_seconds" "$DOMUM_LOCK_FD" || return 1
  else
    flock -n "$DOMUM_LOCK_FD" || return 1
  fi
  # Diagnostic only -- never consulted to decide whether the lock is held. That
  # decision belongs to flock alone; a file that says who owns it is for the
  # operator reading a refusal, and may be stale or absent without consequence.
  printf '%s %s %s\n' "$$" "$(date -Iseconds)" "$label" > "${lock_file}.holder" 2>/dev/null || true
  return 0
}

domum_lock_holder() {
  local h
  h="$(cat "$(domum_lock_file).holder" 2>/dev/null || true)"
  printf '%s' "${h:-unknown}"
}
# END SHARED LOCK HELPER

snapshot_protection_unavailable() {
  local what="$1" detail="$2"
  if [[ "$(snapshot_policy)" == "WARN" ]]; then
    warn "$what: $detail"
    warn "Continuing because SNAPSHOT_POLICY=WARN — this operation has NO rollback point."
    return 0
  fi
  die "$what: $detail
Refusing to continue: this operation depends on a snapshot for rollback and none was created.
Service state paths must be Btrfs subvolumes; see docs/SNAPSHOT-MODEL.md.
To proceed deliberately without rollback protection, set SNAPSHOT_POLICY=WARN in $CFG_FILE."
}

# The retention count, validated, with a floor of 1.
#
# `drop=$(( total - keep ))` is honest arithmetic and that is the problem: with
# keep=0 a prune deletes EVERY snapshot of a service, and with a negative value it
# deletes them and then fails. Measured against the real snapshot_prune on a
# fixture shaped like production (one Jellyfin snapshot):
#
#   keep=14   start=1  left=1   <- the default and the shipped example: safe
#   keep=0    start=1  left=0   <- the only recovery point, gone
#   keep=-5   start=1  left=0   <- gone, and rc=1
#   keep=fourteen      rc=1     <- aborts under set -u, deleting nothing
#
# A RETENTION job must never leave a protected service with zero recovery points.
# Deliberate wholesale removal is what `cleanup snapshots --confirm` is for, which
# is attended and asks. So the floor is 1, and a non-numeric value falls back to
# the default rather than failing a weekly timer forever.
#
# This also removes the need to trust the config to know the Sunday job is safe.
snapshot_retention_keep() {
  local raw="${1:-}" keep
  if [[ "$raw" =~ ^[0-9]+$ ]]; then
    keep="$raw"
  else
    [[ -n "$raw" ]] && warn "SNAPSHOT_KEEP_PER_SUBVOL is not a non-negative integer ('$raw'); using 14."
    keep=14
  fi
  if (( keep < 1 )); then
    warn "Retention of $keep would leave services with no recovery point; using 1."
    warn "To remove snapshots deliberately, use: domum-media cleanup snapshots --confirm"
    keep=1
  fi
  printf '%s' "$keep"
}

snapshot_prune() {
  local keep
  keep="$(snapshot_retention_keep "${SNAPSHOT_KEEP_PER_SUBVOL:-}")"
  local pruned=0 failed=0
  [[ -d "$DOMUM_SNAPSHOT_ROOT" ]] || return 0
  local names
  names="$(find "$DOMUM_SNAPSHOT_ROOT" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | sed -E 's/-[0-9]{8}-[0-9]{6}-.*$//' | sort -u || true)"
  while IFS= read -r base; do
    [[ -n "$base" ]] || continue
    local snaps
    mapfile -t snaps < <(list_snapshots_for_base "$base")
    local total="${#snaps[@]}"
    local drop=$(( total - keep ))
    if (( drop > 0 )); then
      local i
      for (( i = 0; i < drop; i++ )); do
        local victim="$DOMUM_SNAPSHOT_ROOT/${snaps[$i]}"
        echo "[domum-media] Pruning snapshot: $victim"
        # Not `|| true`. A delete that fails means the snapshot root never
        # converges on the retention policy, and swallowing it means nobody
        # finds out: the operator sees a clean weekly run while the count grows.
        # Report it, keep pruning the rest, and fail at the end so the systemd
        # unit records the failure.
        if btrfs subvolume delete "$victim" >&2; then
          pruned=$(( pruned + 1 ))
        else
          warn "Could not delete snapshot: $victim"
          failed=$(( failed + 1 ))
        fi
      done
    fi
  done <<< "$names"

  echo "[domum-media] Snapshot prune: ${pruned} deleted, ${failed} failed (keeping ${keep} per subvolume)."
  (( failed == 0 ))
}

list_service_snapshots() {
  [[ -d "$DOMUM_SNAPSHOT_ROOT" ]] || return 0
  list_snapshots_for_base "$(service_snapshot_base_name "$1")"
}

# Stop compose services and PROVE they are gone.
#
# The rollback path used to run `compose_cmd stop $svcs 2>/dev/null || true`,
# discarding both stderr and the exit status. A container that kept running
# would keep writing through its existing mount into the directory that was then
# renamed aside: the restore "succeeds", the application never experiences it,
# and the operator goes on to delete the tree the live container is using.
# A stop that cannot be proven is a failed stop.
stop_compose_services_verified() {
  local svcs="$1"
  [[ -n "$svcs" ]] || return 0
  # shellcheck disable=SC2086
  compose_cmd stop $svcs || {
    echo "[domum-media] Could not stop: $svcs" >&2
    return 1
  }
  # Confirm each intended container is actually gone, one at a time: a
  # command-substituted pattern list would word-split unpredictably.
  #
  # `docker ps | grep -q` is deliberately NOT used. Under this script's `pipefail`,
  # `grep -q` exits at the first match, the left-hand command takes SIGPIPE, and
  # the PIPELINE reports 141 -- so a match reads as "no match". Measured:
  # `sed file | grep -q <hit>` returns 141. It does not bite at 130 bytes of
  # `docker ps` output (0 inversions in 1000 trials) because that fits the pipe
  # buffer and docker finishes first -- but "safe because the output is small" is
  # not a property to rest the stop verification on, and an inverted result here
  # would declare a RUNNING container stopped and let the migration proceed.
  local still="" svc running
  running="$(docker ps --format '{{.Names}}' 2>/dev/null || true)"
  for svc in $svcs; do
    if grep -qFx -- "$svc" <<< "$running"; then
      still+="${still:+ }$svc"
    fi
  done
  [[ -z "$still" ]] || {
    echo "[domum-media] Still running after stop: $still" >&2
    return 1
  }
  return 0
}

restore_snapshot_for_service() {
  local service="$1"
  local snapshot_name="$2"
  local data_path compose_svcs
  local current_backup=""

  data_path="$(service_data_path "$service")" || die "No data path mapping for $service"

  # A rollback entry is a root-owned file, but it is still DATA -- it can be
  # hand-edited, truncated, or corrupted. Two things are checked before it is
  # used to decide what gets overwritten:
  #
  #  * the name must be a single path component. "../data/immich" passes a bare
  #    `[[ -d ]]` test against the snapshot root and would restore something
  #    entirely different over this service's path.
  #  * the snapshot must belong to THIS service. Snapshots are named
  #    "<data dir basename>-<stamp>-<tag>", so a mismatched entry means the
  #    index and the snapshot store disagree -- and restoring one service's
  #    state onto another's path is an operation that would SUCCEED.
  case "$snapshot_name" in
    ""|*/*|.|..) die "Refusing: '$snapshot_name' is not a valid snapshot name" ;;
  esac
  #
  # ANCHORED to the stamp, not just the prefix. `"$expect"-*` accepts any name
  # that merely STARTS with this service's basename, so with two services where
  # one basename is a "-"-prefix of the other -- plex and plex-hd, immich and
  # immich-ml -- restoring `plex` would accept `plex-hd-20260101-000000-tag` and
  # write plex-hd's state over plex's path. Exactly the defect defe282 fixed in
  # list_snapshots_for_base, in the one place where a false accept overwrites live
  # state instead of miscounting retention.
  #
  # Not reachable with today's eight service basenames, because none is a
  # "-"-prefix of another. Adding one would arm it silently, and this is the last
  # check before a `btrfs subvolume snapshot` over a service's data path.
  #
  # Prefix STRIPPED rather than regex-matched, so a basename containing regex
  # metacharacters cannot change what is accepted.
  local expect rest
  expect="$(basename "$data_path")"
  rest="${snapshot_name#"$expect"-}"
  [[ "$rest" != "$snapshot_name" && "$rest" =~ ^[0-9]{8}-[0-9]{6}(-|$) ]] \
    || die "Refusing: snapshot '$snapshot_name' does not belong to $service (expected '$expect-<YYYYMMDD>-<HHMMSS>[-tag]').
The rollback index and the snapshot store disagree; investigate before restoring."

  [[ -d "$DOMUM_SNAPSHOT_ROOT/$snapshot_name" ]] || die "Snapshot not found: $snapshot_name"

  compose_svcs="$(service_compose_services "$service" || true)"
  # Nothing has been moved yet, so failing here is completely safe -- and far
  # safer than restoring underneath a container that is still writing.
  stop_compose_services_verified "$compose_svcs" \
    || die "Refusing to restore $service: its containers could not be confirmed stopped.
A restore under a running container is invisible to the application and would leave
the live tree in the preserved copy. Nothing has been changed."

  # Preserve whatever is there now, whatever its type. The previous code moved a
  # subvolume aside but `rm -rf`'d an ordinary directory, so restoring onto a
  # non-subvolume path destroyed the live state before the replacement existed:
  # if the snapshot then failed to materialise, there was nothing to go back to.
  # Live state is never deleted here -- only moved.
  if [[ -e "$data_path" ]]; then
    current_backup="${data_path}.rollback-$(date +%Y%m%d-%H%M%S)"
    [[ -e "$current_backup" ]] && die "Refusing to restore: $current_backup already exists"
    mv -- "$data_path" "$current_backup" \
      || die "Refusing to restore: could not preserve the current state of $data_path"
    echo "[domum-media] Preserved current state at $current_backup"
  fi

  echo "[domum-media] Restoring $service from $snapshot_name"
  if ! btrfs subvolume snapshot "$DOMUM_SNAPSHOT_ROOT/$snapshot_name" "$data_path"; then
    # The restore failed. Put the preserved state back rather than leaving the
    # service with nothing.
    if [[ -n "$current_backup" && -e "$current_backup" ]]; then
      # Only ever removes a partial restore we just created, never live state.
      #
      # The removal is CHECKED. `mv A B` with B an existing directory succeeds by
      # moving A *inside* B, so a silent rm failure would leave the live state one
      # level deeper inside a partial subvolume while `|| die` never fired and the
      # message below claimed it had been put back. Verified: `mv live dest` with
      # dest/ present yields dest/live/file.txt and exit 0.
      if [[ -e "$data_path" ]]; then
        rm -rf -- "$data_path" \
          || die "Restore failed, and the partial restore at $data_path could not be removed.
The preserved state is intact at $current_backup. Put it back by hand once
$data_path is clear; do not delete $current_backup."
      fi
      [[ ! -e "$data_path" ]] \
        || die "Restore failed, and $data_path still exists, so putting the preserved
state back would nest it inside. The preserved state is intact at $current_backup."
      mv -- "$current_backup" "$data_path" \
        || die "Restore failed AND the preserved state could not be put back. It is at: $current_backup"
      echo "[domum-media] Restore failed; previous state put back from $current_backup" >&2
    fi
    die "Restore failed for $service from $snapshot_name"
  fi

  # The preserved copy is deliberately NOT deleted: it is the only way back if
  # the restored state turns out to be wrong. Remove it when satisfied.
  if [[ -n "$current_backup" ]]; then
    echo "[domum-media] Previous state kept at $current_backup (remove it once satisfied)"
  fi

  if [[ -n "$compose_svcs" ]]; then
    # `start`, not `up -d`, for the same reason the migration uses it: `up -d`
    # reconciles and would recreate the containers on whatever the image tag now
    # resolves to. Restoring an older application's data and upgrading the
    # application in the same breath is the pairing failure, not a fix for it --
    # and a rollback is the operation where it matters most.
    #
    # shellcheck disable=SC2086
    if ! compose_cmd start $compose_svcs; then
      # FAIL CLOSED, and here it matters most. The old state has already been
      # restored. Recreating would resolve the image tag, so the sequence would be
      #
      #   old data -> newer application -> automatic schema migration
      #
      # which is the Kavita failure mode, arrived at during the very operation
      # meant to undo it. The restored data would be forward-migrated before
      # anyone noticed.
      warn "Could not start the existing container(s) for $compose_svcs."
      warn "NOT recreating them: that resolves the image tag, and a newer application"
      warn "would migrate the state just restored -- destroying the pairing this"
      warn "rollback exists to recover."
      warn "The restored state is in place at $data_path."
      [[ -n "$current_backup" ]] && warn "The state it replaced is preserved at $current_backup."
      warn "$service is DOWN. Nothing has been deleted."
      warn "The image that wrote the restored state is recorded in:"
      warn "    ${DOMUM_STATE_ROOT:-/var/lib/domum-media}/snapshots/${snapshot_name}.recovery"
      die "Rollback restored the data but could not restart $service from its existing container.
Start it on the recorded image, or recreate it deliberately:
    <SERVICE>_IMAGE=<CONTAINER_1_IMAGE_ID> sudo domum-media compose up -d $compose_svcs"
    fi
  fi
  return 0
}

latest_snapshot_for_service() {
  list_service_snapshots "$1" | tail -n 1
}

# ---- timer syncing --------------------------------------------------------

normalize_daily_schedule() {
  local value="$1"
  if [[ "$value" =~ ^[0-9]{2}:[0-9]{2}$ ]]; then
    printf '*-*-* %s:00' "$value"
    return 0
  fi
  if [[ "$value" == *"*-*-*"* ]]; then
    printf '%s' "$value"
    return 0
  fi
  die "Invalid daily schedule '$value' (expected HH:MM or full systemd OnCalendar string)"
}

normalize_weekly_schedule() {
  local value="$1"
  if [[ "$value" =~ ^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)[[:space:]]+[0-9]{2}:[0-9]{2}$ ]]; then
    printf '%s *-*-* %s:00' "${value%% *}" "${value##* }"
    return 0
  fi
  if [[ "$value" == *"*-*-*"* ]]; then
    printf '%s' "$value"
    return 0
  fi
  die "Invalid weekly schedule '$value' (expected 'Sun 03:30' or full systemd OnCalendar string)"
}

write_timer_override() {
  local unit="$1"
  local oncalendar="$2"
  local randomized_delay="$3"
  local dir="/etc/systemd/system/${unit}.d"
  install -d "$dir"
  cat > "${dir}/override.conf" <<EOF
[Timer]
OnCalendar=
OnCalendar=${oncalendar}
RandomizedDelaySec=${randomized_delay}
Persistent=true
EOF
}

sync_unattended_upgrades() {
  local auto_cfg="/etc/apt/apt.conf.d/20auto-upgrades"
  local domum_cfg="/etc/apt/apt.conf.d/50domum-unattended-upgrades"
  local reboot_flag="false"

  if [[ "${HOST_AUTO_REBOOT_ENABLED:-0}" == "1" ]]; then
    reboot_flag="true"
  fi

  cat > "$auto_cfg" <<EOF
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "${HOST_SECURITY_AUTO_UPDATE_ENABLED:-1}";
EOF

  cat > "$domum_cfg" <<EOF
Unattended-Upgrade::Origins-Pattern {
  "origin=Debian,codename=\${distro_codename}-security,label=Debian-Security";
};
Unattended-Upgrade::Package-Blacklist {
  "docker-ce";
  "docker-ce-cli";
  "docker-buildx-plugin";
  "docker-compose-plugin";
  "containerd.io";
};
Unattended-Upgrade::AutoFixInterruptedDpkg "true";
Unattended-Upgrade::MinimalSteps "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::Automatic-Reboot "${reboot_flag}";
Unattended-Upgrade::Automatic-Reboot-Time "${HOST_AUTO_REBOOT_WINDOW_START:-03:00}";
EOF

  systemctl enable --now unattended-upgrades.service apt-daily-upgrade.timer >/dev/null 2>&1 || true
}

# Canonical list of timers installation and convergence may enable. Read from
# systemd/auto-enable.timers so install.sh and this CLI cannot drift apart.
# Deployment timers are deliberately absent; see that file for the rule.
auto_enable_timer_units() {
  local list="$DOMUM_DIR/systemd/auto-enable.timers"
  if [[ ! -r "$list" ]]; then
    warn "Missing $list; not enabling any timer automatically."
    return 0
  fi
  sed -E 's/#.*//; s/[[:space:]]+//g' "$list" | grep -E '^domum-media-[A-Za-z0-9-]+\.timer$' || true
}

sync_timer_overrides() {
  local backup_calendar check_calendar prune_calendar image_update_calendar host_update_calendar
  backup_calendar="$(normalize_daily_schedule "${BACKUP_DAILY_AT:-02:30}")"
  check_calendar="$(normalize_weekly_schedule "${CHECK_WEEKLY_AT:-Sun 03:30}")"
  prune_calendar="$(normalize_weekly_schedule "${SNAPSHOT_PRUNE_WEEKLY_AT:-Sun 04:30}")"
  image_update_calendar="$(normalize_daily_schedule "${IMAGE_AUTO_UPDATE_AT:-05:15}")"
  host_update_calendar="$(normalize_weekly_schedule "${HOST_PACKAGE_AUTO_UPDATE_AT:-Mon 05:45}")"
  write_timer_override "domum-media-backup.timer" "$backup_calendar" "15m"
  write_timer_override "domum-media-check.timer" "$check_calendar" "20m"
  write_timer_override "domum-media-btrfs-snapshot.timer" "$prune_calendar" "20m"
  write_timer_override "domum-media-image-refresh.timer" "$image_update_calendar" "${IMAGE_AUTO_UPDATE_RANDOMIZED_DELAY:-30m}"
  write_timer_override "domum-media-host-update.timer" "$host_update_calendar" "${HOST_PACKAGE_AUTO_UPDATE_RANDOMIZED_DELAY:-45m}"

  systemctl daemon-reload

  # Only auto-enable the protective timers. Image refresh is never enabled
  # here: it stages and applies image updates, and apply/init/configure all
  # reach this function, so enabling it here would let routine convergence
  # silently resume automatic deployment. Existing enablement is left alone --
  # this never fights an explicit operator decision in either direction.
  local auto_units=()
  mapfile -t auto_units < <(auto_enable_timer_units)
  if (( ${#auto_units[@]} > 0 )); then
    systemctl enable --now "${auto_units[@]}" >/dev/null
  fi

  # Best-effort: disable the retired hot-prune timer on hosts upgraded from an
  # older release that still has the unit installed.
  systemctl disable --now domum-media-hot-prune.timer >/dev/null 2>&1 || true

  sync_unattended_upgrades
}

# ---- configure flow -------------------------------------------------------

config_set() {
  local key="$1"
  local value="${2:-}"
  local rendered tmp
  printf -v rendered '%q' "$value"
  tmp="$(mktemp)"
  awk -v key="$key" -v val="$rendered" '
    BEGIN { updated = 0 }
    $0 ~ "^" key "=" {
      print key "=" val
      updated = 1
      next
    }
    { print }
    END {
      if (!updated) {
        print key "=" val
      }
    }
  ' "$CFG_FILE" > "$tmp"
  mv "$tmp" "$CFG_FILE"
}

prompt_with_default() {
  local label="$1"
  local current="${2:-}"
  local reply
  read -r -p "$label [$current]: " reply
  printf '%s' "${reply:-$current}"
}

prompt_yes_no() {
  local label="$1"
  local current="${2:-0}"
  local default="n"
  local reply
  [[ "$current" == "1" ]] && default="y"
  while true; do
    read -r -p "$label [y/n] (default: $default): " reply
    reply="${reply:-$default}"
    case "${reply,,}" in
      y|yes) echo "1"; return 0 ;;
      n|no)  echo "0"; return 0 ;;
    esac
  done
}

prompt_choice() {
  local label="$1"
  local current="$2"
  shift 2
  local reply
  while true; do
    read -r -p "$label [$current] ($(printf '%s ' "$@")): " reply
    reply="${reply:-$current}"
    for option in "$@"; do
      if [[ "$reply" == "$option" ]]; then
        echo "$reply"
        return 0
      fi
    done
  done
}

configure_text_value() {
  local key="$1"
  local label="$2"
  local current="${!key:-}"
  config_set "$key" "$(prompt_with_default "$label" "$current")"
}

configure_service_toggle() {
  local key="$1"
  local label="$2"
  local current="${!key:-0}"
  config_set "$key" "$(prompt_yes_no "$label" "$current")"
}

configure_image_behavior() {
  local image_key="$1"
  local auto_key="$2"
  local delay_key="$3"
  local label="$4"
  local auto_enabled

  echo
  echo "Image policy: $label"
  config_set "$image_key" "$(prompt_with_default "Container image ref for $label" "${!image_key:-}")"
  auto_enabled="$(prompt_yes_no "Auto-update $label when a newer image is available?" "${!auto_key:-0}")"
  config_set "$auto_key" "$auto_enabled"
  if [[ "$auto_enabled" == "1" ]]; then
    config_set "$delay_key" "$(prompt_with_default "Delay in days before applying the new $label image" "${!delay_key:-7}")"
  fi
}

configure_secret_file_prompt() {
  local path="$1"
  local label="$2"
  local value
  value="$(prompt_secret_value "$label" "$path")"
  [[ -n "$value" ]] || return 0
  write_secret_file "$path" "$value"
}

configure_generated_secret_prompt() {
  local path="$1"
  local label="$2"
  local value
  value="$(prompt_secret_value "$label" "$path")"
  if [[ -z "$value" ]]; then
    [[ -f "$path" ]] && return 0
    value="$(generate_secret 32)"
    echo "[domum-media] Generated value for $label."
  fi
  write_secret_file "$path" "$value"
}

configure_multiline_secret_prompt() {
  local path="$1"
  local label="$2"
  local value rc
  if value="$(prompt_multiline_value "$label" "$path")"; then
    :
  else
    rc=$?
    [[ "$rc" -eq 10 ]] && return 0
    return "$rc"
  fi
  validate_backup_env_content "$value" \
    || die "Invalid backup env file: $path. It must contain valid shell export/key=value lines."
  write_secret_file "$path" "$value"
}

configure_traefik_dashboard_secret() {
  local path="${TRAEFIK_DASHBOARD_USERS_FILE:-$SECRETS_DIR/traefik_dashboard_users}"
  local username password hash
  local current_user="admin"

  if [[ -f "$path" ]]; then
    current_user="$(cut -d: -f1 "$path" 2>/dev/null || echo admin)"
  fi

  username="$(prompt_with_default "Traefik dashboard username" "$current_user")"
  password="$(prompt_secret_value "Traefik dashboard password" "$path")"
  [[ -n "$password" ]] || return 0

  hash="$(htpasswd_hash "$username" "$password")"
  write_secret_file "$path" "$hash"
}

configure_service_secrets() {
  ensure_secret_dir

  echo
  echo "Secrets"

  if [[ "${ENABLE_TRAEFIK:-0}" == "1" ]]; then
    configure_secret_file_prompt "$SECRETS_DIR/cloudflare_api_token" "Cloudflare DNS API token"
    configure_traefik_dashboard_secret
  fi

  if [[ "${ENABLE_IMMICH:-0}" == "1" ]]; then
    if immich_db_password_initialized; then
      cat <<EOF
[domum-media] Immich Postgres is already initialized at $(immich_postgres_data_dir).
  Changing immich_db_password here will cause 'domum-media apply' to refuse
  to deploy until you either restore the old value or run:
      sudo domum-media immich reset-db
  Press Enter to keep the current value if you do not intend to rotate it.
EOF
    fi
    configure_generated_secret_prompt "$SECRETS_DIR/immich_db_password" "Immich database password"
    configure_generated_secret_prompt "$SECRETS_DIR/immich_jwt_secret" "Immich JWT secret"
  fi

  while IFS= read -r target; do
    backup_target_enabled "$target" || continue
    configure_generated_secret_prompt "$(backup_target_password_file "$target")" "Restic password for $target"

    case "$(backup_target_value "$target" TYPE repository)" in
      repository)
        local env_file
        env_file="$(backup_target_value "$target" ENV_FILE)"
        if [[ -n "$env_file" ]]; then
          configure_multiline_secret_prompt "$env_file" "Backend env file for $target (for example B2_ACCOUNT_ID=... / B2_ACCOUNT_KEY=...)"
        fi
        ;;
      ftp)
        configure_secret_file_prompt \
          "$(backup_target_value "$target" FTP_USERNAME_FILE "$SECRETS_DIR/${target}_ftp_username")" \
          "FTP username for $target"
        configure_secret_file_prompt \
          "$(backup_target_value "$target" FTP_PASSWORD_FILE "$SECRETS_DIR/${target}_ftp_password")" \
          "FTP password for $target"
        ;;
    esac
  done < <(backup_target_names)
}

configure_backup_target() {
  local target="$1"
  local upper
  upper="$(uppercase_token "$target")"

  echo
  echo "Backup target: $target"

  local enabled
  enabled="$(prompt_yes_no "Enable $target backup target?" "$(backup_target_value "$target" ENABLED 0)")"
  config_set "BACKUP_TARGET_${upper}_ENABLED" "$enabled"
  if [[ "$enabled" != "1" ]]; then
    return 0
  fi

  local target_type
  target_type="$(prompt_choice "Target type for $target" "$(backup_target_value "$target" TYPE repository)" repository nfs ftp)"
  config_set "BACKUP_TARGET_${upper}_TYPE" "$target_type"
  config_set "BACKUP_TARGET_${upper}_RETENTION" \
    "$(prompt_choice "Retention cadence for $target" "$(backup_target_value "$target" RETENTION none)" daily weekly none)"

  case "$target_type" in
    repository)
      local repo_url
      repo_url="$(prompt_with_default "Restic repository string for $target (SFTP: sftp:user@host:/absolute/path)" "$(backup_target_value "$target" REPOSITORY)")"
      if [[ "$repo_url" == sftp:* ]] && ! sftp_repo_user_host "$repo_url" >/dev/null; then
        die "Invalid SFTP repository. Use sftp:user@host:/absolute/path and configure the port separately."
      fi
      config_set "BACKUP_TARGET_${upper}_REPOSITORY" "$repo_url"
      config_set "BACKUP_TARGET_${upper}_PASSWORD_FILE" \
        "$(prompt_with_default "Password file for $target" "$(backup_target_password_file "$target")")"
      config_set "BACKUP_TARGET_${upper}_ENV_FILE" \
        "$(prompt_with_default "Optional backend credential env file for $target" "$(backup_target_value "$target" ENV_FILE)")"
      if [[ "$repo_url" == sftp:* ]]; then
        local use_key
        use_key="$(prompt_yes_no "Use SSH key authentication (required for unattended backup)?" "1")"
        if [[ "$use_key" == "1" ]]; then
          config_set "BACKUP_TARGET_${upper}_SFTP_KEY_FILE" \
            "$(prompt_with_default "Path to SSH private key" \
              "$(backup_target_value "$target" SFTP_KEY_FILE "$SECRETS_DIR/hetzner_storagebox_ed25519")")"
          config_set "BACKUP_TARGET_${upper}_SFTP_KNOWN_HOSTS_FILE" \
            "$(prompt_with_default "Path to known_hosts file (or blank)" \
              "$(backup_target_value "$target" SFTP_KNOWN_HOSTS_FILE "$SECRETS_DIR/hetzner_storagebox_known_hosts")")"
          local sftp_port
          sftp_port="$(prompt_with_default "SFTP port (Hetzner Storage Box = 23)" \
            "$(backup_target_value "$target" SFTP_PORT 22)")"
          sftp_port_is_valid "$sftp_port" \
            || die "Invalid SFTP port. Expected a number from 1 through 65535."
          config_set "BACKUP_TARGET_${upper}_SFTP_PORT" "$sftp_port"
        fi
      fi
      local profile profile_default
      profile_default="custom"
      [[ "$target" == "cloud" ]] && profile_default="immich-only"
      profile="$(prompt_choice "Include paths profile for $target" "$profile_default" \
        "immich-only" "all-data" "custom")"
      case "$profile" in
        immich-only)
          config_set "BACKUP_TARGET_${upper}_INCLUDE_PATHS" \
            "/srv/data/immich/library /srv/data/immich/backup-staging /var/lib/domum-media/recovery-pack" ;;
        all-data)
          config_set "BACKUP_TARGET_${upper}_INCLUDE_PATHS" "/srv/data /srv/media/books" ;;
        custom)
          config_set "BACKUP_TARGET_${upper}_INCLUDE_PATHS" \
            "$(prompt_with_default "Include paths (space-separated)" \
              "$(backup_target_value "$target" INCLUDE_PATHS "${BACKUP_INCLUDE_PATHS:-/srv/data}")")" ;;
      esac
      ;;
    nfs)
      config_set "BACKUP_TARGET_${upper}_NFS_REMOTE" \
        "$(prompt_with_default "NFS remote for $target (server:/export/path)" "$(backup_target_value "$target" NFS_REMOTE)")"
      config_set "BACKUP_TARGET_${upper}_NFS_MOUNT_POINT" \
        "$(prompt_with_default "Local mount point for $target" "$(backup_target_value "$target" NFS_MOUNT_POINT "/mnt/domum-media-$target")")"
      config_set "BACKUP_TARGET_${upper}_REPOSITORY" \
        "$(prompt_with_default "Restic repo path on mounted NFS share" "$(backup_target_value "$target" REPOSITORY "/mnt/domum-media-$target/restic")")"
      config_set "BACKUP_TARGET_${upper}_PASSWORD_FILE" \
        "$(prompt_with_default "Password file for $target" "$(backup_target_password_file "$target")")"
      ;;
    ftp)
      config_set "BACKUP_TARGET_${upper}_FTP_HOST" \
        "$(prompt_with_default "FTP host for $target" "$(backup_target_value "$target" FTP_HOST)")"
      config_set "BACKUP_TARGET_${upper}_FTP_PORT" \
        "$(prompt_with_default "FTP port for $target" "$(backup_target_value "$target" FTP_PORT 21)")"
      config_set "BACKUP_TARGET_${upper}_FTP_REMOTE_NAME" \
        "$(prompt_with_default "Temporary rclone remote name for $target" "$(backup_target_value "$target" FTP_REMOTE_NAME "$target")")"
      config_set "BACKUP_TARGET_${upper}_FTP_PATH" \
        "$(prompt_with_default "Remote FTP path for $target" "$(backup_target_value "$target" FTP_PATH "/domum-media")")"
      config_set "BACKUP_TARGET_${upper}_FTP_USERNAME_FILE" \
        "$(prompt_with_default "FTP username file for $target" "$(backup_target_value "$target" FTP_USERNAME_FILE "$SECRETS_DIR/${target}_ftp_username")")"
      config_set "BACKUP_TARGET_${upper}_FTP_PASSWORD_FILE" \
        "$(prompt_with_default "FTP password file for $target" "$(backup_target_value "$target" FTP_PASSWORD_FILE "$SECRETS_DIR/${target}_ftp_password")")"
      config_set "BACKUP_TARGET_${upper}_PASSWORD_FILE" \
        "$(prompt_with_default "Restic repository password file for $target" "$(backup_target_password_file "$target")")"
      ;;
  esac
}

apply_update_delay_profile() {
  local profile="$1"
  local class_a_delay class_b_delay class_c_delay

  case "$profile" in
    Conservative) class_a_delay=14; class_b_delay=30; class_c_delay=30 ;;
    Balanced)     class_a_delay=14; class_b_delay=21; class_c_delay=21 ;;
    Fresh)        class_a_delay=7;  class_b_delay=7;  class_c_delay=7 ;;
    *) die "Unknown update profile: $profile" ;;
  esac

  config_set TRAEFIK_AUTO_UPDATE 1
  config_set TAILSCALE_AUTO_UPDATE 1
  config_set UPTIME_KUMA_AUTO_UPDATE 1
  config_set RESTIC_REST_SERVER_AUTO_UPDATE 1
  config_set TRAEFIK_AUTO_UPDATE_DELAY_DAYS "$class_a_delay"
  config_set TAILSCALE_AUTO_UPDATE_DELAY_DAYS "$class_a_delay"
  config_set UPTIME_KUMA_AUTO_UPDATE_DELAY_DAYS "$class_a_delay"
  config_set RESTIC_REST_SERVER_AUTO_UPDATE_DELAY_DAYS "$class_a_delay"

  config_set JELLYFIN_AUTO_UPDATE 1
  config_set PLEX_AUTO_UPDATE 1
  config_set NAVIDROME_AUTO_UPDATE 1
  config_set CALIBRE_WEB_AUTO_UPDATE 1
  config_set KAVITA_AUTO_UPDATE 1
  config_set JELLYFIN_AUTO_UPDATE_DELAY_DAYS "$class_b_delay"
  config_set PLEX_AUTO_UPDATE_DELAY_DAYS "$class_b_delay"
  config_set NAVIDROME_AUTO_UPDATE_DELAY_DAYS "$class_b_delay"
  config_set CALIBRE_WEB_AUTO_UPDATE_DELAY_DAYS "$class_b_delay"
  config_set KAVITA_AUTO_UPDATE_DELAY_DAYS "$class_b_delay"

  config_set IMMICH_BUNDLE_DELAY_DAYS "$class_c_delay"
}

configure_non_interactive() {
  need_root
  ensure_cfg_file
  load_cfg
  export_env_for_compose
  ensure_secret_dir
  converge_local_installation
  sync_timer_overrides
  echo "[domum-media] Non-interactive configure complete."
}

configure_cmd() {
  if [[ "${1:-}" == "--non-interactive" ]]; then
    configure_non_interactive
    return 0
  fi

  need_root
  ensure_cfg_file
  load_cfg
  export_env_for_compose
  ensure_secret_dir
  converge_local_installation

  echo "[domum-media] Interactive configuration"
  echo "Press Enter to keep the current value."
  echo

  configure_text_value DOMUM_DOMAIN "Base domain"
  configure_text_value DOMUM_EMAIL "ACME email for Let's Encrypt"
  configure_text_value DOMUM_LAN_IP "LAN IP for split-DNS notes"
  configure_text_value DOMUM_TS_IP "Tailscale IP for split-DNS notes"

  echo
  configure_service_toggle ENABLE_TRAEFIK "Enable Traefik reverse proxy?"
  configure_service_toggle ENABLE_TAILSCALE "Enable Tailscale container?"
  configure_service_toggle ENABLE_IMMICH "Enable Immich?"
  configure_service_toggle ENABLE_JELLYFIN "Enable Jellyfin?"
  configure_service_toggle ENABLE_PLEX "Enable Plex?"
  configure_service_toggle ENABLE_NAVIDROME "Enable Navidrome (music)?"
  configure_service_toggle ENABLE_CALIBRE_WEB "Enable Calibre-Web?"
  configure_service_toggle ENABLE_KAVITA "Enable Kavita?"
  configure_service_toggle ENABLE_UPTIME_KUMA "Enable Uptime Kuma?"
  configure_service_toggle ENABLE_RESTIC_REST_SERVER "Enable local restic REST server?"

  ensure_cfg_file
  load_cfg
  export_env_for_compose

  if [[ "${ENABLE_TRAEFIK:-0}" == "1" ]]; then
    configure_text_value TRAEFIK_DASHBOARD_HOST "Traefik dashboard hostname"
  fi
  if [[ "${ENABLE_IMMICH:-0}" == "1" ]]; then
    configure_text_value IMMICH_HOST "Immich hostname"
  fi
  if [[ "${ENABLE_JELLYFIN:-0}" == "1" ]]; then
    configure_text_value JELLYFIN_HOST "Jellyfin hostname"
  fi
  if [[ "${ENABLE_PLEX:-0}" == "1" ]]; then
    configure_text_value PLEX_HOST "Plex hostname"
  fi
  if [[ "${ENABLE_NAVIDROME:-0}" == "1" ]]; then
    configure_text_value NAVIDROME_HOST "Navidrome hostname"
  fi
  if [[ "${ENABLE_CALIBRE_WEB:-0}" == "1" ]]; then
    configure_text_value CALIBRE_WEB_HOST "Calibre-Web hostname"
  fi
  if [[ "${ENABLE_KAVITA:-0}" == "1" ]]; then
    configure_text_value KAVITA_HOST "Kavita hostname"
  fi

  echo
  local freshness_profile immich_policy
  freshness_profile="$(prompt_choice "How fresh should app updates be?" "Balanced" Conservative Balanced Fresh)"
  apply_update_delay_profile "$freshness_profile"
  immich_policy="$(prompt_choice "Immich update policy" "Bundle auto-update" "Bundle auto-update" "Notify only" "Manage manually")"
  case "$immich_policy" in
    "Bundle auto-update") config_set IMMICH_BUNDLE_AUTO_UPDATE 1 ;;
    "Notify only") config_set IMMICH_BUNDLE_AUTO_UPDATE 0 ;;
    "Manage manually") config_set IMMICH_BUNDLE_AUTO_UPDATE 0 ;;
  esac
  config_set BACKUP_POLICY \
    "$(prompt_choice "Backup gate policy for updates" "${BACKUP_POLICY:-BALANCED}" STRICT BALANCED LENIENT)"
  config_set AUTO_ROLLBACK_ENABLED \
    "$(prompt_yes_no "Enable automatic rollback if a service health check fails?" "${AUTO_ROLLBACK_ENABLED:-1}")"
  config_set IMMICH_BUNDLE_ROLLBACK_ENABLED \
    "$(prompt_yes_no "Enable Immich bundle rollback on failed health validation?" "${IMMICH_BUNDLE_ROLLBACK_ENABLED:-1}")"
  config_set CLEANUP_IMAGES_AFTER_UPDATE \
    "$(prompt_yes_no "Automatically clean up old Docker images after successful updates?" "${CLEANUP_IMAGES_AFTER_UPDATE:-1}")"
  config_set HOST_SECURITY_AUTO_UPDATE_ENABLED \
    "$(prompt_yes_no "Enable unattended Debian security patches?" "${HOST_SECURITY_AUTO_UPDATE_ENABLED:-1}")"
  local recovery_pack_enabled
  recovery_pack_enabled="$(prompt_yes_no "Enable encrypted recovery-pack creation?" "${RECOVERY_PACK_ENABLED:-1}")"
  config_set RECOVERY_PACK_ENABLED "$recovery_pack_enabled"
  if [[ "$recovery_pack_enabled" == "1" ]]; then
    config_set RECOVERY_PACK_AGE_PUBKEY_FILE \
      "$(prompt_with_default "Path to the age public key for recovery-pack encryption" "${RECOVERY_PACK_AGE_PUBKEY_FILE:-$SECRETS_DIR/recovery_pack_pubkey}")"
  fi

  if [[ "${ENABLE_IMMICH:-0}" == "1" ]]; then
    config_set IMMICH_BUNDLE_DELAY_DAYS \
      "$(prompt_with_default "Delay in days before applying a new Immich bundle" "${IMMICH_BUNDLE_DELAY_DAYS:-21}")"
  fi

  echo
  config_set BACKUP_DAILY_AT \
    "$(prompt_with_default "Daily backup time (HH:MM)" "${BACKUP_DAILY_AT:-02:30}")"
  config_set CHECK_WEEKLY_AT \
    "$(prompt_with_default "Weekly check schedule (e.g. Sun 03:30)" "${CHECK_WEEKLY_AT:-Sun 03:30}")"
  config_set SNAPSHOT_PRUNE_WEEKLY_AT \
    "$(prompt_with_default "Weekly snapshot prune schedule (e.g. Sun 04:30)" "${SNAPSHOT_PRUNE_WEEKLY_AT:-Sun 04:30}")"
  config_set BACKUP_HEARTBEAT_URL \
    "$(prompt_with_default "Backup heartbeat URL (blank to disable)" "${BACKUP_HEARTBEAT_URL:-}")"
  config_set IMAGE_AUTO_UPDATE_ENABLED \
    "$(prompt_yes_no "Enable scheduled container image refresh checks?" "${IMAGE_AUTO_UPDATE_ENABLED:-0}")"
  config_set IMAGE_AUTO_UPDATE_AT \
    "$(prompt_with_default "Daily image refresh check time (HH:MM)" "${IMAGE_AUTO_UPDATE_AT:-05:15}")"
  config_set IMAGE_AUTO_UPDATE_RANDOMIZED_DELAY \
    "$(prompt_with_default "Randomized delay for image refresh timer" "${IMAGE_AUTO_UPDATE_RANDOMIZED_DELAY:-30m}")"
  config_set HOST_PACKAGE_AUTO_UPDATE_ENABLED \
    "$(prompt_yes_no "Enable scheduled host package upgrades (Docker, compose, tailscale, restic)?" "${HOST_PACKAGE_AUTO_UPDATE_ENABLED:-0}")"
  config_set HOST_PACKAGE_AUTO_UPDATE_AT \
    "$(prompt_with_default "Weekly host upgrade schedule (e.g. Mon 05:45)" "${HOST_PACKAGE_AUTO_UPDATE_AT:-Mon 05:45}")"
  config_set HOST_PACKAGE_AUTO_UPDATE_RANDOMIZED_DELAY \
    "$(prompt_with_default "Randomized delay for host upgrade timer" "${HOST_PACKAGE_AUTO_UPDATE_RANDOMIZED_DELAY:-45m}")"
  local host_auto_reboot_enabled
  host_auto_reboot_enabled="$(prompt_yes_no "Enable auto-reboot after kernel updates during a maintenance window?" "${HOST_AUTO_REBOOT_ENABLED:-0}")"
  config_set HOST_AUTO_REBOOT_ENABLED "$host_auto_reboot_enabled"
  if [[ "$host_auto_reboot_enabled" == "1" ]]; then
    config_set HOST_AUTO_REBOOT_WINDOW_START \
      "$(prompt_with_default "Maintenance window start (HH:MM)" "${HOST_AUTO_REBOOT_WINDOW_START:-03:00}")"
    config_set HOST_AUTO_REBOOT_WINDOW_END \
      "$(prompt_with_default "Maintenance window end (HH:MM)" "${HOST_AUTO_REBOOT_WINDOW_END:-05:00}")"
  fi

  echo
  config_set BACKUP_TARGETS "nas cloud archive"
  configure_backup_target nas
  configure_backup_target cloud
  configure_backup_target archive

  ensure_cfg_file
  load_cfg
  export_env_for_compose
  configure_service_secrets

  ensure_cfg_file
  load_cfg
  sync_timer_overrides

  echo
  echo "[domum-media] Configuration saved to $CFG_FILE"
  echo "[domum-media] Timer overrides synced. Run 'sudo domum-media apply' to converge services."
}

tracked_service_container_id() {
  local svc="$1"
  compose_cmd ps -q "$svc" 2>/dev/null | head -n 1
}

# `compose ps -q` lists RUNNING containers only, so it cannot tell "this service
# has no container" from "its container is stopped". Measured on a disposable
# compose project:
#
#   after `compose stop`:   ps -q  -> (empty)
#                           ps -qa -> 5312d8c00833
#
# Those two cases need opposite handling. A stopped container still carries the
# image identity that was in use; an absent one carries none, and starting one
# resolves a mutable tag.
tracked_service_container_id_any() {
  local svc="$1"
  compose_cmd ps -qa "$svc" 2>/dev/null | head -n 1
}

# running | stopped | absent, for the whole service.
#
# A migration must PRESERVE runtime intent: running before means running after,
# and stopped before means stopped after. Turning a service the operator stopped
# into a running one is a change they did not ask for -- and it is the only way a
# migration can be forced to resolve an image tag it has no captured identity for.
#
# Mixed states in a multi-container service (Immich has four) report `running`,
# because at least one container is up and the whole set has to come back.
service_runtime_state() {  # $1 = service
  local svc="$1" compose_svcs compose_svc any_running=0 any_container=0 cid status
  compose_svcs="$(service_compose_services "$svc" || true)"
  [[ -n "$compose_svcs" ]] || { printf 'absent'; return 0; }
  for compose_svc in $compose_svcs; do
    cid="$(tracked_service_container_id_any "$compose_svc" 2>/dev/null || true)"
    [[ -n "$cid" ]] || continue
    any_container=1
    status="$(docker inspect --format '{{.State.Status}}' "$cid" 2>/dev/null || true)"
    [[ "$status" == "running" ]] && any_running=1
  done
  if (( any_running )); then printf 'running'
  elif (( any_container )); then printf 'stopped'
  else printf 'absent'; fi
}

tracked_service_image_id() {
  local svc="$1"
  local cid
  cid="$(tracked_service_container_id "$svc")"
  [[ -n "$cid" ]] || return 0
  docker inspect --format '{{.Image}}' "$cid" 2>/dev/null || true
}

write_update_state() {
  local path="$1"
  local image_id="$2"
  local first_seen="$3"
  local last_update_ts="${4:-}"
  local last_update_from="${5:-}"
  local last_update_to="${6:-}"
  local last_update_snapshot="${7:-}"
  write_env_kv "$path" \
    SEEN_IMAGE_ID "$image_id" \
    FIRST_SEEN_TS "$first_seen" \
    CANDIDATE_DIGEST "$image_id" \
    LAST_UPDATE_TS "$last_update_ts" \
    LAST_UPDATE_FROM "$last_update_from" \
    LAST_UPDATE_TO "$last_update_to" \
    LAST_UPDATE_SNAPSHOT "$last_update_snapshot"
}

clear_update_candidate_state() {
  local path="$1"
  rm -f "$path"
}

refresh_images() {
  need_root
  load_cfg
  export_env_for_compose
  ensure_dirs
  local force=0
  local check_only=0
  local apply_now=0

  while (( $# )); do
    case "$1" in
      --force) force=1 ;;
      --check-only) check_only=1 ;;
      --apply-now) apply_now=1 ;;
      *) die "Usage: domum-media refresh-images [--force] [--check-only] [--apply-now]" ;;
    esac
    shift
  done

  if (( force == 0 && check_only == 0 && apply_now == 0 )) && [[ "${IMAGE_AUTO_UPDATE_ENABLED:-0}" != "1" ]]; then
    echo "[domum-media] Scheduled image refresh disabled (IMAGE_AUTO_UPDATE_ENABLED=0)."
    return 0
  fi

  local due_services=()
  local any_due=0
  local now
  now="$(date +%s)"

  while IFS='|' read -r key enable_var image_var auto_var delay_var svc; do
    [[ "${!enable_var:-0}" == "1" ]] || continue
    [[ "${!auto_var:-0}" == "1" ]] || continue

    local image_ref running_id current_id state_file delay_days delay_secs first_seen_ts remaining previous_candidate previous_seen
    image_ref="${!image_var:-}"
    [[ -n "$image_ref" ]] || continue

    echo "[domum-media] Checking ${key} -> ${image_ref}"
    compose_cmd pull "$svc" >/dev/null

    running_id="$(tracked_service_image_id "$svc")"
    current_id="$(docker image inspect "$image_ref" --format '{{.Id}}' 2>/dev/null || true)"
    state_file="$DOMUM_STATE_ROOT/image-updates/${key}.env"
    delay_days="${!delay_var:-7}"
    delay_secs=$(( delay_days * 86400 ))

    if [[ -z "$running_id" || -z "$current_id" ]]; then
      clear_update_candidate_state "$state_file"
      echo "[domum-media] Skipping ${key}; container or image metadata unavailable."
      continue
    fi

    if [[ "$running_id" == "$current_id" ]]; then
      clear_update_candidate_state "$state_file"
      echo "[domum-media] ${key} already running the current image."
      continue
    fi

    unset SEEN_IMAGE_ID FIRST_SEEN_TS CANDIDATE_DIGEST LAST_UPDATE_TS LAST_UPDATE_FROM LAST_UPDATE_TO LAST_UPDATE_SNAPSHOT
    if [[ -f "$state_file" ]]; then
      # shellcheck disable=SC1090
      source "$state_file"
    fi

    previous_candidate="${CANDIDATE_DIGEST:-${SEEN_IMAGE_ID:-}}"
    previous_seen="${FIRST_SEEN_TS:-$now}"

    if [[ -z "$previous_candidate" ]]; then
      write_update_state "$state_file" "$current_id" "$now" "${LAST_UPDATE_TS:-}" "${LAST_UPDATE_FROM:-}" "${LAST_UPDATE_TO:-}" "${LAST_UPDATE_SNAPSHOT:-}"
      if (( apply_now == 1 )); then
        due_services+=("${key}|${svc}|${running_id}|${current_id}|${state_file}")
        any_due=1
        continue
      fi
      echo "[domum-media] ${key} has a newer image; waiting ${delay_days} day(s) before rollout."
      continue
    fi

    if [[ "$previous_candidate" != "$current_id" ]]; then
      write_update_state "$state_file" "$current_id" "$now" "${LAST_UPDATE_TS:-}" "${LAST_UPDATE_FROM:-}" "${LAST_UPDATE_TO:-}" "${LAST_UPDATE_SNAPSHOT:-}"
      record_update_history "$key" "delay_reset" "$previous_candidate" "$current_id" "" "success" "upstream moved during delay window"
      if (( apply_now == 1 )); then
        due_services+=("${key}|${svc}|${running_id}|${current_id}|${state_file}")
        any_due=1
        continue
      fi
      echo "[domum-media] ${key} upstream moved during delay window; restarting the ${delay_days}-day timer."
      continue
    fi

    first_seen_ts="$previous_seen"
    if (( apply_now == 0 )) && (( now - first_seen_ts < delay_secs )); then
      remaining=$(( delay_secs - (now - first_seen_ts) ))
      echo "[domum-media] ${key} is still in the delay window (${remaining}s remaining)."
      continue
    fi

    if (( check_only == 1 )); then
      echo "[domum-media] ${key} is ready to update (${image_ref})."
      any_due=1
      continue
    fi

    due_services+=("${key}|${svc}|${running_id}|${current_id}|${state_file}")
    any_due=1
  done < <(managed_image_specs)

  if (( any_due == 0 )); then
    if (( check_only == 1 )); then
      echo "[domum-media] No tracked images are ready."
    else
      echo "[domum-media] No tracked images are ready to roll out."
    fi
    return 0
  fi

  if (( check_only == 1 )); then
    return 0
  fi

  local entry logical_service before_image after_image version_key before_version snapshot_name state_file compose_svcs
  for entry in "${due_services[@]}"; do
    IFS='|' read -r logical_service _ before_image after_image state_file <<< "$entry"
    verify_backup_freshness "$logical_service"
    version_key="$(printf '%s_IMAGE' "$(uppercase_token "$logical_service")")"
    before_version="$(service_configured_version "$version_key")"
    # The snapshot IS the rollback mechanism for this update: if it was not
    # created, auto-rollback below silently cannot run. Gate in the calling
    # shell so a refusal actually stops the rollout.
    snapshot_name=""
    if ! snapshot_name="$(create_service_snapshot "$logical_service" "pre-update" "$before_image" "$after_image")"; then
      snapshot_name=""
    fi
    if [[ -z "$snapshot_name" ]]; then
      snapshot_protection_unavailable \
        "Cannot snapshot $logical_service before updating it" \
        "$(service_data_path "$logical_service" 2>/dev/null || printf '%s' "$logical_service") is not a Btrfs subvolume, so no pre-update snapshot exists and automatic rollback would be unavailable"
    fi
    compose_svcs="$(service_compose_services "$logical_service" || true)"
    [[ -n "$compose_svcs" ]] || continue
    echo "[domum-media] Updating $logical_service (${compose_svcs})"
    # shellcheck disable=SC2086
    compose_cmd up -d $compose_svcs
    if ! wait_for_service_health "$logical_service" 120 5; then
      echo "[domum-media] Health validation failed for $logical_service"
      record_update_history "$logical_service" "skipped_unhealthy" "$before_image" "$after_image" "$snapshot_name" "failure" "automatic rollback triggered"
      if [[ "${AUTO_ROLLBACK_ENABLED:-1}" == "1" && -n "$snapshot_name" ]]; then
        restore_snapshot_for_service "$logical_service" "$snapshot_name"
        # DATA only. restore_snapshot_for_service restores the snapshot and then
        # runs `compose_cmd up -d` -- it never re-pins IMAGE_BEFORE, so the
        # service comes back on the SAME image that just failed its health check.
        # Recording this as an unqualified success said the opposite of what
        # happened. Backlog task-24 is the fix; until then it is reported honestly.
        record_update_history "$logical_service" "rolled_back_data_only" "$after_image" "$before_image" "$snapshot_name" "partial" "data restored from snapshot; the image was NOT rolled back and is still $after_image"
      fi
      if [[ "${AUTO_ROLLBACK_ENABLED:-1}" == "1" && -n "$snapshot_name" ]]; then
        die "Update aborted: $logical_service failed health validation and was rolled back."
      fi
      die "Update aborted: $logical_service failed health validation."
    fi
    clear_update_candidate_state "$state_file"
    record_update_history "$logical_service" "applied" "$before_image" "$after_image" "$snapshot_name" "success" "$before_version -> ${!version_key:-unknown}"
    if [[ "${CLEANUP_IMAGES_AFTER_UPDATE:-1}" == "1" ]]; then
      cleanup_images_execute 1 0 >/dev/null 2>&1 || true
    fi
  done
  echo "[domum-media] Image refresh done."
}

time_hhmm_to_minutes() {
  local value="$1"
  printf '%s' $(( 10#${value%:*} * 60 + 10#${value#*:} ))
}

within_reboot_window() {
  local now_hhmm start end now_m start_m end_m
  now_hhmm="$(date +%H:%M)"
  start="${HOST_AUTO_REBOOT_WINDOW_START:-03:00}"
  end="${HOST_AUTO_REBOOT_WINDOW_END:-05:00}"
  now_m="$(time_hhmm_to_minutes "$now_hhmm")"
  start_m="$(time_hhmm_to_minutes "$start")"
  end_m="$(time_hhmm_to_minutes "$end")"

  if (( start_m <= end_m )); then
    (( now_m >= start_m && now_m <= end_m ))
  else
    (( now_m >= start_m || now_m <= end_m ))
  fi
}

host_upgrade() {
  need_root
  load_cfg
  export_env_for_compose
  local force=0
  [[ "${1:-}" == "--force" ]] && force=1

  if (( force == 0 )) && [[ "${HOST_PACKAGE_AUTO_UPDATE_ENABLED:-0}" != "1" ]]; then
    echo "[domum-media] Scheduled host package upgrades disabled (HOST_PACKAGE_AUTO_UPDATE_ENABLED=0)."
    return 0
  fi

  # Upgrading docker-ce/containerd RESTARTS the Docker daemon, which restarts
  # containers. A migration running at the same time has those containers
  # deliberately stopped while it copies and then renames their data directory --
  # so the daemon would bring a service back up onto a half-copied .new, or
  # during the cutover rename itself. btrfs-progs is in the same list, and this
  # unit can go on to reboot the host.
  #
  # Mondays 05:45 (+45m) does not overlap the 02:30 backup, but it very much can
  # overlap an attended migration, which is exactly when the operator is not
  # expecting the daemon to restart underneath them.
  #
  # Unattended, so it WAITS rather than skipping a week of security updates.
  if ! domum_acquire_lock "host-upgrade" "${HOST_UPGRADE_LOCK_WAIT_SECONDS:-1800}"; then
    die "Timed out waiting for another domum-media operation: $(domum_lock_holder)
No packages were upgraded. Upgrading docker-ce here would restart the Docker
daemon underneath that operation."
  fi

  echo "[domum-media] Updating host packages from configured apt repos..."
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y
  apt-get install -y --only-upgrade \
    docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin \
    tailscale restic btrfs-progs jq apparmor nfs-common rclone gettext-base \
    unattended-upgrades apt-listchanges age
  record_update_history "host" "applied" "" "" "" "success" "apt host-upgrade completed"
  if [[ -f /var/run/reboot-required ]]; then
    echo "[domum-media] Reboot required by the latest package upgrade."
    if [[ "${HOST_AUTO_REBOOT_ENABLED:-0}" == "1" ]] && within_reboot_window; then
      echo "[domum-media] Auto-reboot window open; rebooting now."
      shutdown -r +1 "domum-media host-upgrade requested reboot"
    fi
  fi
  echo "[domum-media] Host package upgrade done."
}

show_update_inventory() {
  need_root
  load_cfg
  export_env_for_compose

  printf '%-14s %-5s %-5s %-8s %-24s\n' "SERVICE" "CLASS" "AUTO" "DELAY" "CURRENT"
  while IFS='|' read -r name enable_var class default_delay _ image_var _; do
    [[ "${!enable_var:-0}" == "1" ]] || continue
    local auto_var delay_var auto_value delay_value
    if [[ "$name" == "immich" ]]; then
      auto_value="${IMMICH_BUNDLE_AUTO_UPDATE:-0}"
      delay_value="${IMMICH_BUNDLE_DELAY_DAYS:-$default_delay}"
    else
      auto_var="$(printf '%s_AUTO_UPDATE' "$(uppercase_token "$name")")"
      delay_var="$(printf '%s_AUTO_UPDATE_DELAY_DAYS' "$(uppercase_token "$name")")"
      auto_value="${!auto_var:-0}"
      delay_value="${!delay_var:-$default_delay}"
    fi
    printf '%-14s %-5s %-5s %-8s %-24s\n' \
      "$name" "$class" "$auto_value" "${delay_value}d" "$(service_configured_version "$image_var")"
  done < <(service_lifecycle_specs)

  if [[ -f "$DOMUM_STATE_ROOT/immich/bundle-candidate.env" ]]; then
    echo
    echo "Immich bundle candidate:"
    # shellcheck disable=SC1090
    # shellcheck disable=SC1091
    source "$DOMUM_STATE_ROOT/immich/bundle-candidate.env"
    printf '  release=%s published=%s\n' "${IMMICH_BUNDLE_TAG:-unknown}" "${IMMICH_BUNDLE_PUBLISHED_AT:-unknown}"
    printf '  server=%s\n' "${IMMICH_BUNDLE_SERVER_IMAGE:-unknown}"
    printf '  ml=%s\n' "${IMMICH_BUNDLE_MACHINE_LEARNING_IMAGE:-unknown}"
    printf '  redis=%s\n' "${IMMICH_BUNDLE_REDIS_IMAGE:-unknown}"
    printf '  postgres=%s\n' "${IMMICH_BUNDLE_POSTGRES_IMAGE:-unknown}"
  fi
}

updates_history() {
  load_cfg
  ensure_state_dirs

  printf '%-19s %-14s %-18s %-8s %s\n' "WHEN" "SERVICE" "EVENT" "RESULT" "NOTE"
  find "$(update_history_dir)" -type f -name '*.env' | sort | while IFS= read -r file; do
    unset SERVICE EVENT RESULT NOTE TS
    # shellcheck disable=SC1090
    source "$file"
    printf '%-19s %-14s %-18s %-8s %s\n' \
      "$(epoch_to_iso "${TS:-0}")" \
      "${SERVICE:-unknown}" \
      "${EVENT:-unknown}" \
      "${RESULT:-unknown}" \
      "${NOTE:-}"
  done
}

updates_cmd() {
  load_cfg
  export_env_for_compose
  local sub="${1:-summary}"
  case "$sub" in
    ""|summary) show_update_inventory ;;
    check) shift; show_update_inventory; echo; refresh_images --check-only; [[ "${ENABLE_IMMICH:-0}" == "1" ]] && immich_refresh_bundle --check-only ;;
    apply)
      shift
      # --service <name> is a DIFFERENT operation, not a filter bolted onto the
      # fleet path. refresh_images cannot take a service argument (it dies on any
      # positional) and its scope is every service with ENABLE_*=1 and
      # *_AUTO_UPDATE=1. service_upgrade upgrades exactly one, with pre-upgrade
      # protection it cannot skip.
      if [[ "${1:-}" == "--service" ]]; then
        shift
        [[ -n "${1:-}" ]] || die "Usage: domum-media updates apply --service <service> [--dry-run]"
        service_upgrade "$1" "${2:-}"
      else
        refresh_images --apply-now --force
        [[ "${ENABLE_IMMICH:-0}" == "1" ]] && immich_refresh_bundle --force
      fi
      ;;
    history) shift; updates_history ;;
    *) die "Usage: domum-media updates {summary|check|apply [--service <service> [--dry-run]]|history}" ;;
  esac
}

immich_extract_image() {
  local compose_file="$1"
  local pattern="$2"
  awk -v pattern="$pattern" '
    $0 ~ pattern { capture=1 }
    capture && $1 == "image:" { print $2; exit }
    capture && NF == 0 { capture=0 }
  ' "$compose_file"
}

immich_refresh_bundle() {
  need_root
  load_cfg
  export_env_for_compose
  ensure_dirs

  local force=0
  local check_only=0
  while (( $# )); do
    case "$1" in
      --force) force=1 ;;
      --check-only) check_only=1 ;;
      *) die "Usage: domum-media immich {refresh-bundle [--force]|check-bundle|apply-bundle|rollback}" ;;
    esac
    shift
  done

  cmd_exists curl || die "curl is required for immich bundle refresh"
  cmd_exists jq || die "jq is required for immich bundle refresh"

  local api_url="https://api.github.com/repos/immich-app/immich/releases/latest"
  local release_json compose_tmp meta_tmp candidate_file applied_file
  release_json="$(mktemp)"
  compose_tmp="$(mktemp)"
  meta_tmp="$(mktemp)"
  candidate_file="$DOMUM_STATE_ROOT/immich/bundle-candidate.env"
  applied_file="$DOMUM_STATE_ROOT/immich/applied-bundle.env"

  curl -fsSL "$api_url" > "$release_json"
  curl -fsSL "https://github.com/immich-app/immich/releases/latest/download/docker-compose.yml" > "$compose_tmp"

  jq -r '{
    tag_name,
    html_url,
    published_at
  } | to_entries[] | "\(.key)=\(.value)"' "$release_json" > "$meta_tmp"

  local tag_name html_url published_at server_image ml_image redis_image postgres_image
  tag_name="$(awk -F= '$1=="tag_name" {print $2}' "$meta_tmp")"
  html_url="$(awk -F= '$1=="html_url" {print $2}' "$meta_tmp")"
  published_at="$(awk -F= '$1=="published_at" {print $2}' "$meta_tmp")"
  server_image="$(immich_extract_image "$compose_tmp" "container_name:[[:space:]]*immich_server")"
  ml_image="$(immich_extract_image "$compose_tmp" "container_name:[[:space:]]*immich_machine_learning")"
  redis_image="$(immich_extract_image "$compose_tmp" "container_name:[[:space:]]*immich_redis")"
  postgres_image="$(immich_extract_image "$compose_tmp" "container_name:[[:space:]]*immich_postgres")"
  [[ -n "$server_image" && -n "$ml_image" && -n "$redis_image" && -n "$postgres_image" ]] \
    || die "Failed to parse one or more Immich images from the upstream release compose file."

  local now delay_days current_bundle_key desired_bundle_key current_candidate_tag current_candidate_first_seen
  now="$(date +%s)"
  delay_days="${IMMICH_BUNDLE_DELAY_DAYS:-21}"
  current_bundle_key="${IMMICH_SERVER_IMAGE}|${IMMICH_MACHINE_LEARNING_IMAGE}|${IMMICH_REDIS_IMAGE}|${IMMICH_POSTGRES_IMAGE}"
  desired_bundle_key="${server_image}|${ml_image}|${redis_image}|${postgres_image}"

  unset IMMICH_BUNDLE_TAG IMMICH_BUNDLE_RELEASE_URL IMMICH_BUNDLE_PUBLISHED_AT IMMICH_BUNDLE_SERVER_IMAGE IMMICH_BUNDLE_MACHINE_LEARNING_IMAGE IMMICH_BUNDLE_REDIS_IMAGE IMMICH_BUNDLE_POSTGRES_IMAGE FIRST_SEEN_TS
  if [[ -f "$candidate_file" ]]; then
    # shellcheck disable=SC1090
    source "$candidate_file"
  fi
  current_candidate_tag="${IMMICH_BUNDLE_TAG:-}"
  current_candidate_first_seen="${FIRST_SEEN_TS:-$now}"

  if [[ "$current_bundle_key" == "$desired_bundle_key" ]]; then
    write_env_kv "$applied_file" \
      RELEASE_TAG "$tag_name" \
      RELEASE_URL "$html_url" \
      RELEASE_DATE "$published_at" \
      FIRST_APPLIED_TS "$now" \
      SERVER_IMAGE "$server_image" \
      ML_IMAGE "$ml_image" \
      REDIS_IMAGE "$redis_image" \
      POSTGRES_IMAGE "$postgres_image"
    rm -f "$candidate_file"
    echo "[domum-media] Immich already matches the latest release bundle ($tag_name)."
    rm -f "$release_json" "$compose_tmp" "$meta_tmp"
    return 0
  fi

  if [[ "$current_candidate_tag" != "$tag_name" ]]; then
    write_env_kv "$candidate_file" \
      IMMICH_BUNDLE_TAG "$tag_name" \
      IMMICH_BUNDLE_RELEASE_URL "$html_url" \
      IMMICH_BUNDLE_PUBLISHED_AT "$published_at" \
      IMMICH_BUNDLE_SERVER_IMAGE "$server_image" \
      IMMICH_BUNDLE_MACHINE_LEARNING_IMAGE "$ml_image" \
      IMMICH_BUNDLE_REDIS_IMAGE "$redis_image" \
      IMMICH_BUNDLE_POSTGRES_IMAGE "$postgres_image" \
      FIRST_SEEN_TS "$now"
    if [[ -n "$current_candidate_tag" ]]; then
      record_update_history "immich" "delay_reset" "$current_candidate_tag" "$tag_name" "" "success" "newer bundle appeared during delay window"
      echo "[domum-media] Immich bundle advanced from $current_candidate_tag to $tag_name; delay restarted."
    else
      echo "[domum-media] Stored new Immich bundle candidate $tag_name; waiting ${delay_days} day(s)."
    fi
    if (( force == 0 )); then
      rm -f "$release_json" "$compose_tmp" "$meta_tmp"
      return 0
    fi
  fi

  local remaining
  if (( force == 0 )) && (( check_only == 0 )) && [[ "${IMMICH_BUNDLE_AUTO_UPDATE:-1}" != "1" ]]; then
    echo "[domum-media] Immich bundle auto-update is disabled."
    rm -f "$release_json" "$compose_tmp" "$meta_tmp"
    return 0
  fi
  if (( force == 0 )) && (( now - current_candidate_first_seen < delay_days * 86400 )); then
    remaining=$(( delay_days * 86400 - (now - current_candidate_first_seen) ))
    echo "[domum-media] Immich bundle $tag_name is still in the delay window (${remaining}s remaining)."
    rm -f "$release_json" "$compose_tmp" "$meta_tmp"
    return 0
  fi
  if (( check_only == 1 )); then
    echo "[domum-media] Immich bundle $tag_name is ready."
    rm -f "$release_json" "$compose_tmp" "$meta_tmp"
    return 0
  fi

  verify_backup_freshness immich

  local old_server="$IMMICH_SERVER_IMAGE"
  local old_ml="$IMMICH_MACHINE_LEARNING_IMAGE"
  local old_redis="$IMMICH_REDIS_IMAGE"
  local old_postgres="$IMMICH_POSTGRES_IMAGE"
  local snapshot_name
  # A bundle apply can migrate the Immich database schema. Without a snapshot
  # the only fallback below is re-pinning the old images against an already
  # migrated database, which is not a data rollback.
  snapshot_name=""
  if ! snapshot_name="$(create_service_snapshot immich "pre-immich-bundle" "$old_server" "$server_image")"; then
    snapshot_name=""
  fi
  if [[ -z "$snapshot_name" ]]; then
    snapshot_protection_unavailable \
      "Cannot snapshot Immich before applying the bundle" \
      "$(service_data_path immich 2>/dev/null || printf 'the Immich state path') is not a Btrfs subvolume, so no pre-bundle snapshot exists and a failed rollout could not restore the database"
  fi

  config_set IMMICH_SERVER_IMAGE "$server_image"
  config_set IMMICH_MACHINE_LEARNING_IMAGE "$ml_image"
  config_set IMMICH_REDIS_IMAGE "$redis_image"
  config_set IMMICH_POSTGRES_IMAGE "$postgres_image"
  load_cfg
  export_env_for_compose

  compose_cmd pull immich_server immich_machine_learning immich_redis immich_postgres
  compose_cmd up -d immich_server immich_machine_learning immich_redis immich_postgres
  if ! wait_for_service_health immich 180 5; then
    echo "[domum-media] Immich bundle rollout failed health validation."
    config_set IMMICH_SERVER_IMAGE "$old_server"
    config_set IMMICH_MACHINE_LEARNING_IMAGE "$old_ml"
    config_set IMMICH_REDIS_IMAGE "$old_redis"
    config_set IMMICH_POSTGRES_IMAGE "$old_postgres"
    load_cfg
    export_env_for_compose
    record_update_history "immich" "skipped_unhealthy" "$old_server" "$server_image" "$snapshot_name" "failure" "bundle rollout failed validation"
    if [[ -n "$snapshot_name" ]]; then
      restore_snapshot_for_service immich "$snapshot_name"
      # Data only -- see the note in refresh_images. The images are re-pinned
      # separately below by config_set, which is why this one is nearer the truth
       # than the generic path, but the restore itself restored data alone.
      record_update_history "immich" "rolled_back_data_only" "$server_image" "$old_server" "$snapshot_name" "partial" "pre-bundle snapshot restored; image pinning handled separately"
    else
      compose_cmd up -d immich_server immich_machine_learning immich_redis immich_postgres
    fi
    die "Immich bundle refresh rolled back."
  fi

  write_env_kv "$applied_file" \
    RELEASE_TAG "$tag_name" \
    RELEASE_URL "$html_url" \
    RELEASE_DATE "$published_at" \
    FIRST_APPLIED_TS "$now" \
    SERVER_IMAGE "$server_image" \
    ML_IMAGE "$ml_image" \
    REDIS_IMAGE "$redis_image" \
    POSTGRES_IMAGE "$postgres_image"
  rm -f "$candidate_file"
  record_update_history "immich" "applied" "$old_server" "$server_image" "$snapshot_name" "success" "$tag_name"
  echo "[domum-media] Immich bundle refreshed to $tag_name"
  rm -f "$release_json" "$compose_tmp" "$meta_tmp"
}

# ---- commands -------------------------------------------------------------

init_host() {
  need_root
  ensure_cfg_file
  load_cfg
  export_env_for_compose
  ensure_dirs
  converge_local_installation

  local missing=()
  if [[ "${ENABLE_TRAEFIK:-0}" == "1" ]]; then
    while IFS= read -r item; do [[ -n "$item" ]] && missing+=("$item"); done \
      < <(missing_if_absent "$SECRETS_DIR/cloudflare_api_token" "cloudflare_api_token")
    while IFS= read -r item; do [[ -n "$item" ]] && missing+=("$item"); done \
      < <(missing_if_absent "${TRAEFIK_DASHBOARD_USERS_FILE:-$SECRETS_DIR/traefik_dashboard_users}" "traefik_dashboard_users")
  fi
  if [[ "${ENABLE_IMMICH:-0}" == "1" ]]; then
    while IFS= read -r item; do [[ -n "$item" ]] && missing+=("$item"); done \
      < <(missing_if_absent "$SECRETS_DIR/immich_db_password" "immich_db_password")
    while IFS= read -r item; do [[ -n "$item" ]] && missing+=("$item"); done \
      < <(missing_if_absent "$SECRETS_DIR/immich_jwt_secret" "immich_jwt_secret")
    if immich_db_password_initialized && [[ ! -f "$(immich_db_password_fingerprint_file)" ]]; then
      echo "[domum-media] NOTE: Immich Postgres is initialized but no password fingerprint is recorded yet."
      echo "    'domum-media apply' will refuse until you restore the expected fingerprint or run:"
      echo "        sudo domum-media immich reset-db"
    fi
  fi

  while IFS= read -r target; do
    backup_target_enabled "$target" || continue
    local target_type pw_file
    target_type="$(backup_target_value "$target" TYPE repository)"
    pw_file="$(backup_target_password_file "$target")"
    [[ -f "$pw_file" ]] || missing+=("$pw_file")
    case "$target_type" in
      repository)
        if ! backup_target_has_repository_source "$target"; then
          missing+=("BACKUP_TARGET_$(uppercase_token "$target")_REPOSITORY or $(backup_target_legacy_env_file "$target")")
        fi
        local env_file
        env_file="$(backup_target_value "$target" ENV_FILE)"
        if [[ -n "$env_file" && -f "$env_file" ]]; then
          if ! validate_backup_env_file "$env_file"; then
            missing+=("invalid env file: $env_file")
          fi
        fi
        ;;
      nfs)
        [[ -n "$(backup_target_value "$target" NFS_REMOTE)" ]] || missing+=("BACKUP_TARGET_$(uppercase_token "$target")_NFS_REMOTE")
        [[ -n "$(backup_target_value "$target" NFS_MOUNT_POINT)" ]] || missing+=("BACKUP_TARGET_$(uppercase_token "$target")_NFS_MOUNT_POINT")
        [[ -n "$(backup_target_value "$target" REPOSITORY)" ]] || missing+=("BACKUP_TARGET_$(uppercase_token "$target")_REPOSITORY")
        ;;
      ftp)
        [[ -n "$(backup_target_value "$target" FTP_HOST)" ]] || missing+=("BACKUP_TARGET_$(uppercase_token "$target")_FTP_HOST")
        while IFS= read -r item; do [[ -n "$item" ]] && missing+=("$item"); done \
          < <(missing_if_absent "$(backup_target_value "$target" FTP_USERNAME_FILE "$SECRETS_DIR/${target}_ftp_username")" "FTP username file for $target")
        while IFS= read -r item; do [[ -n "$item" ]] && missing+=("$item"); done \
          < <(missing_if_absent "$(backup_target_value "$target" FTP_PASSWORD_FILE "$SECRETS_DIR/${target}_ftp_password")" "FTP password file for $target")
        ;;
    esac
  done < <(backup_target_names)

  if (( ${#missing[@]} > 0 )); then
    echo "[domum-media] WARNING: missing config/secrets:"
    for m in "${missing[@]}"; do echo "    $m"; done
    echo "    Run 'domum-media configure' or fill the listed files before the backup timer fires."
  fi

  if ! cmd_exists btrfs; then
    die "btrfs-progs not installed — rerun install.sh"
  fi
  if ! mountpoint -q "$DOMUM_DATA_ROOT"; then
    echo "[domum-media] WARNING: $DOMUM_DATA_ROOT is not a mount point."
    echo "    Did you complete docs/SETUP-N100.md? Snapshots will fail otherwise."
  fi
  if ! cmd_exists mount.nfs; then
    echo "[domum-media] WARNING: mount.nfs not found. NFS backup targets will fail until nfs-common is installed."
  fi
  if ! cmd_exists rclone; then
    echo "[domum-media] WARNING: rclone not found. FTP/rclone backup targets will fail until rclone is installed."
  fi

  sync_timer_overrides
  echo "[domum-media] init complete."
}

# `apply` must not deploy an application upgrade as a side effect of convergence.
#
# The per-service gate lives in `refresh_images`: it calls create_service_snapshot
# for the service being updated and, when that returns nothing, hands off to
# snapshot_protection_unavailable, which dies under SNAPSHOT_POLICY=REQUIRED. So
# `domum-media updates apply` correctly REFUSES plex and calibre-web, whose state
# directories are not subvolumes.
#
# `apply` has no such gate. It takes a fleet-wide `snapshot_create "pre-apply"`,
# treats failure as a WARNING by design -- it is convergence, not an update -- and
# then runs `compose up -d --remove-orphans`, which recreates any container whose
# image has changed. And `domum-media update` is `repo_update`, which ends in
# `exec domum-media apply`.
#
# So the supposedly-gated path was not the gated one. Measured on this host:
#
#   plex         staged image, /srv/data/plex          unprotected
#   calibre-web  staged image, /srv/data/calibre-web   unprotected
#   uptime-kuma  staged image, no /srv/data path       (state is a volume, in the recovery pack)
#   traefik      staged image, no /srv/data path       (ACME store, in the recovery pack)
#
# `domum-media apply` would have upgraded all four, two of them with no recovery
# point for the state they are about to migrate.
#
# The invariant, service by service: an application image upgrade may proceed only
# when the state THAT application may mutate has a recovery point appropriate to
# THAT application. A jellyfin snapshot must never satisfy a plex upgrade. This is
# the same defect class as `immich reset-db` passing on an unrelated snapshot
# count, which is why it is checked per service and never counted.
#
# A service whose state path does not exist is NOT refused: there is nothing under
# the protected tier for a snapshot to cover, and what those services keep
# elsewhere is the recovery-pack question (docs/STATE-CLASSIFICATION.md). It is
# reported rather than silently passed.
apply_staged_image_blockers() {  # -> "service state" lines for services that must not be upgraded
  local svc enable_var path staged state
  while IFS='|' read -r svc enable_var _ _ _ _ _; do
    [[ -n "$svc" ]] || continue
    [[ "${!enable_var:-0}" == "1" ]] || continue
    staged="$(service_staged_image_changes "$svc" 2>/dev/null | grep '^STAGED ' || true)"
    [[ -n "$staged" ]] || continue
    path="$(service_data_path "$svc" 2>/dev/null || true)"
    if [[ -z "$path" || ! -e "$path" ]]; then
      printf 'NOSTATE %s\n' "$svc"
      continue
    fi
    state="$(report_snapshot_protection "$svc" "$path" | jq -r '.state')"
    [[ "$state" == "protected" ]] && continue
    printf 'BLOCKED %s %s\n' "$svc" "$state"
  done < <(service_lifecycle_specs)
}

# The refusal itself, in one place, so a test can run it rather than grep for it.
apply_assert_staged_images_recoverable() {
  load_report_lib
  local blockers nostate
  blockers="$(apply_staged_image_blockers)"
  nostate="$(grep '^NOSTATE ' <<< "$blockers" || true)"
  blockers="$(grep '^BLOCKED ' <<< "$blockers" || true)"
  if [[ -n "$nostate" ]]; then
    warn "A newer image is staged for these services, whose durable state is NOT under ${DOMUM_DATA_ROOT:-/srv/data}:"
    printf '  %s\n' "$nostate" >&2
    warn "A snapshot cannot cover them; see docs/STATE-CLASSIFICATION.md for what does."
  fi
  [[ -n "$blockers" ]] || return 0
  if [[ "${APPLY_ALLOW_IMAGE_CHANGE:-0}" == "1" ]]; then
    warn "APPLY_ALLOW_IMAGE_CHANGE=1, so this apply WILL upgrade these unprotected services:"
    printf '  %s\n' "$blockers" >&2
    return 0
  fi
  die "Refusing: this apply would deploy a staged image for services whose state has no recovery point.
$blockers
\`apply\` is convergence, and \`compose up -d\` recreates any container whose image has
changed -- so it would upgrade the application and migrate its state with nothing to
go back to. An image upgrade needs a recovery point for the state THAT service may
mutate; another service's snapshot does not count.

Either:
  * make the state snapshot-capable first:  sudo domum-media storage migrate-subvolume <service>
  * or deploy through the gated path, which refuses per service:
                                            sudo domum-media updates apply
  * or accept it deliberately:              APPLY_ALLOW_IMAGE_CHANGE=1 sudo domum-media apply"
}

apply() {
  need_root
  load_cfg
  export_env_for_compose
  ensure_dirs
  converge_local_installation
  ensure_networks
  sync_timer_overrides

  sanitize_immich_secret_files

  local immich_first_boot=0
  if [[ "${ENABLE_IMMICH:-0}" == "1" ]] && ! immich_db_password_initialized; then
    immich_first_boot=1
  fi
  validate_immich_db_password_state
  validate_immich_secret_exports

  render_traefik_dynamic
  if [[ "${ENABLE_TRAEFIK:-0}" == "1" ]] && docker inspect traefik >/dev/null 2>&1; then
    echo "[domum-media] Restarting traefik to apply dynamic config..."
    docker restart traefik >/dev/null
  fi
  validate_immich_compose_config

  echo "[domum-media] Pre-apply btrfs snapshot..."
  # apply is routine convergence and does not itself depend on the snapshot for
  # rollback, so this stays non-fatal -- but it must be loud rather than
  # silently reporting a snapshot that never happened.
  if ! snapshot_create "pre-apply"; then
    # Do NOT assert a cause here. This used to say "service state paths are not
    # Btrfs subvolumes", which was the only possible reason while none of them
    # was -- and is now wrong in the case that matters: with migrated services
    # present, snapshot_create also returns non-zero when a subvolume's snapshot
    # genuinely FAILED. Naming the old cause would hide the new one. The counts
    # it just printed say which happened.
    warn "No usable pre-apply snapshot; this apply has no rollback point."
    warn "See the snapshot counts above for whether paths were skipped or a snapshot failed, and docs/SNAPSHOT-MODEL.md."
  fi

  # Convergence must not become an application upgrade. Checked immediately before
  # the only `up -d` that touches every service.
  apply_assert_staged_images_recoverable

  echo "[domum-media] Applying desired state..."
  compose_cmd up -d --remove-orphans

  # docker compose won't recreate a container when it sees no config change, so
  # a secret rotation can leave the old (or empty) env baked into a running
  # container. If the runtime secrets aren't consistent, force-recreate the
  # Immich services once before deciding the apply has failed.
  if [[ "${ENABLE_IMMICH:-0}" == "1" ]] && ! immich_runtime_env_ok; then
    echo "[domum-media] Immich runtime secrets inconsistent after up; force-recreating Immich services..."
    compose_cmd up -d --force-recreate \
      immich_postgres immich_redis immich_machine_learning immich_server
  fi
  validate_immich_runtime_env

  # Record the "born with" password fingerprint only on first boot and only when
  # the database actually came up cleanly — never stamp success onto a broken
  # deploy (auth-looping server / unhealthy postgres).
  if (( immich_first_boot == 1 )) && immich_db_password_initialized; then
    local pg_status server_status
    pg_status="$(container_status_summary immich_postgres)"
    server_status="$(container_status_summary immich_server)"
    if [[ "$pg_status" == "healthy" ]] \
       && [[ "$server_status" != "unhealthy" && "$server_status" != "restarting" \
             && "$server_status" != "exited" && "$server_status" != "dead" \
             && "$server_status" != "missing" ]]; then
      write_immich_db_password_fingerprint
      echo "[domum-media] Recorded Immich DB password fingerprint at $(immich_db_password_fingerprint_file)."
    else
      echo "[domum-media] WARNING: not recording Immich DB password fingerprint — immich_postgres=$pg_status immich_server=$server_status." >&2
      echo "[domum-media] Re-run 'sudo domum-media apply' once Immich is healthy, or 'sudo domum-media immich reset-db' to start clean." >&2
    fi
  fi

  echo "[domum-media] apply done."
}

status_counts() {
  local immich_lib="${DOMUM_DATA_ROOT}/immich/library"
  local media_root="${DOMUM_MEDIA_ROOT:-$MEDIA_ROOT_DEFAULT}"

  echo "=== data counts ==="
  [[ -d "$immich_lib" ]] && printf 'Immich library files: %s\n' "$(find "$immich_lib" -type f 2>/dev/null | wc -l)" || true
  if [[ -d "$media_root" ]]; then
    for subdir in movies tv music books photos; do
      [[ -d "$media_root/$subdir" ]] || continue
      printf '%s files: %s\n' "$subdir" "$(find "$media_root/$subdir" -type f 2>/dev/null | wc -l)"
    done
  fi
}

status_storage() {
  echo "=== storage ==="
  echo "  $DOMUM_DATA_ROOT   = durable / protected disk (snapshotted + backed up)"
  echo "  $DOMUM_MEDIA_ROOT  = disposable media on the OS disk (not backed up by default)"
  printf '%-28s %-8s %-8s %-8s %-6s\n' "PATH" "SIZE" "USED" "AVAIL" "USE%"
  for path in "$DOMUM_DATA_ROOT" "$DOMUM_MEDIA_ROOT" "$DOMUM_SNAPSHOT_ROOT" /; do
    [[ -e "$path" ]] || continue
    df -h --output=target,size,used,avail,pcent "$path" 2>/dev/null | tail -n1
  done | awk '{printf "%-28s %-8s %-8s %-8s %-6s\n",$1,$2,$3,$4,$5}'
}

status() {
  need_root
  load_cfg
  export_env_for_compose
  ensure_networks
  local show_counts=0
  [[ "${1:-}" == "--counts" ]] && show_counts=1

  echo "=== compose ps ==="
  compose_cmd ps || true

  echo
  echo "=== restic last snapshots ==="
  "$DOMUM_DIR/bin/domum-media-backup" --snapshots || true

  echo
  echo "=== btrfs snapshots (${DOMUM_SNAPSHOT_ROOT}) ==="
  snapshot_list

  echo
  status_storage

  if (( show_counts == 1 )); then
    echo
    status_counts
  fi
}

repo_update() {
  need_root
  echo "[domum-media] git fetch + reset --hard origin/main in $DOMUM_DIR..."
  [[ -d "$DOMUM_DIR/.git" ]] || die "$DOMUM_DIR is not a git repo — reinstall via install.sh"
  git -C "$DOMUM_DIR" fetch --all --prune
  git -C "$DOMUM_DIR" reset --hard origin/main
  converge_local_installation
  exec /usr/local/bin/domum-media apply
}

logs_cmd() {
  need_root
  load_cfg
  export_env_for_compose
  local svc="${1:-}"
  [[ -n "$svc" ]] || die "Usage: domum-media logs <service>"
  compose_cmd logs -f --tail=200 "$svc"
}

backup_cmd() {
  need_root
  shift || true
  exec /usr/local/bin/domum-media-backup "$@"
}

snapshot_cmd() {
  need_root
  load_cfg
  local sub="${1:-}"
  case "$sub" in
    create)
      shift
      # Snapshotting a tree a migration is renaming underneath us is exactly the
      # race the lock exists for. Unattended (the weekly timer), so it waits
      # rather than giving up.
      domum_acquire_lock "snapshot create" "${SNAPSHOT_LOCK_WAIT_SECONDS:-900}" \
        || die "Timed out waiting for another domum-media operation: $(domum_lock_holder)"
      # Propagate the real outcome: an operator who asked for a snapshot and got
      # none must not see a success exit status.
      if ! snapshot_create "${1:-manual}"; then
        # Does NOT assert a cause. "Service state paths are not Btrfs subvolumes"
        # was the only possible reason while none of them was, and it is now wrong
        # in the case that matters: with migrated services present, snapshot_create
        # also returns non-zero when a real subvolume's snapshot FAILED. Naming the
        # old cause would hide the new one. The counts it just printed say which.
        die "No snapshot was created. See the counts above for whether paths were skipped or a snapshot failed, and docs/SNAPSHOT-MODEL.md."
      fi
      ;;
    list)   snapshot_list ;;
    prune)
      # `snapshot prune` DELETES snapshots, and its timer is enabled and runs
      # weekly (Sun 04:30 +20m). While no service path was a subvolume the
      # snapshot root stayed empty, so it has never actually deleted anything.
      # The first migration makes it a live deleting job -- which is precisely
      # when it must stop racing migrations and rollbacks: a rollback checks its
      # snapshot exists and then creates from it, and a prune landing between
      # those two steps turns a routine restore into a failure.
      domum_acquire_lock "snapshot prune" "${SNAPSHOT_LOCK_WAIT_SECONDS:-900}" \
        || die "Timed out waiting for another domum-media operation: $(domum_lock_holder)"
      snapshot_prune
      ;;
    *) die "Usage: domum-media snapshot {create [tag]|list|prune}" ;;
  esac
}

rollback_entries() {
  # A missing index directory means NO rollback entries, not an error. `find`
  # exits 1 on it, and under `set -euo pipefail` that propagated through every
  # caller's pipeline: cleanup_image_decisions aborted silently part-way and
  # reported an EMPTY image set -- i.e. "nothing to protect" -- on a host whose
  # index simply had not been created yet.
  local dir
  dir="$(rollback_index_dir)"
  [[ -d "$dir" ]] || return 0
  find "$dir" -type f -name '*.env' 2>/dev/null | sort
}

# The recorded STATUS says what this index believes. The snapshot store is what
# is actually true, and the two drift: `snapshot_prune` runs on Sundays at 04:30
# and deletes snapshots without touching the index, so entries go on advertising
# themselves as "available" while pointing at nothing. The operator then picks
# one and only finds out at restore time.
#
# Resolved against the filesystem at read time rather than by keeping prune in
# sync, because the filesystem is truthful about every cause of disappearance --
# pruning, a manual `btrfs subvolume delete`, a restored-from-backup index.
rollback_entry_effective_status() {
  local recorded="$1" snapshot_name="$2"
  if [[ "$recorded" == "available" ]]; then
    case "$snapshot_name" in
      ""|*/*|.|..) printf 'invalid'; return 0 ;;
    esac
    [[ -d "$DOMUM_SNAPSHOT_ROOT/$snapshot_name" ]] || { printf 'missing'; return 0; }
  fi
  printf '%s' "$recorded"
}

rollback_list_cmd() {
  printf '%-28s %-12s %-18s %-10s %-10s\n' "ID" "SERVICE" "EVENT" "AGE" "STATUS"
  rollback_entries | while IFS= read -r file; do
    unset ID SERVICE EVENT TS STATUS SNAPSHOT SNAPSHOT_NAME
    # shellcheck disable=SC1090
    source "$file"
    local name
    name="${SNAPSHOT_NAME:-$(basename "${SNAPSHOT:-}")}"
    printf '%-28s %-12s %-18s %-10s %-10s\n' \
      "${ID:-unknown}" \
      "${SERVICE:-unknown}" \
      "${EVENT:-unknown}" \
      "$(human_age_from_epoch "${TS:-0}")" \
      "$(rollback_entry_effective_status "${STATUS:-unknown}" "$name")"
  done
}

rollback_show_cmd() {
  local rollback_id="$1"
  local file
  file="$(rollback_index_dir)/${rollback_id}.env"
  [[ -f "$file" ]] || die "Rollback point not found: $rollback_id"
  cat "$file"
}

rollback_apply_entry() {
  local rollback_id="$1"
  local dry_run="${2:-0}"

  # A rollback stops containers and moves live state aside. Doing that while a
  # backup walks the same tree gets both wrong.
  if (( dry_run == 0 )); then
    domum_acquire_lock "rollback apply $rollback_id" 0 \
      || die "Another domum-media operation holds the lock: $(domum_lock_holder)
Refusing to roll back while it runs."
  fi
  local file snapshot_name
  file="$(rollback_index_dir)/${rollback_id}.env"
  [[ -f "$file" ]] || die "Rollback point not found: $rollback_id"

  unset ID SERVICE EVENT SNAPSHOT SNAPSHOT_NAME IMAGE_BEFORE IMAGE_AFTER TS STATUS
  # shellcheck disable=SC1090
  source "$file"
  snapshot_name="${SNAPSHOT_NAME:-$(basename "${SNAPSHOT:-}")}"
  [[ -n "$snapshot_name" ]] || die "Rollback point $rollback_id has no snapshot path."
  # Resolved the same way `rollback list` displays it, so what the operator was
  # shown is what is enforced here.
  local effective
  effective="$(rollback_entry_effective_status "${STATUS:-available}" "$snapshot_name")"
  [[ "$effective" == "available" ]] || die "Rollback point is not available: $effective"

  if (( dry_run == 1 )); then
    echo "[domum-media] Would restore ${SERVICE:-unknown} from ${snapshot_name}"
    return 0
  fi

  restore_snapshot_for_service "${SERVICE:-unknown}" "$snapshot_name"
  update_rollback_entry_status "$file" "consumed"
  # An operator-initiated rollback restores DATA. When the entry records a
  # different image, say so rather than implying both halves went back.
  if [[ -n "${IMAGE_BEFORE:-}" && -n "${IMAGE_AFTER:-}" && "${IMAGE_BEFORE:-}" != "${IMAGE_AFTER:-}" ]]; then
    warn "Data was restored, but the image was NOT rolled back: still ${IMAGE_AFTER}, not ${IMAGE_BEFORE}."
    warn "Re-pin it yourself if that matters; see backlog/task-24-rollback-previous-image.md."
    record_update_history "${SERVICE:-unknown}" "rolled_back_data_only" "${IMAGE_AFTER:-}" "${IMAGE_BEFORE:-}" "$snapshot_name" "partial" "manual rollback apply ${rollback_id}; data only, image still ${IMAGE_AFTER}"
  else
    record_update_history "${SERVICE:-unknown}" "rolled_back" "${IMAGE_AFTER:-}" "${IMAGE_BEFORE:-}" "$snapshot_name" "success" "manual rollback apply ${rollback_id}"
  fi
}

rollback_cmd() {
  need_root
  load_cfg
  export_env_for_compose
  ensure_state_dirs

  local sub="${1:-interactive}"
  case "$sub" in
    list) rollback_list_cmd ;;
    show) shift; [[ -n "${1:-}" ]] || die "Usage: domum-media rollback show <id>"; rollback_show_cmd "$1" ;;
    apply)
      shift
      [[ -n "${1:-}" ]] || die "Usage: domum-media rollback apply <id> [--dry-run]"
      local rollback_id="$1"
      local dry_run=0
      shift || true
      [[ "${1:-}" == "--dry-run" ]] && dry_run=1
      rollback_apply_entry "$rollback_id" "$dry_run"
      ;;
    interactive)
      local snapshots=()
      local idx=1
      while IFS= read -r file; do
        [[ -n "$file" ]] || continue
        unset ID SERVICE EVENT STATUS
        # shellcheck disable=SC1090
        source "$file"
        # Effective, not recorded: prune deletes snapshots without touching the
        # index, so a recorded "available" can point at nothing. Offering such an
        # entry in a menu invites the operator to pick one that cannot be applied.
        [[ "$(rollback_entry_effective_status "${STATUS:-available}" \
              "${SNAPSHOT_NAME:-$(basename "${SNAPSHOT:-}")}")" == "available" ]] || continue
        snapshots+=("${ID}")
        printf '%d) %s | %s | %s\n' "$idx" "${ID}" "${SERVICE:-unknown}" "${EVENT:-unknown}"
        idx=$(( idx + 1 ))
      done < <(rollback_entries)
      (( ${#snapshots[@]} > 0 )) || die "No rollback points available."
      local choice selected
      read -r -p "Select rollback number to restore: " choice
      [[ "$choice" =~ ^[0-9]+$ ]] || die "Invalid selection."
      selected="${snapshots[$((choice - 1))]:-}"
      [[ -n "$selected" ]] || die "Selection out of range."
      rollback_apply_entry "$selected" 0
      ;;
    *) die "Usage: domum-media rollback {list|show <id>|apply <id> [--dry-run]}" ;;
  esac
}

image_ids_used_by_any_container() {
  docker ps -aq 2>/dev/null | while IFS= read -r cid; do
    [[ -n "$cid" ]] || continue
    docker inspect --format '{{.Image}}' "$cid" 2>/dev/null || true
  done | sort -u
}

# Canonicalise an image reference to its full sha256 id, through docker, so no
# comparison can be defeated by format.
#
# THIS IS WHY. `docker images -q` yields SHORT ids (`58f13a1df833`) while
# `{{.Image}}` yields `sha256:<64 hex>`, and the in-use exclusion below compared
# the two with `grep -Fxq` -- which can never match. Measured on this host: FOUR
# images belonging to RUNNING containers were offered as deletion candidates
# (plex 58f13a1df833, calibre-web 6cf7dab48a4a, traefik 9c3b91d5fb77,
# uptime-kuma a8610b3b4c38) because each is dangling: a newer `:latest` moved the
# tag off it. Docker would refuse to remove an image a container uses, but the
# whole batch goes to one `docker image rm`, and the moment such a service is
# upgraded its old image stops being in use and the deletion succeeds.
domum_image_id_full() {  # $1 = any image reference
  docker image inspect -f '{{.Id}}' "$1" 2>/dev/null
}

# Image ids a recovery point's evidence names.
#
# Deleting one of these destroys the APPLICATION half of a recovery point: the
# snapshot still restores the data, but the application that wrote it can no
# longer be obtained, and restoring that data under a different build is exactly
# the pairing failure the evidence exists to prevent. Plex's is `identity,local`
# -- RepoTags and RepoDigests both empty -- so the local object is the ONLY copy.
#
# The selector consulted no recovery metadata at all before this.
recovery_point_image_ids() {
  recovery_point_image_pairs | awk '{print $1}' | sort -u
}

# "<image-id> <recovery-point>" for every image any recovery point names, so the
# report can say WHICH point depends on an image rather than only how many.
recovery_point_image_pairs() {
  local dir f point id
  dir="$(snapshot_metadata_dir 2>/dev/null)" || return 0
  [[ -n "$dir" && -d "$dir" ]] || return 0
  for f in "$dir"/*.recovery; do
    [[ -e "$f" ]] || continue
    point="$(basename "$f" .recovery)"
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      printf '%s %s\n' "$id" "$point"
    done < <(sed -nE "s/^CONTAINER_[0-9]+_IMAGE_ID='(.*)'\$/\1/p" "$f")
  done | sort -u
}

# Prints "<full-id> <reason>" for every image that must NOT be deleted.
cleanup_protected_image_ids() {
  local id full
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    full="$(domum_image_id_full "$id")"
    [[ -n "$full" ]] && printf '%s in-use\n' "$full"
  done < <(image_ids_used_by_any_container)
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    full="$(domum_image_id_full "$id")"
    [[ -n "$full" ]] && printf '%s recovery-point\n' "$full"
  done < <(recovery_point_image_ids)
}

# The ONE decision function for image cleanup.
#
# The human report, the structured output and the candidate list all derive from
# this, so they cannot disagree. The previous shape computed candidacy inline
# inside the human report, which is how the unfalsifiable "0 named by a recovery
# point" line survived for so long: there was no separate representation of the
# decision to check the prose against.
#
# One record per RELEVANT image, space-delimited -- image ids, reason words,
# recovery-point names and image tags all contain no spaces:
#
#   <full-id> <candidate 0|1> <reasons|-> <local 0|1> <points|-> <tags|->
#
# The universe is deliberately WIDER than the candidate set. An image a recovery
# point names is relevant even when nothing would ever have proposed deleting it,
# because "is this image still protected?" is the question automation actually
# asks -- and answering it from the candidate list alone cannot distinguish
# "protected" from "never considered".
cleanup_image_decisions() {
  local protected pairs prunable universe resolved
  protected="$(mktemp)" || return 1
  pairs="$(mktemp)" || { rm -f "$protected"; return 1; }
  prunable="$(mktemp)" || { rm -f "$protected" "$pairs"; return 1; }
  universe="$(mktemp)" || { rm -f "$protected" "$pairs" "$prunable"; return 1; }
  resolved="$(mktemp)" || { rm -f "$protected" "$pairs" "$prunable" "$universe"; return 1; }

  cleanup_protected_image_ids > "$protected"
  recovery_point_image_pairs > "$pairs"

  # Prunable: what docker or a rollback record would ever propose removing.
  {
    docker images --filter dangling=true -q 2>/dev/null || true
    rollback_entries | while IFS= read -r file; do
      unset IMAGE_BEFORE IMAGE_AFTER
      # shellcheck disable=SC1090
      source "$file"
      [[ -n "${IMAGE_BEFORE:-}" ]] && printf '%s\n' "$IMAGE_BEFORE"
      [[ -n "${IMAGE_AFTER:-}" ]] && printf '%s\n' "$IMAGE_AFTER"
    done
  } | sort -u > "$prunable" || true

  # Relevant: prunable, plus every image a container uses or a recovery point
  # names, so the record set can answer the protection question directly.
  {
    cat "$prunable"
    image_ids_used_by_any_container
    awk '{print $1}' "$pairs"
  } | sort -u > "$universe" || true

  # Canonicalise every reference to a full id ONCE. A reference docker can no
  # longer resolve is recorded as absent rather than dropped: a recovery point
  # naming an image that is gone is the most important case to be able to see.
  local ref full
  while IFS= read -r ref; do
    [[ -n "$ref" ]] || continue
    # `|| true` is load-bearing: domum_image_id_full exits non-zero for a
    # reference docker cannot resolve, and under `set -e` the ASSIGNMENT aborts
    # the whole function before the absent-image branch below can run. That
    # turned one unresolvable reference into an EMPTY decision set, i.e. a
    # report that nothing needs protecting.
    full="$(domum_image_id_full "$ref" || true)"
    if [[ -n "$full" ]]; then
      printf '%s %s 1\n' "$ref" "$full"
    elif [[ "$ref" == sha256:* ]]; then
      # A digest docker cannot resolve: a real identity that is no longer here.
      # Kept, because a recovery point naming an image this host has lost is the
      # single most important thing for an operator to be able to see.
      printf '%s %s 0\n' "$ref" "$ref"
    fi
    # Anything else unresolvable is NOT an image identity and is dropped. A
    # rollback record writes IMAGE_BEFORE=unknown when it could not determine
    # one, and that sentinel was being reported as an image whose id is the
    # literal string `unknown`.
  done < "$universe" > "$resolved"

  local prunable_full
  prunable_full="$(mktemp)" || { rm -f "$protected" "$pairs" "$prunable" "$universe" "$resolved"; return 1; }
  while IFS= read -r ref; do
    [[ -n "$ref" ]] || continue
    awk -v r="$ref" '$1 == r { print $2 }' "$resolved"
  done < "$prunable" | sort -u > "$prunable_full"

  local id present reasons points tags candidate
  # The original reference is not needed here, only its canonical id.
  while read -r _ id present; do
    [[ -n "$id" ]] || continue
    # EVERY applicable reason, joined. First-match-wins reported plex's image as
    # `in-use` only, so the recovery rule looked like it had found nothing.
    reasons="$(awk -v id="$id" '$1 == id { printf "%s%s", sep, $2; sep="+" } END { print "" }' "$protected")"
    # A recovery point that names an image docker cannot resolve contributes the
    # recovery reason too -- cleanup_protected_image_ids can only speak about
    # images it could canonicalise.
    if [[ "$reasons" != *recovery-point* ]] \
       && awk -v id="$id" '$1 == id { found = 1 } END { exit !found }' "$pairs"; then
      reasons="${reasons:+$reasons+}recovery-point"
    fi
    points="$(awk -v id="$id" '$1 == id { printf "%s%s", sep, $2; sep="," } END { print "" }' "$pairs")"
    tags="$(docker image inspect "$id" --format '{{range .RepoTags}}{{.}},{{end}}' 2>/dev/null | sed 's/,$//')"
    candidate=0
    if [[ -z "$reasons" ]] && (( present == 1 )) \
       && awk -v id="$id" '$1 == id { found = 1 } END { exit !found }' "$prunable_full"; then
      candidate=1
    fi
    printf '%s %s %s %s %s %s\n' \
      "$id" "$candidate" "${reasons:--}" "$present" "${points:--}" "${tags:--}"
  done < "$resolved" | sort -u

  rm -f "$protected" "$pairs" "$prunable" "$universe" "$resolved" "$prunable_full"
}

# Structured form of exactly the records above. Operator scripts must not parse
# the human report: a wrapper grepping `cleanup images` output for an image id
# was one of the fragile-prose dependencies this replaces.
cleanup_images_json() {
  local first=1 id candidate reasons present points tags
  printf '{\n  "images": [\n'
  while read -r id candidate reasons present points tags; do
    [[ -n "$id" ]] || continue
    (( first == 1 )) || printf ',\n'
    first=0
    printf '    {"id": "%s", "candidate": %s, "in_use": %s, "recovery_referenced": %s, "local": %s, "recovery_points": [%s], "tags": [%s]}' \
      "$id" \
      "$( (( candidate == 1 )) && echo true || echo false )" \
      "$( [[ "$reasons" == *in-use* ]] && echo true || echo false )" \
      "$( [[ "$reasons" == *recovery-point* ]] && echo true || echo false )" \
      "$( (( present == 1 )) && echo true || echo false )" \
      "$( [[ "$points" == "-" ]] || printf '%s' "$points" | awk -v RS=, 'NF{printf "%s\"%s\"", sep, $0; sep=", "}' )" \
      "$( [[ "$tags" == "-" ]] || printf '%s' "$tags" | awk -v RS=, 'NF{printf "%s\"%s\"", sep, $0; sep=", "}' )"
  done < <(cleanup_image_decisions)
  printf '\n  ]\n}\n'
}

collect_cleanup_image_ids() {
  # A filter over cleanup_image_decisions, NOT a second implementation. Keeping
  # the SKIP lines on stderr and the candidates on stdout preserves the existing
  # contract for cleanup_images_execute.
  local id candidate reasons
  while read -r id candidate reasons _ _ _; do
    [[ -n "$id" ]] || continue
    if (( candidate == 1 )); then
      printf '%s\n' "$id"
    elif [[ "$reasons" != "-" ]]; then
      printf 'SKIP %s %s\n' "$id" "$reasons" >&2
    fi
  done < <(cleanup_image_decisions)
}

cleanup_images_execute() {
  local dry_run="${1:-1}"
  local confirm="${2:-0}"
  local -a ids=()
  local total_size=0
  local size

  local skips
  skips="$(mktemp)" || return 1
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    ids+=("$id")
  done < <(collect_cleanup_image_ids 2>"$skips")

  # Report the recovery-image SET FIRST, and independently of what it blocked.
  #
  # The previous version printed only "N named by a recovery point", counting
  # candidates BLOCKED by that reason. In production that was 0 -- correctly, and
  # uninformatively: the only recovery-named image that is also a cleanup
  # candidate is plex's, and it was attributed to `in-use` because that reason was
  # checked first. So the line could not distinguish "no recovery metadata exists"
  # from "the rule found nothing to block", and the operator had no way to tell
  # whether the protection worked at all. A safety report that cannot be falsified
  # is not a safety report.
  local n_named=0 n_present=0 id point
  while read -r id point; do
    [[ -n "$id" ]] || continue
    n_named=$(( n_named + 1 ))
    if docker image inspect "$id" >/dev/null 2>&1; then
      n_present=$(( n_present + 1 ))
      printf '  names %s  %s\n' "${id:0:19}" "$point"
    else
      printf '  names %s  %s  (NOT present locally)\n' "${id:0:19}" "$point"
    fi
  done < <(recovery_point_image_pairs) > "$skips.named"
  if (( n_named > 0 )); then
    echo "[domum-media] Recovery points name $n_named image(s); $n_present present on this host:"
    cat "$skips.named"
    echo "  Deleting one of those leaves the snapshot restorable and the application"
    echo "  that wrote it unobtainable."
  else
    echo "[domum-media] No recovery point names any image -- nothing to protect on that basis."
  fi
  rm -f "$skips.named"

  # Then what was actually withheld, by every applicable reason.
  local n_inuse n_recovery n_both
  n_inuse="$(grep -c ' in-use' "$skips" || true)"
  n_recovery="$(grep -c 'recovery-point' "$skips" || true)"
  n_both="$(grep -c ' in-use+recovery-point$\| recovery-point+in-use$' "$skips" || true)"
  echo "[domum-media] Withheld from cleanup: $(grep -c '^SKIP ' "$skips" || true) image(s) -- ${n_inuse:-0} in use by a container, ${n_recovery:-0} named by a recovery point (${n_both:-0} by both)."
  rm -f "$skips"

  if (( ${#ids[@]} == 0 )); then
    echo "[domum-media] No pruneable images found."
    return 0
  fi

  for id in "${ids[@]}"; do
    size="$(docker image inspect "$id" --format '{{.Size}}' 2>/dev/null || echo 0)"
    total_size=$(( total_size + size ))
    printf '%s %s\n' "$id" "$(docker image inspect "$id" --format '{{.RepoTags}}' 2>/dev/null || echo '[]')"
  done
  echo "[domum-media] Candidate image count: ${#ids[@]} (approx $(( total_size / 1024 / 1024 )) MiB)"

  if (( dry_run == 1 )); then
    return 0
  fi

  if (( confirm == 0 )); then
    die "Refusing destructive cleanup without --confirm"
  fi

  docker image rm "${ids[@]}"
}

cleanup_snapshot_candidates() {
  # One retention policy, not two. This used to default to
  # CLEANUP_OLD_SNAPSHOTS_KEEP, which the shipped example config sets to 7 while
  # SNAPSHOT_KEEP_PER_SUBVOL is 14 -- so `cleanup snapshots --confirm` deleted
  # seven more snapshots per service than the retention policy, including ones the
  # weekly prune had deliberately kept. Two knobs for one policy is a policy
  # nobody can state.
  #
  # CLEANUP_OLD_SNAPSHOTS_KEEP is still honoured, but only upwards: the effective
  # value is the LARGER of the two, so setting either knob can keep more snapshots
  # and never fewer. A cleanup command that quietly deletes past the retention
  # policy is not a cleanup.
  local keep_policy keep_cleanup keep
  keep_policy="$(snapshot_retention_keep "${SNAPSHOT_KEEP_PER_SUBVOL:-}")"
  keep_cleanup="$(snapshot_retention_keep "${CLEANUP_OLD_SNAPSHOTS_KEEP:-$keep_policy}")"
  keep="$keep_policy"
  (( keep_cleanup > keep )) && keep="$keep_cleanup"
  local names base total drop i
  [[ -d "$DOMUM_SNAPSHOT_ROOT" ]] || return 0
  names="$(find "$DOMUM_SNAPSHOT_ROOT" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | sed -E 's/-[0-9]{8}-[0-9]{6}-.*$//' | sort -u || true)"
  while IFS= read -r base; do
    [[ -n "$base" ]] || continue
    mapfile -t snaps < <(list_snapshots_for_base "$base")
    total="${#snaps[@]}"
    drop=$(( total - keep ))
    if (( drop > 0 )); then
      for (( i = 0; i < drop; i++ )); do
        printf '%s\n' "${snaps[$i]}"
      done
    fi
  done <<< "$names"
}

cleanup_snapshots_execute() {
  local dry_run="${1:-1}"
  local confirm="${2:-0}"
  local -a victims=()
  while IFS= read -r snap; do
    [[ -n "$snap" ]] || continue
    victims+=("$snap")
  done < <(cleanup_snapshot_candidates)

  if (( ${#victims[@]} == 0 )); then
    echo "[domum-media] No pruneable snapshots found."
    return 0
  fi

  printf '%s\n' "${victims[@]}"
  if (( dry_run == 1 )); then
    return 0
  fi
  if (( confirm == 0 )); then
    die "Refusing destructive cleanup without --confirm"
  fi
  local victim
  for victim in "${victims[@]}"; do
    btrfs subvolume delete "$DOMUM_SNAPSHOT_ROOT/$victim"
  done
}

cleanup_summary() {
  local dangling exited old_snaps
  dangling="$(docker images --filter dangling=true -q 2>/dev/null | wc -l | tr -d ' ')"
  exited="$(docker ps -a --filter status=exited -q 2>/dev/null | wc -l | tr -d ' ')"
  old_snaps="$(cleanup_snapshot_candidates | wc -l | tr -d ' ')"
  echo "Cleanup summary:"
  echo "  Dangling images: $dangling"
  echo "  Exited containers: $exited"
  echo "  Snapshots beyond retention: $old_snaps"
}

cleanup_cmd() {
  need_root
  load_cfg
  export_env_for_compose
  ensure_state_dirs

  local sub="${1:-summary}"
  local dry_run=1
  local confirm=0
  local as_json=0
  shift || true
  while (( $# )); do
    case "$1" in
      --dry-run) dry_run=1 ;;
      --confirm) dry_run=0; confirm=1 ;;
      --json) as_json=1 ;;
      *) die "Unknown cleanup arg: $1" ;;
    esac
    shift
  done
  # Structured output is read-only by construction: there is no path from --json
  # to a delete, so automation can ask what cleanup thinks without any risk of
  # performing it.
  (( as_json == 1 && confirm == 1 )) \
    && die "Refusing: --json is a read-only query and cannot be combined with --confirm"

  case "$sub" in
    summary) cleanup_summary ;;
    images)
      if (( as_json == 1 )); then
        cleanup_images_json
      else
        cleanup_images_execute "$dry_run" "$confirm"
      fi ;;
    snapshots)
      # A second snapshot DELETER, and until now the only one without the lock.
      # A rollback checks its snapshot exists and then creates from it; a
      # `cleanup snapshots --confirm` landing between those two steps turns a
      # routine restore into a failure. Attended, so it refuses rather than waits.
      if (( confirm == 1 )); then
        domum_acquire_lock "cleanup snapshots" 0 \
          || die "Another domum-media operation holds the lock: $(domum_lock_holder)
Refusing to delete snapshots while it runs."
      fi
      cleanup_snapshots_execute "$dry_run" "$confirm" ;;
    *) die "Usage: domum-media cleanup {summary|images [--json]|snapshots} [--dry-run|--confirm]" ;;
  esac
}

# Traefik's ACME store holds the Let's Encrypt account key and every issued
# certificate. It lives in a Docker volume, so it is neither on the Btrfs data
# root (no snapshots) nor inside any backup include path (no restic). It is
# ~100KB of essentially secret material, which is exactly what the recovery
# pack is for: small, critical, encrypted, and already swept into the cloud
# target via RECOVERY_PACK_DEST.
#
# Resolved by volume name rather than by inspecting the container, so it still
# works when Traefik is stopped.
traefik_acme_source() {
  local vol="${TRAEFIK_ACME_VOLUME:-domum-media_traefik-letsencrypt}" mp
  [[ -n "$vol" ]] || return 1
  cmd_exists docker || return 1
  mp="$(docker volume inspect "$vol" --format '{{.Mountpoint}}' 2>/dev/null || true)"
  [[ -n "$mp" && -f "$mp/acme.json" ]] || return 1
  printf '%s' "$mp/acme.json"
}

recovery_pack_manifest() {
  local stage_dir="$1"
  local manifest="$stage_dir/MANIFEST.txt"
  : > "$manifest"
  find "$stage_dir" -type f ! -name MANIFEST.txt | sort | while IFS= read -r path; do
    printf '%s  %s\n' "$(sha256_of_file "$path")" "${path#"$stage_dir"/}" >> "$manifest"
  done
}

# Uptime Kuma keeps its entire configuration -- monitors, notification targets,
# status pages, the admin account -- in one SQLite database inside a Docker
# volume. Nothing snapshots it, no backup target includes it, and it is the last
# durable state on this host covered by nothing.
#
# It is NOT captured by copying the files. kuma.db runs in WAL mode with an
# uncheckpointed -wal alongside it (8 KB live, right now), so a file copy is a
# torn database -- exactly the reason the Immich artefact is a validated dump
# rather than raw PostgreSQL storage (CLAUDE.md section 7).
#
# `sqlite3 .backup` uses the SQLite backup API: it takes a read lock, walks the
# committed state including the WAL, and produces a consistent copy WITHOUT
# stopping the service. Verified against the live database on this host:
# integrity_check returned ok.
#
# The dump is written inside the container (its own filesystem), read back with
# `docker cp`, and validated before it is accepted. An unvalidated dump is not
# evidence, and a recovery pack that contains a corrupt database is worse than
# one that admits it has none.
uptime_kuma_dump() {
  local dest="$1"
  local container="${UPTIME_KUMA_CONTAINER:-uptime-kuma}"
  local db="${UPTIME_KUMA_DB:-/app/data/kuma.db}"
  local in_container="/tmp/kuma-recovery-$$.db"

  cmd_exists docker || return 1
  docker ps --format '{{.Names}}' 2>/dev/null | grep -qFx -- "$container" || return 1

  docker exec "$container" sh -c \
    "rm -f '$in_container' && sqlite3 '$db' \".backup '$in_container'\"" >/dev/null 2>&1 || {
      docker exec "$container" rm -f "$in_container" >/dev/null 2>&1
      return 1
    }

  # Validate INSIDE the container, before trusting it enough to copy out.
  local check
  check="$(docker exec "$container" sqlite3 "$in_container" 'PRAGMA integrity_check;' 2>/dev/null || true)"
  if [[ "$check" != "ok" ]]; then
    warn "Uptime Kuma dump failed its integrity check: ${check:-no result}"
    docker exec "$container" rm -f "$in_container" >/dev/null 2>&1
    return 1
  fi

  docker cp "$container:$in_container" "$dest" >/dev/null 2>&1 || {
    docker exec "$container" rm -f "$in_container" >/dev/null 2>&1
    return 1
  }
  docker exec "$container" rm -f "$in_container" >/dev/null 2>&1
  [[ -s "$dest" ]] || return 1
  chmod 0600 "$dest"
  return 0
}

recovery_pack_restore_instructions() {
  local stage_dir="$1"
  cat > "$stage_dir/RESTORE.txt" <<EOF
Recovery pack restore notes

1. Decrypt the archive with your age private key.
2. Restore config/domum-media.conf to $CFG_FILE
3. Restore secrets/* to $SECRETS_DIR with mode 0600 and owner root:root
4. Restore state/backups/*-repo.env to $DOMUM_STATE_ROOT/backups with owner root:root.
5. Restore state/immich/db_password.sha256 to
   $DOMUM_STATE_ROOT/immich/db_password.sha256 before restoring Immich data.
6. If state/uptime-kuma/kuma.db is present, restore it into the Uptime Kuma
   data volume with the service STOPPED, then start it:

     docker compose stop uptime-kuma
     install -m 0644 state/uptime-kuma/kuma.db \\
       "\$(docker volume inspect ${UPTIME_KUMA_DATA_VOLUME:-domum-media_uptime-kuma-data} --format '{{.Mountpoint}}')/kuma.db"
     rm -f "\$(docker volume inspect ${UPTIME_KUMA_DATA_VOLUME:-domum-media_uptime-kuma-data} --format '{{.Mountpoint}}')/kuma.db-wal" \\
           "\$(docker volume inspect ${UPTIME_KUMA_DATA_VOLUME:-domum-media_uptime-kuma-data} --format '{{.Mountpoint}}')/kuma.db-shm"
     docker compose up -d uptime-kuma

   The -wal and -shm files MUST be removed: they belong to the database being
   replaced, and leaving them beside a different kuma.db corrupts it.

7. If state/traefik/acme.json is present, restore it into the Traefik ACME
   volume before starting Traefik, as mode 0600 owned by root:root:
     docker volume create ${TRAEFIK_ACME_VOLUME:-domum-media_traefik-letsencrypt}
     install -m 0600 state/traefik/acme.json \
       "\$(docker volume inspect ${TRAEFIK_ACME_VOLUME:-domum-media_traefik-letsencrypt} --format '{{.Mountpoint}}')/acme.json"
   This preserves the ACME account key. Without it Traefik registers a new
   account and re-issues every certificate, which Let's Encrypt rate-limits.
6. Restore /srv/data from restic using domum-media-backup --restore.
   Do not start Immich or restore live PostgreSQL files as a substitute for pg_dump.
7. After persistent state and the fingerprint are restored, run:
   sudo domum-media configure --non-interactive
   sudo domum-media init
   sudo domum-media apply
EOF
}

recovery_pack_repo_metadata_is_safe() {
  local file="$1"
  local target="$2"
  local line target_seen=0 id_seen=0 init_seen=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      "TARGET=\"$target\"")
        (( target_seen == 0 )) || return 1
        target_seen=1
        ;;
      REPOSITORY_ID=\"[0-9a-f]*\")
        (( id_seen == 0 )) || return 1
        [[ "$line" =~ ^REPOSITORY_ID=\"[0-9a-f]{64}\"$ ]] || return 1
        id_seen=1
        ;;
      INIT_TS=\"[0-9]*\")
        (( init_seen == 0 )) || return 1
        [[ "$line" =~ ^INIT_TS=\"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)\"$ ]] \
          || return 1
        init_seen=1
        ;;
      ADOPTED=1) ;;
      *) return 1 ;;
    esac
  done < "$file"

  (( target_seen == 1 && id_seen == 1 && init_seen == 1 ))
}

recovery_pack_secret_files() {
  printf '%s\n' "$RECOVERY_PACK_AGE_PUBKEY_FILE"

  if [[ "${ENABLE_IMMICH:-0}" == "1" ]]; then
    printf '%s\n' "$(immich_db_password_file)" "$(immich_jwt_secret_file)"
  fi
  if [[ "${ENABLE_TRAEFIK:-0}" == "1" ]]; then
    printf '%s\n' "$SECRETS_DIR/cloudflare_api_token" \
      "${TRAEFIK_DASHBOARD_USERS_FILE:-$SECRETS_DIR/traefik_dashboard_users}"
  fi

  local target target_type
  while IFS= read -r target; do
    backup_target_enabled "$target" || continue
    target_type="$(backup_target_value "$target" TYPE repository)"
    printf '%s\n' "$(backup_target_password_file "$target")"
    printf '%s\n' "$(backup_target_value "$target" ENV_FILE)"
    printf '%s\n' "$(backup_target_legacy_env_file "$target")"
    case "$target_type" in
      repository)
        if [[ "$(backup_target_value "$target" REPOSITORY)" == sftp:* ]]; then
          printf '%s\n' \
            "$(backup_target_value "$target" SFTP_KEY_FILE)" \
            "$(backup_target_value "$target" SFTP_KNOWN_HOSTS_FILE)"
        fi
        ;;
      ftp)
        printf '%s\n' \
          "$(backup_target_value "$target" FTP_USERNAME_FILE)" \
          "$(backup_target_value "$target" FTP_PASSWORD_FILE)"
        ;;
    esac
  done < <(backup_target_names)

  if [[ "${RECOVERY_PACK_EMAIL_ENABLED:-0}" == "1" ]]; then
    printf '%s\n' "$RECOVERY_PACK_SMTP_USERNAME_FILE" "$RECOVERY_PACK_SMTP_PASSWORD_FILE"
  fi
}

send_recovery_pack_email() {
  local archive="$1"
  local smtp_user smtp_pass message
  [[ "${RECOVERY_PACK_EMAIL_ENABLED:-0}" == "1" ]] || return 0
  [[ -n "${RECOVERY_PACK_SMTP_HOST:-}" ]] || die "RECOVERY_PACK_SMTP_HOST is required when email delivery is enabled."
  [[ -f "$RECOVERY_PACK_SMTP_USERNAME_FILE" && -f "$RECOVERY_PACK_SMTP_PASSWORD_FILE" ]] || die "SMTP credential files are missing."
  smtp_user="$(read_secret_file_value "$RECOVERY_PACK_SMTP_USERNAME_FILE")"
  smtp_pass="$(read_secret_file_value "$RECOVERY_PACK_SMTP_PASSWORD_FILE")"
  message="$(mktemp)"
  {
    printf 'From: %s\n' "${RECOVERY_PACK_EMAIL_FROM:-$DOMUM_EMAIL}"
    printf 'To: %s\n' "${RECOVERY_PACK_EMAIL_TO:-$DOMUM_EMAIL}"
    printf 'Subject: domum-media recovery pack %s\n' "$(basename "$archive")"
    printf 'MIME-Version: 1.0\n'
    printf 'Content-Type: multipart/mixed; boundary="domum-boundary"\n\n'
    printf -- '--domum-boundary\n'
    printf 'Content-Type: text/plain; charset="utf-8"\n\n'
    printf 'Attached: %s\n\n' "$(basename "$archive")"
    printf -- '--domum-boundary\n'
    printf 'Content-Type: application/octet-stream; name="%s"\n' "$(basename "$archive")"
    printf 'Content-Transfer-Encoding: base64\n'
    printf 'Content-Disposition: attachment; filename="%s"\n\n' "$(basename "$archive")"
    base64 < "$archive"
    printf '\n--domum-boundary--\n'
  } > "$message"
  curl --silent --show-error --ssl-reqd \
    --url "smtps://${RECOVERY_PACK_SMTP_HOST}:${RECOVERY_PACK_SMTP_PORT}" \
    --user "${smtp_user}:${smtp_pass}" \
    --mail-from "${RECOVERY_PACK_EMAIL_FROM:-$DOMUM_EMAIL}" \
    --mail-rcpt "${RECOVERY_PACK_EMAIL_TO:-$DOMUM_EMAIL}" \
    --upload-file "$message"
  rm -f "$message"
}

recovery_pack_create() {
  [[ "${RECOVERY_PACK_ENABLED:-1}" == "1" ]] || die "Recovery pack generation is disabled (RECOVERY_PACK_ENABLED=0)."
  [[ "${RECOVERY_PACK_ENCRYPTION:-age}" == "age" ]] || die "Only age encryption is supported."
  if ! cmd_exists age; then
    echo "[domum-media] age not found — installing via apt..."
    apt-get install -y --no-install-recommends age \
      || die "age is not installed and apt-get install age failed. Install manually: apt-get install -y age"
  fi
  [[ -f "$RECOVERY_PACK_AGE_PUBKEY_FILE" ]] || die "Missing recovery pack age public key: $RECOVERY_PACK_AGE_PUBKEY_FILE"

  local no_email="${1:-0}"
  local stage_dir archive_plain archive_enc archive_tmp pubkey recipient ts sha size cleanup_cmd
  local fingerprint_file repo_meta_file secret_file target
  mkdir -p "$RECOVERY_PACK_DEST"
  stage_dir="$(mktemp -d)"
  ts="$(date +%Y%m%d-%H%M%S)"
  archive_plain="$(mktemp "/tmp/recovery-pack-${ts}.XXXXXX")"
  archive_enc="$RECOVERY_PACK_DEST/recovery-pack-${ts}.tar.age"
  archive_tmp="$(mktemp "$RECOVERY_PACK_DEST/.recovery-pack-${ts}.XXXXXX.tmp")"
  printf -v cleanup_cmd 'rm -rf -- %q; rm -f -- %q %q' \
    "$stage_dir" "$archive_plain" "$archive_tmp"
  # Expand the generated, shell-quoted paths now so EXIT cleanup does not rely
  # on function-local variables remaining in scope.
  # shellcheck disable=SC2064
  trap "$cleanup_cmd" EXIT
  # shellcheck disable=SC2064
  trap "$cleanup_cmd; exit 1" HUP INT TERM
  pubkey="$(read_secret_file_value "$RECOVERY_PACK_AGE_PUBKEY_FILE")"
  recipient="$(printf '%s' "$pubkey" | awk '/^age1/ {print; exit}')"
  [[ -n "$recipient" ]] || die "Could not parse age recipient from $RECOVERY_PACK_AGE_PUBKEY_FILE"

  mkdir -p \
    "$stage_dir/config" \
    "$stage_dir/secrets" \
    "$stage_dir/state/backups" \
    "$stage_dir/state/immich" \
    "$stage_dir/state/traefik" \
    "$stage_dir/meta"
  [[ -f "$CFG_FILE" ]] && install -m 0600 "$CFG_FILE" "$stage_dir/config/domum-media.conf"
  while IFS= read -r secret_file; do
    [[ -n "$secret_file" && -f "$secret_file" ]] || continue
    install -m 0600 "$secret_file" "$stage_dir/secrets/$(basename "$secret_file")"
  done < <(recovery_pack_secret_files | sort -u)

  while IFS= read -r target; do
    backup_target_enabled "$target" || continue
    repo_meta_file="$DOMUM_STATE_ROOT/backups/${target}-repo.env"
    [[ -f "$repo_meta_file" ]] || continue
    recovery_pack_repo_metadata_is_safe "$repo_meta_file" "$target" \
      || die "Unexpected content in repository metadata: $repo_meta_file"
    install -m 0600 "$repo_meta_file" "$stage_dir/state/backups/${target}-repo.env"
  done < <(backup_target_names)

  fingerprint_file="$(immich_db_password_fingerprint_file)"
  if [[ "${ENABLE_IMMICH:-0}" == "1" ]]; then
    [[ -f "$fingerprint_file" ]] \
      || die "Immich password fingerprint is missing: $fingerprint_file"
    install -m 0600 "$fingerprint_file" "$stage_dir/state/immich/db_password.sha256"
  fi
  # Traefik ACME store, when present. Absence is not fatal: Traefik may be
  # disabled, or the volume may not exist yet on a fresh host.
  if [[ "${ENABLE_TRAEFIK:-0}" == "1" ]]; then
    local acme_src
    if acme_src="$(traefik_acme_source)"; then
      install -m 0600 "$acme_src" "$stage_dir/state/traefik/acme.json"
      echo "[domum-media] recovery-pack: included Traefik ACME store"
    else
      warn "Traefik is enabled but its ACME store could not be located; the recovery pack will NOT contain it."
    fi
  fi
  # Uptime Kuma, when it is running. Absence is not fatal -- it may be disabled
  # or not yet started -- but a failure to capture a RUNNING one is reported,
  # because silently shipping a recovery pack without it is how the gap the pack
  # exists to close stays open.
  if [[ "${ENABLE_UPTIME_KUMA:-0}" == "1" ]]; then
    mkdir -p "$stage_dir/state/uptime-kuma"
    if uptime_kuma_dump "$stage_dir/state/uptime-kuma/kuma.db"; then
      echo "[domum-media] recovery-pack: included Uptime Kuma database (validated)"
    else
      rmdir "$stage_dir/state/uptime-kuma" 2>/dev/null || true
      warn "Uptime Kuma is enabled but its database could not be captured; the recovery pack will NOT contain it."
    fi
  fi
  git -C "$DOMUM_DIR" rev-parse HEAD > "$stage_dir/meta/git-revision.txt" 2>/dev/null || true
  compose_cmd config > "$stage_dir/meta/rendered-compose.yml" 2>/dev/null || true
  recovery_pack_restore_instructions "$stage_dir"
  recovery_pack_manifest "$stage_dir"

  tar -C "$stage_dir" -czf "$archive_plain" .
  age -r "$recipient" -o "$archive_tmp" "$archive_plain"
  chmod 0600 "$archive_tmp"
  sync -f "$archive_tmp"
  mv -fT "$archive_tmp" "$archive_enc"
  sync -f "$archive_enc"
  sha="$(sha256_of_file "$archive_enc")"
  size="$(stat -c %s "$archive_enc" 2>/dev/null || stat -f %z "$archive_enc")"
  write_env_kv "$(recovery_pack_state_file)" \
    ARCHIVE_PATH "$archive_enc" \
    SHA256 "$sha" \
    SIZE "$size" \
    TS "$(date +%s)" \
    VERIFIED_TS "$(date +%s)"
  rm -rf "$stage_dir"
  rm -f "$archive_plain"
  trap - EXIT HUP INT TERM

  if (( no_email == 0 )); then
    send_recovery_pack_email "$archive_enc"
  fi

  echo "[domum-media] Recovery pack written to $archive_enc"
}

recovery_pack_status() {
  local state_file archive_path ts size sha
  state_file="$(recovery_pack_state_file)"
  if [[ ! -f "$state_file" ]]; then
    echo "[domum-media] No recovery pack has been created yet."
    return 1
  fi
  unset ARCHIVE_PATH SHA256 SIZE TS VERIFIED_TS
  # shellcheck disable=SC1090
  source "$state_file"
  archive_path="${ARCHIVE_PATH:-}"
  ts="${TS:-0}"
  size="${SIZE:-0}"
  sha="${SHA256:-}"
  echo "Recovery pack:"
  echo "  path: ${archive_path:-missing}"
  echo "  age: $(human_age_from_epoch "$ts")"
  echo "  size: ${size} bytes"
  echo "  sha256: ${sha:-unknown}"
  echo "  verified age: $(human_age_from_epoch "${VERIFIED_TS:-$ts}")"
}

recovery_pack_cmd() {
  need_root
  load_cfg
  export_env_for_compose
  ensure_state_dirs

  local sub="${1:-create}"
  case "$sub" in
    create)
      shift || true
      local no_email=0
      [[ "${1:-}" == "--no-email" ]] && no_email=1
      recovery_pack_create "$no_email"
      ;;
    status) recovery_pack_status ;;
    *) die "Usage: domum-media recovery-pack {create [--no-email]|status}" ;;
  esac
}

json_array_from_items() {
  if (( $# == 0 )); then
    printf '[]'
  else
    printf '%s\n' "$@" | jq -R . | jq -s .
  fi
}

checkup_add() {
  local level="$1"
  shift
  case "$level" in
    critical) CHECKUP_CRITICAL+=("$*") ;;
    warning) CHECKUP_WARNINGS+=("$*") ;;
    healthy) CHECKUP_HEALTHY+=("$*") ;;
    action) CHECKUP_ACTIONS+=("$*") ;;
  esac
}

checkup_cmd() {
  need_root
  load_cfg
  export_env_for_compose
  ensure_state_dirs

  local json=0
  [[ "${1:-}" == "--json" ]] && json=1

  CHECKUP_CRITICAL=()
  CHECKUP_WARNINGS=()
  CHECKUP_HEALTHY=()
  CHECKUP_ACTIONS=()

  [[ -n "${DOMUM_DOMAIN:-}" ]] || checkup_add critical "DOMUM_DOMAIN is empty."
  [[ -n "${BACKUP_POLICY:-}" ]] || checkup_add critical "BACKUP_POLICY is unset."
  case "${BACKUP_POLICY^^}" in
    STRICT|BALANCED|LENIENT) ;;
    *) checkup_add critical "BACKUP_POLICY must be STRICT, BALANCED, or LENIENT." ;;
  esac
  if grep -qE '^(IMMICH_VERSION|JELLYFIN_VERSION|NAVIDROME_VERSION)=' "$CFG_FILE" 2>/dev/null; then
    checkup_add critical "Legacy image pin variables are still present in the config."
  fi
  if ! enabled_backup_targets | grep -q .; then
    checkup_add critical "No backup targets are enabled."
  else
    checkup_add healthy "At least one backup target is enabled."
  fi

  local required_secret
  for required_secret in \
    $([[ "${ENABLE_TRAEFIK:-0}" == "1" ]] && printf '%s ' "$SECRETS_DIR/cloudflare_api_token" "${TRAEFIK_DASHBOARD_USERS_FILE:-$SECRETS_DIR/traefik_dashboard_users}") \
    $([[ "${ENABLE_IMMICH:-0}" == "1" ]] && printf '%s ' "$SECRETS_DIR/immich_db_password" "$SECRETS_DIR/immich_jwt_secret"); do
    if [[ ! -s "$required_secret" ]]; then
      checkup_add critical "Missing or empty secret: $required_secret"
    fi
  done
  while IFS= read -r target; do
    backup_target_enabled "$target" || continue
    local pw_file pw_size
    pw_file="$(backup_target_password_file "$target")"
    if [[ ! -s "$pw_file" ]]; then
      checkup_add critical "Missing backup password file for $target."
    else
      pw_size="$(wc -c < "$pw_file" | tr -d ' ')"
      if [[ "${pw_size:-0}" -lt 12 ]]; then
        checkup_add warning "$target: restic password file looks very short ($pw_size bytes): $pw_file"
      fi
    fi
    local repo
    repo="$(backup_target_value "$target" REPOSITORY)"
    if [[ "$repo" == sftp:* ]]; then
      local sftp_key sftp_opt
      sftp_key="$(backup_target_value "$target" SFTP_KEY_FILE)"
      sftp_opt="$(sftp_command_option_for_target "$target" || true)"
      if [[ -n "$sftp_key" && -f "$sftp_key" ]]; then
        checkup_add healthy "$target: SSH key authentication configured."
        if [[ -n "$sftp_opt" && "$sftp_opt" == *"-i "* ]]; then
          checkup_add healthy "$target: restic SFTP command is configured to use the SSH key."
        else
          checkup_add warning "$target: SFTP key file is configured but restic command does not use it."
        fi
        if ! sftp_key_auth_works "$target"; then
          checkup_add warning "$target: repository still appears to require password auth despite SFTP key config."
          checkup_add action "Test SSH key auth for $target and re-run: sudo domum-media backup init $target"
        fi
      else
        checkup_add warning "$target: SFTP target but SSH key not configured — will prompt for password."
        checkup_add action "Configure BACKUP_TARGET_$(uppercase_token "$target")_SFTP_KEY_FILE and run: sudo domum-media backup init $target"
      fi
    fi
    local meta_file
    meta_file="/var/lib/domum-media/backups/${target}-repo.env"
    if [[ -f "$meta_file" ]]; then
      unset REPOSITORY_ID REPOSITORY
      # shellcheck disable=SC1090
      source "$meta_file"
      checkup_add healthy "$target: repository initialized (id: ${REPOSITORY_ID:0:12})"
    else
      checkup_add warning "$target: repository not initialized. Run: sudo domum-media backup init $target"
      checkup_add action "sudo domum-media backup init $target"
    fi
    checkup_add healthy "$target: encryption = restic client-side (data encrypted before upload)."
    local include_paths broad_path
    include_paths="$(backup_target_value "$target" INCLUDE_PATHS)"
    for broad_path in "/srv/data" "/srv/media" "/srv/media/books"; do
      if [[ " $include_paths " == *" $broad_path "* ]]; then
        checkup_add warning "$target: include paths contain broad path '$broad_path' — backs up all data under that path. Run configure to switch cloud targets to immich-only."
        checkup_add action "sudo domum-media configure  # switch $target backup to immich-only"
        break
      fi
    done
  done < <(backup_target_names)

  if ! cmd_exists age; then
    checkup_add critical "age binary missing — recovery-pack create will fail. Run: apt-get install -y age"
    checkup_add action "Install age: apt-get install -y age"
  fi

  if [[ "${RECOVERY_PACK_ENABLED:-1}" == "1" ]]; then
    if recovery_pack_status >/dev/null 2>&1; then
      unset ARCHIVE_PATH TS VERIFIED_TS
      # shellcheck disable=SC1090
      source "$(recovery_pack_state_file)"
      if (( $(date +%s) - ${TS:-0} > RECOVERY_PACK_REMINDER_DAYS * 86400 )); then
        checkup_add warning "Recovery pack is older than ${RECOVERY_PACK_REMINDER_DAYS} days."
        checkup_add action "sudo domum-media recovery-pack create"
      else
        checkup_add healthy "Recovery pack age is within policy."
      fi
    else
      checkup_add critical "Recovery pack has never completed."
      checkup_add action "sudo domum-media recovery-pack create"
    fi
  fi

  local service enable_var
  while IFS='|' read -r service enable_var _ _ _ _ _; do
    [[ "${!enable_var:-0}" == "1" ]] || continue
    case "$(service_health_state "$service")" in
      healthy)   checkup_add healthy "${service} healthy." ;;
      # Not a warning. A healthcheck reports `starting` for its whole StartPeriod
      # after any restart, and calling that unhealthy would make the report cry
      # wolf every time a service is restarted.
      starting)  checkup_add healthy "${service} starting (healthcheck has not passed yet)." ;;
      unhealthy) checkup_add warning "${service} is UNHEALTHY." ;;
      stopped)   checkup_add warning "${service} is not running." ;;
      # No healthcheck: running is the whole claim, and saying more than that is
      # the CLAUDE.md section 14 defect -- a report implying health it cannot see.
      *)         checkup_add healthy "${service} running (no healthcheck; application health unverified)." ;;
    esac
  done < <(service_lifecycle_specs)

  local last_success age_hours
  if last_success="$(backup_last_success_epoch)"; then
    age_hours=$(( ($(date +%s) - last_success) / 3600 ))
    if (( age_hours > BACKUP_REQUIRED_MAX_AGE_HOURS )); then
      checkup_add critical "Last successful backup is ${age_hours}h old."
    else
      checkup_add healthy "Last backup completed ${age_hours}h ago."
    fi
  else
    checkup_add critical "No successful backup timestamp found."
  fi

  local path pcent
  for path in "$DOMUM_DATA_ROOT" "$DOMUM_MEDIA_ROOT" "$DOMUM_SNAPSHOT_ROOT" /; do
    [[ -e "$path" ]] || continue
    pcent="$(df -P "$path" | awk 'NR==2 {gsub("%","",$5); print $5}')"
    if (( pcent >= 90 )); then
      checkup_add warning "$path is ${pcent}% full."
    fi
  done

  # Storage layout guardrails: durable (/srv/data) must be a distinct, protected
  # filesystem from disposable media (/srv/media), and Immich must live durable.
  if [[ -d "$DOMUM_DATA_ROOT" && -d "$DOMUM_MEDIA_ROOT" ]]; then
    local data_fsid media_fsid
    data_fsid="$(stat -c %d "$DOMUM_DATA_ROOT" 2>/dev/null || echo d)"
    media_fsid="$(stat -c %d "$DOMUM_MEDIA_ROOT" 2>/dev/null || echo m)"
    if [[ "$data_fsid" == "$media_fsid" ]]; then
      checkup_add warning "$DOMUM_MEDIA_ROOT shares a filesystem with $DOMUM_DATA_ROOT — disposable media can fill the protected disk."
      checkup_add action "Mount $DOMUM_MEDIA_ROOT on its own (OS) disk — see docs/SETUP-N100.md."
    else
      checkup_add healthy "Durable ($DOMUM_DATA_ROOT) and disposable ($DOMUM_MEDIA_ROOT) tiers are separate filesystems."
    fi
  fi
  if [[ "${ENABLE_IMMICH:-0}" == "1" ]]; then
    local immich_lib immich_pg
    immich_lib="${IMMICH_LIBRARY_DIR:-$DOMUM_DATA_ROOT/immich/library}"
    immich_pg="${IMMICH_POSTGRES_DIR:-$DOMUM_DATA_ROOT/immich/postgres}"
    if [[ "$immich_lib" != "$DOMUM_DATA_ROOT/immich/"* || "$immich_pg" != "$DOMUM_DATA_ROOT/immich/"* ]]; then
      checkup_add critical "Immich paths are not under $DOMUM_DATA_ROOT/immich (library=$immich_lib postgres=$immich_pg)."
      checkup_add action "Move Immich library + postgres under $DOMUM_DATA_ROOT/immich (durable disk)."
    else
      checkup_add healthy "Immich library + postgres are under $DOMUM_DATA_ROOT/immich."
    fi
  fi

  local dangling exited waiting_count failed_recent reset_recent
  dangling="$(docker images --filter dangling=true -q 2>/dev/null | wc -l | tr -d ' ')"
  exited="$(docker ps -a --filter status=exited -q 2>/dev/null | wc -l | tr -d ' ')"
  (( dangling > 0 )) && checkup_add warning "${dangling} dangling Docker images can be pruned."
  (( exited > 0 )) && checkup_add warning "${exited} containers are exited."
  (( dangling > 0 )) && checkup_add action "sudo domum-media cleanup images --dry-run"

  waiting_count="$(find "$DOMUM_STATE_ROOT/image-updates" -type f -name '*.env' 2>/dev/null | wc -l | tr -d ' ')"
  (( waiting_count > 0 )) && checkup_add warning "${waiting_count} service update candidates are waiting."
  [[ -f "$DOMUM_STATE_ROOT/immich/bundle-candidate.env" ]] && checkup_add warning "Immich bundle candidate is pending."

  reset_recent="$(find "$(update_history_dir)" -type f -name '*.env' -mtime -7 -print0 2>/dev/null | xargs -0 grep -l \"EVENT='delay_reset'\" 2>/dev/null | wc -l | tr -d ' ')"
  failed_recent="$(find "$(update_history_dir)" -type f -name '*.env' -mtime -30 -print0 2>/dev/null | xargs -0 grep -l \"RESULT='failure'\" 2>/dev/null | wc -l | tr -d ' ')"
  (( reset_recent > 0 )) && checkup_add warning "${reset_recent} delay-reset events in the last 7 days."
  (( failed_recent > 0 )) && checkup_add warning "${failed_recent} failed update events in the last 30 days."

  if [[ -f /var/run/reboot-required ]]; then
    checkup_add warning "Reboot required."
    checkup_add action "sudo domum-media host-upgrade --force"
  else
    checkup_add healthy "No reboot is pending."
  fi

  local sim_updates sim_security sim_general
  sim_updates="$(apt-get -s upgrade 2>/dev/null || true)"
  sim_security="$(printf '%s\n' "$sim_updates" | grep '^Inst ' | grep -ci security || true)"
  sim_general="$(printf '%s\n' "$sim_updates" | grep -c '^Inst ' || true)"
  (( sim_security > 0 )) && checkup_add warning "${sim_security} security updates are available."
  (( sim_general > 0 )) && checkup_add warning "${sim_general} general package updates are available."

  if (( json == 1 )); then
    printf '{\n'
    printf '  "critical": %s,\n' "$(json_array_from_items "${CHECKUP_CRITICAL[@]}")"
    printf '  "warnings": %s,\n' "$(json_array_from_items "${CHECKUP_WARNINGS[@]}")"
    printf '  "healthy": %s,\n' "$(json_array_from_items "${CHECKUP_HEALTHY[@]}")"
    printf '  "suggested_actions": %s\n' "$(json_array_from_items "${CHECKUP_ACTIONS[@]}")"
    printf '}\n'
  else
    echo "domum-media checkup"
    echo
    echo "Critical:"
    if (( ${#CHECKUP_CRITICAL[@]} == 0 )); then
      echo "  [✓] none"
    else
      printf '  [!] %s\n' "${CHECKUP_CRITICAL[@]}"
    fi
    echo
    echo "Warnings:"
    if (( ${#CHECKUP_WARNINGS[@]} == 0 )); then
      echo "  [✓] none"
    else
      printf '  [~] %s\n' "${CHECKUP_WARNINGS[@]}"
    fi
    echo
    echo "Healthy:"
    if (( ${#CHECKUP_HEALTHY[@]} == 0 )); then
      echo "  [~] no healthy items recorded"
    else
      printf '  [✓] %s\n' "${CHECKUP_HEALTHY[@]}"
    fi
    echo
    echo "Suggested actions:"
    if (( ${#CHECKUP_ACTIONS[@]} == 0 )); then
      echo "  1. No immediate action required."
    else
      local i=1
      local action
      for action in "${CHECKUP_ACTIONS[@]}"; do
        printf '  %d. %s\n' "$i" "$action"
        i=$(( i + 1 ))
      done
    fi
  fi

  (( ${#CHECKUP_CRITICAL[@]} == 0 ))
}

doctor_backups() {
  load_cfg
  local target
  echo "Backups:"
  if backup_last_success_epoch >/dev/null 2>&1; then
    echo "  last success: $(epoch_to_iso "$(backup_last_success_epoch)")"
  else
    echo "  last success: missing"
  fi
  echo "  enabled targets:"
  while IFS= read -r target; do
    local repo pw_file pw_size sftp_opt
    printf '    %s\n' "$target"
    repo="$(backup_target_value "$target" REPOSITORY)"
    pw_file="$(backup_target_password_file "$target")"
    if [[ -s "$pw_file" ]]; then
      pw_size="$(wc -c < "$pw_file" | tr -d ' ')"
      echo "      password file: $pw_file (${pw_size} bytes)"
      if [[ "${pw_size:-0}" -lt 12 ]]; then
        echo "      warning: restic password file is very short"
      fi
    else
      echo "      warning: missing restic password file: $pw_file"
    fi
    if [[ "$repo" == sftp:* ]]; then
      sftp_opt="$(sftp_command_option_for_target "$target" || true)"
      if [[ -n "$sftp_opt" ]]; then
        echo "      transport: explicit SFTP command configured (port: $(backup_target_value "$target" SFTP_PORT 22))"
      else
        echo "      warning: SFTP key file is configured incompletely or restic command does not use it"
      fi
      if sftp_key_auth_works "$target"; then
        echo "      ssh key auth: batch-mode OK"
      else
        echo "      warning: repository still appears to require password auth despite SFTP key config"
      fi
    fi
  done < <(enabled_backup_targets)
}

doctor_secrets() {
  load_cfg
  echo "Secrets:"
  find "$SECRETS_DIR" -maxdepth 1 -type f 2>/dev/null | sort | while IFS= read -r file; do
    if [[ -s "$file" ]]; then
      printf '  %s: set\n' "$(basename "$file")"
    else
      printf '  %s: empty\n' "$(basename "$file")"
    fi
  done
  echo
  echo "Required binaries:"
  for bin in age restic rclone; do
    if cmd_exists "$bin"; then
      echo "  $bin: $(command -v "$bin")"
    else
      echo "  $bin: MISSING (run: apt-get install -y $bin)"
    fi
  done
  echo
  recovery_pack_status || true
}

immich_reset_db() {
  load_cfg
  export_env_for_compose

  [[ "${ENABLE_IMMICH:-0}" == "1" ]] || die "Immich is not enabled in $CFG_FILE (ENABLE_IMMICH=0)."

  local data_dir fp_file uploads_dir confirm wipe_uploads=0
  data_dir="$(immich_postgres_data_dir)"
  fp_file="$(immich_db_password_fingerprint_file)"
  uploads_dir="$(immich_library_data_dir)"

  while (( $# > 0 )); do
    case "$1" in
      --wipe-uploads) wipe_uploads=1 ;;
      *) die "Usage: domum-media immich reset-db [--wipe-uploads]" ;;
    esac
    shift
  done

  cat <<EOF
[domum-media] This will wipe the Immich Postgres database.

  Deletes: $data_dir
  Clears:  $fp_file
  Keeps:   $uploads_dir (photo blobs — unusable until re-import)
EOF
  if (( wipe_uploads == 1 )); then
    cat <<EOF
  Also deletes: $uploads_dir
EOF
  fi
  cat <<EOF

  Type exactly 'wipe immich' to confirm.
EOF

  read -r -p "> " confirm
  [[ "$confirm" == "wipe immich" ]] || die "Aborted (no changes made)."

  echo "[domum-media] Stopping Immich containers..."
  compose_cmd stop immich_server immich_machine_learning immich_postgres immich_redis 2>/dev/null || true
  compose_cmd rm -f immich_server immich_machine_learning immich_postgres immich_redis 2>/dev/null || true

  echo "[domum-media] Pre-reset btrfs snapshot..."
  # This snapshot is the only safety net before the rm -rf below, so it must
  # cover THESE paths -- not merely "some subvolume somewhere succeeded".
  local -a wipe_paths=("$data_dir")
  (( wipe_uploads == 1 )) && wipe_paths+=("$uploads_dir")
  if ! assert_service_snapshot_covers immich "pre-immich-reset" "${wipe_paths[@]}" >/dev/null; then
    snapshot_protection_unavailable \
      "Cannot snapshot Immich state before resetting the database" \
      "no Btrfs snapshot covers ${wipe_paths[*]}, so the data about to be deleted cannot be restored"
  fi

  if [[ -d "$data_dir" ]]; then
    echo "[domum-media] Removing $data_dir"
    rm -rf "$data_dir"
  fi
  if (( wipe_uploads == 1 )) && [[ -d "$uploads_dir" ]]; then
    echo "[domum-media] Removing $uploads_dir"
    rm -rf "$uploads_dir"
  fi
  if [[ -f "$fp_file" ]]; then
    echo "[domum-media] Removing $fp_file"
    rm -f "$fp_file"
  fi

  echo "[domum-media] Reapplying desired state..."
  exec /usr/local/bin/domum-media apply
}

container_exists() {
  docker inspect "$1" >/dev/null 2>&1
}

container_env_value() {
  local container_name="$1"
  local env_key="$2"

  container_exists "$container_name" || return 0
  docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$container_name" 2>/dev/null \
    | awk -F= -v key="$env_key" '$1 == key {print substr($0, length(key) + 2); exit}'
}

immich_runtime_env_summary() {
  local server_db server_jwt postgres_db
  local server_db_status="empty"
  local server_jwt_status="empty"
  local postgres_db_status="empty"
  local db_match="no"

  server_db="$(container_env_value immich_server DB_PASSWORD)"
  server_jwt="$(container_env_value immich_server JWT_SECRET)"
  postgres_db="$(container_env_value immich_postgres POSTGRES_PASSWORD)"

  [[ -n "$server_db" ]] && server_db_status="set"
  [[ -n "$server_jwt" ]] && server_jwt_status="set"
  [[ -n "$postgres_db" ]] && postgres_db_status="set"
  if [[ -n "$server_db" && -n "$postgres_db" && "$server_db" == "$postgres_db" ]]; then
    db_match="yes"
  fi

  echo "  immich_server DB_PASSWORD: $server_db_status"
  echo "  immich_server JWT_SECRET: $server_jwt_status"
  echo "  immich_postgres POSTGRES_PASSWORD: $postgres_db_status"
  echo "  DB_PASSWORD == POSTGRES_PASSWORD: $db_match"
}

# Non-exiting predicate: are the running Immich containers' secret env vars
# present and consistent? Used by apply() to decide whether a force-recreate
# recovery pass is warranted before hard-failing.
immich_runtime_env_ok() {
  local server_db server_jwt postgres_db
  server_db="$(container_env_value immich_server DB_PASSWORD)"
  server_jwt="$(container_env_value immich_server JWT_SECRET)"
  postgres_db="$(container_env_value immich_postgres POSTGRES_PASSWORD)"

  [[ -n "$server_db" && -n "$server_jwt" && -n "$postgres_db" && "$server_db" == "$postgres_db" ]]
}

validate_immich_runtime_env() {
  [[ "${ENABLE_IMMICH:-0}" == "1" ]] || return 0

  if ! immich_runtime_env_ok; then
    echo "[domum-media] Runtime Immich env validation:"
    immich_runtime_env_summary
    echo "[domum-media] ERROR: Rendered Compose validation passed, but running containers have empty Immich secrets. This means docker compose up did not receive the runtime secret environment." >&2
    exit 1
  fi

  echo "[domum-media] Runtime Immich env validation:"
  immich_runtime_env_summary
}

container_status_summary() {
  local container_name="$1"
  local status health

  if ! container_exists "$container_name"; then
    printf 'missing'
    return 0
  fi

  status="$(docker inspect --format '{{.State.Status}}' "$container_name" 2>/dev/null || true)"
  health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$container_name" 2>/dev/null || true)"

  if [[ -n "$health" ]]; then
    printf '%s' "$health"
    return 0
  fi

  printf '%s' "${status:-unknown}"
}

container_image_ref() {
  local container_name="$1"
  container_exists "$container_name" || return 0
  docker inspect --format '{{.Config.Image}}' "$container_name" 2>/dev/null || true
}

container_mount_list() {
  local container_name="$1"
  container_exists "$container_name" || return 0
  docker inspect --format '{{range .Mounts}}{{println .Source "->" .Destination}}{{end}}' "$container_name" 2>/dev/null || true
}

doctor_immich() {
  need_root
  load_cfg
  export_env_for_compose

  [[ "${ENABLE_IMMICH:-0}" == "1" ]] || die "Immich is not enabled in $CFG_FILE (ENABLE_IMMICH=0)."

  local issues=0
  local db_file jwt_file fp_file pg_dir rendered_file
  local db_secret_status="missing"
  local jwt_secret_status="missing"
  local db_export_status="empty"
  local jwt_export_status="empty"
  local compose_db_status="empty"
  local compose_pg_status="empty"
  local compose_jwt_status="empty"
  local compose_db_match="no"
  local fingerprint_status="missing"
  local initialized="no"
  local server_db_raw server_jwt_raw postgres_db_raw
  local server_db postgres_db
  local current_digest stored_digest
  local postgres_status redis_status ml_status server_status

  db_file="$(immich_db_password_file)"
  jwt_file="$(immich_jwt_secret_file)"
  fp_file="$(immich_db_password_fingerprint_file)"
  pg_dir="$(immich_postgres_data_dir)"

  if [[ -f "$db_file" ]]; then
    if [[ -n "$(read_secret_file_value "$db_file")" ]]; then
      db_secret_status="set"
    else
      db_secret_status="empty"
      issues=1
    fi
  else
    db_secret_status="empty"
    issues=1
  fi

  if [[ -f "$jwt_file" ]]; then
    if [[ -n "$(read_secret_file_value "$jwt_file")" ]]; then
      jwt_secret_status="set"
    else
      jwt_secret_status="empty"
      issues=1
    fi
  else
    jwt_secret_status="empty"
    issues=1
  fi

  if [[ -n "${IMMICH_DB_PASSWORD:-}" ]]; then
    db_export_status="set"
  else
    issues=1
  fi
  if [[ -n "${IMMICH_JWT_SECRET:-}" ]]; then
    jwt_export_status="set"
  else
    issues=1
  fi

  if immich_db_password_initialized; then
    initialized="yes"
    if [[ -f "$fp_file" ]]; then
      if [[ -n "${IMMICH_DB_PASSWORD:-}" && -f "$db_file" ]]; then
        current_digest="$(sha256_of_file "$db_file")"
      else
        current_digest=""
      fi
      stored_digest="$(head -n1 "$fp_file" | tr -d '[:space:]')"
      if [[ -n "$current_digest" && "$current_digest" == "$stored_digest" ]]; then
        fingerprint_status="matches"
      else
        fingerprint_status="mismatch"
        issues=1
      fi
    else
      fingerprint_status="missing"
      issues=1
    fi
  else
    fingerprint_status="not-recorded"
  fi

  rendered_file="$(mktemp)"
  if render_compose_config_file "$rendered_file" 2>/dev/null; then
    server_db_raw="$(compose_rendered_env_value "$rendered_file" "immich_server" "DB_PASSWORD")"
    server_jwt_raw="$(compose_rendered_env_value "$rendered_file" "immich_server" "JWT_SECRET")"
    postgres_db_raw="$(compose_rendered_env_value "$rendered_file" "immich_postgres" "POSTGRES_PASSWORD")"

    if yaml_scalar_is_set "$server_db_raw"; then
      compose_db_status="set"
      server_db="$(yaml_scalar_plaintext "$server_db_raw")"
    fi
    if yaml_scalar_is_set "$postgres_db_raw"; then
      compose_pg_status="set"
      postgres_db="$(yaml_scalar_plaintext "$postgres_db_raw")"
    fi
    if yaml_scalar_is_set "$server_jwt_raw"; then
      compose_jwt_status="set"
    fi

    if [[ "$compose_db_status" != "set" || "$compose_pg_status" != "set" || "$compose_jwt_status" != "set" ]]; then
      issues=1
    fi

    if [[ "$compose_db_status" == "set" && "$compose_pg_status" == "set" && "$server_db" == "$postgres_db" ]]; then
      compose_db_match="yes"
    elif [[ "$compose_db_status" == "set" && "$compose_pg_status" == "set" ]]; then
      issues=1
    fi
  else
    issues=1
  fi
  rm -f "$rendered_file"

  if [[ -z "$(container_env_value immich_server DB_PASSWORD)" \
     || -z "$(container_env_value immich_server JWT_SECRET)" \
     || -z "$(container_env_value immich_postgres POSTGRES_PASSWORD)" ]]; then
    issues=1
  elif [[ "$(container_env_value immich_server DB_PASSWORD)" != "$(container_env_value immich_postgres POSTGRES_PASSWORD)" ]]; then
    issues=1
  fi

  postgres_status="$(container_status_summary immich_postgres)"
  redis_status="$(container_status_summary immich_redis)"
  ml_status="$(container_status_summary immich_machine_learning)"
  server_status="$(container_status_summary immich_server)"

  [[ "$postgres_status" == "healthy" ]] || issues=1
  [[ "$redis_status" == "healthy" ]] || issues=1
  [[ "$ml_status" == "healthy" || "$ml_status" == "running" ]] || issues=1
  [[ "$server_status" == "healthy" || "$server_status" == "running" ]] || issues=1

  echo "Immich secrets:"
  echo "  immich_db_password: $db_secret_status"
  echo "  immich_jwt_secret: $jwt_secret_status"
  echo
  echo "Exported env:"
  echo "  IMMICH_DB_PASSWORD: $db_export_status"
  echo "  IMMICH_JWT_SECRET: $jwt_export_status"
  echo
  echo "Rendered compose env:"
  echo "  DB_PASSWORD: $compose_db_status"
  echo "  POSTGRES_PASSWORD: $compose_pg_status"
  echo "  JWT_SECRET: $compose_jwt_status"
  echo "  DB_PASSWORD == POSTGRES_PASSWORD: $compose_db_match"
  echo
  echo "Running container env:"
  immich_runtime_env_summary
  echo
  echo "Database:"
  echo "  data path: $pg_dir"
  echo "  initialized: $initialized"
  echo "  password fingerprint: $fingerprint_status"
  echo
  echo "Containers:"
  echo "  immich_postgres: $postgres_status"
  echo "  immich_redis: $redis_status"
  echo "  immich_machine_learning: $ml_status"
  echo "  immich_server: $server_status"
  echo
  echo "Images:"
  echo "  immich_postgres: $(container_image_ref immich_postgres)"
  echo "  immich_redis: $(container_image_ref immich_redis)"
  echo "  immich_machine_learning: $(container_image_ref immich_machine_learning)"
  echo "  immich_server: $(container_image_ref immich_server)"
  echo
  echo "Mounts:"
  if container_exists immich_postgres; then
    while IFS= read -r mount; do
      [[ -n "$mount" ]] && echo "  immich_postgres: $mount"
    done < <(container_mount_list immich_postgres)
  else
    echo "  immich_postgres: missing"
  fi
  if container_exists immich_server; then
    while IFS= read -r mount; do
      [[ -n "$mount" ]] && echo "  immich_server: $mount"
    done < <(container_mount_list immich_server)
  else
    echo "  immich_server: missing"
  fi

  (( issues == 0 ))
}

immich_cmd() {
  need_root
  load_cfg
  export_env_for_compose
  local sub="${1:-}"
  case "$sub" in
    refresh-bundle) shift; immich_refresh_bundle "$@" ;;
    check-bundle) shift; immich_refresh_bundle --check-only "$@" ;;
    apply-bundle) shift; immich_refresh_bundle --force "$@" ;;
    rollback)
      local rollback_id
      rollback_id="$(rollback_entries | while IFS= read -r file; do
        unset ID SERVICE STATUS
        # shellcheck disable=SC1090
        source "$file"
        # Same as the interactive selector. This one also does `| tail -n 1`, so a
        # single pruned-but-recorded entry made `immich rollback` pick it every
        # time and die "not available: missing" -- permanently unusable, even with
        # older genuinely restorable snapshots present.
        [[ "${SERVICE:-}" == "immich" ]] || continue
        [[ "$(rollback_entry_effective_status "${STATUS:-available}" \
              "${SNAPSHOT_NAME:-$(basename "${SNAPSHOT:-}")}")" == "available" ]] || continue
        printf '%s\n' "${ID}"
      done | tail -n 1)"
      [[ -n "$rollback_id" ]] || die "No available Immich rollback points found."
      rollback_apply_entry "$rollback_id" 0
      ;;
    reset-db) shift; immich_reset_db "$@" ;;
    *) die "Usage: domum-media immich {refresh-bundle [--force]|check-bundle|apply-bundle|rollback|reset-db [--wipe-uploads]}" ;;
  esac
}

doctor_traefik() {
  need_root
  load_cfg
  export_env_for_compose

  [[ "${ENABLE_TRAEFIK:-0}" == "1" ]] || die "Traefik is not enabled in $CFG_FILE (ENABLE_TRAEFIK=0)."

  local traefik_status traefik_image started_at ports_raw
  local entry svc host
  local -a hosts=()

  traefik_status="$(container_status_summary traefik)"
  traefik_image="$(container_image_ref traefik)"
  if container_exists traefik; then
    started_at="$(docker inspect --format '{{.State.StartedAt}}' traefik 2>/dev/null || true)"
    ports_raw="$(docker inspect --format '{{range $p, $bindings := .NetworkSettings.Ports}}{{if $bindings}}{{range $bindings}}{{println $p "->" .HostIp ":" .HostPort}}{{end}}{{else}}{{println $p "(no host binding)"}}{{end}}{{end}}' traefik 2>/dev/null || true)"
  else
    started_at=""
    ports_raw=""
  fi

  echo "Traefik container:"
  echo "  status: $traefik_status"
  echo "  image:  ${traefik_image:-unknown}"
  echo "  started: ${started_at:-n/a}"
  echo "  ports:"
  if [[ -n "$ports_raw" ]]; then
    while IFS= read -r line; do
      [[ -n "$line" ]] && echo "    $line"
    done <<<"$ports_raw"
  else
    echo "    n/a"
  fi
  echo

  hosts+=("dashboard|${TRAEFIK_DASHBOARD_HOST:-}")
  [[ "${ENABLE_JELLYFIN:-0}" == "1" ]]    && hosts+=("jellyfin|${JELLYFIN_HOST:-}")
  [[ "${ENABLE_PLEX:-0}" == "1" ]]        && hosts+=("plex|${PLEX_HOST:-}")
  [[ "${ENABLE_NAVIDROME:-0}" == "1" ]]   && hosts+=("navidrome|${NAVIDROME_HOST:-}")
  [[ "${ENABLE_CALIBRE_WEB:-0}" == "1" ]] && hosts+=("calibre-web|${CALIBRE_WEB_HOST:-}")
  [[ "${ENABLE_KAVITA:-0}" == "1" ]]      && hosts+=("kavita|${KAVITA_HOST:-}")
  [[ "${ENABLE_UPTIME_KUMA:-0}" == "1" ]] && hosts+=("uptime-kuma|status.${DOMUM_DOMAIN:-}")
  [[ "${ENABLE_IMMICH:-0}" == "1" ]]      && hosts+=("immich|photos.${DOMUM_DOMAIN:-}")

  echo "Configured hosts:"
  for entry in "${hosts[@]}"; do
    svc="${entry%%|*}"
    host="${entry#*|}"
    printf '  %-14s %s\n' "$svc" "${host:-<unset>}"
  done
  echo

  local have_dig=0
  cmd_exists dig && have_dig=1

  echo "DNS resolution:"
  for entry in "${hosts[@]}"; do
    svc="${entry%%|*}"
    host="${entry#*|}"
    [[ -n "$host" ]] || continue
    local split_view public_view
    split_view="$(getent hosts "$host" 2>/dev/null | awk '{print $1}' | paste -sd, - 2>/dev/null || true)"
    [[ -z "$split_view" ]] && split_view="<unresolved>"
    if (( have_dig )); then
      public_view="$(dig +short +time=2 +tries=1 @1.1.1.1 "$host" 2>/dev/null | paste -sd, - || true)"
      [[ -z "$public_view" ]] && public_view="<unresolved>"
    else
      public_view="<dig unavailable>"
    fi
    printf '  %-14s split=%s public=%s\n' "$svc" "$split_view" "$public_view"
  done
  echo

  echo "acme.json:"
  if container_exists traefik; then
    local acme_source acme_file
    acme_source="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/letsencrypt"}}{{.Source}}{{end}}{{end}}' traefik 2>/dev/null || true)"
    if [[ -n "$acme_source" ]]; then
      acme_file="$acme_source/acme.json"
      if [[ -f "$acme_file" ]]; then
        local size mode owner issued_hosts state
        size="$(stat -c '%s' "$acme_file" 2>/dev/null || echo 'unknown')"
        mode="$(stat -c '%a' "$acme_file" 2>/dev/null || echo 'unknown')"
        owner="$(stat -c '%U:%G' "$acme_file" 2>/dev/null || echo 'unknown')"
        echo "  path: $acme_file"
        echo "  size: $size bytes"
        echo "  mode: $mode"
        echo "  owner: $owner"

        issued_hosts=""
        if cmd_exists jq; then
          issued_hosts="$(jq -r '
            (.cf.Certificates // [])
              | map(.domain.main, (.domain.sans // [])[])
              | unique
              | .[]
          ' "$acme_file" 2>/dev/null || true)"
        fi

        echo "  per-host certificate state:"
        for entry in "${hosts[@]}"; do
          svc="${entry%%|*}"
          host="${entry#*|}"
          [[ -n "$host" ]] || continue
          if ! cmd_exists jq; then
            state="unknown (jq not installed)"
          elif [[ -n "$issued_hosts" ]] && printf '%s\n' "$issued_hosts" | grep -Fxq -- "$host"; then
            state="issued"
          else
            state="missing"
          fi
          printf '    %-14s %-40s %s\n' "$svc" "$host" "$state"
        done
      else
        echo "  path: $acme_file (missing)"
      fi
    else
      echo "  unable to resolve traefik-letsencrypt mount source from docker inspect"
    fi
  else
    echo "  traefik container is not running"
  fi
  echo

  echo "Cloudflare token:"
  local cf_token=""
  if [[ -f "$SECRETS_DIR/cloudflare_api_token" ]]; then
    cf_token="$(read_secret_file_value "$SECRETS_DIR/cloudflare_api_token")"
  fi
  if [[ -z "$cf_token" ]]; then
    echo "  secret file: missing or empty ($SECRETS_DIR/cloudflare_api_token)"
  elif ! cmd_exists curl; then
    echo "  curl not installed — skipping token verify"
  else
    local resp
    resp="$(curl -sS --max-time 10 \
      -H "Authorization: Bearer $cf_token" \
      -H "Content-Type: application/json" \
      "https://api.cloudflare.com/client/v4/user/tokens/verify" 2>&1 || true)"
    if cmd_exists jq && jq -e . >/dev/null 2>&1 <<<"$resp"; then
      local success status_field expires not_before
      success="$(jq -r '.success' <<<"$resp")"
      status_field="$(jq -r '.result.status // "unknown"' <<<"$resp")"
      expires="$(jq -r '.result.expires_on // "n/a"' <<<"$resp")"
      not_before="$(jq -r '.result.not_before // "n/a"' <<<"$resp")"
      echo "  success: $success"
      echo "  status: $status_field"
      echo "  not_before: $not_before"
      echo "  expires_on: $expires"
      if [[ "$success" != "true" ]]; then
        echo "  errors:"
        jq -r '.errors[]? | "    [\(.code)] \(.message)"' <<<"$resp" || true
      fi
    else
      echo "  raw response: $resp"
    fi
  fi
  echo

  echo "Recent ACME log lines:"
  if container_exists traefik; then
    local logs
    logs="$(docker logs traefik 2>&1 | grep -iE 'acme|certificate|cf:' | tail -n 40 || true)"
    if [[ -n "$logs" ]]; then
      logs="  ${logs//$'\n'/$'\n  '}"
      printf '%s\n' "$logs"
    else
      echo "  (no ACME-related log lines found)"
    fi
  else
    echo "  traefik container is not running"
  fi
}

doctor_navidrome() {
  need_root
  load_cfg
  export_env_for_compose

  [[ "${ENABLE_NAVIDROME:-0}" == "1" ]] \
    || die "Navidrome is not enabled in $CFG_FILE (ENABLE_NAVIDROME=0)."

  local user data_dir music_root
  user="${NAVIDROME_USER:-0:0}"
  data_dir="${NAVIDROME_DATA_DIR:-$DOMUM_DATA_ROOT/navidrome}"
  music_root="${NAVIDROME_MUSIC_ROOT:-$DOMUM_MEDIA_ROOT/music}"

  local cfg_uid cfg_gid
  cfg_uid="${user%%:*}"
  cfg_gid="${user##*:}"

  echo "Navidrome:"
  echo "  NAVIDROME_USER:       $user"
  echo "  NAVIDROME_DATA_DIR:   $data_dir"
  echo "  NAVIDROME_MUSIC_ROOT: $music_root"
  echo

  echo "Data dir:"
  if [[ -d "$data_dir" ]]; then
    local owner_label owner_uid owner_gid mode
    owner_label="$(stat -c '%U:%G (%u:%g)' "$data_dir" 2>/dev/null || echo 'unknown')"
    owner_uid="$(stat -c '%u' "$data_dir" 2>/dev/null || echo '')"
    owner_gid="$(stat -c '%g' "$data_dir" 2>/dev/null || echo '')"
    mode="$(stat -c '%a' "$data_dir" 2>/dev/null || echo 'unknown')"
    echo "  path:  $data_dir"
    echo "  owner: $owner_label"
    echo "  mode:  $mode"
    if [[ -n "$owner_uid" && -n "$owner_gid" ]]; then
      if [[ "$owner_uid" == "$cfg_uid" && "$owner_gid" == "$cfg_gid" ]]; then
        echo "  ownership: PASS (matches NAVIDROME_USER=$user)"
      else
        echo "  ownership: WARN (expected $cfg_uid:$cfg_gid — run: sudo domum-media apply)"
      fi
    fi
  else
    echo "  path: $data_dir (missing — run: sudo domum-media apply)"
  fi
  echo

  echo "Music root:"
  if [[ -d "$music_root" ]]; then
    local m_owner m_mode readable=0 traversable=0
    m_owner="$(stat -c '%U:%G (%u:%g)' "$music_root" 2>/dev/null || echo 'unknown')"
    m_mode="$(stat -c '%a' "$music_root" 2>/dev/null || echo 'unknown')"
    echo "  path:  $music_root"
    echo "  owner: $m_owner"
    echo "  mode:  $m_mode"
    if [[ "$cfg_uid" == "0" ]]; then
      [[ -r "$music_root" ]] && readable=1
      [[ -x "$music_root" ]] && traversable=1
    elif cmd_exists runuser && getent passwd "$cfg_uid" >/dev/null 2>&1; then
      runuser -u "#${cfg_uid}" -- test -r "$music_root" && readable=1
      runuser -u "#${cfg_uid}" -- test -x "$music_root" && traversable=1
    else
      [[ -r "$music_root" ]] && readable=1
      [[ -x "$music_root" ]] && traversable=1
    fi
    if (( readable == 1 && traversable == 1 )); then
      echo "  access: PASS (readable+traversable by uid $cfg_uid)"
    else
      echo "  access: WARN (uid $cfg_uid lacks read/traverse — see docs/SETUP-NAVIDROME.md)"
    fi
  else
    echo "  path: $music_root (missing)"
  fi
  echo

  echo "Container:"
  local nv_status nv_image
  nv_status="$(container_status_summary navidrome)"
  nv_image="$(container_image_ref navidrome)"
  echo "  status: $nv_status"
  [[ -n "$nv_image" ]] && echo "  image:  $nv_image"
  echo

  echo "Recent errors (last 5 matching readonly|panic|error|permission):"
  if container_exists navidrome; then
    local err_lines
    err_lines="$(docker logs navidrome --tail 80 2>&1 \
      | grep -iE 'readonly|panic|error|permission' \
      | tail -n 5 || true)"
    if [[ -n "$err_lines" ]]; then
      err_lines="  ${err_lines//$'\n'/$'\n  '}"
      printf '%s\n' "$err_lines"
    else
      echo "  (none)"
    fi
  else
    echo "  navidrome container is not running"
  fi
}

doctor_cmd() {
  need_root
  local sub="${1:-}"
  case "$sub" in
    immich) shift; doctor_immich "$@" ;;
    traefik) shift; doctor_traefik "$@" ;;
    backups) shift; doctor_backups "$@" ;;
    secrets) shift; doctor_secrets "$@" ;;
    navidrome) shift; doctor_navidrome "$@" ;;
    *) die "Usage: domum-media doctor {immich|traefik|backups|secrets|navidrome}" ;;
  esac
}

# ---- storage: directory -> Btrfs subvolume migration -----------------------
#
# Converts one service state directory into a Btrfs subvolume so that
# service-level snapshots can work at all. See docs/BTRFS-MIGRATION-PLAN.md.
#
# The invariant this is built around:
#
#   A migration failure must never leave less recoverable state than existed
#   before it started.
#
# Live state is therefore never deleted -- only ever renamed aside -- and every
# stage that can fail has an explicit recovery.

MIGRATE_FULL_HASH_MAX_FILES="${MIGRATE_FULL_HASH_MAX_FILES:-20000}"
MIGRATE_SQLITE_MAX_BYTES="${MIGRATE_SQLITE_MAX_BYTES:-2147483648}"

migrate_stage() { echo "[domum-media] migrate[$1] $2"; }

# Services whose state directory may be migrated. Anything else is refused.
migrate_allowed_service() {
  case "$1" in
    jellyfin|plex|navidrome|calibre-web|kavita|immich) return 0 ;;
    *) return 1 ;;
  esac
}

# A Btrfs subvolume root always has inode 256.
# Refuse to touch anything that is not on the durable Btrfs data root.
migrate_assert_same_btrfs() {
  local path="$1" data_fs snap_fs path_fs
  path_fs="$(stat -f -c %T "$path" 2>/dev/null || true)"
  [[ "$path_fs" == "btrfs" ]] || die "$path is not on a Btrfs filesystem ($path_fs)"
  data_fs="$(findmnt -no SOURCE -T "$DOMUM_DATA_ROOT" 2>/dev/null | sed 's/\[.*//')"
  snap_fs="$(findmnt -no SOURCE -T "$DOMUM_SNAPSHOT_ROOT" 2>/dev/null | sed 's/\[.*//')"
  [[ -n "$data_fs" && "$data_fs" == "$snap_fs" ]] \
    || die "Snapshot root and data root are on different filesystems ($data_fs vs $snap_fs); snapshots cannot work"
}

# SQLite in WAL mode cannot be copied file-by-file while a writer is live: .db
# and .db-wal would be captured at different instants. A clean shutdown
# checkpoints and removes them.
# Returns non-zero rather than calling `die`, because by the time this runs the
# service has already been STOPPED. `die` exits the shell outright, which made
# the caller's `|| { migrate_restart; exit 1; }` unreachable dead code and left
# the service down until someone noticed and ran `docker compose up -d` by hand.
# Refusing to migrate is correct; refusing and walking away is not.
# "The containers are stopped" is not the same as "nothing is writing". A leftover
# process, an editor, a stray backup script or an rsync on the HOST all keep file
# handles that no `docker ps` check can see -- and the migration's entire safety
# argument rests on the tree being still.
#
# Scope, stated precisely: this sees HOST processes. A containerised process has
# its own mount namespace, so its fd links render as the container-internal path
# (`/config/data/jellyfin.db`, not `/srv/data/jellyfin/config/data/jellyfin.db`)
# and cannot match the pattern below. Containers are covered by
# `stop_compose_services_verified`, which proves each one is gone from `docker ps`
# -- a different mechanism for a different class of writer. An earlier version of
# this comment claimed the scan caught "a manual `docker run`"; it would not.
#
# Read from /proc rather than lsof or fuser: /proc is always there on Linux and
# needs no package, whereas fuser is NOT installed on this host. A check that
# silently degrades to "no tool, assume fine" is worse than no check.
#
# Self-exclusion is by PROCESS GROUP, not by PID. Excluding only $$ is not
# enough: every command substitution, pipeline member and subshell this check
# spawns INHERITS the parent's open descriptors, so each would be reported as a
# foreign writer. They all share our process group; an unrelated service or
# another operator's shell does not.
migrate_process_group() {
  local stat
  stat="$(cat "/proc/${1}/stat" 2>/dev/null)" || return 1
  # The comm field can contain spaces and parentheses, so split after the LAST
  # ')' and count from there: pgrp is the 3rd field of the remainder.
  stat="${stat##*) }"
  printf '%s' "$(printf '%s' "$stat" | cut -d" " -f3)"
}

migrate_open_handles() {
  local path="$1" fd link pid mygrp grp
  mygrp="$(migrate_process_group "$$" || true)"
  for fd in /proc/[0-9]*/fd/* /proc/[0-9]*/cwd; do
    pid="${fd#/proc/}"; pid="${pid%%/*}"
    if [[ -n "$mygrp" ]]; then
      grp="$(migrate_process_group "$pid" || true)"
      [[ "$grp" == "$mygrp" ]] && continue
    fi
    link="$(readlink "$fd" 2>/dev/null)" || continue
    case "$link" in
      "$path"|"$path"/*)
        printf '%s %s %s\n' "$pid" "$(cat "/proc/$pid/comm" 2>/dev/null || echo '?')" "$link"
        ;;
    esac
  done
}

migrate_assert_quiesced() {
  local path="$1" leftovers handles journals

  handles="$(migrate_open_handles "$path" | sort -u)"
  if [[ -n "$handles" ]]; then
    warn "Something still has files open under $path:
$handles
The containers are stopped, so this is an unexpected writer. Migrating while it
holds handles risks copying a torn state. Investigate before migrating."
    return 1
  fi

  # A hot rollback journal is NOT a refusal. With the writer stopped, the journal
  # is copied alongside its database and SQLite recovers from the pair on open --
  # that is what the journal is for. Recorded because it is evidence about how
  # the service shut down, and because a reader of the log should not have to
  # wonder whether it was noticed.
  journals="$(find "$path" -name '*-journal' -size +0 2>/dev/null || true)"
  if [[ -n "$journals" ]]; then
    migrate_stage stop "hot SQLite rollback journal(s) present; copied with their databases:
$journals"
  fi

  leftovers="$(find "$path" -name '*-wal' -size +0 2>/dev/null || true)"
  if [[ -n "$leftovers" ]]; then
    warn "Non-empty SQLite write-ahead logs remain after stopping the service:
$leftovers
The application did not shut down cleanly. Investigate before migrating."
    return 1
  fi
  if [[ -e "$path/postgres/postmaster.pid" ]]; then
    warn "PostgreSQL is still running or did not shut down cleanly ($path/postgres/postmaster.pid exists)."
    return 1
  fi
  return 0
}

migrate_measure() {
  local path="$1"
  printf '%s %s' \
    "$(find "$path" -type f 2>/dev/null | wc -l)" \
    "$(du -sb --apparent-size "$path" 2>/dev/null | awk '{print $1}')"
}

# Deterministic content manifest, relative to the given root so the two sides
# are comparable.
migrate_manifest() {
  local root="$1"
  ( cd "$root" && find . -type f -print0 2>/dev/null | sort -z \
      | xargs -0 -r sha256sum 2>/dev/null )
}

# Content hashes say nothing about ownership, permissions, or where a symlink
# points. `cp -a --reflink` preserves all three, so a difference means the copy
# is wrong -- and BTRFS-MIGRATION-PLAN.md has always claimed these are verified.
#
# Covers every entry type, not just regular files: directories (including empty
# ones), symlinks with their targets, and anything else that turns up. Sorted
# and NUL-delimited so the comparison is stable and newline-safe.
migrate_metadata_manifest() {
  local root="$1"
  (
    cd "$root" || exit 1
    find . -printf '%y %m %U %G %p -> %l\0' 2>/dev/null | sort -z | tr '\0' '\n'
  )
}

migrate_verify() {
  local src="$1" dst="$2" stage="${3:-verify}" files
  local s_count s_bytes d_count d_bytes
  read -r s_count s_bytes <<< "$(migrate_measure "$src")"
  read -r d_count d_bytes <<< "$(migrate_measure "$dst")"
  migrate_stage "$stage" "files: $s_count -> $d_count, bytes: $s_bytes -> $d_bytes"
  [[ "$s_count" == "$d_count" ]] || { warn "file count mismatch"; return 1; }
  [[ "$s_bytes" == "$d_bytes" ]] || { warn "byte count mismatch"; return 1; }

  files="$s_count"
  if (( files <= MIGRATE_FULL_HASH_MAX_FILES )); then
    migrate_stage "$stage" "hashing all $files file(s)"
    local src_manifest dst_manifest src_lines dst_lines
    src_manifest="$(mktemp)" || { warn "could not stage the source manifest"; return 1; }
    dst_manifest="$(mktemp)" || { warn "could not stage the copy manifest"; rm -f "$src_manifest"; return 1; }
    # `|| true` is deliberate here, unlike the pattern it usually is: sha256sum
    # exits non-zero when it cannot read a file, and with `pipefail` plus this
    # script's `set -e` that aborts the whole function before anything is
    # compared. The completeness check immediately below is what turns that
    # non-zero exit into a refusal, so swallowing it here hides nothing. Inside
    # the old `<(...)` the failure was swallowed by the shell anyway, and there
    # was no completeness check at all.
    migrate_manifest "$src" > "$src_manifest" || true
    migrate_manifest "$dst" > "$dst_manifest" || true
    src_lines="$(wc -l < "$src_manifest")"
    dst_lines="$(wc -l < "$dst_manifest")"

    # A file sha256sum could not read is DROPPED from the manifest, silently --
    # and because it drops out of both manifests identically, the diff below
    # passes and verification reports "content manifest identical" having never
    # compared it. The file count comes from `find`, so it cannot catch this
    # either. Demonstrated: 2 files on disk, 1 line in the manifest.
    #
    # Root can normally read everything, so this is a guard against a
    # verification that quietly proves less than it claims -- not a condition
    # seen today.
    # One check, not one per side. Separate src and dst checks were redundant for
    # the only reachable case -- a file unreadable in BOTH trees, which is what
    # makes the diff pass -- so either alone caught it and neither was
    # independently testable. Symmetry that cannot fail is not a safeguard.
    if [[ "$src_lines" != "$files" || "$dst_lines" != "$files" ]]; then
      warn "manifests cover $src_lines and $dst_lines of $files file(s); some could not be hashed"
      rm -f "$src_manifest" "$dst_manifest"
      return 1
    fi

    if ! diff "$src_manifest" "$dst_manifest" >/dev/null; then
      warn "content manifest mismatch"
      diff "$src_manifest" "$dst_manifest" | head -20 >&2
      rm -f "$src_manifest" "$dst_manifest"
      return 1
    fi
    rm -f "$src_manifest" "$dst_manifest"
    migrate_stage "$stage" "content manifest identical ($files of $files file(s))"
  else
    # Too many files to hash inline, so hash a deterministic sample: the first
    # and last paths in sorted order, every Nth in between, and the largest file.
    #
    # The previous selector was `awk 'NR%s==1'`, which for step==1 is NEVER
    # true: the sample came out empty, the loop body never ran, `bad` stayed 0
    # and verification PASSED having compared nothing. That was reachable
    # whenever MIGRATE_FULL_HASH_MAX_FILES < files < 400. A sample of zero is
    # now a failure, so the degenerate case cannot masquerade as a pass.
    migrate_stage "$stage" "$files files exceeds $MIGRATE_FULL_HASH_MAX_FILES; hashing a deterministic sample"
    local step sample_file sampled=0 bad=0 rel
    step=$(( files / 200 )); (( step > 0 )) || step=1
    sample_file="$(mktemp)" || { warn "could not stage the verification sample"; return 1; }
    # NUL-delimited throughout: a filename containing a newline must not split
    # one path into two unreadable ones.
    (
      cd "$src" || exit 1
      find . -type f -printf '%s\t%p\0' 2>/dev/null | sort -z -t"$(printf '\t')" -k2,2
    ) | awk -v RS='\0' -v ORS='\0' -v s="$step" '
        {
          rec[NR] = $0
          split($0, f, "\t"); sz = f[1] + 0
          if (maxn == 0 || sz > maxsz) { maxsz = sz; maxn = NR }
          if (NR == 1 || NR % s == 0) pick[NR] = 1
        }
        END {
          if (NR == 0) exit
          pick[NR] = 1           # last
          if (maxn) pick[maxn] = 1  # largest
          for (i = 1; i <= NR; i++)
            if (i in pick) { p = rec[i]; sub(/^[^\t]*\t/, "", p); print p }
        }' > "$sample_file"

    while IFS= read -r -d "" rel; do
      [[ -n "$rel" ]] || continue
      local a b
      a="$(sha256sum "$src/$rel" 2>/dev/null | cut -d" " -f1)"
      b="$(sha256sum "$dst/$rel" 2>/dev/null | cut -d" " -f1)"
      [[ -n "$a" && "$a" == "$b" ]] || { warn "sample mismatch: $rel"; bad=1; }
      sampled=$(( sampled + 1 ))
    done < "$sample_file"
    rm -f -- "$sample_file"

    (( bad == 0 )) || return 1
    # A verification that hashed nothing has verified nothing. With the selector
    # above this is unreachable (first and last are always picked), so it is
    # defence in depth against a future change to the selection rules rather
    # than a tested path -- mutation testing confirms nothing exercises it.
    (( sampled > 0 )) || { warn "the verification sample was empty; nothing was compared"; return 1; }
    migrate_stage "$stage" "sampled content identical ($sampled of $files file(s))"
  fi

  # Always compared in full, whichever content branch ran: this is cheap
  # (metadata only, no reads) and it is the only check that sees empty
  # directories, permissions, ownership, and symlink targets.
  if ! diff <(migrate_metadata_manifest "$src") <(migrate_metadata_manifest "$dst") >/dev/null; then
    warn "metadata mismatch (type, mode, owner, group, or symlink target)"
    diff <(migrate_metadata_manifest "$src") <(migrate_metadata_manifest "$dst") \
      | head -20 >&2
    return 1
  fi
  migrate_stage "$stage" "type, mode, owner, group and symlink targets identical"
  return 0
}

# SQLite integrity for a tree that has to be RECOVERABLE, not merely identical.
#
# Byte-for-byte equality proves the copy is faithful. It does not prove the thing
# copied is a loadable database: a torn write that predates the migration copies
# perfectly and verifies perfectly. The recovery point is the one tree whose
# usability actually matters, so it gets opened.
#
# Always against a DISPOSABLE COPY, never in place. The proof snapshot is
# read-only and `.premigration` is the last independent copy of the pre-migration
# state; opening a WAL-mode database can create sidecars and can trigger
# recovery, and neither may happen to either tree.
#
# Prints `ok`, a reason, or `unchecked`. `unchecked` is not a pass, and the caller
# must not report it as one -- a check that did not run is reported as not having
# run. This is the only function here allowed to say "I don't know".
domum_sqlite_check() {  # $1 = path to a disposable COPY
  local db="$1" ic fk
  if cmd_exists sqlite3; then
    ic="$(sqlite3 -readonly "$db" 'PRAGMA integrity_check;' 2>&1 | head -1)"
    fk="$(sqlite3 -readonly "$db" 'PRAGMA foreign_key_check;' 2>&1 | grep -c . || true)"
    case "$ic" in
      *"unknown tokenizer"*|*"no such module"*|*"unknown function"*|*"no such collation"*)
        printf 'unsupported: %s' "$ic"; return 0 ;;
    esac
    if [[ "$ic" != "ok" ]]; then printf 'integrity_check: %s' "$ic"
    elif [[ "${fk:-0}" != "0" ]]; then printf 'foreign_key_check: %s violation(s)' "$fk"
    else printf 'ok'; fi
  elif cmd_exists python3; then
    python3 - "$db" <<'PY' 2>/dev/null || printf 'unreadable as a database'
import sqlite3, sys
try:
    con = sqlite3.connect("file:%s?mode=ro" % sys.argv[1], uri=True)
except Exception as e:
    print("cannot open: %s" % e, end=""); sys.exit(0)
try:
    ic = con.execute("PRAGMA integrity_check").fetchone()[0]
    fk = con.execute("PRAGMA foreign_key_check").fetchall()
    if ic != "ok":
        print("integrity_check: %s" % ic, end="")
    elif fk:
        print("foreign_key_check: %d violation(s)" % len(fk), end="")
    else:
        print("ok", end="")
except sqlite3.OperationalError as e:
    # A pragma that cannot RUN is not a database that is broken. Plex's databases
    # carry FTS virtual tables built with its own `collating` tokenizer, which
    # only Plex's bundled SQLite registers: integrity_check AND quick_check both
    # raise "unknown tokenizer: collating" on a perfectly sound file. Measured on
    # the real plex recovery point -- those same two databases returned `ok` with
    # zero foreign-key violations under /usr/lib/plexmediaserver/Plex SQLite,
    # while page_count, schema_version and all 254 sqlite_master rows read fine
    # under the generic one.
    msg = str(e)
    unsupported = ("unknown tokenizer" in msg or "no such module" in msg
                   or "unknown function" in msg or "no such collation" in msg)
    print(("unsupported: %s" if unsupported else "failed: %s") % msg, end="")
except Exception as e:
    print("failed: %s" % e, end="")
finally:
    con.close()
PY
  else
    printf 'unchecked'
  fi
}

# Some applications build their SQLite with private extensions, so only THEIR
# binary can run integrity_check over their own schema. Per-service, like
# service_ready_probe: a generic checker reporting "unsupported" is honest but
# weak, and this turns it back into a real check.
service_sqlite_binary() {  # $1 = service -> path INSIDE its container
  case "$1" in
    plex) printf '/usr/lib/plexmediaserver/Plex SQLite' ;;
    *) return 1 ;;
  esac
}

# Run the check with the service's own SQLite, on a copy placed in the container's
# /tmp. It never touches the service's state directory and removes the copy
# afterwards. Needs a RUNNING container, so it is a fallback, not the primary
# path: during the pre-cutover verify the service is deliberately stopped and the
# honest answer there remains "not checked".
domum_sqlite_check_via_container() {  # $1 = service, $2 = local copy
  local service="$1" db="$2" bin cid dest ic fk
  bin="$(service_sqlite_binary "$service" 2>/dev/null)" || return 1
  cid="$(tracked_service_container_id_any "$service" 2>/dev/null || true)"
  [[ -n "$cid" ]] || return 1
  [[ "$(docker inspect -f '{{.State.Status}}' "$cid" 2>/dev/null)" == "running" ]] || return 1
  dest="/tmp/.domum-sqlite-check.$$.db"
  docker cp "$db" "$cid:$dest" >/dev/null 2>&1 || return 1
  ic="$(docker exec "$cid" "$bin" "$dest" 'PRAGMA integrity_check;' 2>&1 | head -1)"
  fk="$(docker exec "$cid" "$bin" "$dest" 'PRAGMA foreign_key_check;' 2>/dev/null | grep -c . || true)"
  docker exec "$cid" rm -f "$dest" >/dev/null 2>&1 || true
  [[ -n "$ic" ]] || return 1
  if [[ "$ic" != "ok" ]]; then printf 'integrity_check: %s' "$ic"
  elif [[ "${fk:-0}" != "0" ]]; then printf 'foreign_key_check: %s violation(s)' "$fk"
  else printf 'ok'; fi
  return 0
}

# Every SQLite database in $1, checked from a copy. Returns non-zero only for a
# database that is genuinely broken -- never for one that could not be checked,
# which is reported instead.
migrate_sqlite_integrity() {  # $1 = tree, $2 = stage label
  local tree="$1" stage="${2:-verify}"
  local tmp rel size result bad=0 checked=0 skipped=0

  tmp="$(mktemp -d)" || { warn "could not stage a scratch directory for the database check"; return 1; }
  while IFS= read -r -d "" rel; do
    [[ -n "$rel" ]] || continue
    size="$(stat -c %s "$tree/$rel" 2>/dev/null || echo 0)"
    # Copying a very large database to check it costs real time and space, and a
    # multi-gigabyte SQLite file is not a shape this project has. Stated, not
    # silently skipped.
    if (( size > MIGRATE_SQLITE_MAX_BYTES )); then
      migrate_stage "$stage" "sqlite $rel: $(( size / 1048576 )) MiB exceeds the check limit; NOT checked"
      skipped=$(( skipped + 1 ))
      continue
    fi
    # Only files that ARE SQLite databases. A `.db` extension is a naming
    # convention, not a format: failing a migration because some application's
    # `.db` is Berkeley DB, or a plain file someone named `.db`, would be a false
    # positive on a path where a false positive is expensive. The 16-byte magic
    # is definitive, costs one read, and avoids copying the file at all.
    # 15 bytes, not 16: the magic is "SQLite format 3\0" and command
    # substitution drops the NUL with a warning on stderr.
    if [[ "$(head -c 15 "$tree/$rel" 2>/dev/null)" != "SQLite format 3" ]]; then
      migrate_stage "$stage" "sqlite $rel: not a SQLite database; not checked"
      skipped=$(( skipped + 1 ))
      continue
    fi
    # A COPY, always. Opening a WAL-mode database CREATES `-shm` and `-wal` beside
    # it and leaves them there -- even with `mode=ro`. Measured:
    #
    #   before:  w.db
    #   ro open: w.db  w.db-shm  w.db-wal      <- and they persist after close
    #
    # In `.premigration` that would make the preserved original differ from the
    # proof snapshot, so the act of verifying the integrity claim would break it.
    # Against the read-only snapshot it would simply fail. Neither is acceptable.
    if ! cp -- "$tree/$rel" "$tmp/probe.db" 2>/dev/null; then
      warn "sqlite $rel: could not be copied for checking"
      bad=1
      continue
    fi
    result="$(domum_sqlite_check "$tmp/probe.db")"
    # NOTE: the probe copy is removed AFTER the fallback below, not here. It was
    # deleted first, so `docker cp` had nothing to copy and the fallback silently
    # never ran -- it reported "not checked" while a real answer was available.
    # An extension this SQLite LACKS is "I could not check", not "it is broken".
    # This function's contract has always said it never fails an unchecked
    # database; the case below sent anything unrecognised to bad=1 anyway, and
    # that reported plex's two perfectly sound databases as a failed recovery
    # point. Before giving up, try the application's own SQLite.
    if [[ "$result" == unsupported:* && -n "${MIGRATE_SQLITE_SERVICE:-}" ]]; then
      local via
      if via="$(domum_sqlite_check_via_container "$MIGRATE_SQLITE_SERVICE" "$tmp/probe.db")"; then
        migrate_stage "$stage" "sqlite $rel: this SQLite cannot read the schema; used the application's own"
        result="$via"
      fi
    fi
    rm -f -- "$tmp/probe.db"
    case "$result" in
      ok)        migrate_stage "$stage" "sqlite $rel: ok"; checked=$(( checked + 1 )) ;;
      unchecked) migrate_stage "$stage" "sqlite $rel: NOT checked (no sqlite3 and no python3)"; skipped=$(( skipped + 1 )) ;;
      unsupported:*)
        migrate_stage "$stage" "sqlite $rel: NOT checked -- this SQLite cannot read the schema"
        migrate_stage "$stage" "  ${result#unsupported: }"
        migrate_stage "$stage" "  the file opened; header, page count and schema all read fine."
        migrate_stage "$stage" "  Only the integrity pragma needs an extension this build lacks."
        skipped=$(( skipped + 1 )) ;;
      *)         warn "sqlite $rel: $result"; bad=1 ;;
    esac
  done < <(find "$tree" -xdev -type f \( -name '*.db' -o -name '*.sqlite' -o -name '*.sqlite3' \) -printf '%P\0' 2>/dev/null)
  rm -rf -- "$tmp"

  (( bad == 0 )) || return 1
  migrate_stage "$stage" "sqlite: $checked checked, $skipped not checked"
  return 0
}

# THE integrity claim of a migration, asserted by the migration itself.
#
# CLAUDE.md section 13b states it: `.premigration` == proof snapshot -- the
# original that was moved aside, against a snapshot of the copy that replaced it.
# Both are static, so a running application cannot disturb the comparison, and it
# catches corruption introduced after migrate_verify has already passed.
#
# Until now that comparison existed ONLY in a hand-written operator script. A
# migration run straight from the CLI never made its own central claim, and the
# one copy of it lived in a file CI never sees -- which is exactly how the stale
# topology invariant came to abort a correct deployment. Same class, higher stakes.
#
# Deliberately run AFTER the restart: both trees are static, so nothing is gained
# by holding the service down while a large tree is hashed.
#
# A failure here is not recoverable by this command and must not try to be: both
# copies are intact, and which one is right is a question for the operator.
# Paths a running service is expected to write, rewrite or remove. THE DATABASE
# FILE IS DELIBERATELY ABSENT: sidecars appearing proves the service opened its
# database, but `.db` content changing is a different claim the operator must see.
#
# This lived only in the operator wrapper, which is the defect the project keeps
# re-learning: docs/MIGRATION-LIFECYCLE.md and CLAUDE.md both described the live
# tree as "classified, not compared", and the CLI had no such stage at all. One
# canonical implementation, tested in CI, invoked by the operator script.
#
# Case matters. `*/logs/*` does not match Plex's `Logs/`, and plugin logs are
# named `com.plexapp.system.log.5`, so `*.log.*` is needed as well as `*.log`.
migrate_runtime_expected() {  # $1 = path relative to the tree root
  case "$1" in
    */log/*|*/logs/*|*/Log/*|*/Logs/*|*.log|*.log.*|*/.*-log) return 0 ;;
    */ScheduledTasks/*|*/temp/*|*/tmp/*|*/Temp/*) return 0 ;;
    # Any directory whose name IS or STARTS WITH cache -- Kavita writes
    # config/cache-long/update/*.json, which `*/cache/*` does not match, so six
    # regenerable update-checker files were reported as "NOT obviously runtime
    # state" for the operator to review. Noise in a safety report is a defect:
    # it trains the reader to skim the list that exists to be read.
    */cache/*|*/cache-*/*|*/Cache/*|*/Cache-*/*|*/caches/*) return 0 ;;
    */thumbnails/*|*/covers/*|*/favicons/*|*/bookmarks/*) return 0 ;;
    # Plex: crash reports and codec downloads are regenerable, and `Updates/` is
    # where it stages its own installers.
    */Crash?Reports/*|*/Codecs/*|*/Updates/*) return 0 ;;
    *.pid|*.lock|*.sock) return 0 ;;
    *-wal|*-shm|*-journal) return 0 ;;
    *) return 1 ;;
  esac
}

# Classify the live tree against the proof snapshot, and say which differences
# matter. Emits one record per differing path:
#
#   LOST <path>       in the snapshot, gone from the live tree, NOT runtime state
#   PRUNED <path>     in the snapshot, gone from the live tree, expected churn
#   CHANGED <path>    in both, content differs, NOT runtime state
#   ADDED <path>      only in the live tree, NOT runtime state
#   CHURN <path>      differs or appeared, and is expected runtime state
#
# Only LOST is a failure. The caller decides; this function only classifies, so a
# test can drive it directly.
#
# WHY "missing is a hard failure" could not survive Plex. The wrapper aborted
# unconditionally when any snapshotted file was absent from the live tree. That
# held for jellyfin, kavita and navidrome and is FALSE for Plex, which rotates
# `Plex Media Server.N.log` and prunes its own dated database backups
# (`com.plexapp.plugins.library.db-YYYY-MM-DD`, four kept). A correct migration
# would have aborted on ordinary log rotation -- the same shape as the stale
# topology invariant and the prose-grep abort. So a disappearance is split the
# same way an addition is, and only an unexpected one fails.
#
# NUL-delimited throughout. The wrapper iterated `for f in $CHANGED $ADDED`,
# which word-splits: measured, two real Plex paths became ELEVEN fragments, and
# because `Server.2.log` matches `*.log` while `Support/Plex` matches nothing,
# pieces of one path were classified differently from each other. Any service
# whose paths contain spaces -- Plex is the first -- made that output meaningless.
migrate_classify_live_tree() {  # $1 = proof snapshot root, $2 = live tree root
  local snap="$1" live="$2" rel a b
  [[ -d "$snap" ]] || { warn "proof snapshot not found: $snap"; return 2; }
  [[ -d "$live" ]] || { warn "live tree not found: $live"; return 2; }

  # Snapshot side: lost, pruned or changed.
  while IFS= read -r -d '' rel; do
    rel="${rel#./}"
    if [[ ! -e "$live/$rel" ]]; then
      if migrate_runtime_expected "$rel"; then printf 'PRUNED %s\0' "$rel"
      else printf 'LOST %s\0' "$rel"; fi
      continue
    fi
    a="$(sha256sum "$snap/$rel" 2>/dev/null | cut -d' ' -f1)"
    b="$(sha256sum "$live/$rel" 2>/dev/null | cut -d' ' -f1)"
    # An unreadable file must never read as "identical". Both empty would compare
    # equal and silently pass, which is how a dropped manifest line hid a real
    # difference once already.
    if [[ -z "$a" || -z "$b" ]]; then printf 'LOST %s\0' "$rel"; continue; fi
    if [[ "$a" != "$b" ]]; then
      if migrate_runtime_expected "$rel"; then printf 'CHURN %s\0' "$rel"
      else printf 'CHANGED %s\0' "$rel"; fi
    fi
  done < <(cd "$snap" && find . -type f -print0 2>/dev/null | sort -z)

  # Live side: anything that appeared.
  while IFS= read -r -d '' rel; do
    rel="${rel#./}"
    [[ -e "$snap/$rel" ]] && continue
    if migrate_runtime_expected "$rel"; then printf 'CHURN %s\0' "$rel"
    else printf 'ADDED %s\0' "$rel"; fi
  done < <(cd "$live" && find . -type f -print0 2>/dev/null | sort -z)
  return 0
}

# Report the classification, and fail only on a genuine loss.
migrate_report_live_tree() {  # $1 = proof snapshot root, $2 = live tree root
  local snap="$1" live="$2" out rec kind path
  local lost=0 changed=0 added=0 churn=0 pruned=0
  out="$(mktemp)" || { warn "cannot stage the live-tree classification"; return 1; }
  if ! migrate_classify_live_tree "$snap" "$live" > "$out"; then
    rm -f "$out"; warn "the live tree could not be classified"; return 1
  fi
  local review=""
  while IFS= read -r -d '' rec; do
    kind="${rec%% *}"; path="${rec#* }"
    case "$kind" in
      LOST)    lost=$((lost+1));       review="$review  LOST    $path"$'\n' ;;
      CHANGED) changed=$((changed+1)); review="$review  CHANGED $path"$'\n' ;;
      ADDED)   added=$((added+1));     review="$review  ADDED   $path"$'\n' ;;
      CHURN)   churn=$((churn+1)) ;;
      PRUNED)  pruned=$((pruned+1)) ;;
    esac
  done < "$out"
  rm -f "$out"
  migrate_stage live "since the proof snapshot: $churn expected-churn, $pruned pruned, \
$changed changed, $added added, $lost lost"
  if [[ -n "$review" ]]; then
    warn "Differences that are NOT obviously runtime state -- review:"
    printf '%s' "$review" >&2
    warn "The integrity claim is unaffected: it compares two static trees."
  else
    migrate_stage live "all divergence is expected runtime state"
  fi
  if (( lost > 0 )); then
    warn "$lost file(s) present in the proof snapshot are GONE from the live tree,"
    warn "and are not the kind of path a running service is expected to remove."
    return 1
  fi
  return 0
}

migrate_verify_recovery_point() {  # $1 = .premigration, $2 = proof snapshot, $3 = service
  local premigration="$1" proof_path="$2"
  # Optional, and only used to pick the application's own SQLite when the generic
  # one cannot read the schema. Absent means "generic checker only", which is the
  # honest default rather than a silent downgrade.
  local MIGRATE_SQLITE_SERVICE="${3:-}"

  [[ -d "$premigration" ]] || { warn "the preserved original is missing from $premigration"; return 1; }
  [[ -d "$proof_path" ]] || { warn "the proof snapshot is missing from $proof_path"; return 1; }

  # Read-only is what makes the snapshot a proof rather than another mutable copy.
  if cmd_exists btrfs; then
    local ro
    ro="$(btrfs property get -ts "$proof_path" 2>/dev/null || true)"
    if [[ "$ro" != "ro=true" ]]; then
      warn "the proof snapshot is not read-only ($proof_path: ${ro:-unknown})"
      return 1
    fi
  fi

  if ! migrate_verify "$premigration" "$proof_path" recovery; then
    warn "THE PRESERVED ORIGINAL AND THE PROOF SNAPSHOT DIFFER."
    warn "  preserved original : $premigration"
    warn "  proof snapshot     : $proof_path"
    warn "Both trees are intact. Do NOT delete either one."
    return 1
  fi

  migrate_sqlite_integrity "$proof_path" recovery || return 1

  migrate_stage recovery "integrity proven: $premigration == $proof_path"
  return 0
}

# A hand-built `docker compose` command is wrong here, and wrong in a way that
# only shows up during recovery. This project has no compose.yml: the stack is
# assembled from fragments chosen by which services are enabled, so a bare
# `docker compose -p domum-media up -d jellyfin` in /opt/domum-core-media fails
# with "no configuration file provided: not found".
#
# Runbooks therefore point at this passthrough instead of spelling out an -f
# list that will drift. It layers exactly what every other command layers.
compose_passthrough() {
  need_root
  load_cfg
  export_env_for_compose
  (( $# > 0 )) || die "Usage: domum-media compose <docker compose arguments...>"
  compose_cmd "$@"
}

storage_migrate_subvolume() {
  need_root
  load_cfg
  export_env_for_compose

  local service="${1:-}"
  [[ -n "$service" ]] || die "Usage: domum-media storage migrate-subvolume <service>"
  migrate_allowed_service "$service" \
    || die "Refusing: '$service' is not in the migration allowlist (jellyfin, plex, navidrome, calibre-web, kavita, immich)"

  local path premigration newsub compose_svcs
  path="$(service_data_path "$service")" || die "No data path mapping for $service"
  [[ -n "$path" && "$path" != "/" ]] || die "Refusing: resolved an unsafe path for $service"
  [[ -d "$path" ]] || die "Refusing: $path does not exist"

  # Taken here rather than at the top of the function: a usage error or an
  # unknown service should be refused without touching runtime state at all.
  #
  # Refuse immediately rather than wait. A migration is attended, and the right
  # answer to "a backup is running" is for the operator to come back in half an
  # hour -- not for the CLI to sit there silently for thirty minutes.
  domum_acquire_lock "storage migrate-subvolume $service" 0 \
    || die "Another domum-media operation holds the lock: $(domum_lock_holder)
Refusing to migrate while it runs. The nightly backup starts at 02:30 (+15m jitter)
and reads all of ${DOMUM_DATA_ROOT:-/srv/data}; a migration renaming directories
underneath it would make that backup fail. Wait for it to finish and retry."

  # Never touch the replaceable media tier, whatever the config says.
  case "$path" in
    "${DOMUM_MEDIA_ROOT%/}"/*|"${DOMUM_MEDIA_ROOT%/}")
      die "Refusing: $path is inside the media tier ($DOMUM_MEDIA_ROOT), which is not Btrfs and is out of scope" ;;
    "${DOMUM_DATA_ROOT%/}"/*) ;;
    *) die "Refusing: $path is outside the durable data root ($DOMUM_DATA_ROOT)" ;;
  esac

  path_is_subvolume "$path" && die "Nothing to do: $path is already a Btrfs subvolume."
  migrate_assert_same_btrfs "$path"

  premigration="${path}.premigration"
  newsub="${path}.new"
  [[ -e "$premigration" ]] \
    && die "Refusing: $premigration already exists. A previous migration left rollback material; review and move it aside before migrating again."
  [[ -e "$newsub" ]] \
    && die "Refusing: $newsub already exists from an interrupted run. Review and remove it before retrying."

  # Space: reflink makes the copy nearly free, but refuse if the filesystem is
  # close to full, since a failed copy mid-way is the worst outcome.
  local avail_kb
  avail_kb="$(df --output=avail -k "$DOMUM_DATA_ROOT" | tail -1 | tr -d ' ')"
  (( avail_kb > 1048576 )) || die "Refusing: less than 1 GiB free on $DOMUM_DATA_ROOT"

  compose_svcs="$(service_compose_services "$service" || true)"

  # A migration must not upgrade the application as a side effect of moving its
  # data: the two decisions have different blast radii and different rollback
  # stories, and bundling them means the proof snapshot holds the OLD
  # application's data while the NEW application runs. That is the Kavita
  # incident (docs/IMAGE-DEPLOYMENT-BY-MIGRATION.md).
  #
  # THIS USED TO REFUSE WHENEVER AN IMAGE WAS MERELY STAGED, and its own
  # justification said "restarting it would DEPLOY that image". That was true when
  # the migration restarted with `up -d`. It is NOT true of `compose start`, which
  # is what migrate_restart has used since -- and which fails closed rather than
  # falling back.
  #
  # Measured on this host, with a disposable compose project and no pull, retag or
  # prune: a container created on image A, stopped, its compose file repointed at
  # image B, then `compose start` -> the container stayed on A. `up -d` with the
  # same file recreated it on B. `compose start` resolves no image reference at
  # all, so a staged image cannot be deployed by this code path.
  #
  # Refusing on a merely-staged image therefore deadlocked the project: plex could
  # not be UPGRADED because its state was unprotected, and could not be MIGRATED
  # to gain protection because an upgrade was staged. Each gate was individually
  # right and together they were a trap.
  #
  # So the control moves from prediction to verification:
  #   * a staged image is reported loudly here and does NOT refuse;
  #   * an image that actually CHANGED across the restart is a HARD failure after
  #     the fact (see stage 8), not a warning;
  #   * identity we could not determine still refuses BEFORE the stop, because a
  #     recovery point whose application is unknown cannot be paired.
  local image_verdicts staged_images unknown_images absent_images
  image_verdicts="$(service_staged_image_changes "$service")"
  staged_images="$(grep '^STAGED '  <<< "$image_verdicts" || true)"
  unknown_images="$(grep '^UNKNOWN ' <<< "$image_verdicts" || true)"
  # ABSENT, not STOPPED: the verdict was renamed when stopped containers started
  # being inspected like any other, and this grep went on looking for a string the
  # producer no longer emits -- so it silently matched nothing.
  absent_images="$(grep '^ABSENT ' <<< "$image_verdicts" || true)"
  [[ -n "$absent_images" ]] \
    && migrate_stage preflight "no container at all: $(tr '\n' ' ' <<< "$absent_images")"

  if [[ -n "$staged_images" || -n "$unknown_images" ]]; then
    if [[ "${MIGRATE_ALLOW_IMAGE_CHANGE:-0}" == "1" ]]; then
      warn "MIGRATE_ALLOW_IMAGE_CHANGE=1, so this migration may also deploy an image for $service:"
      printf '  %s\n' "$staged_images$unknown_images" >&2
      warn "If it does, the proof snapshot will hold the previous application's data."
    elif [[ -n "$staged_images" ]]; then
      # Not a refusal any more. `compose start` resolves no image reference, so
      # this migration cannot deploy it -- and stage 8 FAILS if it somehow did.
      migrate_stage preflight "a newer image is STAGED for $service and will NOT be deployed:"
      printf '  %s\n' "$staged_images"
      migrate_stage preflight "  the restart uses \`compose start\`, which resolves no image reference;"
      migrate_stage preflight "  stage 8 fails the migration if the image changed anyway"
    else
      # "I could not tell" must never read as "nothing is staged". A migration is
      # attended and nothing has been touched yet, so refusing costs nothing --
      # and the alternative is proceeding on a check that did not run.
      die "Refusing: cannot determine whether restarting $service would deploy a different image.
$unknown_images
Restarting a service deploys whatever its tag resolves to, so this must be known
before the service is stopped, not discovered afterwards.
To proceed anyway, set MIGRATE_ALLOW_IMAGE_CHANGE=1."
    fi
  fi

  local images_before runtime_before staged_recovery
  images_before="$(service_running_images "$service")"
  runtime_before="$(service_runtime_state "$service")"
  migrate_stage preflight "runtime state before: $runtime_before"

  # Captured NOW, from the containers that are still the ones that wrote this
  # state, and bound to the proof snapshot's name later. Staging it before the
  # stop is what makes the evidence describe the snapshot rather than whatever
  # comes up afterwards -- and a migration that cannot record it refuses here,
  # where nothing has been touched, rather than after the cutover.
  if ! staged_recovery="$(stage_recovery_point_metadata "$service" "$runtime_before")" \
     || [[ -z "$staged_recovery" ]]; then
    die "Refusing: could not record which application image is operating $service.
A recovery point is the filesystem state AND the application that wrote it; without
the second part the snapshot cannot be paired with anything. Nothing has been changed.
Check that ${DOMUM_STATE_ROOT:-/var/lib/domum-media}/snapshots is writable."
  fi
  migrate_stage preflight "recovery evidence staged: $staged_recovery"
  # Never left behind on any exit path, including a die from a later stage.
  # shellcheck disable=SC2064
  trap "rm -f -- '$staged_recovery'" EXIT

  migrate_stage preflight "service=$service path=$path"
  migrate_stage preflight "compose services: ${compose_svcs:-none}"
  migrate_stage preflight "free space: $(( avail_kb / 1024 )) MiB"

  # ---- stage 1: stop --------------------------------------------------------
  local started=0

  # Defined BEFORE the stop is attempted, because the stop itself can fail and
  # the recovery for that is a restart.
  #
  # `compose start`, NOT `compose up -d`. This is the invariant, not a preference:
  #
  #   `up -d` RECONCILES. It recreates any container whose image or config has
  #   changed, so it resolves the image tag afresh -- which is how the Kavita
  #   migration deployed a staged image and forward-migrated its schema. Worse,
  #   the preflight staged-image check cannot close that hole, only narrow it: a
  #   `docker pull` between the check and the restart re-points the tag, and the
  #   operation lock does not cover other tools' pulls.
  #
  #   `start` starts THE SAME CONTAINER OBJECT. There is no image resolution at
  #   all, so the image cannot change and the race has nowhere to happen.
  #
  # A migration changes no compose configuration, so nothing requires recreation.
  # What it changes is the tree a bind mount points at -- and a bind mount is
  # re-resolved on start. Measured on a disposable compose project:
  #
  #   up -d                     -> container 5312d8c00833, sees OLD
  #   compose stop; swap dir; compose start
  #                             -> container 5312d8c00833, sees NEW, same image
  #
  # Same container, same image, new tree. That is exactly what a migration needs.
  migrate_restart() {
    (( started == 1 )) || return 0
    [[ -n "$compose_svcs" ]] || return 0
    # shellcheck disable=SC2086
    if compose_cmd start $compose_svcs >/dev/null 2>&1; then
      return 0
    fi
    # FAIL CLOSED. `start` failing means a container is gone -- removed
    # externally, or never created -- and the only way to bring the service back
    # is to recreate it, which resolves the image tag and can deploy whatever has
    # since been pulled. That is the exact failure this invariant exists to
    # prevent, so it is NOT done automatically.
    #
    # The previous version warned that recreation would resolve the tag and then
    # did it anyway, which is the worst shape available: a documented fail-open.
    # A service that is down is visible and fixable in one command. A service
    # silently running a different application than the one its recovery point
    # pairs with is neither.
    warn "Could not start the existing container(s) for $compose_svcs."
    warn "NOT recreating them: recreation resolves the image tag and could start a"
    warn "different application than the one this migration's recovery point pairs with."
    warn "$service is DOWN. Nothing has been deleted."
    warn "To bring it back on the image recorded in the recovery evidence:"
    warn "    sudo domum-media rollback list          # find the recovery point"
    warn "    cat ${DOMUM_STATE_ROOT:-/var/lib/domum-media}/snapshots/<point>.recovery"
    warn "    <SERVICE>_IMAGE=<CONTAINER_1_IMAGE_ID> sudo domum-media compose up -d $compose_svcs"
    warn "or, to accept whatever the tag now resolves to, deliberately:"
    warn "    sudo domum-media compose up -d $compose_svcs"
    return 1
  }

  if [[ -n "$compose_svcs" && "$runtime_before" == "running" ]]; then
    migrate_stage stop "stopping $compose_svcs"
    # Set BEFORE the stop, not after it succeeds. A stop that fails part-way has
    # still taken containers down, and the old ordering made migrate_restart a
    # no-op in exactly that case: the message said "nothing has been changed"
    # while leaving the service off. No data was ever at risk -- but the service
    # stayed down until somebody noticed.
    started=1
    stop_compose_services_verified "$compose_svcs" || {
      migrate_restart
      die "Could not confirm $compose_svcs stopped; no data was changed, and a restart was attempted."
    }
  fi

  if [[ "$runtime_before" != "running" ]]; then
    # Nothing was running, so there is nothing to stop and nothing to start
    # afterwards. A migration PRESERVES runtime intent: a service the operator
    # stopped must not come back running, and a service with no container must
    # not acquire one -- creating it would resolve a mutable image tag for which
    # no identity was ever captured.
    migrate_stage stop "$service was $runtime_before before this migration and will be left $runtime_before"
  fi

  if ! migrate_assert_quiesced "$path"; then
    migrate_restart
    die "Migration aborted: the service is not quiesced. Nothing has been changed, and $service has been restarted."
  fi
  migrate_stage stop "quiesced: nothing holding files open, no non-empty WAL, no postmaster.pid"

  # ---- stage 2: create the new subvolume ------------------------------------
  if ! btrfs subvolume create "$newsub" >/dev/null; then
    migrate_restart
    die "Could not create subvolume $newsub. Nothing has been changed."
  fi
  migrate_stage create "created subvolume $newsub"

  # ---- stage 3: reflink copy ------------------------------------------------
  if ! cp -a --reflink=always "$path/." "$newsub/"; then
    warn "Copy failed; removing the partial copy. The original at $path is untouched."
    rm -rf -- "$newsub" || warn "Could not remove the partial copy at $newsub"
    migrate_restart
    die "Migration aborted during copy. Nothing was lost."
  fi
  migrate_stage copy "reflink copy complete"

  # ---- stage 4: verify ------------------------------------------------------
  if ! migrate_verify "$path" "$newsub"; then
    warn "Verification failed; removing the unverified copy. The original at $path is untouched."
    rm -rf -- "$newsub" || warn "Could not remove the unverified copy at $newsub"
    migrate_restart
    die "Migration aborted: the copy did not verify. Nothing was lost."
  fi

  # ---- stage 5+6: cutover ---------------------------------------------------
  if ! mv -- "$path" "$premigration"; then
    rm -rf -- "$newsub" || warn "Could not remove the staged copy at $newsub"
    migrate_restart
    die "Could not move the original aside. Nothing has been changed."
  fi
  migrate_stage cutover "original preserved at $premigration"

  if ! mv -- "$newsub" "$path"; then
    warn "Could not move the new subvolume into place; restoring the original."
    mv -- "$premigration" "$path" \
      || die "CRITICAL: the original could not be restored. It is at $premigration."
    rm -rf -- "$newsub" || warn "Could not remove the staged copy at $newsub"
    migrate_restart
    die "Migration aborted at cutover. The original was restored."
  fi
  migrate_stage cutover "$path is now a Btrfs subvolume"

  # ---- stage 7: prove a snapshot can now be taken ---------------------------
  # Taken BEFORE the service restarts, while the tree is still quiesced, so the
  # proof snapshot is of a cleanly stopped service rather than a running one.
  # Previously this ran after the restart, which made it crash-consistent --
  # recoverable, since btrfs snapshots are atomic and SQLite replays its WAL,
  # but weaker than the clean copy the plan's reasoning assumes, and weaker for
  # no reason: the service is already stopped at this point and one btrfs
  # snapshot is near-instant.
  #
  # Not `|| true`: a swallowed snapshot failure is the exact pattern the
  # snapshot gate forbids. This one is genuinely non-fatal -- the migration has
  # already succeeded and the proof is confirmatory -- but it must be reported,
  # never discarded.
  local proof=""
  if proof="$(create_service_snapshot "$service" "post-migration" "" "")" && [[ -n "$proof" ]]; then
    migrate_stage proof "snapshot created: $DOMUM_SNAPSHOT_ROOT/$proof"
    # What application wrote the state this snapshot holds. Captured while the
    # service is still stopped, from the container that was running before -- so
    # it describes the snapshot, not whatever comes up afterwards.
    local recovery_meta
    if recovery_meta="$(bind_recovery_point_metadata "$staged_recovery" "$service" "$proof")" \
       && [[ -n "$recovery_meta" ]]; then
      migrate_stage proof "recovery evidence: $recovery_meta"
      trap - EXIT
    else
      # The data is migrated and safe, and NOTHING is deleted -- but this is not a
      # complete recovery point, and saying "Migration complete" would be a lie of
      # exactly the kind this project keeps finding. Reported at the end as an
      # incomplete result, not swallowed as a warning.
      recovery_meta=""
      warn "The recovery-point evidence for $proof could NOT be recorded."
      warn "The data is migrated and both copies are intact, but the snapshot is not"
      warn "paired with the application image that wrote it, so it is a DATA recovery"
      warn "point only. Do not treat it as a rollback point."
    fi
  else
    proof=""
    warn "Migration succeeded but a snapshot could NOT be created; investigate before relying on rollback."
  fi

  # ---- stage 8: restart and health -----------------------------------------
  local restart_ok=1 restart_since
  # Recorded BEFORE the restart, so `docker logs --since` cannot be satisfied by a
  # readiness line from the previous run.
  # UTC, and compared against the log line's own UTC stamp -- never handed to
  # `docker logs --since` without a zone, which is read in the caller's timezone.
  restart_since="$(date -u +%Y-%m-%dT%H:%M:%S)"
  migrate_restart || restart_ok=0
  if (( restart_ok == 1 )) && [[ -n "$compose_svcs" && "$runtime_before" == "running" ]]; then
    if wait_for_service_health "$service" 120 5; then
      # Be precise about what that actually proved, because the three cases prove
      # very different things and conflating them is how "the container started"
      # becomes "the application works".
      local health_url health_state
      health_url="$(service_health_url "$service" 2>/dev/null || true)"
      health_state="$(service_health_state "$service")"
      if [[ "$health_state" == "healthy" ]]; then
        migrate_stage health "$service is HEALTHY: its container healthcheck passed after the migration"
      elif [[ -n "$health_url" ]]; then
        migrate_stage health "$service container running and $health_url responded"
      else
        migrate_stage health "$service container is running (no healthcheck or health URL configured)"
      fi

      # An application-level claim for services that cannot make one any other
      # way. Polled within the same window, because a readiness line arrives after
      # the container does.
      local ready_pat ready_waited=0 ready_rc=2
      ready_pat="$(service_ready_log_pattern "$service")"
      if [[ -n "$ready_pat" ]]; then
        while (( ready_waited < 120 )); do
          service_logged_ready_since "$service" "$restart_since" && { ready_rc=0; break; }
          sleep 5
          ready_waited=$(( ready_waited + 5 ))
        done
        if (( ready_rc == 0 )); then
          migrate_stage health "$service LOGGED READY since the restart: \"$ready_pat\""
        else
          warn "$service never logged readiness (\"$ready_pat\") in ${ready_waited}s after the restart."
          warn "Its container is running, but the application did not report that it is serving."
          warn "The previous state is intact at $premigration; nothing was deleted."
          die "Migration completed but $service did not report readiness."
        fi
      elif [[ "$health_state" != "healthy" && -z "$health_url" ]]; then
        migrate_stage health "no healthcheck, no health URL and no readiness pattern for $service:"
        migrate_stage health "  'running' is the whole claim. Content was verified byte-for-byte;"
        migrate_stage health "  exercise the application yourself before removing $premigration"
      fi

      # The strongest evidence available WITHOUT changing the service: an
      # in-container request to an endpoint it already serves. For plex this is
      # GET /identity, which is strictly better than its readiness log line --
      # that line only reports that a TCP listener exists on 32400, while an HTTP
      # 200 carrying a machineIdentifier proves the application answered and had
      # read its own preferences. Polled, not one-shot, because HTTP comes up
      # after the listener.
      #
      # It does NOT prove the library database opened: /identity does not touch
      # it, and anything that does needs an X-Plex-Token. That question is
      # answered by integrity_check / foreign_key_check on disposable copies.
      local probe_waited=0 probe_rc=2 probe_version=""
      if service_ready_probe "$service" >/dev/null 2>&1; then
        while (( probe_waited < 120 )); do
          service_probe_ready "$service" && { probe_rc=0; break; }
          sleep 5
          probe_waited=$(( probe_waited + 5 ))
        done
        if (( probe_rc == 0 )); then
          probe_version="$(service_probe_version "$service" 2>/dev/null || true)"
          migrate_stage health "$service ANSWERED its own endpoint after the migration"
          [[ -n "$probe_version" ]] \
            && migrate_stage health "  application reports version $probe_version" \
            || migrate_stage health "  (endpoint responded; no version string in the reply)"
          migrate_stage health "  this proves the application served HTTP and read its preferences;"
          migrate_stage health "  it does NOT prove the library database opened -- see the SQLite checks"
        else
          warn "$service did not answer its own endpoint within ${probe_waited}s after the restart."
          warn "Its container is running and it logged readiness, but the application did not serve."
          warn "The previous state is intact at $premigration; nothing was deleted."
          die "Migration completed but $service never answered its endpoint."
        fi
      fi
    else
      # `starting` now counts as not-yet-healthy, so this is reached when a real
      # healthcheck has not passed within the timeout -- not merely when a
      # container failed to appear.
      warn "$service did not become healthy after migration (state: $(service_health_state "$service"))."
      warn "The previous state is intact at $premigration."
      warn "To roll back: stop the service, mv '$path' aside, mv '$premigration' '$path', start it."
      die "Migration completed but the service is unhealthy. Nothing was deleted."
    fi
  fi

  # The image must be the same one that was running before. Belt and braces: the
  # preflight refusal cannot see a tag that is absent locally, where `up -d`
  # pulls. An upgrade that happened anyway must be reported, not discovered later
  # from a schema that no longer matches the recovery point.
  local image_changed=0
  if [[ -n "$compose_svcs" ]]; then
    local images_after
    images_after="$(service_running_images "$service")"
    local runtime_after
    runtime_after="$(service_runtime_state "$service")"
    if [[ "$runtime_after" != "$runtime_before" ]]; then
      warn "$service was $runtime_before before this migration and is $runtime_after now."
      warn "A migration must preserve runtime state; this did not."
    else
      migrate_stage health "runtime state preserved: $runtime_after"
    fi
    if [[ "$images_after" != "$images_before" ]]; then
      warn "$service IS RUNNING A DIFFERENT IMAGE than before the migration:"
      warn "  before: $(printf '%s' "$images_before" | tr '\n' ' ')"
      warn "  after : $(printf '%s' "$images_after" | tr '\n' ' ')"
      warn "The application was upgraded by this migration. The proof snapshot holds the"
      warn "PREVIOUS application's data, so it is a data recovery point, not a full rollback."
      # HARD, not advisory. The pre-stop check no longer refuses on a merely
      # staged image, because `compose start` cannot deploy one; this is what
      # replaces that refusal, so it must not be a warning the summary ignores.
      if [[ "${MIGRATE_ALLOW_IMAGE_CHANGE:-0}" == "1" ]]; then
        warn "MIGRATE_ALLOW_IMAGE_CHANGE=1, so this is accepted deliberately."
      else
        image_changed=1
      fi
    else
      migrate_stage health "image unchanged across the restart"
    fi
  fi

  # ---- stage 9: prove the RECOVERY POINT, not just the copy -----------------
  # migrate_verify proved the copy matched the source before cutover. This proves
  # the thing a rollback would actually use: the preserved original against the
  # snapshot of what replaced it. Two static trees, so the running service cannot
  # disturb it, and it catches corruption introduced after verification passed.
  local recovery_ok=1
  if [[ -n "$proof" ]]; then
    if ! migrate_verify_recovery_point "$premigration" "$DOMUM_SNAPSHOT_ROOT/$proof" "$service"; then
      recovery_ok=0
      warn "The data is migrated and $service is running, but the recovery point did not verify."
      warn "Nothing has been deleted. Investigate before relying on rollback for $service."
    fi
  fi

  # ---- stage 10: classify the LIVE tree ------------------------------------
  # Stage 9 compared two static trees, which is the integrity claim. This asks a
  # different question: what has the restarted service done to its state since
  # the snapshot was taken? A running service legitimately writes logs, touches
  # locks and reopens its databases, so the answer is a classification, not an
  # equality -- and a file that VANISHED is only acceptable when it is the kind of
  # path a service is expected to remove.
  #
  # Reported but deliberately NOT part of the four claims: it describes the live
  # tree, not the recovery point, and the recovery point is what a rollback uses.
  # A genuine loss still prints a warning the operator cannot miss.
  local live_ok=1
  if [[ -n "$proof" ]]; then
    migrate_report_live_tree "$DOMUM_SNAPSHOT_ROOT/$proof" "$path" || live_ok=0
  fi

  echo
  # FOUR claims, reported separately. "Migration complete" used to be printed
  # before any of them was known, and the exit status was decided by one. The
  # filesystem migration can succeed while the recovery point is incomplete, and
  # calling that success is the class of defect this project keeps finding.
  local complete=1
  echo "[domum-media] Migration result for $service"
  echo "  data migrated   : yes -- $path is a Btrfs subvolume"
  echo "  previous state  : $premigration   (retained deliberately; remove it yourself when satisfied)"

  if [[ -n "$proof" ]]; then
    echo "  proof snapshot  : $proof"
  else
    echo "  proof snapshot  : NONE -- rollback protection was not established"
    complete=0
  fi

  if [[ -z "$proof" ]]; then
    echo "  recovery point  : not established (no snapshot)"
  elif (( recovery_ok == 0 )); then
    echo "  recovery point  : DID NOT VERIFY -- see the warnings above"
    complete=0
  elif [[ -z "$recovery_meta" ]]; then
    echo "  recovery point  : DATA ONLY -- verified, but not paired with an application image"
    complete=0
  else
    echo "  recovery point  : complete -- verified, and paired with the image that wrote it"
    echo "  recovery evidence: $recovery_meta"
  fi

  if (( image_changed == 1 )); then
    echo "  application     : UPGRADED by this migration -- the recovery point pairs with the PREVIOUS image"
    complete=0
  fi

  if [[ -n "$proof" ]] && (( live_ok == 0 )); then
    echo "  live tree       : a file in the proof snapshot is GONE and is not expected churn"
  fi

  if (( restart_ok == 0 )); then
    echo "  service         : DOWN -- could not be started from its existing container"
    complete=0
  elif [[ "$runtime_before" == "running" ]]; then
    echo "  service         : running (as it was before)"
  else
    echo "  service         : $runtime_before (as it was before; deliberately not started)"
  fi

  echo
  if (( complete == 1 )); then
    echo "[domum-media] Migration COMPLETE for $service."
    return 0
  fi
  echo "[domum-media] Migration INCOMPLETE for $service -- read the lines above."
  echo "  Nothing was deleted. Both copies of the previous state are intact."
  return 1
  return 0
}

# A deterministic inventory of the storage topology this project manages.
#
# Exists because the Jellyfin deployment aborted on a stale ABSOLUTE invariant.
# The hand-written deploy script asserted
#
#   find /srv/data -maxdepth 1 -inum 256   ->  must be EMPTY
#   ls /srv/snapshots | wc -l              ->  must be 0
#
# which was true only before any service had been migrated. After the pilot,
# /srv/data/jellyfin is intentionally a subvolume and /srv/snapshots intentionally
# holds its proof snapshot, so a deployment that changed nothing was reported as
# having changed storage. Both assertions would have fired; the first one did.
#
# The question a deployment actually needs answered is not "is the topology
# empty?" but "is the topology the SAME as before I started?". This prints it in a
# form two runs can be compared with, so the caller asserts equality rather than
# emptiness.
#
# Subvolume-ness is decided by domum_is_subvolume, NOT by an inline `find -inum
# 256`. Inode 256 is necessary but not sufficient -- it is perfectly ordinary on
# ext4, and /srv/media on this host is ext4 -- so an inline test here would have
# been a fourth answer to a question this project deliberately has one answer to.
#
# Sorted, one item per line, no timestamps or sizes -- nothing that changes on its
# own between two captures minutes apart.
DOMUM_TOPOLOGY_FORMAT=1

# domum_is_subvolume answers with the btrfs tool when it can (root) and with
# inode+filesystem-type when it cannot. Both are correct, and they are not
# guaranteed to agree in every corner -- so a capture RECORDS which one produced
# it. Comparing a capture taken unprivileged against one taken as root would
# otherwise be able to report a change that never happened, which is precisely
# the failure this whole mechanism exists to prevent.
storage_topology_detector() {
  if command -v btrfs >/dev/null 2>&1 && [[ "$(id -u)" == "0" ]]; then
    printf 'btrfs-tool'
  else
    printf 'inode+fstype'
  fi
}

storage_topology() {
  local data_root="${DOMUM_DATA_ROOT%/}" snap_root="${DOMUM_SNAPSHOT_ROOT%/}" p name
  printf '# topology-format %s detector=%s data-root=%s snapshot-root=%s\n' \
    "$DOMUM_TOPOLOGY_FORMAT" "$(storage_topology_detector)" "$data_root" "$snap_root"
  # Service subvolumes: depth 1 under the data root. Nested subvolumes deeper than
  # that are a different concern and are reported by the protection states.
  if [[ -d "$data_root" ]]; then
    while IFS= read -r p; do
      [[ -n "$p" ]] || continue
      domum_is_subvolume "$p" && printf 'subvolume %s\n' "$p"
    done < <(find "$data_root" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | LC_ALL=C sort)
  fi
  if [[ -d "$snap_root" ]]; then
    while IFS= read -r name; do
      [[ -n "$name" ]] && printf 'snapshot %s\n' "$name"
    done < <(find "$snap_root" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' 2>/dev/null | LC_ALL=C sort)
  fi
}

# Compare a saved capture against the live topology, and say WHAT differs.
#
# This is the assertion a storage-neutral operation -- a deployment installs files
# and moves a git ref -- needs after it finishes. It lives here, tested, rather
# than in each hand-written operator script, because the script that aborted the
# b762fe8 deployment was the only copy of an invariant nobody had reviewed.
#
# Three outcomes, deliberately distinct:
#   0  unchanged
#   1  CHANGED, with each appearance and disappearance named
#   2  NOT COMPARABLE -- the two captures do not describe the same question
#
# 2 exists because "I cannot tell" must never be reported as "unchanged". A caller
# that only tests for success treats it as a failure, which is the safe default.
storage_topology_verify() {
  local before="${1:-}" now hb hn line changed=0 subs snaps
  [[ -n "$before" ]] || die "storage_topology_verify needs a capture file"

  if [[ ! -f "$before" ]]; then
    warn "No topology capture to compare against: $before"
    return 2
  fi

  now="$(mktemp)"
  storage_topology > "$now"

  hb="$(grep -m1 '^# topology-format ' "$before" || true)"
  hn="$(grep -m1 '^# topology-format ' "$now" || true)"
  if [[ -z "$hb" ]]; then
    warn "$before has no topology header; it was not produced by 'storage topology'."
    rm -f "$now"
    return 2
  fi
  if [[ "$hb" != "$hn" ]]; then
    # Different format version, different subvolume detector, or different roots.
    # Diffing these would manufacture a topology change out of a changed question.
    warn "Topology captures are not comparable; refusing to report a change that may not have happened."
    warn "  captured: $hb"
    warn "  now     : $hn"
    rm -f "$now"
    return 2
  fi

  while IFS= read -r line; do
    case "$line" in
      '<'*) printf 'DISAPPEARED %s\n' "${line#< }"; changed=1 ;;
      '>'*) printf 'APPEARED    %s\n' "${line#> }"; changed=1 ;;
    esac
  done < <(diff <(grep -v '^#' "$before" | LC_ALL=C sort) \
                <(grep -v '^#' "$now"    | LC_ALL=C sort) | grep -E '^[<>]' || true)

  subs="$(grep -c '^subvolume ' "$now" || true)"
  snaps="$(grep -c '^snapshot ' "$now" || true)"
  rm -f "$now"

  if (( changed )); then
    warn "Storage topology CHANGED (now ${subs} subvolume(s), ${snaps} snapshot(s))."
    return 1
  fi
  echo "[domum-media] Storage topology unchanged: ${subs} subvolume(s), ${snaps} snapshot(s)."
  return 0
}

# Read the recovery evidence for a point and say what it actually proves.
#
# Exists so nobody has to grep the CLI's prose to find out. The migration wrapper
# used to assert on the literal string "recovery point  : verified"; the wording
# changed when the summary was split into four claims, and a perfectly good
# migration was aborted by a stale string assertion -- the same shape as the
# topology invariant that aborted a correct deployment.
#
# Read-only. Prints a per-container classification and returns non-zero when the
# evidence is missing or does not describe what it claims to.
# "Is this service actually protected?", as a value rather than a sentence.
#
# The migration wrapper used to decide this by grepping `domum-media report` for
# `: protected` / `: snapshottable` / `: degraded` and ABORTING on the English.
# That is the same dependency that aborted a completed migration when a summary
# line was reworded -- and it was a safety decision, not a note.
#
# One implementation: report_snapshot_protection already computes it, and this
# exposes its verdict. Prints the state word; exits 0 only for `protected`, so a
# caller can simply test the command.
#
#   protected      a subvolume WITH a snapshot that covers it
#   snapshottable  a subvolume with no snapshot -- nothing to roll back to
#   degraded       a nested subvolume would be omitted from any snapshot of it
#   unprotected    an ordinary directory
#   unknown        the path is missing, or btrfs is unavailable
storage_protection() {  # $1 = service (optional: all services when omitted)
  local service="${1:-}" path state rc=0
  load_report_lib
  if [[ -z "$service" ]]; then
    local svc
    while IFS='|' read -r svc _ _ _ _ _ _; do
      [[ -n "$svc" ]] || continue
      path="$(service_data_path "$svc" 2>/dev/null || true)"
      [[ -n "$path" ]] || continue
      state="$(report_snapshot_protection "$svc" "$path" | jq -r '.state')"
      printf '%-14s %s\n' "$svc" "$state"
    done < <(service_lifecycle_specs)
    return 0
  fi
  path="$(service_data_path "$service" 2>/dev/null || true)"
  [[ -n "$path" ]] || die "No data path mapping for $service"
  state="$(report_snapshot_protection "$service" "$path" | jq -r '.state')"
  printf '%s\n' "$state"
  [[ "$state" == "protected" ]] || rc=1
  return "$rc"
}

# Where a durable image archive lives.
#
# /srv/data/backups is the right tier, and the alternatives are wrong:
#   * it is on the protected Btrfs tier and `restic backup` is given
#     "$DOMUM_DATA_ROOT" with only immich-tmp and media-cache excluded, so an
#     archive here IS in the off-host backup set (measured);
#   * it is a top-level ordinary directory, NOT inside any service subvolume, so
#     it does not duplicate into per-service snapshots;
#   * /srv/media is the deliberately replaceable tier, and / is not backed up.
image_archive_dir() {
  printf '%s/backups/images' "${DOMUM_DATA_ROOT%/}"
}

# Archive an image by ID, with a checksum beside it.
#
# `docker save <image-id>` records RepoTags: null, which is correct: the identity
# worth preserving is the image ID, not a mutable tag. Measured on this host with
# a disposable image: `docker load` of such an archive reported
# "Loaded image ID: sha256:fd7dc98638c8…", byte-identical to the original, so the
# round trip preserves identity.
#
# NOTE: the archive's config-blob digest does NOT equal the image ID here (this
# host records Id as the manifest digest), so identity cannot be checked from the
# blob alone. The .sha256 beside the archive proves the FILE is intact; `docker
# load` is what proves the identity. Both are recorded, and neither is presented
# as the other.
archive_image_to_file() {  # $1 = image id, $2 = destination .tar
  local img="$1" dest="$2" dir
  dir="$(dirname "$dest")"
  install -d -m 0750 "$dir" || { warn "cannot create $dir"; return 1; }
  [[ -e "$dest" ]] && { warn "refusing to overwrite an existing archive: $dest"; return 1; }
  docker image inspect "$img" >/dev/null 2>&1     || { warn "image $img is not present locally; nothing to archive"; return 1; }
  if ! docker save "$img" -o "$dest.partial" 2>/dev/null; then
    rm -f -- "$dest.partial"
    warn "docker save failed for $img"
    return 1
  fi
  # Checksum the partial, then publish atomically: an archive that exists under
  # its final name must always be complete.
  sha256sum "$dest.partial" | awk '{print $1}' > "$dest.sha256.partial"     || { rm -f -- "$dest.partial" "$dest.sha256.partial"; warn "could not checksum the archive"; return 1; }
  sync -f "$dest.partial" 2>/dev/null || sync 2>/dev/null || true
  mv -- "$dest.partial" "$dest" && mv -- "$dest.sha256.partial" "$dest.sha256"     || { warn "could not publish the archive"; return 1; }
  chmod 0640 "$dest" "$dest.sha256" 2>/dev/null || true
  return 0
}

# A PRE-UPGRADE recovery point: the complete rollback artifact for an application
# upgrade, created WITHOUT deploying anything.
#
# WHY THE EXISTING UPDATE PATH IS NOT ENOUGH. Measured in refresh_images:
#
#   * it calls create_service_snapshot while the service is RUNNING. There is no
#     stop, no open-handle check and no WAL gate anywhere in that function, so
#     the snapshot is CRASH-consistent, not application-consistent -- and Plex
#     holds a live non-empty WAL (93 KB at the last measurement). The migration
#     path stops, proves quiescence and only then snapshots; the update path
#     would quietly use a weaker model for the same data.
#   * create_service_snapshot writes NO recovery metadata -- zero references to
#     it -- so a pre-update snapshot is a DATA-only point. Which application
#     wrote the state is not recorded.
#   * and because the cleanup protection keys off `.recovery` files, the old
#     image a pre-update snapshot depends on would NOT be protected from
#     `cleanup images`.
#
# So this exists as a separate, reversible operation. It stops the service,
# proves it quiesced, takes a read-only snapshot, optionally archives the exact
# running image, binds complete metadata tying the two together, and restarts the
# SAME container on the SAME image via `compose start`. It never resolves an
# image reference and never deploys.
# Can a pre-upgrade recovery point exist for this service AT ALL?
#
# Answering this is cheap, read-only, and must happen BEFORE anything is stopped.
# service_upgrade asks first so a service whose state cannot be snapshotted is
# refused while it is still running, rather than after the stop -- and
# storage_pre_upgrade_point asks through the same function so the two can never
# disagree about what counts as protectable. There is one implementation of this
# check for the same reason the topology check has one: a second copy is how a
# stale invariant escapes review.
#
# Prints the service's data path on success. Everything else is a refusal.
assert_pre_upgrade_possible() {  # $1 = service -> prints data path
  local service="${1:-}" path
  [[ -n "$service" ]] || die "assert_pre_upgrade_possible: no service given"
  migrate_allowed_service "$service" \
    || die "Refusing: '$service' is not a service this command knows about"
  path="$(service_data_path "$service")" || die "No data path mapping for $service"
  [[ -n "$path" ]] || die "No data path mapping for $service"
  # A path that does not exist is NOT "nothing to protect": for a service that
  # should have state it means the mount is missing or the name is wrong, and
  # upgrading on top of that would create a fresh install.
  [[ -d "$path" ]] || die "Refusing: $path does not exist"
  domum_is_subvolume "$path" \
    || die "Refusing: $path is not a Btrfs subvolume, so no snapshot can be taken.
Migrate it first:  sudo domum-media storage migrate-subvolume $service"
  printf '%s\n' "$path"
}

storage_pre_upgrade_point() {  # $1 = service, [--archive-image]
  need_root
  load_cfg
  export_env_for_compose
  ensure_dirs

  local service="${1:-}" archive=0
  [[ "${2:-}" == "--archive-image" ]] && archive=1
  [[ -n "$service" ]] || die "Usage: domum-media storage pre-upgrade-point <service> [--archive-image]"

  local path
  path="$(assert_pre_upgrade_possible "$service")"

  domum_acquire_lock "pre-upgrade-point $service" 0     || die "Another domum-media operation holds the lock: $(domum_lock_holder)"

  local compose_svcs runtime_before images_before staged
  compose_svcs="$(service_compose_services "$service" || true)"
  runtime_before="$(service_runtime_state "$service")"
  images_before="$(service_running_images "$service")"
  migrate_stage preflight "service=$service path=$path runtime=$runtime_before"
  migrate_stage preflight "images: $(printf '%s' "$images_before" | tr '\n' ' ')"

  # Staged BEFORE the stop, so the running image is recorded while it is still
  # observably running -- the same ordering the migration uses.
  staged="$(stage_recovery_point_metadata "$service" "$runtime_before")"     || die "Could not stage recovery evidence; nothing has been touched."
  migrate_stage preflight "recovery evidence staged: $staged"

  local started=0
  migrate_restart() {
    (( started == 1 )) || return 0
    [[ -n "$compose_svcs" ]] || return 0
    # shellcheck disable=SC2086
    compose_cmd start $compose_svcs >/dev/null 2>&1 && return 0
    warn "Could not restart $compose_svcs with \`compose start\`."
    warn "NOT recreating: that resolves the image tag and could deploy the staged image."
    warn "$service is DOWN. Nothing was deleted and no snapshot was published."
    return 1
  }

  if [[ "$runtime_before" == "running" && -n "$compose_svcs" ]]; then
    migrate_stage stop "stopping $compose_svcs"
    # shellcheck disable=SC2086
    compose_cmd stop $compose_svcs || { rm -f "$staged"; die "Could not stop $compose_svcs"; }
    started=1
  fi

  # Application-consistent, or refuse. This is the gate the update path lacks.
  if ! migrate_assert_quiesced "$path"; then
    migrate_restart
    rm -f "$staged"
    die "Refusing: $path is not quiesced after the stop. No snapshot was taken."
  fi
  migrate_stage stop "quiesced: no open handles, no non-empty WAL, no hot journal"

  local proof
  if ! proof="$(create_service_snapshot "$service" "pre-upgrade" "" "")" || [[ -z "$proof" ]]; then
    migrate_restart
    rm -f "$staged"
    die "Could not create a pre-upgrade snapshot. Nothing was changed."
  fi
  migrate_stage proof "snapshot created: $DOMUM_SNAPSHOT_ROOT/$proof"

  # The archive, while the service is still stopped and the image still pinned by
  # its container. Failure here is fatal BEFORE the restart: a recovery point that
  # claims an archive it does not have is worse than one that admits it has none.
  local arch="" arch_sha=""
  if (( archive == 1 )); then
    local img
    img="$(printf '%s' "$images_before" | awk 'NR==1{print $2}')"
    [[ -n "$img" ]] || { migrate_restart; rm -f "$staged"; die "No image id to archive for $service"; }
    arch="$(image_archive_dir)/${service}-${img#sha256:}.tar"
    arch="${arch:0:200}"
    migrate_stage archive "saving $img -> $arch"
    if ! archive_image_to_file "$img" "$arch"; then
      migrate_restart; rm -f "$staged"
      die "Could not archive $img. The snapshot exists but no metadata was bound."
    fi
    arch_sha="$(cat "$arch.sha256")"
    migrate_stage archive "archived $(stat -c %s "$arch") bytes, sha256 ${arch_sha:0:16}…"
    printf "IMAGE_ARCHIVE='%s'\n" "$arch" >> "$staged"
    printf "IMAGE_ARCHIVE_SHA256='%s'\n" "$arch_sha" >> "$staged"
    printf "IMAGE_ARCHIVE_BYTES='%s'\n" "$(stat -c %s "$arch")" >> "$staged"
  fi
  printf "POINT_KIND='pre-upgrade'\n" >> "$staged"

  local meta
  if ! meta="$(bind_recovery_point_metadata "$staged" "$service" "$proof")"; then
    migrate_restart
    die "The snapshot exists at $DOMUM_SNAPSHOT_ROOT/$proof but recovery evidence
could not be bound to it. That is a DATA-only point. Investigate before upgrading."
  fi
  migrate_stage proof "recovery evidence: $meta"

  local restart_ok=1
  migrate_restart || restart_ok=0

  local runtime_after images_after
  runtime_after="$(service_runtime_state "$service")"
  images_after="$(service_running_images "$service")"
  [[ "$runtime_after" == "$runtime_before" ]]     && migrate_stage health "runtime state preserved: $runtime_after"     || warn "runtime state changed: $runtime_before -> $runtime_after"
  if [[ "$images_after" == "$images_before" ]]; then
    migrate_stage health "image unchanged -- nothing was deployed"
  else
    warn "$service IS RUNNING A DIFFERENT IMAGE than before:"
    warn "  before: $(printf '%s' "$images_before" | tr '\n' ' ')"
    warn "  after : $(printf '%s' "$images_after" | tr '\n' ' ')"
    restart_ok=0
  fi

  echo
  echo "[domum-media] Pre-upgrade recovery point for $service"
  echo "  snapshot        : $proof"
  echo "  recovery evidence: $meta"
  if (( archive == 1 )); then
    echo "  image archive   : $arch"
    echo "  archive sha256  : $arch_sha"
  else
    echo "  image archive   : none (re-run with --archive-image for a durable copy)"
  fi
  # Reported so an orchestrator binds its later phases to the EXACT artefacts
  # this produced, rather than re-deriving them from a name. No split of this
  # function was needed: domum_acquire_lock is re-entrant
  # (`[[ -n "${DOMUM_LOCK_FD:-}" ]] && return 0`), as are need_root, load_cfg and
  # ensure_dirs, so a caller already holding the lock can call this directly.
  PRE_UPGRADE_POINT="$proof"
  PRE_UPGRADE_META="$meta"
  PRE_UPGRADE_ARCHIVE="$arch"
  if (( restart_ok == 1 )); then
    echo "  service         : $runtime_after on the SAME image"
    echo
    echo "[domum-media] Pre-upgrade point COMPLETE. Nothing was deployed."
    return 0
  fi
  echo "[domum-media] Pre-upgrade point INCOMPLETE -- read the warnings above."
  return 1
}

# Every container that is NOT part this service, as "<name> <id> <image>".
# The scope proof for a single-service upgrade: captured before, compared after.
other_container_identities() {  # $1 = service being upgraded
  local service="$1" mine c
  mine=" $(service_compose_services "$service" 2>/dev/null || true) "
  while IFS= read -r c; do
    [[ -n "$c" ]] || continue
    [[ "$mine" == *" $c "* ]] && continue
    printf '%s %s %s\n' "$c" \
      "$(docker inspect -f '{{.Id}}' "$c" 2>/dev/null)" \
      "$(docker inspect -f '{{.Image}}' "$c" 2>/dev/null)"
  done < <(docker ps -a --format '{{.Names}}' | LC_ALL=C sort)
}

# Verify an image archive independently of any upgrade: the file is intact, and
# the identity it restores is the one recorded.
#
# The checksum and the identity are DIFFERENT claims and are reported as such.
# Measured on this host: the archive's config-blob digest does NOT equal the
# image ID (Id is the manifest digest), so a matching .sha256 proves only that
# the FILE is unchanged. `docker load` is what proves identity, and a load is a
# mutation, so this reports what it verified and what it did not.
storage_verify_archive() {  # $1 = recovery point
  need_root
  load_cfg
  local point="${1:-}" meta img arch want_sha got_sha bytes
  [[ -n "$point" ]] || die "Usage: domum-media storage verify-archive <recovery-point>"
  meta="$(snapshot_metadata_dir)/${point}.recovery"
  [[ -s "$meta" ]] || die "No recovery evidence for $point at $meta"

  img="$(sed -nE "s/^CONTAINER_1_IMAGE_ID='(.*)'\$/\1/p" "$meta" | head -1)"
  arch="$(sed -nE "s/^IMAGE_ARCHIVE='(.*)'\$/\1/p" "$meta" | head -1)"
  want_sha="$(sed -nE "s/^IMAGE_ARCHIVE_SHA256='(.*)'\$/\1/p" "$meta" | head -1)"
  bytes="$(sed -nE "s/^IMAGE_ARCHIVE_BYTES='(.*)'\$/\1/p" "$meta" | head -1)"

  echo "recovery point    : $point"
  echo "  service         : $(sed -nE "s/^SERVICE='(.*)'\$/\1/p" "$meta" | head -1)"
  echo "  kind            : $(sed -nE "s/^POINT_KIND='(.*)'\$/\1/p" "$meta" | head -1)"
  echo "  image id        : ${img:-<none recorded>}"
  if [[ -z "$arch" ]]; then
    echo "  image archive   : NONE recorded for this point"
    echo "  -> the snapshot restores the data; the application it pairs with exists"
    echo "     only as a local Docker object, which nothing here can guarantee."
    [[ -n "$img" ]] && docker image inspect "$img" >/dev/null 2>&1 \
      && echo "  local object    : present today" \
      || echo "  local object    : ABSENT -- this point has no recoverable application"
    return 1
  fi
  echo "  image archive   : $arch"
  if [[ ! -r "$arch" ]]; then
    echo "  archive         : MISSING from disk"
    return 1
  fi
  echo "  archive bytes   : $(stat -c %s "$arch") (recorded ${bytes:-?})"
  got_sha="$(sha256sum "$arch" | awk '{print $1}')"
  if [[ "$got_sha" != "$want_sha" ]]; then
    echo "  archive sha256  : MISMATCH"
    echo "    recorded      : $want_sha"
    echo "    on disk       : $got_sha"
    return 1
  fi
  echo "  archive sha256  : matches ($got_sha)"
  echo "  -> the FILE is intact. That is not the same as the identity it restores:"
  echo "     'docker load' is what proves the image id, and loading is a mutation,"
  echo "     so it is not done here. The rollback path does it and then compares."
  [[ -n "$img" ]] && docker image inspect "$img" >/dev/null 2>&1 \
    && echo "  local object    : present today (a load would be a no-op)" \
    || echo "  local object    : absent -- a rollback would load it from this archive"
  return 0
}

# Roll back an application upgrade: BOTH halves, or refuse.
#
# TASK-24. The existing auto-rollback restores the snapshot and brings the
# service back with `compose start` -- on the container the upgrade created, i.e.
# the NEW image. Old data under a newer application is the exact pairing failure
# the recovery evidence exists to prevent, and for Plex it means a newer build
# forward-migrating a database restored from before the upgrade.
#
# This restores the data AND pins the recorded image:
#   * the image id comes from the recovery evidence, never from a mutable tag;
#   * if that object is absent it is loaded from the archive, and the id that
#     comes back is COMPARED to the recorded one;
#   * the service is started with that id pinned via <SERVICE>_IMAGE, so compose
#     recreates onto the old image deliberately rather than resolving `:latest`;
#   * the failed state is PRESERVED, never deleted.
rollback_upgrade() {  # $1 = service, $2 = recovery point
  need_root
  load_cfg
  export_env_for_compose
  ensure_dirs

  local service="${1:-}" point="${2:-}"
  [[ -n "$service" && -n "$point" ]] \
    || die "Usage: domum-media rollback-upgrade <service> <recovery-point>"
  managed_image_specs | cut -d'|' -f1 | grep -qxF "$service" \
    || die "Refusing: '$service' is not a service this command knows about"

  local meta path snap want_img arch want_sha compose_svcs
  meta="$(snapshot_metadata_dir)/${point}.recovery"
  [[ -s "$meta" ]] || die "No recovery evidence for $point at $meta"
  path="$(service_data_path "$service")"
  snap="${DOMUM_SNAPSHOT_ROOT%/}/$point"
  [[ -d "$snap" ]] || die "The snapshot $snap is missing; this point cannot be restored"
  compose_svcs="$(service_compose_services "$service" || true)"
  [[ -n "$compose_svcs" ]] || die "No compose services mapped for $service"

  want_img="$(sed -nE "s/^CONTAINER_1_IMAGE_ID='(.*)'\$/\1/p" "$meta" | head -1)"
  arch="$(sed -nE "s/^IMAGE_ARCHIVE='(.*)'\$/\1/p" "$meta" | head -1)"
  want_sha="$(sed -nE "s/^IMAGE_ARCHIVE_SHA256='(.*)'\$/\1/p" "$meta" | head -1)"
  [[ -n "$want_img" ]] \
    || die "Refusing: $point records no image identity, so the application half of
this rollback is unknown. Restoring the data under whatever is running now is the
pairing failure this refuses to perform."

  echo "[domum-media] Rollback plan for $service"
  echo "  recovery point  : $point"
  echo "  restore data    : $snap -> $path"
  echo "  pin image       : $want_img"
  echo "  from archive    : ${arch:-<none; relying on the local object>}"

  domum_acquire_lock "rollback-upgrade $service" 0 \
    || die "Another domum-media operation holds the lock: $(domum_lock_holder)"

  # ---- 1. make the recorded image available, and PROVE it is the right one ----
  if docker image inspect "$want_img" >/dev/null 2>&1; then
    echo "[domum-media] 1/5: recorded image already present locally"
  elif [[ -n "$arch" && -r "$arch" ]]; then
    local got_sha loaded
    got_sha="$(sha256sum "$arch" | awk '{print $1}')"
    [[ "$got_sha" == "$want_sha" ]] \
      || die "The archive at $arch does not match its recorded sha256.
  recorded: $want_sha
  on disk : $got_sha
Refusing to load it. Nothing was changed."
    echo "[domum-media] 1/5: loading $want_img from $arch"
    loaded="$(docker load -i "$arch" 2>&1 | sed -nE 's/.*Loaded image ID: (sha256:[0-9a-f]+).*/\1/p' | head -1)"
    [[ "$loaded" == "$want_img" ]] \
      || die "The archive restored a DIFFERENT image than the point records.
  recorded: $want_img
  loaded  : ${loaded:-<none reported>}
Refusing to continue. Nothing was restored."
    echo "[domum-media] 1/5: loaded and identity CONFIRMED equal to the record"
  else
    die "Refusing: $want_img is not present locally and there is no readable
archive for $point. The data could be restored but the application it pairs with
could not, and starting it under a different build is the failure this prevents."
  fi

  # ---- 2. stop the current (failed) service, preserving its state ------------
  echo "[domum-media] 2/5: stopping $compose_svcs"
  # shellcheck disable=SC2086
  compose_cmd stop $compose_svcs || die "Could not stop $compose_svcs; nothing was restored"

  # ---- 3. preserve the failed state; never delete it ------------------------
  local failed stamp
  stamp="$(date +%Y%m%d-%H%M%S)" || die "cannot read the clock"
  failed="${path}.failed-${stamp}"
  echo "[domum-media] 3/5: preserving the current state at $failed"
  mv -- "$path" "$failed" || die "Could not move $path aside; nothing was restored"

  # ---- 4. restore the snapshot as the live tree -----------------------------
  echo "[domum-media] 4/5: restoring $point"
  if ! btrfs subvolume snapshot "$snap" "$path" >/dev/null 2>&1; then
    warn "Could not create a writable subvolume from $snap."
    mv -- "$failed" "$path" 2>/dev/null \
      && warn "The previous state was put back at $path." \
      || warn "CRITICAL: $path is missing and the previous state is at $failed."
    die "Rollback failed. Nothing was deleted."
  fi

  # ---- 5. start on the PINNED image, not on whatever the tag resolves to ----
  local image_var
  image_var="$(printf '%s_IMAGE' "$(uppercase_token "$service")")"
  echo "[domum-media] 5/5: starting $compose_svcs with $image_var=$want_img"
  # A deliberate recreate, pinned: this is the one place recreating is correct,
  # because the container that exists belongs to the image being rolled back FROM.
  #
  # The pin is an EXPORT IN A SUBSHELL, not `env VAR=... compose_cmd`: compose_cmd
  # is a shell function and `env` can only exec a real binary -- measured,
  # `env X=1 f` gives "env: 'f': No such file or directory", so that form would
  # have failed outright every time. The subshell keeps the override from leaking
  # into the rest of this function, and compose_cmd's own
  # export_env_for_compose uses `${PLEX_IMAGE:-default}`, so a value set first is
  # preserved rather than overwritten.
  # shellcheck disable=SC2086
  if ! ( export "$image_var=$want_img"; compose_cmd up -d $compose_svcs ); then
    warn "Could not start $compose_svcs on the restored image."
    warn "The restored data is at $path and the failed state at $failed."
    die "Rollback incomplete. Nothing was deleted."
  fi

  local now_img
  now_img="$(service_running_images "$service" | awk 'NR==1{print $2}')"
  echo
  if [[ "$now_img" == "$want_img" ]]; then
    echo "[domum-media] Rollback COMPLETE for $service."
    echo "  running image   : $now_img (the image the recovery point pairs with)"
    echo "  restored from   : $point"
    echo "  failed state    : $failed   (retained deliberately; remove it yourself)"
    return 0
  fi
  warn "$service came back on $now_img, not the recorded $want_img."
  echo "[domum-media] Rollback INCOMPLETE -- the data is restored but the application"
  echo "  does not match the recovery point. Failed state retained at $failed."
  return 1
}

# Every image archive on disk, and whether anything still needs it.
#
# Lifecycle, deliberately WITHOUT any automatic deletion:
#
#   a retained recovery point names the image  ->  the archive is NEEDED
#   no retained recovery point names it        ->  ORPHAN, eligible for operator
#                                                  review, never removed here
#
# This exists so the questions have answers that do not require reading two
# directories by hand: which point needs this, which image, which version, does
# the checksum still match, is the local Docker object still there, and is it
# safe to delete. An unmanaged pile of opaque tarballs is the failure mode.
storage_archives() {
  need_root
  load_cfg
  local dir meta_dir f base img point svc ver sha bytes want_sha n=0 orphans=0
  dir="$(image_archive_dir)"
  meta_dir="$(snapshot_metadata_dir)"

  if [[ ! -d "$dir" ]] || ! compgen -G "$dir/*.tar" >/dev/null 2>&1; then
    echo "No image archives in $dir."
    return 0
  fi

  for f in "$dir"/*.tar; do
    [[ -e "$f" ]] || continue
    n=$(( n + 1 ))
    base="$(basename "$f")"
    # Which retained recovery point names this archive? Ask the metadata, not the
    # filename -- the filename is a convenience, the metadata is the record.
    point=""; img=""; svc=""; ver=""
    while IFS= read -r m; do
      [[ -e "$m" ]] || continue
      if grep -qF "IMAGE_ARCHIVE='$f'" "$m"; then
        point="$(basename "$m" .recovery)"
        img="$(sed -nE "s/^CONTAINER_1_IMAGE_ID='(.*)'\$/\1/p" "$m" | head -1)"
        svc="$(sed -nE "s/^SERVICE='(.*)'\$/\1/p" "$m" | head -1)"
        # ..._IMAGE_LABEL_VERSION is what the writer emits. The obvious shorter
        # guess matches nothing and would have left the version silently blank
        # forever; tests/recovery-metadata-keys-audit.py now catches that class.
        ver="$(sed -nE "s/^CONTAINER_1_IMAGE_LABEL_VERSION='(.*)'\$/\1/p" "$m" | head -1)"
        want_sha="$(sed -nE "s/^IMAGE_ARCHIVE_SHA256='(.*)'\$/\1/p" "$m" | head -1)"
        break
      fi
    done < <(compgen -G "$meta_dir/*.recovery" || true)

    bytes="$(stat -c %s "$f" 2>/dev/null || echo 0)"
    echo "$base"
    echo "  path            : $f"
    echo "  bytes           : $bytes"
    if [[ -n "$point" ]]; then
      echo "  needed by       : $point   (service ${svc:-?})"
      echo "  image id        : ${img:-<not recorded>}"
      [[ -n "$ver" ]] && echo "  version         : $ver"
      sha="$(sha256sum "$f" | awk '{print $1}')"
      if [[ -n "$want_sha" && "$sha" == "$want_sha" ]]; then
        echo "  checksum        : matches the record"
      elif [[ -n "$want_sha" ]]; then
        echo "  checksum        : MISMATCH -- recorded $want_sha, on disk $sha"
      else
        echo "  checksum        : nothing recorded to compare against"
      fi
      if [[ -n "$img" ]] && docker image inspect "$img" >/dev/null 2>&1; then
        echo "  local object    : present (a rollback would not need this archive)"
      else
        echo "  local object    : ABSENT -- this archive is the only copy"
      fi
      echo "  safe to delete  : NO"
    else
      orphans=$(( orphans + 1 ))
      echo "  needed by       : nothing -- no retained recovery point names it"
      echo "  safe to delete  : operator review (nothing here deletes it)"
    fi
    echo
  done
  echo "$n archive(s), $orphans orphan(s). Nothing was deleted."
  return 0
}

# Upgrade ONE service, and prove it was one.
#
# This is deliberately NOT refresh_images. That function cannot take a service
# argument at all -- it dies on any positional -- and its scope is every service
# with ENABLE_*=1 and *_AUTO_UPDATE=1, pulling each. With staged images for plex,
# calibre-web, traefik and uptime-kuma, using it for a plex upgrade risks a
# four-service deployment. It also snapshots while the service RUNS and writes no
# recovery metadata, so its rollback point is crash-consistent and unpaired.
#
# Here, the pre-upgrade protection is not optional and not a separate operator
# step: the point is created, archived and verified under the same lock, and the
# staged image cannot start until that has succeeded.
service_upgrade() {  # $1 = service, [--dry-run]
  need_root
  load_cfg
  export_env_for_compose
  ensure_dirs

  local service="${1:-}" dry=0
  [[ "${2:-}" == "--dry-run" ]] && dry=1
  [[ -n "$service" ]] || die "Usage: domum-media updates apply --service <service> [--dry-run]"
  # Fail CLOSED on an unknown name. A typo must never widen to every service.
  managed_image_specs | cut -d'|' -f1 | grep -qxF "$service" \
    || die "Refusing: '$service' is not an upgradable service.
Known: $(managed_image_specs | cut -d'|' -f1 | tr '\n' ' ')"
  # Refuse while the service is still RUNNING if its state cannot be snapshotted.
  # The path it prints is not needed here, only the refusal -- and leaving its
  # stdout unredirected printed the data path into the operator's upgrade log.
  assert_pre_upgrade_possible "$service" >/dev/null

  local compose_svcs old_images staged_verdicts target_image others_before
  compose_svcs="$(service_compose_services "$service" || true)"
  [[ -n "$compose_svcs" ]] || die "No compose services mapped for $service"
  old_images="$(service_running_images "$service")"
  others_before="$(other_container_identities "$service")"

  # The target must already be local. Pulling here would resolve a mutable tag at
  # upgrade time and change what is being deployed between review and execution.
  staged_verdicts="$(service_staged_image_changes "$service")"
  # `|| true` is load-bearing. Under `set -euo pipefail` a `grep | awk` whose
  # grep matches NOTHING makes the pipeline return grep's 1 -- awk's own 0 is
  # discarded by pipefail -- so the assignment aborts the function. That made the
  # graceful "nothing to upgrade" branch below UNREACHABLE: with no staged image
  # the upgrade exited 1 with no message at all. Same family as the
  # `cmd | grep -q` rule in CLAUDE.md, found by running the code rather than
  # reading it.
  target_image="$(grep '^STAGED ' <<< "$staged_verdicts" | awk 'NR==1{print $4}' || true)"
  if [[ -z "$target_image" ]]; then
    echo "[domum-media] $service has no staged image locally; nothing to upgrade."
    echo "$staged_verdicts" | sed 's/^/  /'
    return 0
  fi

  echo "[domum-media] Upgrade plan for $service"
  echo "  compose services : $compose_svcs"
  echo "  from image       : $(printf '%s' "$old_images" | awk 'NR==1{print $2}')"
  echo "  to image         : $target_image"
  echo "  other containers : $(printf '%s' "$others_before" | grep -c .) will be left untouched"
  if (( dry == 1 )); then
    echo "[domum-media] --dry-run: nothing was changed."
    return 0
  fi

  domum_acquire_lock "upgrade $service" 0 \
    || die "Another domum-media operation holds the lock: $(domum_lock_holder)"
  verify_backup_freshness "$service"

  # ---- phase 1: the recovery point, archived, before anything is deployed ----
  echo "[domum-media] phase 1/4: pre-upgrade recovery point (with image archive)"
  if ! create_upgrade_rollback_point "$service"; then
    die "Pre-upgrade protection failed. The staged image was NOT deployed and
$service is on its original image. Nothing was deleted."
  fi
  local point="$PRE_UPGRADE_POINT" meta="$PRE_UPGRADE_META" arch="$PRE_UPGRADE_ARCHIVE"
  [[ -n "$point" && -n "$meta" && -n "$arch" ]] \
    || die "Pre-upgrade protection did not produce a point, metadata and an archive.
The staged image was NOT deployed."

  echo "[domum-media] phase 2/4: verifying the archive before deploying"
  storage_verify_archive "$point" \
    || die "The pre-upgrade archive did not verify. The staged image was NOT deployed."

  # ---- phase 3: deploy ONLY this service -------------------------------------
  echo "[domum-media] phase 3/4: deploying $target_image to $compose_svcs only"
  # shellcheck disable=SC2086
  compose_cmd up -d $compose_svcs \
    || die "Deployment failed. The pre-upgrade point $point is intact; see the
rollback instructions in $meta."

  # ---- phase 4: prove it ------------------------------------------------------
  echo "[domum-media] phase 4/4: verification"
  local rc=0 new_images others_after
  new_images="$(service_running_images "$service")"
  others_after="$(other_container_identities "$service")"

  if [[ "$(printf '%s' "$new_images" | awk 'NR==1{print $2}')" == "$target_image" ]]; then
    echo "  image           : $service is running the intended staged image"
  else
    warn "$service is NOT running the intended image:"
    warn "  intended: $target_image"
    warn "  actual  : $(printf '%s' "$new_images" | tr '\n' ' ')"
    rc=1
  fi

  # THE SCOPE PROOF. Every other container must be byte-identical, id and image.
  if [[ "$others_before" == "$others_after" ]]; then
    echo "  scope           : all $(printf '%s' "$others_before" | grep -c .) other containers unchanged (id and image)"
  else
    warn "OTHER SERVICES CHANGED. This was supposed to be a $service-only upgrade:"
    diff <(printf '%s\n' "$others_before") <(printf '%s\n' "$others_after") | sed 's/^/    /' >&2
    rc=1
  fi

  if wait_for_service_health "$service" 180 5; then
    echo "  health          : $(service_health_state "$service")"
  else
    warn "$service did not become healthy within 180s (state: $(service_health_state "$service"))."
    rc=1
  fi
  if service_ready_probe "$service" >/dev/null 2>&1; then
    local waited=0
    while (( waited < 180 )); do service_probe_ready "$service" && break; sleep 5; waited=$(( waited + 5 )); done
    if service_probe_ready "$service"; then
      echo "  application     : answered its endpoint, version $(service_probe_version "$service" 2>/dev/null)"
    else
      warn "$service never answered its own endpoint after the upgrade."
      rc=1
    fi
  fi

  # The pre-upgrade artefacts must still be exactly as created.
  domum_is_subvolume "$(service_data_path "$service")" \
    && echo "  storage         : still a Btrfs subvolume" \
    || { warn "$(service_data_path "$service") is no longer a subvolume"; rc=1; }
  [[ "$(btrfs property get -ts "$DOMUM_SNAPSHOT_ROOT/$point" 2>/dev/null | tr -d ' ')" == "ro=true" ]] \
    && echo "  pre-upgrade snap: $point still read-only" \
    || { warn "$point is not read-only any more"; rc=1; }
  storage_verify_archive "$point" >/dev/null \
    && echo "  image archive   : still verifies" \
    || { warn "the pre-upgrade archive no longer verifies"; rc=1; }

  # ---- the metadata-only cleanup proof ---------------------------------------
  # The old image is now unreferenced by any container, so this is the first time
  # recovery-metadata-only protection can be demonstrated in production. DRY RUN.
  echo "[domum-media] cleanup dry run (no --confirm): the old image must be withheld"
  local old_id
  old_id="$(printf '%s' "$old_images" | awk 'NR==1{print $2}')"
  # Two separate things, deliberately not one.
  #
  # cleanup_images_execute writes a HUMAN report, so its stdout is shown, never
  # captured: capturing a function that logs makes the log the value, which is
  # what tests/lib-stdout-purity-audit.py exists to catch -- and did catch here.
  cleanup_images_execute 1 0 || true
  # The CHECK reads the value-returning selector instead, and matches the whole
  # line rather than grepping prose.
  if collect_cleanup_image_ids 2>/dev/null | grep -qxF "$old_id"; then
    warn "THE OLD IMAGE IS A DELETION CANDIDATE: $old_id"
    warn "Its recovery point depends on it. Do NOT run cleanup --confirm."
    rc=1
  else
    echo "  old image       : $old_id withheld from cleanup (metadata-only protection)"
  fi

  echo
  if (( rc == 0 )); then
    echo "[domum-media] Upgrade COMPLETE for $service."
    echo "  rollback point  : $point   ($meta)"
    echo "  old image       : $old_id, archived at $arch"
    echo "  To roll back:    sudo domum-media rollback-upgrade $service $point"
    return 0
  fi
  echo "[domum-media] Upgrade INCOMPLETE for $service -- read the warnings above."
  echo "  Nothing was deleted. The pre-upgrade point $point and its archive are intact."
  echo "  To roll back:    sudo domum-media rollback-upgrade $service $point"
  return 1
}

# Always archived. A named shim so the orchestrator cannot accidentally create an
# UNARCHIVED point: for an upgrade the archive is the half that makes the point a
# rollback rather than a museum piece, and `--archive-image` being optional on the
# standalone command must not leak into the upgrade path as a default.
create_upgrade_rollback_point() {  # $1 = service
  storage_pre_upgrade_point "$1" --archive-image
}

storage_verify_recovery() {  # $1 = service, $2 = recovery point, [--deep]
  local service="${1:-}" point="${2:-}" deep=0 meta problem n ident avail img ref ver
  [[ "${3:-}" == "--deep" ]] && deep=1
  [[ -n "$service" && -n "$point" ]] \
    || die "Usage: domum-media storage verify-recovery <service> <recovery-point> [--deep]"
  meta="$(snapshot_metadata_dir)/${point}.recovery"

  if [[ ! -s "$meta" ]]; then
    echo "recovery evidence : MISSING for $point"
    echo "  expected at     : $meta"
    echo "  A filesystem snapshot without it is a DATA recovery point only: which"
    echo "  application wrote the state is not recorded, so restoring it under a"
    echo "  different one is untested."
    return 1
  fi

  if ! problem="$(verify_recovery_point_metadata "$meta" "$service" "$point")"; then
    echo "recovery evidence : NOT USABLE -- $problem"
    echo "  file            : $meta"
    return 1
  fi

  echo "recovery evidence : $meta"
  echo "  service         : $service"
  echo "  recovery point  : $point"
  echo "  runtime before  : $(sed -nE "s/^RUNTIME_STATE_BEFORE='(.*)'\$/\1/p" "$meta" | head -1)"
  echo "  captured at     : $(sed -nE "s/^CAPTURED_AT='(.*)'\$/\1/p" "$meta" | head -1)"
  n=1
  while grep -q "^CONTAINER_${n}_SERVICE=" "$meta"; do
    ident="$(sed -nE "s/^CONTAINER_${n}_IMAGE_IDENTITY='(.*)'\$/\1/p" "$meta" | head -1)"
    avail="$(sed -nE "s/^CONTAINER_${n}_IMAGE_AVAILABILITY='(.*)'\$/\1/p" "$meta" | head -1)"
    img="$(sed -nE "s/^CONTAINER_${n}_IMAGE_ID='(.*)'\$/\1/p" "$meta" | head -1)"
    ref="$(sed -nE "s/^CONTAINER_${n}_IMAGE_REF='(.*)'\$/\1/p" "$meta" | head -1)"
    ver="$(sed -nE "s/^CONTAINER_${n}_IMAGE_LABEL_VERSION='(.*)'\$/\1/p" "$meta" | head -1)"
    echo "  container $n"
    echo "    service       : $(sed -nE "s/^CONTAINER_${n}_SERVICE='(.*)'\$/\1/p" "$meta" | head -1)"
    echo "    image id      : ${img:-<none>}"
    echo "    created from  : ${ref:-<none>}   (MUTABLE: may point elsewhere now)"
    echo "    version label : ${ver:-<none>}"
    echo "    identity      : $ident"
    echo "    availability  : ${avail:-unknown}"
    # Says what each value means, because the whole point is that they are
    # different claims and only one of them is about getting the image back.
    case "$avail" in
      *registry-digest*) echo "      -> an immutable registry reference is recorded" ;;
      *local*)           echo "      -> the object is on THIS HOST today; no immutable reference for later" ;;
      identity)          echo "      -> identified only; not present locally and no registry reference" ;;
      *)                 echo "      -> nothing recorded; pairing is unknown" ;;
    esac
    # Is that image still here, now, rather than when the evidence was written?
    if [[ -n "$img" ]]; then
      if cmd_exists docker && docker image inspect "$img" >/dev/null 2>&1; then
        echo "    present now   : yes"
      else
        echo "    present now   : NO -- the recorded image is no longer on this host"
      fi
    fi
    n=$(( n + 1 ))
  done

  # --deep re-proves the INTEGRITY claim for a recovery point that already
  # exists: .premigration == the proof snapshot, plus the SQLite checks. Without
  # it the only way to re-run that proof was to re-run a migration, which is not
  # something you can do twice -- so a false negative (plex's databases reported
  # as failed because this host's SQLite lacks Plex's `collating` tokenizer) left
  # no way to reach a clean verdict.
  if (( deep == 1 )); then
    echo
    local prem proof_path
    prem="$(service_data_path "$service" 2>/dev/null || true).premigration"
    proof_path="${DOMUM_SNAPSHOT_ROOT%/}/$point"
    if [[ ! -d "$prem" ]]; then
      echo "deep verification : NOT POSSIBLE -- $prem is gone"
      echo "  The integrity claim compares the preserved original against the proof"
      echo "  snapshot. Once .premigration is removed that comparison cannot be redone."
      return 1
    fi
    if ! migrate_verify_recovery_point "$prem" "$proof_path" "$service"; then
      echo "deep verification : FAILED -- see the warnings above"
      return 1
    fi
    echo "deep verification : integrity re-proven ($prem == $proof_path)"
  fi
  return 0
}

# The STABLE capability contract for operator scripts.
#
# WHY IT EXISTS. The Plex upgrade wrapper feature-detected by grepping the
# installed binary for private Bash function names:
#
#   for fn in service_upgrade rollback_upgrade make_pre_upgrade_point ...; do
#     grep -q "^$fn()" /usr/local/bin/domum-media || abort ...
#
# `make_pre_upgrade_point` was a helper from a refactor that was abandoned, so it
# never existed in any merged revision and the wrapper aborted a correct
# production state. That is the same failure shape as the wrapper that grepped
# for the prose `recovery point  : verified`, and as the stale topology
# invariant: a script asserting on something that was never a contract.
#
# A capability token is a promise about BEHAVIOUR. Private function names,
# dispatcher wiring and prose may all change freely underneath it.
#
# Each row is  <token>|<argv path>|<implementation>:
#   token           what operator scripts name. Stable. Never renamed in place.
#   argv path       the supported invocation. tests/capabilities-contract-audit.py
#                   proves the dispatcher actually routes it to the
#                   implementation, so a capability cannot advertise something
#                   that is not reachable from the command line.
#   implementation  checked at RUN TIME with `declare -F`, so a token disappears
#                   if its implementation does. This is the half that the static
#                   audit cannot cover on the operator's host: it tells the
#                   script about the binary that is actually installed.
domum_capability_specs() {
  cat <<'EOF'
service-scoped-upgrade|updates apply --service|service_upgrade
pre-upgrade-point|storage pre-upgrade-point|storage_pre_upgrade_point
archive-image|storage pre-upgrade-point --archive-image|archive_image_to_file
verify-image-archive|storage verify-archive|storage_verify_archive
image-archive-inventory|storage archives|storage_archives
rollback-upgrade|rollback-upgrade|rollback_upgrade
recovery-image-protection|cleanup images|cleanup_protected_image_ids
machine-readable-cleanup-images|cleanup images --json|cleanup_images_json
verify-recovery-deep|storage verify-recovery|storage_verify_recovery
topology-verify|storage topology --verify|storage_topology_verify
EOF
}

# Read-only, and deliberately does NOT require root: a preflight must be able to
# ask what the installed binary supports before escalating.
capabilities_cmd() {
  local mode="${1:-list}" want="" token impl
  case "$mode" in
    list) ;;
    --has)
      want="${2:-}"
      [[ -n "$want" ]] || die "Usage: domum-media capabilities [--has <token>]" ;;
    *) die "Usage: domum-media capabilities [--has <token>]" ;;
  esac

  local known=0 supported=0
  # The argv field is for tests/capabilities-contract-audit.py to read from the
  # table; run time only needs the token and its implementation.
  while IFS='|' read -r token _ impl; do
    [[ -n "$token" ]] || continue
    if [[ -n "$want" ]]; then
      [[ "$token" == "$want" ]] || continue
      known=1
      declare -F "$impl" >/dev/null 2>&1 && supported=1
      break
    fi
    # Listing advertises only what is actually present in THIS binary.
    declare -F "$impl" >/dev/null 2>&1 && printf '%s\n' "$token"
  done < <(domum_capability_specs)

  if [[ -n "$want" ]]; then
    # An unknown token and a known-but-missing one are both "not supported", and
    # both must be non-zero: a script asking about a token this binary has never
    # heard of must not read that as a yes.
    (( known == 1 )) || return 2
    (( supported == 1 )) || return 1
  fi
  return 0
}

storage_cmd() {
  local sub="${1:-}"
  case "$sub" in
    migrate-subvolume) shift; storage_migrate_subvolume "$@" ;;
    topology)
      shift
      # Read-only. Deliberately does NOT require root: a deployment captures this
      # before and after, and both captures must run the same code -- if this
      # needed privilege the pre-capture could silently differ from the post one.
      # The capture records which detector produced it, so a mismatch is reported
      # rather than silently diffed.
      load_cfg
      case "${1:-}" in
        "")        storage_topology ;;
        --verify)  [[ -n "${2:-}" ]] || die "Usage: domum-media storage topology --verify <capture-file>"
                   storage_topology_verify "$2" ;;
        *)         die "Usage: domum-media storage topology [--verify <capture-file>]" ;;
      esac ;;
    protection)
      shift
      # Read-only. Prints the state word and exits 0 only when `protected`, so an
      # operator script tests the command rather than matching its prose.
      load_cfg
      storage_protection "${1:-}" ;;
    verify-recovery)
      shift
      # Read-only, and deliberately does not require root beyond reading the state
      # directory, so an operator can ask months later what a point is paired with.
      load_cfg
      storage_verify_recovery "${1:-}" "${2:-}" "${3:-}" ;;
      pre-upgrade-point)
        shift
        # Deploys nothing: stop, prove quiescence, snapshot, archive the EXACT
        # running image, bind metadata, restart the same container on the same
        # image. The complete rollback artifact for a later upgrade.
        storage_pre_upgrade_point "${1:-}" "${2:-}" ;;
      verify-archive)
        shift
        # Read-only. Checks the archive FILE against its recorded sha256 and
        # says plainly that this is not the same claim as image identity.
        storage_verify_archive "${1:-}" ;;
      archives)
        shift
        # Read-only inventory: which recovery point needs each archive, and
        # which are orphans. Deletes nothing.
        storage_archives ;;
    *) die "Usage: domum-media storage {migrate-subvolume <service>|topology [--verify <file>]|protection [service]|verify-recovery <service> <point> [--deep]|pre-upgrade-point <service> [--archive-image]|verify-archive <point>|archives}" ;;
  esac
}

# ---- operational reporting -------------------------------------------------

REPORT_LIB_DEFAULT="/usr/local/lib/domum-media/domum-media-report"

# The report helpers live in a separate file so they can reuse this CLI's
# canonical config and service inventory functions. Sourced lazily so a missing
# helper cannot break unrelated commands.
load_report_lib() {
  local lib="${DOMUM_REPORT_LIB:-}"
  if [[ -z "$lib" ]]; then
    if [[ -r "$REPORT_LIB_DEFAULT" ]]; then
      lib="$REPORT_LIB_DEFAULT"
    elif [[ -r "$DOMUM_DIR/bin/domum-media-report" ]]; then
      lib="$DOMUM_DIR/bin/domum-media-report"
    fi
  fi
  [[ -n "$lib" && -r "$lib" ]] \
    || die "Report library not found (looked in $REPORT_LIB_DEFAULT and $DOMUM_DIR/bin/domum-media-report)"
  # shellcheck disable=SC1090
  source "$lib"
}

# Reporting reads root-owned runtime state under $DOMUM_STATE_ROOT and the live
# config, so it requires root. Running unprivileged would silently degrade every
# probe to "unknown", which is worse than refusing.
report_entry() {
  need_root
  load_report_lib
  report_cmd "$@"
}

usage() {
  cat <<EOF
domum-media (domum-core-media)

Usage:
  domum-media init
  domum-media configure
  domum-media apply
  domum-media status [--counts]
  domum-media update
  domum-media updates {summary|check|apply [--service <service> [--dry-run]]|history}
                                            apply --service upgrades ONE service,
                                            with pre-upgrade protection it cannot
                                            skip. Bare apply is the fleet path
                                            and cannot target one service
  domum-media refresh-images [--force] [--check-only] [--apply-now]
  domum-media host-upgrade [--force]
  domum-media logs <service>
  domum-media backup {init <target> [--adopt-existing]|plan <target>|verify <target>|verify-restore <target>|adopt-repo <target>|--check|--check-deep [repo]|--restore <snapshot> <target>}
  domum-media snapshot {create [tag]|list|prune}
  domum-media rollback {list|show <id>|apply <id> [--dry-run]}
  domum-media rollback-upgrade <service> <recovery-point>
                                            Undo an application upgrade: restores
                                            the pre-upgrade state AND the exact
                                            image it pairs with, loading it from
                                            the archive if needed. Refuses if the
                                            identity cannot be matched
  domum-media checkup [--json]
  domum-media report [--json|--write]
  domum-media storage migrate-subvolume <service>
  domum-media storage topology              Deterministic inventory of managed
                                            subvolumes and snapshots. Capture it
                                            before an operation, then verify,
                                            rather than asserting an absolute
                                            state
  domum-media storage protection [service]  Whether a service is actually
                                            protected: protected,
                                            snapshottable, degraded,
                                            unprotected or unknown. Exits 0 only
                                            for "protected"
  domum-media storage verify-recovery <service> <point> [--deep]
  domum-media storage archives              Which recovery point needs each
                                            image archive, and which are
                                            orphans. Deletes nothing
  domum-media storage verify-archive <point>
                                            Whether a recovery point's image
                                            archive is intact, and what that does
                                            and does not prove
  domum-media storage pre-upgrade-point <service> [--archive-image]
                                            Application-consistent recovery point
                                            for a later upgrade: stop, prove
                                            quiescence, snapshot, archive the
                                            exact running image, bind metadata,
                                            restart the SAME image. Deploys
                                            nothing
                                            What application image a recovery
                                            point is paired with, and whether that
                                            image can still be obtained
  domum-media storage topology --verify <file>
                                            Compare a saved capture against the
                                            live topology. 0 unchanged, 1 changed
                                            (naming each difference), 2 not
                                            comparable
  domum-media compose <docker compose arguments...>
                                            Run docker compose with this
                                            installation's fragment layering
                                            (there is no compose.yml to use
                                            directly)
  domum-media cleanup {summary|images [--json]|snapshots} [--dry-run|--confirm]
  domum-media capabilities [--has <token>]
  domum-media recovery-pack {create [--no-email]|status}
  domum-media doctor {immich|traefik|backups|secrets|navidrome}
  domum-media immich {refresh-bundle [--force]|check-bundle|apply-bundle|rollback|reset-db [--wipe-uploads]}

Config:  $CFG_FILE
Secrets: $SECRETS_DIR
Env:     DOMUM_DIR=$DOMUM_DIR
EOF
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    init)      shift; init_host "$@" ;;
    configure) shift; configure_cmd "$@" ;;
    apply)     shift; apply "$@" ;;
    status)    shift; status "$@" ;;
    update)    shift; repo_update "$@" ;;
    rollback-upgrade)
      shift
      # Restores BOTH halves: the pre-upgrade data AND the exact recorded image,
      # loaded from its archive if the local object is gone. Refuses rather than
      # pairing old data with a newer application (task-24).
      rollback_upgrade "${1:-}" "${2:-}" ;;
    updates)   shift; updates_cmd "$@" ;;
    refresh-images) shift; refresh_images "$@" ;;
    host-upgrade) shift; host_upgrade "$@" ;;
    logs)      shift; logs_cmd "$@" ;;
    backup)    backup_cmd "$@" ;;
    snapshot)  shift; snapshot_cmd "$@" ;;
    rollback)  shift; rollback_cmd "$@" ;;
    checkup)   shift; checkup_cmd "$@" ;;
    report)    shift; report_entry "$@" ;;
    storage)   shift; storage_cmd "$@" ;;
    compose)   shift; compose_passthrough "$@" ;;
    cleanup)   shift; cleanup_cmd "$@" ;;
    capabilities)
      shift
      # The stable surface operator scripts assert on instead of grepping this
      # file for private function names. Read-only; no root.
      capabilities_cmd "${1:-list}" "${2:-}" ;;
    recovery-pack) shift; recovery_pack_cmd "$@" ;;
    doctor)    shift; doctor_cmd "$@" ;;
    immich)    shift; immich_cmd "$@" ;;
    -h|--help|help|"") usage ;;
    *) usage; exit 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
