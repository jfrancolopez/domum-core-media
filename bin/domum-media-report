#!/usr/bin/env bash

# Read-only operational reporting helpers. This file is sourced by domum-media
# so it can reuse the canonical config and service inventory functions.

# Bash RETURN traps are global, not stacked: a trap set inside a nested
# function replaces the caller's, leaking the caller's temporaries and then
# re-firing with out-of-scope variables (fatal under `set -u`). Register
# temporaries here and clean them from a single trap in report_cmd.
REPORT_TMP_PATHS=()

report_tmp_register() {
  REPORT_TMP_PATHS+=("$1")
  printf '%s' "$1"
}

report_tmp_cleanup() {
  local path
  for path in "${REPORT_TMP_PATHS[@]:-}"; do
    [[ -n "$path" ]] && rm -rf -- "$path"
  done
  REPORT_TMP_PATHS=()
}

report_iso_from_epoch() {
  local epoch="${1:-}"
  [[ "$epoch" =~ ^[0-9]+$ ]] || { printf 'null'; return; }
  date -d "@$epoch" --iso-8601=seconds 2>/dev/null | jq -R . || printf 'null'
}

report_age_seconds() {
  local epoch="${1:-}" now="${REPORT_NOW_EPOCH:-}"
  [[ "$epoch" =~ ^[0-9]+$ ]] || { printf 'null'; return; }
  # Tolerate being called outside report_generate_json: an unset reference
  # would be fatal under `set -u` and emit invalid JSON into --argjson.
  [[ "$now" =~ ^[0-9]+$ ]] || now="$(date +%s)"
  if (( now >= epoch )); then
    printf '%s' "$(( now - epoch ))"
  else
    printf '0'
  fi
}

# A DIRECTORY's mtime changes only when its own entries change, so it says
# nothing about the freshness of content written deeper inside it. Reporting it
# as an "age" invites the reader to conclude the data is stale when it is not.
# Directories therefore report a null age and carry their mtime under a name
# that states what it actually is.
report_file_details() {
  local path="$1" size epoch kind
  if [[ ! -e "$path" ]]; then
    jq -cn --arg path "$path" \
      '{state:"missing",kind:"missing",path:$path,size_bytes:null,modified_at:null,age_seconds:null,path_mtime:null,age_basis:null}'
    return
  fi
  size="$(du -sb -- "$path" 2>/dev/null | awk '{print $1}' || true)"
  epoch="$(stat -c %Y -- "$path" 2>/dev/null || true)"
  if [[ -d "$path" ]]; then
    jq -cn \
      --arg path "$path" \
      --argjson size "${size:-null}" \
      --argjson mtime "$(report_iso_from_epoch "$epoch")" \
      '{state:"available",kind:"directory",path:$path,size_bytes:$size,
        modified_at:null,age_seconds:null,path_mtime:$mtime,
        age_basis:"directory mtime only; it does not reflect the freshness of content inside"}'
    return
  fi
  kind="file"
  jq -cn \
    --arg path "$path" --arg kind "$kind" \
    --argjson size "${size:-null}" \
    --argjson modified "$(report_iso_from_epoch "$epoch")" \
    --argjson age "$(report_age_seconds "$epoch")" \
    '{state:"available",kind:$kind,path:$path,size_bytes:$size,modified_at:$modified,
      age_seconds:$age,path_mtime:$modified,age_basis:"file mtime"}'
}

# Query exactly one property per call. `systemctl show` returns properties in
# its own internal order, not the order they were requested, so parsing a
# multi-property --value block positionally silently swaps fields.
# NOTE on jq object construction below: `{a: (x|select(...))}` produces NO
# output at all when the select matches nothing, silently discarding the entire
# object. Every optional field therefore needs an explicit `// null` guard.
report_systemd_property() {
  local unit="$1" property="$2" value
  value="$(systemctl show "$unit" --property="$property" --value 2>/dev/null || true)"
  [[ "$value" == "n/a" ]] && value=""
  printf '%s' "$value"
}

report_systemd_state() {
  local timer="$1" service="$2" enabled active
  if ! cmd_exists systemctl; then
    jq -cn --arg timer "$timer" --arg service "$service" \
      '{timer:$timer,service:$service,enabled:"unknown",active:"unknown",last_trigger:null,next_trigger:null,result:"unknown",service_started_at:null,service_finished_at:null}'
    return
  fi
  enabled="$(systemctl is-enabled "$timer" 2>/dev/null || true)"
  active="$(systemctl is-active "$timer" 2>/dev/null || true)"
  jq -cn \
    --arg timer "$timer" --arg service "$service" \
    --arg enabled "${enabled:-unknown}" --arg active "${active:-unknown}" \
    --arg last "$(report_systemd_property "$timer" LastTriggerUSec)" \
    --arg next "$(report_systemd_property "$timer" NextElapseUSecRealtime)" \
    --arg result "$(report_systemd_property "$service" Result)" \
    --arg started "$(report_systemd_property "$service" ExecMainStartTimestamp)" \
    --arg finished "$(report_systemd_property "$service" ExecMainExitTimestamp)" \
    '{timer:$timer,service:$service,enabled:$enabled,active:$active,
      last_trigger:($last|select(length>0 and .!="n/a") // null),next_trigger:($next|select(length>0 and .!="n/a") // null),
      result:($result|select(length>0) // "unknown"),service_started_at:($started|select(length>0 and .!="n/a") // null),
      service_finished_at:($finished|select(length>0 and .!="n/a") // null)}'
}

report_container_specs() {
  while IFS='|' read -r logical enable_var _ _ compose_services image_var _; do
    [[ "${!enable_var:-0}" == "1" ]] || continue
    local compose_service configured_var
    for compose_service in $compose_services; do
      configured_var="$image_var"
      case "$compose_service" in
        immich_machine_learning) configured_var=IMMICH_MACHINE_LEARNING_IMAGE ;;
        immich_redis) configured_var=IMMICH_REDIS_IMAGE ;;
        immich_postgres) configured_var=IMMICH_POSTGRES_IMAGE ;;
      esac
      printf '%s|%s|%s\n' "$logical" "$compose_service" "${!configured_var:-unknown}"
    done
  done < <(service_lifecycle_specs)
  if [[ "${ENABLE_RESTIC_REST_SERVER:-0}" == "1" ]]; then
    printf 'restic-rest-server|restic-rest-server|%s\n' "${RESTIC_REST_SERVER_IMAGE:-restic/rest-server:latest}"
  fi
}

report_container() {
  local logical="$1" name="$2" configured="$3" inspect="" available_id="" running=null health=unknown restarts=null running_id=""
  if cmd_exists docker; then
    running=false
    inspect="$(docker inspect --format '{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}|{{.RestartCount}}|{{.Image}}' "$name" 2>/dev/null || true)"
    if [[ -n "$inspect" ]]; then
      local status restart_raw
      IFS='|' read -r status health restart_raw running_id <<< "$inspect"
      # Docker reports no Health object when the image defines no healthcheck.
      # "none" reads like a problem; say what it actually means.
      [[ "$health" == "none" ]] && health="no healthcheck"
      [[ "$status" == "running" ]] && running=true
      [[ "$restart_raw" =~ ^[0-9]+$ ]] && restarts="$restart_raw"
    else
      health=missing
    fi
    available_id="$(docker image inspect --format '{{.Id}}' "$configured" 2>/dev/null || true)"
  fi
  local match=null
  [[ -n "$running_id" && -n "$available_id" ]] && { match=false; [[ "$running_id" == "$available_id" ]] && match=true; }
  jq -cn --arg service "$logical" --arg name "$name" --arg configured "$configured" \
    --arg health "$health" --arg running_id "$running_id" --arg available_id "$available_id" \
    --argjson running "$running" --argjson restarts "$restarts" --argjson match "$match" \
    '{service:$service,name:$name,running:$running,health:$health,restart_count:$restarts,
      image:{configured:$configured,running_id:($running_id|select(length>0) // null),available_id:($available_id|select(length>0) // null),matches_available:$match}}'
}

report_filesystem() {
  local path="$1" row
  row="$(df -B1 -P -- "$path" 2>/dev/null | awk 'NR==2 {gsub("%","",$5); print $2, $3, $4, $5}' || true)"
  if [[ -z "$row" ]]; then
    jq -cn --arg path "$path" '{path:$path,state:"unknown",total_bytes:null,used_bytes:null,available_bytes:null,used_percent:null}'
    return
  fi
  local total used available percent
  read -r total used available percent <<< "$row"
  jq -cn --arg path "$path" --argjson total "$total" --argjson used "$used" \
    --argjson available "$available" --argjson percent "$percent" \
    '{path:$path,state:"available",total_bytes:$total,used_bytes:$used,available_bytes:$available,used_percent:$percent}'
}

# The CLI already encodes a risk tier: service_strict_backup_required is true
# only for services whose loss is not acceptable (Immich). Reuse it rather than
# inventing a second opinion about which state matters.
report_service_tier() {
  if declare -F service_strict_backup_required >/dev/null 2>&1 \
     && service_strict_backup_required "$1" >/dev/null 2>&1; then
    printf 'strict'
  else
    printf 'standard'
  fi
}

report_snapshot_protection() {
  local service="$1" path="$2" state reason latest="" latest_epoch="" tier
  tier="$(report_service_tier "$service")"
  if [[ ! -d "$path" ]]; then
    state=unknown; reason="state path is missing"
  elif ! cmd_exists btrfs; then
    state=unknown; reason="btrfs tool unavailable"
  elif btrfs subvolume show "$path" >/dev/null 2>&1; then
    state=protected; reason="state path is a Btrfs subvolume"
    latest="$(latest_snapshot_for_service "$service" 2>/dev/null || true)"
    [[ -n "$latest" ]] && latest_epoch="$(snapshot_path_mtime "$DOMUM_SNAPSHOT_ROOT/$latest" 2>/dev/null || true)"
  else
    state=unprotected; reason="state path is an ordinary directory, not a Btrfs subvolume"
  fi
  jq -cn --arg service "$service" --arg path "$path" --arg state "$state" --arg reason "$reason" \
    --arg tier "$tier" \
    --arg latest "$latest" --argjson latest_at "$(report_iso_from_epoch "$latest_epoch")" \
    --argjson age "$(report_age_seconds "$latest_epoch")" \
    '{service:$service,path:$path,state:$state,reason:$reason,tier:$tier,latest_snapshot:($latest|select(length>0) // null),latest_snapshot_at:$latest_at,latest_snapshot_age_seconds:$age}'
}

report_update_candidate() {
  local kind="$1" service="$2" file="$3" first_seen="" candidate=""
  if [[ "$kind" == "immich" ]]; then
    unset IMMICH_BUNDLE_TAG FIRST_SEEN_TS
    # shellcheck disable=SC1090
    source "$file"
    first_seen="${FIRST_SEEN_TS:-}"
    candidate="${IMMICH_BUNDLE_TAG:-unknown}"
  else
    unset CANDIDATE_DIGEST SEEN_IMAGE_ID FIRST_SEEN_TS
    # shellcheck disable=SC1090
    source "$file"
    first_seen="${FIRST_SEEN_TS:-}"
    candidate="${CANDIDATE_DIGEST:-${SEEN_IMAGE_ID:-unknown}}"
  fi
  jq -cn --arg kind "$kind" --arg service "$service" --arg candidate "$candidate" \
    --argjson first_seen_at "$(report_iso_from_epoch "$first_seen")" \
    --argjson age "$(report_age_seconds "$first_seen")" \
    '{kind:$kind,service:$service,candidate:$candidate,first_seen_at:$first_seen_at,age_seconds:$age}'
}

report_latest_backup_snapshot() {
  local target="$1" output="" state=unknown
  if [[ -x "$DOMUM_DIR/bin/domum-media-backup" ]] && cmd_exists timeout; then
    output="$(timeout 20 "$DOMUM_DIR/bin/domum-media-backup" --latest-snapshot-json "$target" 2>/dev/null || true)"
  fi
  if jq -e 'type == "object"' >/dev/null 2>&1 <<< "$output"; then
    jq -c --arg target "$target" '{target:$target,state:"available",snapshot:.}' <<< "$output"
  else
    jq -cn --arg target "$target" --arg state "$state" '{target:$target,state:$state,snapshot:null}'
  fi
}

# Per-target evidence. The daily backup writes a single aggregate heartbeat and
# no per-target run result, so last_run is reported as unknown rather than
# inferred from the aggregate. Repository identity pinning is real state and is
# reported from the metadata file's presence only; its contents are never read
# into the report.
report_backup_target_state() {
  local target="$1" meta meta_dir run_file identity=unknown
  meta_dir="${REPO_META_DIR:-$DOMUM_STATE_ROOT/backups}"
  meta="$meta_dir/$target-repo.env"
  run_file="$meta_dir/$target-run.env"
  if [[ -r "$meta" ]]; then
    identity=pinned
  elif [[ -e "$meta" ]]; then
    identity=unreadable
  elif [[ -r "$meta_dir" ]]; then
    identity=missing
  fi

  # Per-target run evidence, written by the backup wrapper after each target.
  # Absent evidence stays "unknown"; it is never inferred from the aggregate
  # heartbeat, which cannot attribute a result to one target.
  local last_run
  if [[ -r "$run_file" ]]; then
    local r_result r_finished r_snapshot r_paths r_missing r_epoch=""
    eval "$(
      unset RESULT FINISHED_TS SNAPSHOT_ID PATHS PATHS_MISSING
      # shellcheck disable=SC1090
      . "$run_file" >/dev/null 2>&1 || true
      printf 'r_result=%q\nr_finished=%q\nr_snapshot=%q\nr_paths=%q\nr_missing=%q\n' \
        "${RESULT:-}" "${FINISHED_TS:-}" "${SNAPSHOT_ID:-}" "${PATHS:-}" "${PATHS_MISSING:-}"
    )"
    [[ -n "$r_finished" ]] && r_epoch="$(date -d "$r_finished" +%s 2>/dev/null || true)"
    case "$r_result" in
      success) r_result="ok" ;;
      failure) r_result="failed" ;;
      # A run that started and never recorded an outcome: still in flight, or
      # killed/aborted. Never report it as ok.
      running) r_result="incomplete" ;;
      *)       r_result="unknown" ;;
    esac
    last_run="$(jq -cn --arg state "$r_result" --arg snapshot "$r_snapshot" \
      --arg paths "$r_paths" --arg missing "$r_missing" \
      --argjson at "$(report_iso_from_epoch "$r_epoch")" \
      --argjson age "$(report_age_seconds "$r_epoch")" \
      '{state:$state,at:$at,age_seconds:$age,
        snapshot_id:($snapshot|select(length>0) // null),
        paths:(($paths|select(length>0)|split(" ")) // null),
        paths_missing:(($missing|select(length>0)|split(" ")) // null),
        reason:null}')"
  else
    last_run='{"state":"unknown","at":null,"age_seconds":null,"snapshot_id":null,"paths":null,"paths_missing":null,"reason":"no per-target run result has been recorded for this target yet"}'
  fi

  jq -cn --arg target "$target" --arg identity "$identity" --arg path "$meta" \
    --argjson last_run "$last_run" \
    '{target:$target,
      repository_identity:{state:$identity,path:$path},
      last_run:$last_run}'
}

# Restore verification has no durable state on this host yet. Report unknown
# rather than implying the backups have been proven restorable.
# Only a recorded, successful, isolated restore counts. A successful backup does
# not, and neither does a repository check. Records are written solely by
# `domum-media-backup verify-restore`.
#
# Two separate questions are answered: what happened on the most recent
# verification attempt, and when did verification last genuinely pass. A failed
# attempt must not erase the second.
report_restore_verification() {
  local dir="$DOMUM_STATE_ROOT/restore-verification" f
  # Note: the snapshot reported is deliberately the last VERIFIED one
  # (ok_snapshot), not the one a failed attempt was looking at.
  local newest_epoch="" newest_result="" newest_target="" newest_reason="" newest_checks=""
  local ok_epoch="" ok_target="" ok_snapshot=""

  if [[ -d "$dir" ]]; then
    shopt -s nullglob
    for f in "$dir"/*.env; do
      local v_result v_ts v_target v_snapshot v_checks v_reason v_ok_ts v_ok_snap
      local v_epoch="" v_ok_epoch=""
      eval "$(
        unset RESULT VERIFIED_TS TARGET SNAPSHOT_ID CHECKS REASON LAST_SUCCESS_TS LAST_SUCCESS_SNAPSHOT_ID
        # shellcheck disable=SC1090
        . "$f" >/dev/null 2>&1 || true
        printf 'v_result=%q\nv_ts=%q\nv_target=%q\nv_snapshot=%q\nv_checks=%q\nv_reason=%q\nv_ok_ts=%q\nv_ok_snap=%q\n' \
          "${RESULT:-}" "${VERIFIED_TS:-}" "${TARGET:-}" "${SNAPSHOT_ID:-}" "${CHECKS:-}" \
          "${REASON:-}" "${LAST_SUCCESS_TS:-}" "${LAST_SUCCESS_SNAPSHOT_ID:-}"
      )"
      [[ -n "$v_ts" ]] && v_epoch="$(date -d "$v_ts" +%s 2>/dev/null || true)"
      if [[ "$v_epoch" =~ ^[0-9]+$ ]]; then
        if [[ -z "$newest_epoch" ]] || (( v_epoch > newest_epoch )); then
          newest_epoch="$v_epoch"; newest_result="$v_result"; newest_target="$v_target"
          newest_checks="$v_checks"; newest_reason="$v_reason"
        fi
      fi
      # When did this target last genuinely pass?
      if [[ "$v_result" == "success" ]]; then
        v_ok_epoch="$v_epoch"
      elif [[ -n "$v_ok_ts" ]]; then
        v_ok_epoch="$(date -d "$v_ok_ts" +%s 2>/dev/null || true)"
        v_snapshot="$v_ok_snap"
      fi
      if [[ "$v_ok_epoch" =~ ^[0-9]+$ ]]; then
        if [[ -z "$ok_epoch" ]] || (( v_ok_epoch > ok_epoch )); then
          ok_epoch="$v_ok_epoch"; ok_target="$v_target"; ok_snapshot="$v_snapshot"
        fi
      fi
    done
    shopt -u nullglob
  fi

  local state reason=""
  case "$newest_result" in
    success) state="verified" ;;
    failure) state="failed"; reason="${newest_reason:-the most recent restore verification did not pass}" ;;
    "")      state="unknown"; reason="no restore verification has been recorded on this host" ;;
    *)       state="unknown"; reason="the most recent restore verification record is not interpretable" ;;
  esac

  jq -cn \
    --arg state "$state" --arg reason "$reason" \
    --arg target "${ok_target:-$newest_target}" --arg snapshot "$ok_snapshot" --arg checks "$newest_checks" \
    --argjson at "$(report_iso_from_epoch "$ok_epoch")" \
    --argjson age "$(report_age_seconds "$ok_epoch")" \
    --argjson attempted_at "$(report_iso_from_epoch "$newest_epoch")" \
    '{state:$state,
      target:($target|select(length>0) // null),
      snapshot_id:($snapshot|select(length>0) // null),
      checks:($checks|select(length>0) // null),
      last_verified_at:$at,
      age_seconds:$age,
      last_attempt_at:$attempted_at,
      reason:($reason|select(length>0) // null)}'
}

report_generate_json() {
  cmd_exists jq || die "jq is required for report output"
  REPORT_NOW_EPOCH="${DOMUM_REPORT_NOW_EPOCH:-$(date +%s)}"
  local generated_at uptime_seconds=null load1=null load5=null load15=null
  generated_at="$(date -d "@$REPORT_NOW_EPOCH" --iso-8601=seconds)"
  [[ -r "${DOMUM_REPORT_PROC_ROOT:-/proc}/uptime" ]] && read -r uptime_seconds _ < "${DOMUM_REPORT_PROC_ROOT:-/proc}/uptime"
  uptime_seconds="${uptime_seconds%%.*}"
  if [[ -r "${DOMUM_REPORT_PROC_ROOT:-/proc}/loadavg" ]]; then
    read -r load1 load5 load15 _ < "${DOMUM_REPORT_PROC_ROOT:-/proc}/loadavg"
  fi

  local mem_total=null mem_available=null mem_used=null mem_percent=null
  if [[ -r "${DOMUM_REPORT_PROC_ROOT:-/proc}/meminfo" ]]; then
    mem_total="$(awk '/^MemTotal:/ {print $2 * 1024}' "${DOMUM_REPORT_PROC_ROOT:-/proc}/meminfo")"
    mem_available="$(awk '/^MemAvailable:/ {print $2 * 1024}' "${DOMUM_REPORT_PROC_ROOT:-/proc}/meminfo")"
    if [[ "$mem_total" =~ ^[0-9]+$ && "$mem_available" =~ ^[0-9]+$ ]]; then
      mem_used=$(( mem_total - mem_available ))
      (( mem_total > 0 )) && mem_percent=$(( mem_used * 100 / mem_total ))
    fi
  fi
  local temperature=null thermal
  shopt -s nullglob
  for thermal in "${DOMUM_REPORT_THERMAL_ROOT:-/sys/class/thermal}"/thermal_zone*/temp; do
    temperature="$(awk '{printf "%.1f", $1 / 1000}' "$thermal" 2>/dev/null || true)"
    [[ -n "$temperature" ]] && break
  done
  shopt -u nullglob

  local work containers_file fs_file protection_file updates_file backups_file failed_file targets_file
  work="$(report_tmp_register "$(mktemp -d)")"
  containers_file="$work/containers"; fs_file="$work/filesystems"; protection_file="$work/protection"
  updates_file="$work/updates"; backups_file="$work/backups"; failed_file="$work/failed"
  targets_file="$work/targets"
  : > "$containers_file"; : > "$fs_file"; : > "$protection_file"; : > "$updates_file"; : > "$backups_file"; : > "$failed_file"
  : > "$targets_file"

  local logical name image path service enable_var data_path target file
  while IFS='|' read -r logical name image; do report_container "$logical" "$name" "$image" >> "$containers_file"; done < <(report_container_specs)
  for path in / /srv/data /srv/media /srv/snapshots; do report_filesystem "$path" >> "$fs_file"; done
  while IFS='|' read -r service enable_var _ _ _ _ _; do
    [[ "${!enable_var:-0}" == "1" ]] || continue
    service_backup_required "$service" || continue
    data_path="$(service_data_path "$service" 2>/dev/null || true)"
    [[ -n "$data_path" ]] && report_snapshot_protection "$service" "$data_path" >> "$protection_file"
  done < <(service_lifecycle_specs)
  shopt -s nullglob
  for file in "$DOMUM_STATE_ROOT"/image-updates/*.env; do report_update_candidate generic "$(basename "$file" .env)" "$file" >> "$updates_file"; done
  shopt -u nullglob
  [[ -f "$DOMUM_STATE_ROOT/immich/bundle-candidate.env" ]] && report_update_candidate immich immich "$DOMUM_STATE_ROOT/immich/bundle-candidate.env" >> "$updates_file"
  while IFS= read -r target; do
    report_latest_backup_snapshot "$target" >> "$backups_file"
    report_backup_target_state "$target" >> "$targets_file"
  done < <(enabled_backup_targets)

  local failed_state=unknown failed_count=null
  if cmd_exists systemctl; then
    systemctl --failed --no-legend --plain --type=service 2>/dev/null | awk 'NF {print $1}' | jq -R . >> "$failed_file" || true
    failed_count="$(wc -l < "$failed_file" | tr -d ' ')"; failed_state=available
  fi

  local heartbeat_epoch="" heartbeat_at=null heartbeat_age=null heartbeat_state=missing
  if heartbeat_epoch="$(backup_last_success_epoch 2>/dev/null)"; then
    heartbeat_at="$(report_iso_from_epoch "$heartbeat_epoch")"; heartbeat_age="$(report_age_seconds "$heartbeat_epoch")"; heartbeat_state=available
  fi
  local recovery_json dump_json library_json
  recovery_json="$(report_file_details "$(recovery_pack_state_file)")"
  if [[ -f "$(recovery_pack_state_file)" ]]; then
    unset TS SIZE ARCHIVE_PATH VERIFIED_TS
    # shellcheck disable=SC1090
    source "$(recovery_pack_state_file)"
    recovery_json="$(jq -cn --argjson at "$(report_iso_from_epoch "${TS:-}")" --argjson age "$(report_age_seconds "${TS:-}")" --argjson size "${SIZE:-null}" '{state:"available",created_at:$at,age_seconds:$age,size_bytes:$size}')"
  fi
  library_json="$(report_file_details "${IMMICH_LIBRARY_DIR:-$DOMUM_DATA_ROOT/immich/library}")"
  dump_json="$(report_file_details "$DOMUM_DATA_ROOT/immich/backup-staging/immich-postgres.dump.sql.gz")"

  local backup_timer check_timer image_timer reboot=false
  backup_timer="$(report_systemd_state domum-media-backup.timer domum-media-backup.service)"
  check_timer="$(report_systemd_state domum-media-check.timer domum-media-check.service)"
  image_timer="$(report_systemd_state domum-media-image-refresh.timer domum-media-image-refresh.service)"
  [[ -e "${DOMUM_REPORT_REBOOT_REQUIRED:-/var/run/reboot-required}" ]] && reboot=true

  local initial overall findings
  initial="$(jq -cn \
    --arg generated "$generated_at" --argjson uptime "${uptime_seconds:-null}" \
    --argjson load1 "$load1" --argjson load5 "$load5" --argjson load15 "$load15" \
    --argjson mem_total "$mem_total" --argjson mem_available "$mem_available" --argjson mem_used "$mem_used" --argjson mem_percent "$mem_percent" \
    --argjson temperature "$temperature" --argjson reboot "$reboot" \
    --arg failed_state "$failed_state" --argjson failed_count "$failed_count" \
    --argjson failed_units "$(jq -s . "$failed_file")" --argjson containers "$(jq -s . "$containers_file")" \
    --argjson filesystems "$(jq -s . "$fs_file")" --arg heartbeat_state "$heartbeat_state" \
    --argjson heartbeat_at "$heartbeat_at" --argjson heartbeat_age "$heartbeat_age" \
    --argjson backup_timer "$backup_timer" --argjson check_timer "$check_timer" --argjson image_timer "$image_timer" \
    --argjson library "$library_json" --argjson dump "$dump_json" --argjson snapshots "$(jq -s . "$backups_file")" \
    --argjson targets "$(jq -s . "$targets_file")" --argjson restore_verification "$(report_restore_verification)" \
    --argjson recovery "$recovery_json" --argjson candidates "$(jq -s . "$updates_file")" \
    --argjson protection "$(jq -s . "$protection_file")" --arg image_policy "${IMAGE_AUTO_UPDATE_ENABLED:-0}" \
    --arg snapshot_policy "${SNAPSHOT_POLICY:-REQUIRED}" \
    --arg immich_enabled "${ENABLE_IMMICH:-0}" \
    '{schema_version:2,generated_at:$generated,overall:"unknown",
      host:{uptime_seconds:$uptime,load:{one:$load1,five:$load5,fifteen:$load15},memory:{total_bytes:$mem_total,available_bytes:$mem_available,used_bytes:$mem_used,used_percent:$mem_percent},temperature_c:$temperature,pending_reboot:$reboot},
      filesystems:$filesystems,failed_systemd_units:{state:$failed_state,count:$failed_count,units:$failed_units},containers:$containers,
      immich:{enabled:($immich_enabled=="1"),library:$library,database_dump:$dump},
      backups:{heartbeat:{state:$heartbeat_state,last_success_at:$heartbeat_at,age_seconds:$heartbeat_age},timer:$backup_timer,check_timer:$check_timer,latest_snapshots:$snapshots,targets:$targets,restore_verification:$restore_verification},
      recovery_pack:$recovery,updates:{image_refresh:{policy_enabled:($image_policy=="1"),timer:$image_timer},candidates:$candidates},snapshot_protection:{policy:($snapshot_policy|ascii_upcase),enforced:(($snapshot_policy|ascii_upcase)=="REQUIRED"),services:$protection},findings:[]}')"
  findings="$(jq -c '[
    (.failed_systemd_units | select(.count != null and .count > 0) | {level:"critical",message:((.count|tostring)+" failed systemd service unit(s)"),action:"Run: systemctl --failed"}),
    (.failed_systemd_units | select(.count == null) | {level:"warning",message:"Failed systemd units could not be determined",action:"Verify systemctl is available to the reporting user"}),
    (.containers[] | select(.running == false) | {level:"critical",message:(.name+" is not running"),action:("Run: docker inspect "+.name)}),
    (.containers[] | select(.running == null) | {level:"warning",message:(.name+" state could not be inspected"),action:"Verify Docker is available to the reporting user"}),
    (.containers[] | select(.health == "unhealthy") | {level:"critical",message:(.name+" is unhealthy"),action:("Run: docker logs "+.name)}),
    (.containers[] | select(.running == true and .health == "starting") | {level:"warning",message:(.name+" health check is still starting"),action:("Re-check: docker inspect "+.name)}),
    # Severity follows the actual risk, not the mere absence of a snapshot.
    #  - gate disabled  -> a stateful operation CAN run with no rollback point.
    #  - gate enforcing -> risky operations are refused, so this is degraded but
    #    not an active hazard; how bad it is then depends on whether the state
    #    is recoverable by other means.
    (.snapshot_protection as $sp | .snapshot_protection.services[] | select(.state == "unprotected") |
      if ($sp.enforced | not) then
        {level:"critical",
         message:(.service+" has no snapshot protection and the snapshot gate is disabled (SNAPSHOT_POLICY="+$sp.policy+"), so a stateful operation can proceed with no rollback point"),
         action:("Set SNAPSHOT_POLICY=REQUIRED, or migrate "+.path+" to a Btrfs subvolume")}
      elif .tier == "strict" then
        {level:"warning",
         message:(.service+" has no service-level snapshot protection; recovery would depend on restic alone"),
         action:("Migrate "+.path+" to a Btrfs subvolume; meanwhile risky operations are refused, not run unprotected")}
      else
        {level:"info",
         message:(.service+" has no service-level snapshot protection (rebuildable state)"),
         action:("Migrate "+.path+" to a Btrfs subvolume when convenient; meanwhile risky operations are refused")}
      end),
    (.snapshot_protection.services[] | select(.state == "unknown") | {level:"warning",message:(.service+" snapshot protection is unknown"),action:"Verify the state path and Btrfs tooling"}),
    (.filesystems[] | select(.used_percent != null and .used_percent >= 90) | {level:"warning",message:(.path+" is "+(.used_percent|tostring)+"% full"),action:"Free space or expand the filesystem"}),
    (select(.backups.heartbeat.state != "available") | {level:"critical",message:"No successful backup heartbeat is available",action:"Run and verify domum-media-backup"}),
    (.backups.heartbeat | select(.age_seconds != null and .age_seconds > 172800) | {level:"critical",message:"Latest backup is older than 48 hours",action:"Inspect domum-media-backup.service"}),
    (.backups.timer | select(.enabled != "enabled" or .active != "active") | {level:"warning",message:"Backup timer is not enabled and active",action:"Inspect domum-media-backup.timer"}),
    (.backups.check_timer | select(.enabled != "enabled" or .active != "active") | {level:"warning",message:"Backup check timer is not enabled and active",action:"Inspect domum-media-check.timer"}),
    (select((.updates.candidates|length) > 0) |
      (.updates.candidates | map(select(.age_seconds != null) | .age_seconds) | max) as $oldest |
      (.updates.image_refresh.timer.enabled != "enabled") as $frozen |
      {level:"warning",
       message:(((.updates.candidates|length)|tostring)+" staged update candidate(s) awaiting deployment"
                + (if $oldest == null then "" else ", oldest seen "+(($oldest/86400)|floor|tostring)+" days ago" end)
                + (if $frozen then " (image refresh is frozen, so these will not deploy on their own)"
                   else " (image refresh is ENABLED, so these can deploy automatically)" end)),
       action:"Review: domum-media updates summary"}),
    # The freeze is enforced by the timer, not by this policy flag. If they
    # disagree, say so: someone reading only the config would conclude image
    # refresh is live.
    (.updates.image_refresh | select(.policy_enabled and .timer.enabled != "enabled") |
      {level:"warning",
       message:"IMAGE_AUTO_UPDATE_ENABLED is set in the config while the image-refresh timer is disabled",
       action:"The freeze holds because the timer is disabled. Set IMAGE_AUTO_UPDATE_ENABLED=0 so the config matches intent"}),
    (.updates.image_refresh.timer | select(.enabled == "enabled") |
      {level:"critical",
       message:"The image-refresh timer is ENABLED; automatic image deployment is no longer frozen",
       action:"Disable it: systemctl disable --now domum-media-image-refresh.timer"}),
    (.backups.restore_verification | select(.state == "failed") | {level:"critical",message:"The most recent restore verification did not pass",action:"Run: domum-media backup verify-restore <target>"}),
    (.backups.restore_verification | select(.state == "unknown") | {level:"warning",message:"No successful restore verification has been recorded",action:"Run: domum-media backup verify-restore <target>"}),
    (.backups.restore_verification | select(.state == "verified" and .age_seconds != null and .age_seconds > 2678400) | {level:"warning",message:"The last successful restore verification is over 31 days old",action:"Run: domum-media backup verify-restore <target>"}),
    (.backups.targets[] | select(.repository_identity.state == "missing") | {level:"warning",message:("Backup target "+.target+" has no pinned repository identity"),action:("Run: domum-media backup verify "+.target)}),
    (.backups.targets[] | select(.last_run.state == "failed") | {level:"critical",message:("Backup target "+.target+" last run FAILED"),action:("Inspect: journalctl -u domum-media-backup.service, then retry that target")}),
    (.backups.targets[] | select(.last_run.state == "unknown") | {level:"warning",message:("Backup target "+.target+" has no per-target run evidence"),action:"It will be recorded after the next scheduled backup run"}),
    (.backups.targets[] | select(.last_run.state == "incomplete") | {level:"warning",message:("Backup target "+.target+" has a run that started but recorded no outcome (in flight, or interrupted)"),action:"If no backup is running, inspect journalctl -u domum-media-backup.service"}),
    (.backups.targets[] | select(.last_run.state == "ok" and .last_run.age_seconds != null and .last_run.age_seconds > 172800) | {level:"warning",message:("Backup target "+.target+" last succeeded more than 48 hours ago"),action:"Inspect domum-media-backup.service for that target"}),
    (.backups.targets[] | select(.last_run.paths_missing != null) | {level:"warning",message:("Backup target "+.target+" skipped configured paths that do not exist: "+(.last_run.paths_missing|join(", "))),action:"Fix the path, or remove it from the include list for that target"})
  ]' <<< "$initial")"
  # `info` records an absence that is known, accepted and not an active risk; it
  # must not move the verdict, or every report would read as degraded forever.
  overall="$(jq -r 'if any(.[]; .level=="critical") then "critical" elif any(.[]; .level=="warning") then "warning" else "healthy" end' <<< "$findings")"
  jq --arg overall "$overall" --argjson findings "$findings" '.overall=$overall | .findings=$findings' <<< "$initial"
}

report_render_text() {
  jq -r '
    def age: if . == null then "unknown" elif . < 3600 then ((./60|floor|tostring)+"m") elif . < 86400 then ((./3600|floor|tostring)+"h") else ((./86400|floor|tostring)+"d") end;
    "domum-media report: " + (.overall|ascii_upcase) + " (" + .generated_at + ")",
    "",
    "Host",
    "  Uptime: " + (.host.uptime_seconds|age) + "  Load: " + ([.host.load.one,.host.load.five,.host.load.fifteen]|map(if .==null then "?" else tostring end)|join("/")) + "  Memory: " + (if .host.memory.used_percent==null then "unknown" else (.host.memory.used_percent|tostring)+"%" end) + "  Temp: " + (if .host.temperature_c==null then "unknown" else (.host.temperature_c|tostring)+"C" end) + "  Reboot: " + (.host.pending_reboot|tostring),
    "  Filesystems: " + ([.filesystems[] | .path+"="+(if .used_percent==null then "unknown" else (.used_percent|tostring)+"%" end)]|join("  ")),
    "  Failed systemd units: " + (if .failed_systemd_units.count==null then "unknown" else (.failed_systemd_units.count|tostring) end),
    "",
    "Containers",
    (if (.containers|length)==0 then "  No enabled application containers" else (.containers[] | "  "+.name+": "+(if .running == null then "not inspected" elif .running then .health else "not running" end)+"; restarts="+(if .restart_count==null then "unknown" else (.restart_count|tostring) end)+"; image="+(if .image.matches_available==null then "unknown" elif .image.matches_available then "current" else "staged" end)) end),
    "",
    "Immich",
    "  Library: " + .immich.library.state + "; size=" + (if .immich.library.size_bytes==null then "unknown" else (.immich.library.size_bytes|tostring)+"B" end) + (if .immich.library.kind=="directory" then "; dir mtime=" + (.immich.library.path_mtime // "unknown") + " (not content freshness)" else "; age=" + (.immich.library.age_seconds|age) end),
    "  DB dump: " + .immich.database_dump.state + "; size=" + (if .immich.database_dump.size_bytes==null then "unknown" else (.immich.database_dump.size_bytes|tostring)+"B" end) + "; age=" + (.immich.database_dump.age_seconds|age),
    "",
    "Backups",
    "  Heartbeat: " + .backups.heartbeat.state + "; age=" + (.backups.heartbeat.age_seconds|age),
    "  Backup timer: " + .backups.timer.enabled + "/" + .backups.timer.active + "; service=" + .backups.timer.result,
    "  Check timer: " + .backups.check_timer.enabled + "/" + .backups.check_timer.active + "; service=" + .backups.check_timer.result,
    (.backups.latest_snapshots[] | "  "+.target+" latest snapshot: "+(if .snapshot==null then .state else (.snapshot.time // "available") end)),
    (.backups.targets[] | "  "+.target+" repository identity: "+.repository_identity.state+"; last run: "+.last_run.state+(if .last_run.age_seconds==null then "" else " ("+(.last_run.age_seconds|age)+" ago)" end)+(if .last_run.snapshot_id==null then "" else "; snapshot "+.last_run.snapshot_id end)+(if .last_run.paths==null then "" else "; scope: "+((.last_run.paths|length)|tostring)+" path(s)" end)),
    "  Restore verification: " + .backups.restore_verification.state + (if .backups.restore_verification.state=="verified" then " ("+(.backups.restore_verification.target // "?")+", "+(.backups.restore_verification.age_seconds|age)+" ago, checks: "+(.backups.restore_verification.checks // "?")+")" else " ("+(.backups.restore_verification.reason // "no detail")+")"+(if .backups.restore_verification.last_verified_at==null then "" else "; last passed "+(.backups.restore_verification.age_seconds|age)+" ago" end) end),
    "  Recovery pack: " + .recovery_pack.state + "; age=" + (.recovery_pack.age_seconds|age),
    "",
    "Updates",
    "  Image refresh: policy=" + (.updates.image_refresh.policy_enabled|tostring) + "; timer=" + .updates.image_refresh.timer.enabled + "/" + .updates.image_refresh.timer.active,
    (if (.updates.candidates|length)==0 then "  No staged candidates" else (.updates.candidates[] | "  "+.service+": "+.candidate+(if .age_seconds==null then "; first seen: unknown" else "; first seen "+(.age_seconds|age)+" ago" end)) end),
    "",
    "Snapshot protection",
    "  Gate: SNAPSHOT_POLICY=" + .snapshot_protection.policy + (if .snapshot_protection.enforced then " (risky operations are refused without a snapshot)" else " (risky operations may proceed WITHOUT a rollback point)" end),
    (if (.snapshot_protection.services|length)==0 then "  No enabled stateful service paths" else (.snapshot_protection.services[] | "  "+.service+" ["+.tier+"]: "+.state+" ("+.reason+")") end),
    "",
    "Findings/Actions",
    (if (.findings|length)==0 then "  No immediate action required." else (.findings[] | "  ["+(.level|ascii_upcase)+"] "+.message+". "+.action) end)
  '
}

report_cmd() {
  local mode="text"
  case "$#:${1:-}" in
    0:) ;;
    1:--json) mode="json" ;;
    1:--write) mode="write" ;;
    *) die "Usage: domum-media report [--json|--write]" ;;
  esac

  if [[ -f "$CFG_FILE" ]]; then
    load_cfg
  else
    DOMUM_DATA_ROOT="${DOMUM_DATA_ROOT:-$DATA_ROOT_DEFAULT}"
    DOMUM_MEDIA_ROOT="${DOMUM_MEDIA_ROOT:-$MEDIA_ROOT_DEFAULT}"
    DOMUM_SNAPSHOT_ROOT="${DOMUM_SNAPSHOT_ROOT:-$SNAPSHOT_ROOT_DEFAULT}"
    DOMUM_LOG_DIR="${DOMUM_LOG_DIR:-$LOG_DIR_DEFAULT}"
    DOMUM_STATE_ROOT="${DOMUM_STATE_ROOT:-$STATE_ROOT_DEFAULT}"
    RECOVERY_PACK_DEST="${RECOVERY_PACK_DEST:-$DOMUM_STATE_ROOT/recovery-pack}"
  fi

  local json_file text_file report_dir
  json_file="$(report_tmp_register "$(mktemp)")"
  text_file="$(report_tmp_register "$(mktemp)")"
  trap 'report_tmp_cleanup' RETURN
  report_generate_json > "$json_file"
  report_render_text < "$json_file" > "$text_file"
  case "$mode" in
    json) cat "$json_file" ;;
    text) cat "$text_file" ;;
    write)
      report_dir="$DOMUM_STATE_ROOT/reports"
      install -d -m 0700 "$report_dir"
      local json_tmp text_tmp
      json_tmp="$(mktemp "$report_dir/.latest.json.XXXXXX")"
      text_tmp="$(mktemp "$report_dir/.latest.txt.XXXXXX")"
      install -m 0600 "$json_file" "$json_tmp"
      install -m 0600 "$text_file" "$text_tmp"
      mv -f "$json_tmp" "$report_dir/latest.json"
      mv -f "$text_tmp" "$report_dir/latest.txt"
      cat "$text_file"
      ;;
  esac
}
